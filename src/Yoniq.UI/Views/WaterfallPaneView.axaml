<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yoniq.UI.ViewModels"
             xmlns:controls="using:Yoniq.UI.Controls"
             x:Class="Yoniq.UI.Views.WaterfallPaneView"
             x:DataType="vm:WaterfallPaneViewModel">

    <Border Classes="YoniqPanelBody">
        <controls:WaterfallControl Frame="{Binding LatestFrame}" />
    </Border>

</UserControl>
