<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Yoniq.UI.Localization"
             xmlns:vm="using:Yoniq.UI.ViewModels"
             x:Class="Yoniq.UI.Views.RxImagePaneView"
             x:DataType="vm:RxImagePaneViewModel">

    <Border Classes="YoniqPanelBody">
        <Panel>
            <TextBlock Text="{loc:Translate Panes.RxImage.NoImageYet}"
                       IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Image Source="{Binding Image}"
                   Stretch="Uniform"
                   IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>
    </Border>

</UserControl>
