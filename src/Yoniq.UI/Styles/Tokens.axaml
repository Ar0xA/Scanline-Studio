<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design-token layer: see spec/09-ui.md's "Aesthetic Directive": raw, functional
         instrumentation (cuSDR64/Perseus/SDR++), not a modern SaaS look. No rounded corners, no
         gradients/shadows/glows, minimal padding, monospace for all numeric/data readouts. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="YoniqPanelHeaderBackgroundColor">#1B1B20</Color>
                    <Color x:Key="YoniqPanelHeaderForegroundColor">#D6D6DC</Color>
                    <Color x:Key="YoniqPanelBodyBackgroundColor">#131316</Color>
                    <Color x:Key="YoniqPanelBorderColor">#2A2A30</Color>
                    <Color x:Key="YoniqAccentColor">#3FA7D6</Color>
                    <Color x:Key="YoniqTxActiveColor">#D64545</Color>
                    <Color x:Key="YoniqTxActiveForegroundColor">#FFFFFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="YoniqPanelHeaderBackgroundColor">#E4E4EA</Color>
                    <Color x:Key="YoniqPanelHeaderForegroundColor">#202024</Color>
                    <Color x:Key="YoniqPanelBodyBackgroundColor">#F2F2F5</Color>
                    <Color x:Key="YoniqPanelBorderColor">#CFCFD6</Color>
                    <Color x:Key="YoniqAccentColor">#1E7EA8</Color>
                    <Color x:Key="YoniqTxActiveColor">#B93636</Color>
                    <Color x:Key="YoniqTxActiveForegroundColor">#FFFFFF</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Spacing scale: Aesthetic Directive says 2px/4px maximum between individual elements.
                 "Large" is deliberately still small (6px) and reserved for rare panel-level
                 separation only, never the default for control-to-control spacing. Two shapes of
                 the same numbers: plain doubles for double-typed properties (e.g.
                 StackPanel.Spacing), Thickness for Padding/Margin. Avalonia's DynamicResource
                 lookup does not run the string-to-Thickness type converter a Padding="4" literal
                 gets, so a bare double resource used against a Thickness-typed property throws at
                 runtime (confirmed by actually running the app, not assumed). -->
            <x:Double x:Key="YoniqSpacingSmall">2</x:Double>
            <x:Double x:Key="YoniqSpacingMedium">4</x:Double>
            <x:Double x:Key="YoniqSpacingLarge">6</x:Double>
            <Thickness x:Key="YoniqPaddingSmall">2</Thickness>
            <Thickness x:Key="YoniqPaddingMedium">4</Thickness>
            <Thickness x:Key="YoniqPaddingLarge">6</Thickness>

            <!-- Monospace for every numeric/rapid-update readout (frequency, signal meters, etc.):
                 comma-separated fallback list, same mechanism as bundling Inter for body text, but
                 relying on each OS's own already-installed monospace font rather than adding another
                 bundled-font dependency for a Phase-3 minimal need. -->
            <FontFamily x:Key="YoniqMonospaceFontFamily">Consolas,Cascadia Mono,DejaVu Sans Mono,Liberation Mono,Menlo,monospace</FontFamily>

            <!-- TX toggle button: opt-in (Theme="{StaticResource YoniqTxToggleButtonTheme}"), not a
                 global implicit style, since this state coloring is specific to the one TX/transmit
                 control, not every ToggleButton in the app. -->
            <ControlTheme x:Key="YoniqTxToggleButtonTheme" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Style Selector="^:checked /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource YoniqTxActiveColor}" />
                    <Setter Property="TextBlock.Foreground" Value="{DynamicResource YoniqTxActiveForegroundColor}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Square corners everywhere, globally: the Aesthetic Directive's least negotiable rule.
         FluentTheme's default control themes expose CornerRadius as a themed property their own
         templates bind to, so overriding it here (rather than replacing whole templates) is enough. -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource YoniqPaddingMedium}" />
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource YoniqPaddingMedium}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource YoniqPaddingSmall}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource YoniqPaddingSmall}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.YoniqPanelHeader">
        <Setter Property="Background" Value="{DynamicResource YoniqPanelHeaderBackgroundColor}" />
        <Setter Property="Padding" Value="{DynamicResource YoniqPaddingMedium}" />
    </Style>
    <Style Selector="Border.YoniqPanelHeader TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource YoniqPanelHeaderForegroundColor}" />
    </Style>

    <Style Selector="Border.YoniqPanelBody">
        <Setter Property="Background" Value="{DynamicResource YoniqPanelBodyBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YoniqPanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource YoniqPaddingMedium}" />
    </Style>

    <!-- Rigid grouping: a bordered "module" container simulating a physical hardware module
         boundary (Avalonia has no native GroupBox); opt-in via Classes="YoniqModuleGroup", not
         every Border, since not every container is meant to read as a distinct instrument module. -->
    <Style Selector="Border.YoniqModuleGroup">
        <Setter Property="BorderBrush" Value="{DynamicResource YoniqPanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource YoniqPaddingSmall}" />
    </Style>

    <!-- Monospace readout: opt-in via Classes="YoniqReadout" on any TextBlock showing a
         frequency/signal-meter/rapid-update numeric value. -->
    <Style Selector="TextBlock.YoniqReadout">
        <Setter Property="FontFamily" Value="{DynamicResource YoniqMonospaceFontFamily}" />
    </Style>

</Styles>
