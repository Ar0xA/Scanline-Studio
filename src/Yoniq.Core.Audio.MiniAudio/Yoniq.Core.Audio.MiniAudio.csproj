<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for pointer-based ring buffer P/Invoke (MiniAudioRing): pinning a Span/array via
         `fixed` and passing the raw pointer is the allocation-free path; marshaling a `float[]`
         parameter on every call would allocate/copy on every single audio buffer, defeating the
         entire point of piece Audio 3. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yoniq.Abstractions\Yoniq.Abstractions.csproj" />
  </ItemGroup>

  <!--
    Piece Audio 1 scope only: builds the native shim for Linux (this dev sandbox), via a plain
    gcc invocation. This is deliberately NOT the real cross-platform build: per-RID matrix
    (win-x64/arm64, linux-x64/arm64, osx universal), platform-specific link flags (CoreAudio/
    AudioToolbox/AudioUnit frameworks on macOS), and the committed-binaries-vs-build-from-source
    decision are piece Audio 1b's job, still pending. Gated to Linux only so this doesn't break
    a build on any other OS before that piece lands.
  -->
  <Target Name="BuildNativeShimLinux" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <NativeDir>$(MSBuildProjectDirectory)/native/</NativeDir>
      <NativeObjPath>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)yoniq_audio.o</NativeObjPath>
      <NativeLibPath>$(MSBuildProjectDirectory)/$(OutDir)libyoniqaudio.so</NativeLibPath>
    </PropertyGroup>
    <Exec Command="gcc -c -O2 -fPIC &quot;$(NativeDir)yoniq_audio.c&quot; -o &quot;$(NativeObjPath)&quot;" />
    <Exec Command="gcc -shared -o &quot;$(NativeLibPath)&quot; &quot;$(NativeObjPath)&quot; -ldl -lpthread -lm" />
  </Target>
</Project>
