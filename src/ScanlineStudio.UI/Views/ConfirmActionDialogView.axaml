<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        x:Class="ScanlineStudio.UI.Views.ConfirmActionDialogView"
        x:DataType="vm:ConfirmActionDialogViewModel"
        Title="{Binding Title}"
        Width="380" SizeToContent="Height"
        MinWidth="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <!-- Configurations-preset backlog, Phase 4b (2026-08-28). Modeled on TextPromptWindowView.axaml's
         own Border/Grid content-footer split. No/Cancel is IsDefault AND IsCancel — Enter and Esc both
         decline, matching this dialog's own "prevent accidental resets/deletes" purpose.

         User-caught fix (2026-08-28): a hardcoded Height="180" left a large dead gap below the
         buttons — this dialog's whole content (one message line + one button row) never needs
         anywhere near that. SizeToContent="Height" fits the window to whatever the Grid actually
         measures, which also scales correctly for a longer configuration name that wraps to 2 lines
         instead of leaving a fixed number wrong in either direction. -->

    <Border Background="{DynamicResource IndustryBg}">
        <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource IndustryPaddingGroup}" RowSpacing="{StaticResource IndustrySpacingGroup}">
            <TextBlock Grid.Row="0" Classes="IndustryRowValue" TextWrapping="Wrap" Text="{Binding Message}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource IndustrySpacingTight}">
                <!-- Templates rack rework: CancelLabel/ConfirmLabel are now REQUIRED constructor
                     args (yoniq-auditor finding — {loc:Translate ...} can't be used as a
                     TargetNullValue since it returns a Binding object, not a string; every caller
                     passes its own already-localized text explicitly instead). Cancel stays
                     IsDefault/IsCancel regardless of which label it shows — Enter/Esc must always
                     decline, never the destructive/replacing action, matching this dialog's whole
                     "prevent accidental resets/deletes" purpose stated above. -->
                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0"
                        Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
                <Button Grid.Column="2" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0"
                        Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" />
            </Grid>
        </Grid>
    </Border>
</Window>
