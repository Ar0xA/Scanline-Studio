<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        x:Class="ScanlineStudio.UI.Views.UnexpectedErrorDialogView"
        x:DataType="vm:UnexpectedErrorDialogViewModel"
        Title="{loc:Translate Errors.Unexpected.Title}"
        Width="420" SizeToContent="Height"
        MinWidth="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <!-- Same OK-only shape as QuickSwitchFailedDialogView.axaml, with a static locale message. Shown
         non-modal (UnexpectedErrorNotice) so the main window and Stop TX stay usable. -->

    <Border Background="{DynamicResource IndustryBg}">
        <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource IndustryPaddingGroup}" RowSpacing="{StaticResource IndustrySpacingGroup}">
            <TextBlock Grid.Row="0" Classes="IndustryRowValue" TextWrapping="Wrap"
                       Text="{loc:Translate Errors.Unexpected.Message}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0"
                        Content="{loc:Translate Errors.Unexpected.Ok}" Command="{Binding CloseCommand}"
                        IsDefault="True" IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
