<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             x:Class="ScanlineStudio.UI.Views.RxImagePaneView"
             x:DataType="vm:RxImagePaneViewModel">

    <Border Classes="ScanlineStudioPanelBody">
        <Panel>
            <TextBlock Text="{loc:Translate Panes.RxImage.NoImageYet}"
                       IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Image Source="{Binding Image}"
                   Stretch="Uniform"
                   IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>
    </Border>

</UserControl>
