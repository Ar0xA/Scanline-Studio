<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             x:Class="ScanlineStudio.UI.Views.RxImagePaneView"
             x:DataType="vm:RxImagePaneViewModel">

    <!-- §7.4 fixed exception: this is the live received-frame pane, so it needs
         ControlBorder (#A0A0A0) not the shared Border.IndustryPlot chrome default
         (#B9B9B9) — a local override, not a retarget of IndustryPlot itself, since that
         style is also shared with the spectrum/waterfall instrument canvases (§7.3),
         which legitimately stay chrome. The override wins on plain Avalonia priority
         (LocalValue > Style setter) — this is this codebase's first site where a local
         attribute deliberately shadows a Style setter of the same property, not an
         existing in-repo pattern being reused, so don't go looking for a precedent
         elsewhere in this file. -->
    <Border Classes="Industry IndustryPlot" BorderBrush="{DynamicResource IndustryControlBorder}">
        <Panel>
            <TextBlock Text="{loc:Translate Panes.RxImage.NoImageYet}"
                       Foreground="{DynamicResource IndustryPlotInk}"
                       Opacity="0.55"
                       IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Image Source="{Binding Image}"
                   Stretch="Uniform"
                   IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>
    </Border>

</UserControl>
