<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:conv="using:ScanlineStudio.UI.Converters"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             x:Class="ScanlineStudio.UI.Views.TxImageEditorPaneView"
             x:DataType="vm:TxImageEditorPaneViewModel"
             KeyDown="OnRootKeyDown">

    <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/"cardInner"/"caption"/
         "tool"/"small"/"halt"/"value"/"label"/"chip"/"kv"/"thumb"/"plot"/"pill"/"readoutSmall"/
         "safeArea"/"plate"/"plateText" styling). One of the design's 2 real "gb blueprint" (title
         notch + corner marks together) sites, per Atoms.axaml's own item-1 correction (the other is
         the Receive tab's Incoming-frame card, MainWindow.axaml — same
         Classes="Industry blueprint"/Theme={StaticResource IndustryGroupBoxTheme}/
         Padding={StaticResource IndustryGbPaddingWideDeep} pattern, reused here for consistency).
         Header merges the old split Title+right-aligned-Caption TextBlocks into ONE string (now
         bound to HeaderText, a computed VM property formatted from the real target mode's own
         dimensions/name — spec/18-path-to-1.0.md Medium item; originally a static
         Panes.TxImageEditor.CardHeader locale key hardcoding "640×496 · PD120" regardless of the
         actual mode being edited): the title-notch
         template only has room for a single Left-aligned ContentPresenter, matching every other
         ported card's own single-title-string precedent (RxImage.CardHeader etc.) and mock2's own
         single `<span class="gbt">` for this exact card. -->
    <!-- Margin top=6 (design-fidelity-agent re-check): the Transmit tab's outer Grid margin
         alone (fix above, 258,*,330 -> 236,*,312 / 9,11,9,8) wasn't quite enough clearance for
         THIS card specifically — unlike the Receive tab's Incoming-frame blueprint card (which
         sits below a sibling row and gets extra clearance from RowSpacing), this is the ONLY
         element in the centre column, so it only ever had the outer Grid's raw top margin. Same
         "headroom on the card itself, not just the ancestor" fix as TxControlsPaneView's own
         root Margin. -->
    <HeaderedContentControl Classes="Industry blueprint" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWideDeep}" ClipToBounds="False" Margin="0,6,0,0">
        <HeaderedContentControl.Header>
            <TextBlock Classes="IndustryGbTitle" Text="{Binding HeaderText}" />
        </HeaderedContentControl.Header>
        <Grid RowDefinitions="Auto,*">

            <!-- Merged tool strip: Move/Crop/Scale/.../Pick RadioButton group, IndustryMiniRadioTheme
                 (GroupName="EditorTool"). Only "Move" reflects real behavior (the default/only tool
                 state), so it's the sole enabled+checked radio; the other 7 (Rotate graduated out to
                 a real Button below, spec/18-path-to-1.0.md High item 3) imply tool-switching
                 that doesn't exist (Crop/Text are especially misleading since a REAL always-on crop
                 rectangle and a separate real "Add text" button already exist elsewhere in this
                 file) — disabled with the app's standard NotImplemented tooltip rather than removed,
                 since removing Move's siblings would leave an orphan single radio with no group
                 context. Undo/Redo now real (spec/18-path-to-1.0.md Medium item, undo/redo
                 sub-piece — CanExecute-gated via UndoCommand/RedoCommand, no IsEnabled="False"/
                 NotImplemented tooltip needed). Fit/100% now real (Phase 7, spec/15-template-
                 designer.md — see this file's own OnFitButtonClick/ApplyFitFromViewport and
                 TxImageEditorPaneViewModel.ZoomFactor's own doc comment).
                 Safe-area's ToggleButton isn't wired to the canvas guide below
                 (that guide is unconditionally visible), so it's disabled too but keeps
                 IsChecked="True" to match the guide's always-on state. Dimensions chip is a plain
                 (non-interactive) label, left as-is. Real wired
                 PreserveAspect/AddText/Apply/Cancel on the right — ALL in one WrapPanel (not a fixed
                 non-wrapping StackPanel/Grid), matching the old design's own stated intent
                 ("collapsed from 2 rows into 1 to match mock2's single tool-strip row") while fixing
                 a real containment risk that intent introduces: mock2's row assumes a 1920px-wide
                 design canvas, this column is far narrower at runtime, so a non-wrapping row would
                 clip; WrapPanel degrades to extra lines instead (containment over an exact 1-line
                 match, this project's #1 priority). -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <!-- Phase 1 (spec/15-template-designer.md): the old EditorTool RadioButton group
                     (Move/Crop/Scale/Text/Box/Line/Mask/Pick) removed outright — 7 of its 8
                     members were already dead stubs implying tool-switching that doesn't exist, and
                     the 8th (Move) had no distinct behavior of its own to keep (drag always works
                     regardless of any "tool" selection) — a lone surviving radio with no group
                     siblings would look broken, not minimal. -->
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Command="{Binding UndoCommand}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Undo}" />
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Command="{Binding RedoCommand}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Redo}" />
                <!-- Phase 7 (spec/15-template-designer.md): Fit needs the ScrollViewer's own runtime
                     viewport size (View knowledge), which a plain Command binding can't supply, so
                     Click reads EditorScrollViewer.Bounds in code-behind and calls vm.ApplyFit(w,h)
                     directly — a small necessary deviation from a zero-arg RelayCommand. 100% needs
                     no viewport data, so it stays a plain Command binding. -->
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Click="OnFitButtonClick" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Fit}" />
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Command="{Binding ZoomActualCommand}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.ZoomActual}" />
                <!-- Task #23 (zoom slider addendum, plan-reviewed). Minimum/Maximum bound via
                     x:Static to the VM's own public MinZoomFactor/MaxZoomFactor consts — NOT
                     hardcoded XAML literals — since ZoomFactor's own property setter has no clamp;
                     a drifted slider Maximum would write an out-of-range value straight through with
                     nothing else to catch it (unlike the adjustment sliders below, whose bounds exist
                     nowhere else in the codebase). Explicit Width (a bare Slider has no intrinsic
                     width and would collapse to ~thumb size unconstrained inside this WrapPanel).
                     Unanchored (plan-review finding): unlike the scroll-wheel path, dragging this
                     slider does NOT adjust EditorScrollViewer.Offset to keep any particular canvas
                     point fixed — the user's eyes are on the slider while dragging it, not the
                     canvas, so center-anchoring only adds cross-path re-entrancy risk (both this
                     binding and the wheel handler write the same ZoomFactor) for little real benefit. -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}" Margin="0,0,4,4" VerticalAlignment="Center">
                    <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Zoom}" />
                    <Slider Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}"
                            Width="120"
                            Minimum="{x:Static vm:TxImageEditorPaneViewModel.MinZoomFactor}"
                            Maximum="{x:Static vm:TxImageEditorPaneViewModel.MaxZoomFactor}"
                            Value="{Binding ZoomFactor}"
                            VerticalAlignment="Center" />
                    <TextBlock Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding ZoomPercentText}" />
                </StackPanel>
                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" IsChecked="{Binding SnapToGrid}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.SnapGrid}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.SnapGrid.Help}" />
                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" IsChecked="{Binding SafeAreaVisible}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.SafeArea}" />
                <Border Classes="Industry IndustryMini" Margin="0,0,4,4"><TextBlock Text="{Binding DimensionsChipText}" /></Border>

                <!-- Real, wired: aspect toggle + add-text + apply/cancel. PreserveAspect has no
                     mockup equivalent (mock2's own row ends at the dimensions chip) — reuses
                     IndustryMiniToggleTheme per its own established "checkbox-like toggle with no
                     mockup equivalent" precedent (Peak-hold/SWR-cutoff), not a new CheckBox atom. -->
                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="12,0,4,4"
                              IsChecked="{Binding PreserveAspect}"
                              Content="{loc:Translate Panes.TxImageEditor.PreserveAspect}" />
                <!-- Real, wired (spec/18-path-to-1.0.md High item 4): constrains crop-rect drag-resize
                     SHAPE to the target mode's own aspect ratio — orthogonal to PreserveAspect above,
                     which governs the separate letterbox-vs-stretch Resize step, not crop shape.
                     Combining this ON with PreserveAspect OFF (stretch) fills the mode's frame
                     edge-to-edge with zero distortion and zero letterboxing — the tooltip states
                     that combination explicitly since the two toggles' relationship isn't obvious
                     from the labels alone. -->
                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="0,0,4,4"
                              IsChecked="{Binding LockAspectToMode}"
                              Content="{loc:Translate Panes.TxImageEditor.LockAspectToMode}"
                              ToolTip.Tip="{loc:Translate Panes.TxImageEditor.LockAspectToMode.Help}" />
                <!-- Real, wired (spec/18-path-to-1.0.md High item 3): a real action button, not a
                     RadioButton in the EditorTool group above — rotate is an instant 90°-clockwise
                     action (4 clicks returns to the original orientation), not a persistent
                     tool/mode the way Move conceptually is. Reuses the same
                     Panes.TxImageEditor.ToolRotate localization key the removed disabled
                     RadioButton used to occupy — that was its only other reference. -->
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.ToolRotate}"
                        Command="{Binding RotateCommand}" />
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.AddText}"
                        Command="{Binding AddOverlayElementCommand}" />
                <!-- Phase 1: reuses the ToolBox locale key freed up by the tool-strip removal above
                     (same reuse pattern ToolRotate's own comment already established for this
                     card). -->
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.ToolBox}"
                        Command="{Binding AddBoxElementCommand}" />
                <!-- Phase 2 (spec/15-template-designer.md): 3-source picker (file / last RX image /
                     RX history) — clipboard-paste and OS drag-drop deliberately deferred, see the
                     plan's own scope-cut reasoning (zero existing precedent for either anywhere in
                     this codebase). The "From RX history" row's own nested Flyout opens a second
                     picker list; its Command ALSO triggers a refresh on open (Button.Flyout opening
                     doesn't itself run any VM code — the Command binding is what does). -->
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.AddImage}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="4" MinWidth="180">
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:Translate Panes.TxImageEditor.AddImageFromFile}"
                                        Command="{Binding AddImageFromFileCommand}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:Translate Panes.TxImageEditor.AddImageFromLastRx}"
                                        Command="{Binding AddLastRxImageCommand}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:Translate Panes.TxImageEditor.AddImageFromRxHistory}"
                                        Command="{Binding RefreshRxHistoryPickerCommand}">
                                    <Button.Flyout>
                                        <Flyout Placement="RightEdgeAlignedTop">
                                            <ScrollViewer MaxHeight="280">
                                                <ItemsControl ItemsSource="{Binding RxHistoryPickerEntries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <!-- SelectCommand is parent-pushed on the entry
                                                             record itself (see its own doc comment) —
                                                             not a $parent[ItemsControl] binding path. -->
                                                        <DataTemplate DataType="vm:TxImageEditorPaneViewModel+RxHistoryPickerEntry">
                                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    Margin="0,0,0,2"
                                                                    Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Image Source="{Binding Thumbnail}" Width="32" Height="32" Stretch="Uniform" />
                                                                    <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- Phase 6 (spec/15-template-designer.md): acts on whatever is currently selected
                     (any element type) — CanExecute-gated, not text-only like "Add plate" below. -->
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.Duplicate}"
                        Command="{Binding DuplicateCommand}" />
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnPrimary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.Apply}"
                        Command="{Binding ApplyCommand}" />
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.Cancel}"
                        Command="{Binding CancelCommand}" />
            </WrapPanel>

            <!-- EditWindow redesign Phase 1 (mockups/Editwindow, user-provided design handoff,
                 2026-08-17): "four homes, one per workflow stage" — RECALL (rack/library rail) |
                 COMPOSE (stage: toolbar + canvas) | INSPECT (preview/elements/style), left to right.
                 Fixed 212/fluid/364 columns, matching the mock's own body proportions (rack 212px
                 fixed, stage fluid, inspector 364px fixed) — widened from the pre-redesign 186px
                 side column since the TEXT STYLE panel's real content (Phase 4/8) needs the room;
                 "spirit of the design over pixel-perfect" per the user's own explicit instruction,
                 so exact px values are a starting point, not a contract. Fill/QSO-fill/Send bottom
                 bar restructuring and inspector TAB splitting are later sub-phases of the same
                 redesign, not yet done here — this phase is the 3-column skeleton only. -->
            <Grid Grid.Row="1" ColumnDefinitions="212,*,364" ColumnSpacing="{StaticResource IndustrySpacingGutter}">

                <!-- RECALL rail (EditWindow redesign Phase 1): the ready rack + template library,
                     relocated here from the bottom of the old single sidebar (mockups/Editwindow
                     README's own stated gap: "the rack is a same-window action, treat it as such,"
                     i.e. give it a permanent, dedicated home rather than burying it below a scrolled
                     stack of unrelated panels). Content unchanged from Phase 5's own real
                     ITemplateStore-backed ReadyRackViewModel wiring — this phase only moves it, see
                     each control's own doc comment further down for why it's built the way it is. -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="0,0,4,0">
                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.TemplatesHeader}" />
                        </HeaderedContentControl.Header>
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <TextBox Classes="Industry IndustryInput" Watermark="{loc:Translate Panes.TxImageEditor.TemplateNamePlaceholder}" Text="{Binding NewTemplateName}" />
                                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnPrimary" Padding="7,0"
                                        Content="{loc:Translate Panes.TxImageEditor.SaveTemplate}" Command="{Binding SaveTemplateCommand}" />
                            </Grid>

                            <!-- Ready rack: fixed 3x3 grid, 1 = top-left, matching the same reading
                                 order as the number-key accelerators (D1..D9, see
                                 TxImageEditorPaneView.axaml.cs's OnRootKeyDown). An empty slot renders
                                 a bare numbered placeholder (IndustryHatchPanel, same "nothing here
                                 yet" texture the Receive tab's own empty session-frames slots use) —
                                 RecallCommand no-ops on click for an empty slot (see
                                 ReadyRackViewModel.RecallSlot's own doc comment). -->
                            <ItemsControl ItemsSource="{Binding ReadyRack.Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Rows="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReadyRackSlotViewModel">
                                        <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Margin="2" Padding="0"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                Command="{Binding RecallCommand}" CommandParameter="{Binding SlotNumber}"
                                                ToolTip.Tip="{Binding Template.Name}">
                                            <Panel>
                                                <Border Classes="IndustryHatchPanel" IsVisible="{Binding Template, Converter={x:Static ObjectConverters.IsNull}}" MinHeight="34" />
                                                <Image Source="{Binding Template.Thumbnail}" Stretch="Uniform" IsVisible="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <!-- NOT Classes="Industry IndustryMini" here (real-window finding, Phase 5): that chip
                                                     style's fixed Height="17" (AtomsTokens.axaml) is sized for use inside normal-height
                                                     controls, but IndustryBtn22's own Height is only 22px total — the chip badge ate
                                                     most of the slot and visually hid the thumbnail underneath it. A purpose-built
                                                     small corner tag instead, sized for THIS 22px button specifically. -->
                                                <Border Background="{StaticResource IndustryBg}" BorderBrush="{StaticResource IndustryControlBorder}" BorderThickness="1"
                                                        Padding="2,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1" IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding SlotNumber}" FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="8" Foreground="{StaticResource IndustryText}" />
                                                </Border>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="IndustryRowValue" Text="{loc:Translate Panes.TxImageEditor.NoTemplatesYet}" IsVisible="{Binding ReadyRack.HasNoTemplates}" />

                            <ItemsControl ItemsSource="{Binding ReadyRack.AllTemplates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TemplateListRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2" ColumnSpacing="4">
                                            <TextBlock Classes="IndustryRowValue" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                            <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.LoadTemplate}" Command="{Binding LoadCommand}" CommandParameter="{Binding}" />
                                            <ToggleButton Grid.Column="2" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0"
                                                          IsChecked="{Binding IsPinned, Mode=OneWay}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding}"
                                                          Content="{loc:Translate Panes.TxImageEditor.PinTemplate}" />
                                            <Button Grid.Column="3" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.DeleteTemplate}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
                </ScrollViewer>

                <!-- Interactive canvas: crop rectangle (drag body to move, drag the corner handle to
                     resize; legacy's own real precedent has resize on the bottom-right corner only,
                     see PicRect.cpp) and draggable overlay text, both drawn over the pre-downsampled
                     working copy at native pixel size (Stretch="None") so on-screen pixels map
                     directly to normalized crop/overlay coordinates with no scale-factor math needed.
                     Crop border/handle recolored to IndustryAccent (was ScanlineStudioAccentColor)
                     for visual consistency with the new design system — purely cosmetic, no change
                     to the real pointer-handler logic below. -->
                <DockPanel Grid.Column="1" LastChildFill="True">

                    <!-- Bottom action bar removed: it was a decorative duplicate of the real
                         Transmit/Halt controls in TxControlsPaneView's left column (locked decision
                         #8, plan), with no Command wired at all — a confirmed duplicate of real UI
                         elsewhere, removed outright rather than left as a disabled ghost (matches
                         this project's own precedent for confirmed-duplicate stub UI). -->

                    <!-- Adjustments row: real ITransmitImagePreparer.ApplyAdjustments backing
                         (spec/18-path-to-1.0.md Medium item), wired 2026-08-16. 3-per-row x 2 rows
                         (UniformGrid Columns=3, auto-flows 6 children into 2 rows), matching mock2's
                         own grid-template-columns:repeat(3,1fr) intent — IndustrySliderTheme h6
                         variant + Label/Value flanking it, same 3-cell composition as the Output
                         card's real Drive slider (TxControlsPaneView.axaml). Value readouts use
                         StringFormat={}{0:0} (MainWindow.axaml's own ModeTimingRowViewModel rows
                         are the precedent for this exact pattern in this codebase) since these
                         sliders have no TickFrequency/IsSnapToTickEnabled and would otherwise show
                         raw double noise. -->
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Brightness}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-50" Maximum="50" Value="{Binding Brightness}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Brightness, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Contrast}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-50" Maximum="50" Value="{Binding Contrast}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Contrast, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Saturation}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-50" Maximum="50" Value="{Binding Saturation}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Saturation, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Gamma}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-100" Maximum="100" Value="{Binding Gamma}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Gamma, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Sharpen}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="0" Maximum="100" Value="{Binding Sharpen}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Sharpen, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Denoise}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="0" Maximum="100" Value="{Binding Denoise}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Denoise, StringFormat={}{0:0}}" />
                        </Grid>
                    </UniformGrid>

                    <!-- Instructional caption: NOT in mock2 (app-added disclaimer, real information
                         not mockup scaffolding) — kept, re-skinned with IndustryRowLabel (closest
                         semantic match: small muted body text). -->
                    <TextBlock DockPanel.Dock="Top"
                               Classes="IndustryRowLabel"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Text="{loc:Translate Panes.TxImageEditor.Caption}" />

                    <ScrollViewer x:Name="EditorScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Phase 7 (spec/15-template-designer.md): zoom is baked directly into
                             CanvasDisplayWidth/Height (= WorkingCopyWidth/Height * ZoomFactor, and
                             into every other on-screen pixel property — CropLeftPixels/LeftPixels/
                             CanvasWidthPixels/etc.) rather than a LayoutTransformControl/RenderTransform
                             wrapper. Real-window finding, post-implementation: the original
                             LayoutTransformControl design (kept a bare WorkingCopyWidth/Height-sized
                             Canvas, scaled the whole subtree via a render transform) looked correct in
                             plan-review and built clean, but its subtree did not reliably re-composite
                             on a descendant-only bounds change — confirmed via pixel-diffed screenshots
                             (an element drag updated its bound X/Y correctly and the mini-preview picked
                             it up, but the interactive canvas itself stayed visually frozen; reproduced
                             identically at exactly 1.0 zoom, so it wasn't a "only happens when scaled"
                             issue; three different Avalonia invalidation attempts all failed). Diagnosed
                             (auditor) as a render/composition-invalidation gap specific to that control,
                             not a layout bug — the Bounds were already right every time. This
                             rearchitecture uses only ordinary Avalonia data-binding invalidation, the
                             same mechanism every other property on this page already relies on with zero
                             issues, so it sidesteps the bug class instead of working around it — see
                             TxImageEditorPaneViewModel.ZoomFactor's own doc comment for the full story.
                             No transform/wrapper control of any kind between this ScrollViewer and the
                             Panel below anymore; the Panel's own children size themselves directly off
                             CanvasDisplayWidth/Height, so Auto scrollbars/extent just work. -->
                        <!-- Panel wrapper exists only so the safe-area guide below can use ordinary
                             Margin/HorizontalAlignment/VerticalAlignment positioning; that's a no-op
                             directly inside a Canvas. The Panel sizes to the Canvas's own bound
                             CanvasDisplayWidth/Height since the Canvas is the only size-driving child.
                             (Used to also host the plate text overlays, removed 2026-08-14 — see the
                             guide's own comment below.) -->
                        <Panel>
                        <Canvas x:Name="EditorCanvas"
                                Width="{Binding CanvasDisplayWidth}"
                                Height="{Binding CanvasDisplayHeight}"
                                Focusable="True"
                                Background="Transparent"
                                KeyDown="OnCanvasKeyDown"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerReleased="OnCanvasPointerReleased">

                            <!-- Explicit Width/Height + Stretch="Fill" (was Stretch="None" with no
                                 explicit size, back when the Canvas was always native working-copy
                                 resolution and zoom didn't exist) — without this the bitmap would stay
                                 native-size while everything else on this canvas scales with zoom. -->
                            <Image Source="{Binding WorkingCopyBitmap}"
                                   Width="{Binding CanvasDisplayWidth}" Height="{Binding CanvasDisplayHeight}"
                                   Stretch="Fill" />

                            <Border Canvas.Left="{Binding CropLeftPixels}"
                                    Canvas.Top="{Binding CropTopPixels}"
                                    Width="{Binding CropWidthPixels}"
                                    Height="{Binding CropHeightPixels}"
                                    BorderBrush="{StaticResource IndustryAccent}"
                                    BorderThickness="2"
                                    Background="#22FFFF00"
                                    PointerPressed="OnCropBodyPointerPressed" />

                            <Border Canvas.Left="{Binding CropRightPixels}"
                                    Canvas.Top="{Binding CropBottomPixels}"
                                    RenderTransform="translate(-5px, -5px)"
                                    Width="10" Height="10"
                                    Background="{StaticResource IndustryAccent}"
                                    PointerPressed="OnCropHandlePointerPressed" />

                            <!-- Width/Height bound explicitly (real-window code-review finding, via
                                 Avalonia DevTools): a Canvas ItemsPanel does NOT auto-size to its
                                 children's Canvas.Left/Top-positioned content — with neither an
                                 explicit size NOR content-driven sizing, this ItemsControl's own
                                 Bounds/DesiredSize measured to (0,0,0,0) (directly observed on the live
                                 instance in DevTools' property inspector, ClipToBounds reading true on
                                 that instance too — its default control theme, not Visual's own
                                 documented false default). With zero size and clipping, nothing inside
                                 ever rendered regardless of Canvas.Left/Top/ZIndex on the elements
                                 themselves. This was a total rendering failure (not just a z-order or
                                 border-thickness issue); the fix (explicit size) is confirmed via a real
                                 running window, not inferred — round-3 code-review flagged the exact
                                 causal mechanism above as unverifiable from static docs alone, which is
                                 fair; treat it as "what DevTools showed," not a documented contract. -->
                            <ItemsControl x:Name="OverlayElementsHost" ItemsSource="{Binding OverlayElements}"
                                          Width="{Binding CanvasDisplayWidth}" Height="{Binding CanvasDisplayHeight}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <!-- Phase 7 real-window finding (post-implementation), root cause of a
                                     LIVE-UPDATE bug this codebase already had one documented symptom of
                                     (ZIndex, see the comment immediately below): Canvas.Left/Canvas.Top
                                     bound on a DataTemplate's own ROOT element only positions correctly
                                     on the FIRST layout pass. Avalonia wraps each ItemsControl item in
                                     its own generated container (a ContentPresenter here — ItemsControl
                                     has no SelectingItemsControl-style item container), and the attached
                                     Canvas.Left/Top properties are read by the OUTER ItemsPanel Canvas
                                     against THAT container, not against whatever's inside the
                                     DataTemplate — so AffectsParentArrange's invalidation, triggered by
                                     LeftPixels/TopPixels changing, never reaches the actual owning Canvas
                                     when the properties are set one level too deep. A full top-down
                                     layout pass (initial render, or anything that invalidates the whole
                                     subtree) still happens to place things correctly once, which is why
                                     this went unnoticed until a live, isolated drag was actually tested
                                     (confirmed via direct user observation on the running app: dragging
                                     an element updates the mini-preview immediately but the interactive
                                     canvas itself never visibly moves). Fixed below by moving Canvas.Left/
                                     Top onto the actual generated container via a Style targeting
                                     "ItemsControl#OverlayElementsHost > ContentPresenter" instead of the
                                     DataTemplate roots — see that Style, right after this ItemsControl's
                                     own DataTemplates. -->
                                <ItemsControl.Styles>
                                    <Style Selector="ItemsControl#OverlayElementsHost &gt; ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding LeftPixels}" />
                                        <Setter Property="Canvas.Top" Value="{Binding TopPixels}" />
                                    </Style>
                                </ItemsControl.Styles>
                                <!-- Phase 1 (spec/15-template-designer.md): polymorphic per-type
                                     DataTemplates (ItemsControl.DataTemplates, NOT a single
                                     ItemTemplate — Avalonia selects by the item's own runtime type)
                                     replace the pre-Phase-1 text-only ItemTemplate. Each template's
                                     ROOT is itself a Canvas sized (NOT positioned — see the Style
                                     above for why Canvas.Left/Top moved off this root) via the
                                     element's own CanvasWidthPixels/CanvasHeightPixels; its CHILDREN
                                     position within that inner Canvas's own coordinate space, same
                                     nested-Canvas technique the crop body/handle pair above already
                                     uses one level up. Single bottom-right resize handle per element
                                     (Phase 1 plan-review finding: mirrors the crop rect's OWN existing
                                     single-corner-handle convention — PicRect.cpp real legacy
                                     precedent, see the crop handle above — deliberately not a
                                     4-corner/8-handle system), hidden while Locked (code-behind is the
                                     real gate; this is the visual cue). -->
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:OverlayElementViewModel">
                                        <!-- No ZIndex binding here (real-window code-review finding, via
                                             Avalonia DevTools: a ZIndex bound on this DataTemplate root had
                                             NO effect — Avalonia wraps each ItemsControl item in its own
                                             container and doesn't forward the attached property to reorder
                                             those containers). Draw order instead comes from plain Canvas
                                             child order, which TxImageEditorPaneViewModel keeps in sync with
                                             Z itself (MoveElementUp/Down physically move the item within
                                             OverlayElements, not just its Z value) — see that method's own
                                             doc comment. -->
                                        <Canvas Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}">
                                            <!-- FontSize/FontFamily bound so the canvas chrome
                                                 actually matches what TransmitImagePreparer.
                                                 ApplyTemplate bakes into the transmitted image
                                                 (spec/18-path-to-1.0.md Medium item, overlay-text
                                                 WYSIWYG; Phase 1 generalized the underlying fit
                                                 computation to real shrink-to-fit). CanvasFontSize
                                                 is computed by the parent VM (not a converter here,
                                                 since it depends on the crop rect, PreserveAspect,
                                                 the element's own box, and the target mode's own
                                                 dimensions, none of which this DataTemplate's own
                                                 DataContext has access to). Foreground bound to the
                                                 element's own Color (Phase 1 fix: this was hardcoded
                                                 White pre-Phase-1 despite Color being a real,
                                                 editable, undo-tracked property — same fix class as
                                                 the box fill/border below, not a separate concern). -->
                                            <!-- RenderTransform bound to RotationTransform (Phase 8
                                                 canvas-preview amendment) — on the OUTER Border, not
                                                 either TextBlock individually, so rotation carries the
                                                 shadow copy along with the real text as one unit,
                                                 matching the real pipeline's own behavior of rotating
                                                 the whole offscreen sub-bitmap together. -->
                                            <Border Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}"
                                                    RenderTransform="{Binding RotationTransform}"
                                                    Background="#33FFFFFF"
                                                    BorderBrush="{StaticResource IndustryAccent}" BorderThickness="1"
                                                    PointerPressed="OnOverlayElementPointerPressed">
                                                <!-- Task #24 (right-click context menu addendum, plan-reviewed):
                                                     declared INLINE (not a shared resource) so DataContext
                                                     inheritance resolves {Binding XCommand} against THIS
                                                     element (plan-review finding: a shared instance would be
                                                     reparented to whichever control attached last, silently
                                                     breaking every binding — same failure class RemoveCommand's
                                                     own doc comment already documents for $parent bindings).
                                                     Lock uses MenuItem's native ToggleType="CheckBox" +
                                                     IsChecked (plan-review finding: no new command needed,
                                                     mirrors the sidebar's own ToggleButton exactly — Locked has
                                                     no undo/preview hook, confirmed via OnOverlayElementPropertyChanged's
                                                     own filter list). Duplicate/AddPlate bind the SAME
                                                     parameterless VM-level commands the toolbar already uses,
                                                     with NO CommandParameter (see DuplicateCommand's own
                                                     interface doc comment for why this is still correct). A
                                                     LOCKED background image element is unreachable by
                                                     right-click here (IsHitTestVisible="{Binding !BlocksHitTesting}"
                                                     on the image template) — a stated, known limitation, not
                                                     fixed by this addendum; the sidebar's own Lock toggle stays
                                                     the recovery path for that one case. -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Lock}" ToggleType="CheckBox" IsChecked="{Binding Locked, Mode=TwoWay}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Duplicate}" Command="{Binding DuplicateCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.AddPlate}" Command="{Binding AddPlateCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" Command="{Binding BringToFrontCommand}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" Command="{Binding SendToBackCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Remove}" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <!-- Phase 8 canvas-preview amendment: shadow copy,
                                                     drawn BEHIND the real text (declared first, same
                                                     draw-order convention as the real pipeline's own
                                                     shadow-pre-pass), offset via ShadowRenderTransform,
                                                     IsVisible-gated on HasShadow. Avalonia's TextBlock
                                                     has no native drop-shadow primitive, so this fakes
                                                     it the same way the real pipeline does: a second,
                                                     offset copy of the glyph run. -->
                                                <Panel>
                                                    <TextBlock Text="{Binding ResolvedText}"
                                                               FontSize="{Binding CanvasFontSize}"
                                                               FontFamily="{Binding FontFamily, Converter={x:Static conv:PipelineFontFamilyNameConverter.Instance}}"
                                                               Foreground="{Binding ShadowColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                               RenderTransform="{Binding ShadowRenderTransform}"
                                                               IsVisible="{Binding HasShadow}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               IsHitTestVisible="False" />
                                                    <!-- Phase 4: FontFamily now bound to the element's own
                                                         selected family (was hardcoded IndustryMonoFontFamily)
                                                         via PipelineFontFamilyNameConverter, mapping the
                                                         pipeline's plain family name to the matching bundled
                                                         avares:// resource. Foreground bound to ForegroundBrush
                                                         (Phase 8 canvas-preview amendment — a plain solid
                                                         brush from Color, or a real Avalonia gradient brush
                                                         when GradientEnabled is set). Stroke is NOT shown here
                                                         (Avalonia's plain TextBlock has no outline capability)
                                                         — a stated, accepted scope decision (Phase 4
                                                         plan-review finding), not a silent gap; the
                                                         mini-preview (real ApplyTemplate pipeline) shows the
                                                         actual stroked result. -->
                                                    <TextBlock Text="{Binding ResolvedText}"
                                                               FontSize="{Binding CanvasFontSize}"
                                                               FontFamily="{Binding FontFamily, Converter={x:Static conv:PipelineFontFamilyNameConverter.Instance}}"
                                                               Foreground="{Binding ForegroundBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               IsHitTestVisible="False" />
                                                </Panel>
                                            </Border>
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{StaticResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                        </Canvas>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:BoxElementViewModel">
                                        <!-- No ZIndex binding here either — see the text DataTemplate's own
                                             comment above; same non-effect, same fix (collection order). -->
                                        <Canvas Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}">
                                            <!-- BorderThickness bound to CanvasBorderThicknessPixels via
                                                 DoubleToThicknessConverter (round-3 code-review finding: a bare
                                                 double->Thickness value binding has no implicit conversion path
                                                 in Avalonia and fails silently, leaving BorderThickness at 0 —
                                                 see that converter's own doc comment; this was hardcoded to a
                                                 literal 1 before that, which also ignored the element's own
                                                 normalized BorderThickness). A null BorderColor yields a null
                                                 brush, which Avalonia treats as "no border" — matching
                                                 TemplateBoxElement's own BorderColor==null="no border" contract. -->
                                            <Border Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}"
                                                    Background="{Binding FillColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                    BorderBrush="{Binding BorderColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                    BorderThickness="{Binding CanvasBorderThicknessPixels, Converter={x:Static conv:DoubleToThicknessConverter.Instance}}"
                                                    Opacity="{Binding Opacity}"
                                                    PointerPressed="OnOverlayElementPointerPressed">
                                                <!-- Task #24: same inline-ContextMenu reasoning as the text
                                                     DataTemplate above — no Add Plate item (text-only) or
                                                     Set as Background item (image-only). -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Lock}" ToggleType="CheckBox" IsChecked="{Binding Locked, Mode=TwoWay}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Duplicate}" Command="{Binding DuplicateCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" Command="{Binding BringToFrontCommand}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" Command="{Binding SendToBackCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Remove}" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            </Border>
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{StaticResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                        </Canvas>
                                    </DataTemplate>
                                    <!-- Phase 2 (spec/15-template-designer.md): third polymorphic branch,
                                         image elements. CanvasBitmap is a cached WriteableBitmap on the
                                         VM itself (rebuilt only when Source changes, not per-frame) —
                                         see ImageElementViewModel's own doc comment. Stretch="Fill" here
                                         is deliberate: the Image control just fills its own
                                         CanvasWidth/HeightPixels box exactly like the box/text elements'
                                         own Border does — actual Fit-mode (Stretch/Contain/Cover)
                                         cropping/letterboxing happens in the real pipeline
                                         (TransmitImagePreparer.DrawTemplateImage), not duplicated here;
                                         this is WYSIWYG for POSITION/SIZE, not yet for Fit mode (Fit
                                         isn't user-editable until Phase 4's style panel). -->
                                    <DataTemplate DataType="vm:ImageElementViewModel">
                                        <Canvas Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}">
                                            <!-- Image has NO explicit Width/Height (code-review nit fixed
                                                 here): the text DataTemplate's own TextBlock above doesn't
                                                 set them either, relying on Border's own default
                                                 Stretch-to-content-area child layout — setting them here
                                                 to the SAME CanvasWidth/HeightPixels as the outer Border
                                                 (which is already inset by its own 1px BorderThickness)
                                                 made the image overflow the border by ~1px right/bottom. -->
                                            <!-- IsHitTestVisible bound to !BlocksHitTesting (Phase 6,
                                                 spec/15-template-designer.md): a LOCKED background
                                                 element stops intercepting canvas clicks entirely, so
                                                 the crop rect underneath it (drawn earlier in this
                                                 canvas's own child order, hence normally occluded)
                                                 becomes reachable again — see
                                                 ImageElementViewModel.BlocksHitTesting's own doc
                                                 comment for the full reasoning. -->
                                            <Border Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}"
                                                    BorderBrush="{StaticResource IndustryAccent}" BorderThickness="1"
                                                    IsHitTestVisible="{Binding !BlocksHitTesting}"
                                                    PointerPressed="OnOverlayElementPointerPressed">
                                                <!-- Task #24: same inline-ContextMenu reasoning as the text
                                                     DataTemplate above, plus Set as Background (image-only).
                                                     Known, stated limitation (plan-review finding, not fixed
                                                     by this addendum): a LOCKED background element has
                                                     IsHitTestVisible="{Binding !BlocksHitTesting}" = False on
                                                     this same Border, so right-click can never reach it while
                                                     it's in that state — the sidebar's own Lock toggle stays
                                                     the only way to unlock a background element once set. -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Lock}" ToggleType="CheckBox" IsChecked="{Binding Locked, Mode=TwoWay}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Duplicate}" Command="{Binding DuplicateCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.SetAsBackground}" Command="{Binding SetAsBackgroundCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" Command="{Binding BringToFrontCommand}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" Command="{Binding SendToBackCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Remove}" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Image Source="{Binding CanvasBitmap}"
                                                       Stretch="Fill"
                                                       IsHitTestVisible="False" />
                                            </Border>
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{StaticResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>

                        </Canvas>

                        <!-- Safe-area guide: a visual crop-boundary indicator only (dashed rectangle),
                             not fake content — kept. The mock2-derived callsign/caption "plate" text
                             overlays that used to sit here (Panes.TxImageEditor.PlateCallsign/
                             PlateCaption, literal "DL2QSK" / "EA7KDT · RSV 595 · 14.230 USB") were
                             removed: they read as callsign/report text burned into the outgoing
                             image, but no MyCallsign/CaptionLine binding ever existed — the real
                             overlay-text path is the "Add text" button + OverlayElements above, which
                             this did not affect. IsHitTestVisible="False" so the real crop/overlay
                             pointer handlers on the Canvas above are unaffected. Rectangle (not a
                             Border, which has no dash support in Avalonia) with StrokeDashArray,
                             matching mock2's own "1px dashed" guide exactly rather than settling for
                             a solid-line concession. -->
                        <!-- Margin bound (was a literal Margin="14", correct only when 14 screen px
                             == 14 image px, i.e. only at 100% zoom before Phase 7) via
                             DoubleToThicknessConverter, same reasoning as BorderThickness above — a
                             bare double-to-Thickness value binding fails silently in Avalonia. -->
                        <Rectangle IsHitTestVisible="False"
                                   Margin="{Binding SafeAreaInsetPixels, Converter={x:Static conv:DoubleToThicknessConverter.Instance}}"
                                   IsVisible="{Binding SafeAreaVisible}"
                                   Stroke="{StaticResource IndustryAccent}" Opacity="0.55"
                                   StrokeThickness="1" StrokeDashArray="4,2" />
                        </Panel>
                    </ScrollViewer>

                </DockPanel>

                <!-- Side panel: real pipeline preview (mode-exact pixels, nearest-neighbor upscaled for
                     display so low-res SSTV fidelity is visible, not smoothed away) + the overlay
                     element list with numeric X/Y fields (legacy's own real precedent for text
                     placement precision, TextIn.h's SEX/SEY fields), alongside free drag, plus mock2
                     scaffolding cards below (Insert field/Text style/Saved templates) — each a nested
                     (non-blueprint) group box, same "gb inside gb blueprint" nesting as the Receive
                     tab's Incoming-frame/Previous-frames pair. -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <!-- Margin right of 12 clears Fluent's overlay vertical scrollbar (it floats over
                     content rather than reserving a column) — confirmed via real-window testing
                     that without this, the scrollbar thumb visually overlaps and silently eats
                     clicks on the right-edge Save button (Phase 5). -->
                <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="0,0,12,0">

                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.PreviewLabel}" />
                        </HeaderedContentControl.Header>
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               MaxHeight="200"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </HeaderedContentControl>

                    <!-- Overlay-element edit rows: no mock2 equivalent (real app-added editing UI).
                         Plain bordered box, not a titled group box — IndustryBlueprintBorderTheme
                         WITHOUT Classes="blueprint" is exactly this ("plain bordered, no title
                         notch"), matching the old design's own untitled "cardInner" semantic. -->
                    <ItemsControl ItemsSource="{Binding OverlayElements}">
                        <!-- Phase 1: polymorphic per-type DataTemplates (same technique as the
                             canvas ItemsControl above), each row now also exposing Width/Height
                             (Phase 1's real resizable box, not just a point), Lock, and layer-order
                             (Up/Down) — this row list IS the "element list panel" Phase 1 called
                             for, not a separate new panel (this one already existed pre-Phase-1;
                             extending it is the reuse). Box rows expose geometry/lock/reorder only
                             for now — fill/border COLOR editing is Phase 4's "real style panel"
                             scope, not front-run here. -->
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:OverlayElementViewModel">
                                <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Margin="0,0,0,4" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                                    <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBox Classes="Industry IndustryInput" Text="{Binding Text}" IsEnabled="{Binding !Locked}" />
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding X}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Y}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Width}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Height}" Width="50" IsEnabled="{Binding !Locked}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                            <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}"
                                                          IsChecked="{Binding Locked}" Content="{loc:Translate Panes.TxImageEditor.Lock}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.MoveUp}"
                                                    Command="{Binding MoveUpCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.MoveDown}"
                                                    Command="{Binding MoveDownCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.BringToFront}"
                                                    Command="{Binding BringToFrontCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.SendToBack}"
                                                    Command="{Binding SendToBackCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.Remove}"
                                                    Command="{Binding RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                            <DataTemplate DataType="vm:BoxElementViewModel">
                                <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Margin="0,0,0,4" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                                    <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding X}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Y}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Width}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Height}" Width="50" IsEnabled="{Binding !Locked}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                            <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}"
                                                          IsChecked="{Binding Locked}" Content="{loc:Translate Panes.TxImageEditor.Lock}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.MoveUp}"
                                                    Command="{Binding MoveUpCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.MoveDown}"
                                                    Command="{Binding MoveDownCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.BringToFront}"
                                                    Command="{Binding BringToFrontCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.SendToBack}"
                                                    Command="{Binding SendToBackCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.Remove}"
                                                    Command="{Binding RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                            <!-- Phase 2: third polymorphic branch, image elements — WITHOUT this,
                                 an inserted image would still render fine on the canvas (that
                                 ItemsControl has its own separate 3rd DataTemplate above) but show
                                 as an uncontrollable fallback row here (no Lock/Up/Down/Remove) —
                                 real-window-review-caught bug class from Phase 1, avoided here by
                                 doing both ItemsControls in the same pass. -->
                            <DataTemplate DataType="vm:ImageElementViewModel">
                                <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Margin="0,0,0,4" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                                    <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding X}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Y}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Width}" Width="50" IsEnabled="{Binding !Locked}" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Height}" Width="50" IsEnabled="{Binding !Locked}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                            <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}"
                                                          IsChecked="{Binding Locked}" Content="{loc:Translate Panes.TxImageEditor.Lock}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.MoveUp}"
                                                    Command="{Binding MoveUpCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    Content="{loc:Translate Panes.TxImageEditor.MoveDown}"
                                                    Command="{Binding MoveDownCommand}"
                                                    CommandParameter="{Binding}" />
                                            <!-- Hidden once IsBackground (code-review finding: an
                                                 opaque, locked, full-frame background element has no
                                                 meaningful "front"/"back" of its own, and bringing it
                                                 to front would cover every other element in one
                                                 click — also removes the easiest UI path to a
                                                 SendToBack edge case the VM-level guard already
                                                 handles defensively, see SendToBack's own doc
                                                 comment). -->
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    IsVisible="{Binding !IsBackground}"
                                                    Content="{loc:Translate Panes.TxImageEditor.BringToFront}"
                                                    Command="{Binding BringToFrontCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                    IsVisible="{Binding !IsBackground}"
                                                    Content="{loc:Translate Panes.TxImageEditor.SendToBack}"
                                                    Command="{Binding SendToBackCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.Remove}"
                                                    Command="{Binding RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Content="{loc:Translate Panes.TxImageEditor.SetAsBackground}"
                                                Command="{Binding SetAsBackgroundCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!-- Insert-field token chips. Only the 5 backed by real data this pass (MY CALL/MY
                         GRID/MY NAME/DATE/UTC, sourced from OperatorSettings + system clock via
                         MacroTextResolver) get a Command; HIS CALL/HIS GRID/FREQ/MODE/HIS RSV/DIST/BEAM
                         need a "current QSO" form concept this port doesn't have yet
                         (spec/14-roadmap.md's TX-macro/CW-ID backlog entry). 0.9-beta pass: these 7
                         were previously left fully clickable with no Command (a fake-live gap the
                         wiring survey's "correctly-STUB" label didn't actually reflect) — now
                         disabled + NotImplemented-tooltipped like every other non-functional control.
                         Clicking a wired chip appends its token to the selected overlay element's raw
                         Text (no caret-position tracking; append is simplest and matches what
                         "insert" means for the other chips' future no-selection-yet state too). -->
                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.InsertFieldHeader}" />
                        </HeaderedContentControl.Header>
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                            <!-- Phase 3 (spec/15-template-designer.md): HIS CALL/HIS GRID/HIS RSV/FREQ/
                                 MODE now real "insert variable"/"insert macro" chips — same
                                 InsertFieldCommand/CommandParameter wiring the 5 already-working chips
                                 use, fixed conventional token names matching spec/15's own worked
                                 example ({his_call}/{rsv}) for the 3 QSO-shaped ones, {freq}/{mode} for
                                 the 2 radio-state ones (ordinary resolved macros, not part of the
                                 variable mechanism — see MacroTextResolver's own doc comment).
                                 DIST/BEAM (Chip11/12) stay disabled — explicitly out of scope, no
                                 distance/bearing calculation exists anywhere in this codebase. -->
                            <WrapPanel>
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip1}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{his_call}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip2}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{his_grid}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip3}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="%m" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip4}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{grid}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip5}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{freq}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip6}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{mode}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip7}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="%T" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip8}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="%D" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip9}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{rsv}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip10}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{name}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" IsEnabled="False" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip11}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" IsEnabled="False" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip12}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                            </WrapPanel>
                            <Border Classes="IndustryRow" IsEnabled="False" Opacity="0.45" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}"><Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.SourceLabel}" />
                                <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxImageEditor.SourceValue}" />
                            </Grid></Border>
                            <!-- Phase 3 fill bar: one row per template-variable name currently
                                 referenced by a live text element (TxImageEditorPaneViewModel's own
                                 RescanTemplateVariables keeps this in sync) — typing here updates
                                 every reference live, per spec/15-template-designer.md's own
                                 "slot-fill bar" design. Empty (no rows) when the loaded template
                                 doesn't reference any {word} beyond the fixed macro set. -->
                            <ItemsControl ItemsSource="{Binding TemplateVariableRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TemplateVariableRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,3">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding Key}" />
                                            <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*" Margin="0,2,0,0">
                                <!-- "Fill all" dropped outright (Phase 3 plan-review decision, not
                                     just left disabled) — no real default-value source exists yet
                                     (OperatorSettings is MY-side only; spec/15 frames any
                                     logbook-based prefill as future/additive). "Clear" is the one
                                     real, spec-backed action (spec/15: "one 'clear fields' action
                                     after the QSO"). -->
                                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.TxImageEditor.ClearFields}"
                                        Command="{Binding ClearTemplateVariablesCommand}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Phase 4 (spec/15-template-designer.md): real, selection-tracking-driven
                         controls replacing the 3 fake rows above (font/size, fill/stroke, plate).
                         Bound via path bindings through SelectedTextElement (a computed property on
                         THIS view's own DataContext, narrowed from SelectedOverlayElement) rather
                         than a nested DataContext override — keeps every control reachable via a
                         plain path binding, no $parent/DataContext-override complexity to fight the
                         "$parent[ItemsControl].((vm:Type)DataContext)..." binding-path crash this
                         codebase has already hit elsewhere (see ITemplateElementViewModel.RemoveCommand's
                         own doc comment) — not the same shape here (this isn't inside an
                         ItemsControl DataTemplate), but the same simpler-binding preference applies. -->
                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.TextStyleHeader}" />
                        </HeaderedContentControl.Header>
                        <StackPanel Classes="Industry IndustryRows">
                            <TextBlock Classes="IndustryRowValue" Text="{loc:Translate Panes.TxImageEditor.NoTextSelected}"
                                       IsVisible="{Binding SelectedTextElement, Converter={x:Static ObjectConverters.IsNull}}" />
                            <StackPanel Spacing="{StaticResource IndustrySpacingTight}"
                                        IsVisible="{Binding SelectedTextElement, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontFamilyLabel}" />
                                    <ComboBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding FontFamilyPickerItems}"
                                              SelectedItem="{Binding SelectedTextElement.FontFamily}" />
                                    <!-- Phase 6: warning glyph, visible only when the selected text
                                         element's own FontFamily isn't one of this build's real
                                         bundled families (see IsFontUnavailable's own doc comment) —
                                         the transmitted image silently falls back to the default font
                                         in this case, with nothing else in this panel indicating it. -->
                                    <TextBlock Grid.Column="2" Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontUnavailableGlyph}" Margin="4,0,0,0"
                                               Foreground="{StaticResource IndustryDanger}"
                                               IsVisible="{Binding IsFontUnavailable}"
                                               ToolTip.Tip="{loc:Translate Panes.TxImageEditor.FontUnavailableWarning}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontSizeLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElement.FontSizeRelative}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FillColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedTextElement.Color, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.OutlineLabel}"
                                              IsChecked="{Binding SelectedTextElement.HasStroke}" />
                                    <ColorPicker Grid.Column="2" HorizontalAlignment="Right"
                                                 IsEnabled="{Binding SelectedTextElement.HasStroke}"
                                                 Color="{Binding SelectedTextElement.StrokeColorForPicker, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasStroke}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.OutlineThicknessLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElement.StrokeThickness}" />
                                </Grid></Border>

                                <!-- Phase 8 (spec/15-template-designer.md, YONIQ-style text-effects
                                     follow-up): Shadow/Rotation/Gradient rows, same
                                     HasStroke/StrokeColor/StrokeThickness row pattern as Outline
                                     above — a checkbox-wrapped nullable color (HasShadow/
                                     ShadowColor, same reasoning as HasStroke) plus two offset
                                     TextBoxes. Canvas TextBlock cannot preview any of shadow/
                                     rotation/gradient (Avalonia's plain TextBlock has none of these
                                     capabilities) — same stated, accepted scope decision Phase 4
                                     already made for stroke; only the mini-preview (real
                                     ApplyTemplate pipeline) shows the actual result. -->
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.ShadowLabel}"
                                              IsChecked="{Binding SelectedTextElement.HasShadow}" />
                                    <ColorPicker Grid.Column="2" HorizontalAlignment="Right"
                                                 IsEnabled="{Binding SelectedTextElement.HasShadow}"
                                                 Color="{Binding SelectedTextElement.ShadowColorForPicker, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasShadow}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.ShadowOffsetXLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElement.ShadowOffsetX}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasShadow}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.ShadowOffsetYLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElement.ShadowOffsetY}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.RotationLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElement.RotationDegrees}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.GradientLabel}"
                                              IsChecked="{Binding SelectedTextElement.GradientEnabled}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientKindLabel}" />
                                    <ComboBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableGradientKinds}"
                                              SelectedItem="{Binding SelectedTextElement.GradientKind}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientStartColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedTextElement.GradientStartColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientEndColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedTextElement.GradientEndColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>

                                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AddPlate}"
                                        Command="{Binding AddPlateBehindTextCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </HeaderedContentControl>

</UserControl>
