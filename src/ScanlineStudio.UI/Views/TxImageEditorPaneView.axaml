<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:conv="using:ScanlineStudio.UI.Converters"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             x:Class="ScanlineStudio.UI.Views.TxImageEditorPaneView"
             x:DataType="vm:TxImageEditorPaneViewModel">

    <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/"cardInner"/"caption"/
         "tool"/"small"/"halt"/"value"/"label"/"chip"/"kv"/"thumb"/"plot"/"pill"/"readoutSmall"/
         "safeArea"/"plate"/"plateText" styling). One of the design's 2 real "gb blueprint" (title
         notch + corner marks together) sites, per Atoms.axaml's own item-1 correction (the other is
         the Receive tab's Incoming-frame card, MainWindow.axaml — same
         Classes="Industry blueprint"/Theme={StaticResource IndustryGroupBoxTheme}/
         Padding={StaticResource IndustryGbPaddingWideDeep} pattern, reused here for consistency).
         Header merges the old split Title+right-aligned-Caption TextBlocks into ONE string (new
         Panes.TxImageEditor.CardHeader key, replacing HeaderLabel/HeaderCaption): the title-notch
         template only has room for a single Left-aligned ContentPresenter, matching every other
         ported card's own single-title-string precedent (RxImage.CardHeader etc.) and mock2's own
         single `<span class="gbt">` for this exact card. -->
    <HeaderedContentControl Classes="Industry blueprint" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWideDeep}" ClipToBounds="False">
        <HeaderedContentControl.Header>
            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.CardHeader}" />
        </HeaderedContentControl.Header>
        <Grid RowDefinitions="Auto,*">

            <!-- Merged tool strip: decorative Move/Crop/Scale/.../Pick (real RadioButton group,
                 IndustryMiniRadioTheme — the old design already made this a genuine exclusive-
                 select group, GroupName="EditorTool", not inert chips, so the re-skin preserves
                 that) + Undo/Redo/Fit/100%/Snap-grid/Safe-area/dimensions (mini chips/toggles, no
                 real per-tool behavior yet) on the left, real wired PreserveAspect/AddText/Apply/
                 Cancel on the right — ALL in one WrapPanel (not a fixed non-wrapping
                 StackPanel/Grid), matching the old design's own stated intent ("collapsed from 2
                 rows into 1 to match mock2's single tool-strip row") while fixing a real
                 containment risk that intent introduces: mock2's row assumes a 1920px-wide design
                 canvas, this column is far narrower at runtime, so a non-wrapping row would clip;
                 WrapPanel degrades to extra lines instead (containment over an exact 1-line match,
                 this project's #1 priority). -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" IsChecked="True" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolMove}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolCrop}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolScale}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolRotate}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolText}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolBox}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolLine}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolMask}" />
                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="EditorTool" Margin="0,0,4,4"
                             Content="{loc:Translate Panes.TxImageEditor.ToolPick}" />
                <Border Width="1" Height="16" Margin="0,0,4,4" Background="{StaticResource IndustryDivider}" />
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Undo}" />
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Redo}" />
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Fit}" />
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.ZoomActual}" />
                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.SnapGrid}" />
                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" IsChecked="True" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.SafeArea}" />
                <Border Classes="Industry IndustryMini" Margin="0,0,4,4"><TextBlock Text="{loc:Translate Panes.TxImageEditor.DimensionsChip}" /></Border>

                <!-- Real, wired: aspect toggle + add-text + apply/cancel. PreserveAspect has no
                     mockup equivalent (mock2's own row ends at the dimensions chip) — reuses
                     IndustryMiniToggleTheme per its own established "checkbox-like toggle with no
                     mockup equivalent" precedent (Peak-hold/SWR-cutoff), not a new CheckBox atom. -->
                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="12,0,4,4"
                              IsChecked="{Binding PreserveAspect}"
                              Content="{loc:Translate Panes.TxImageEditor.PreserveAspect}" />
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.AddText}"
                        Command="{Binding AddOverlayElementCommand}" />
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnPrimary" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.Apply}"
                        Command="{Binding ApplyCommand}" />
                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.Cancel}"
                        Command="{Binding CancelCommand}" />
            </WrapPanel>

            <Grid Grid.Row="1" ColumnDefinitions="2*,Auto" ColumnSpacing="{StaticResource IndustrySpacingGutter}">

                <!-- Interactive canvas: crop rectangle (drag body to move, drag the corner handle to
                     resize; legacy's own real precedent has resize on the bottom-right corner only,
                     see PicRect.cpp) and draggable overlay text, both drawn over the pre-downsampled
                     working copy at native pixel size (Stretch="None") so on-screen pixels map
                     directly to normalized crop/overlay coordinates with no scale-factor math needed.
                     Crop border/handle recolored to IndustryAccent (was ScanlineStudioAccentColor)
                     for visual consistency with the new design system — purely cosmetic, no change
                     to the real pointer-handler logic below. -->
                <DockPanel Grid.Column="0" LastChildFill="True">

                    <!-- Bottom action bar: decorative duplicate of the real Transmit/Halt controls in
                         TxControlsPaneView's left column (locked decision #8, plan) - no Command this
                         pass. Halt uses IndustryBtnSecondary (not a dedicated danger/red style): no
                         Industry danger-button variant exists yet, and since this bar is decorative
                         scaffolding (no Command), inventing one here would be a drive-by atom
                         addition beyond this pass's re-skin scope — the real Stop-TX button (with its
                         own real red styling) already lives in TxControlsPaneView's left column. -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                Spacing="{StaticResource IndustrySpacingTight}"
                                Margin="0,6,0,0">
                        <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnPrimary" Content="{loc:Translate Panes.TxImageEditor.TransmitAction}" />
                        <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Content="{loc:Translate Panes.TxImageEditor.TuneAction}" />
                        <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Content="{loc:Translate Panes.TxImageEditor.PreviewAudio}" />
                        <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Content="{loc:Translate Panes.TxImageEditor.HaltAction}" />
                        <ProgressBar Classes="Industry" Value="0" Minimum="0" Maximum="100" Width="140" Height="6"
                                     VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Classes="IndustryRowValue" VerticalAlignment="Center"
                                   Text="{loc:Translate Panes.TxImageEditor.StateIdle}" />
                    </StackPanel>

                    <!-- Adjustments row: literal Value=, no binding this pass. 3-per-row x 2 rows
                         (UniformGrid Columns=3, auto-flows 6 children into 2 rows), matching mock2's
                         own grid-template-columns:repeat(3,1fr) intent; each cell is a real,
                         interactive Slider (preserving the old design's own upgrade from mock2's
                         static .trk bar — a real Slider is more usable even unbound, same
                         preserve-behavior precedent as elsewhere in this port), IndustrySliderTheme
                         h6 variant + Label/Value flanking it, same 3-cell composition as the Output
                         card's real Drive slider (TxControlsPaneView.axaml). -->
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Brightness}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Value="0" Minimum="-50" Maximum="50" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.BrightnessValue}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Contrast}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Value="0" Minimum="-50" Maximum="50" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.ContrastValue}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Saturation}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Value="0" Minimum="-50" Maximum="50" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.SaturationValue}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Gamma}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Value="0" Minimum="-100" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.GammaValue}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,10,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Sharpen}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Value="0" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.SharpenValue}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Denoise}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Value="0" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.DenoiseValue}" />
                        </Grid>
                    </UniformGrid>

                    <!-- Instructional caption: NOT in mock2 (app-added disclaimer, real information
                         not mockup scaffolding) — kept, re-skinned with IndustryRowLabel (closest
                         semantic match: small muted body text). -->
                    <TextBlock DockPanel.Dock="Top"
                               Classes="IndustryRowLabel"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Text="{loc:Translate Panes.TxImageEditor.Caption}" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Panel wrapper exists only so the safe-area/plate overlays below can use
                             ordinary Margin/HorizontalAlignment/VerticalAlignment positioning; those are
                             no-ops directly inside a Canvas. The Panel sizes to the Canvas's own bound
                             WorkingCopyWidth/Height since the Canvas is the only size-driving child. -->
                        <Panel>
                        <Canvas x:Name="EditorCanvas"
                                Width="{Binding WorkingCopyWidth}"
                                Height="{Binding WorkingCopyHeight}"
                                Focusable="True"
                                Background="Transparent"
                                KeyDown="OnCanvasKeyDown"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerReleased="OnCanvasPointerReleased">

                            <Image Source="{Binding WorkingCopyBitmap}" Stretch="None" />

                            <Border Canvas.Left="{Binding CropLeftPixels}"
                                    Canvas.Top="{Binding CropTopPixels}"
                                    Width="{Binding CropWidthPixels}"
                                    Height="{Binding CropHeightPixels}"
                                    BorderBrush="{StaticResource IndustryAccent}"
                                    BorderThickness="2"
                                    Background="#22FFFF00"
                                    PointerPressed="OnCropBodyPointerPressed" />

                            <Border Canvas.Left="{Binding CropRightPixels}"
                                    Canvas.Top="{Binding CropBottomPixels}"
                                    RenderTransform="translate(-5px, -5px)"
                                    Width="10" Height="10"
                                    Background="{StaticResource IndustryAccent}"
                                    PointerPressed="OnCropHandlePointerPressed" />

                            <ItemsControl ItemsSource="{Binding OverlayElements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OverlayElementViewModel">
                                        <TextBlock Text="{Binding ResolvedText}"
                                                   Foreground="White"
                                                   Background="#66000000"
                                                   Canvas.Left="{Binding LeftPixels}"
                                                   Canvas.Top="{Binding TopPixels}"
                                                   PointerPressed="OnOverlayElementPointerPressed">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{Binding Bounds.Width, RelativeSource={RelativeSource Self}, Converter={x:Static conv:NegativeHalfConverter.Instance}}"
                                                                     Y="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={x:Static conv:NegativeHalfConverter.Instance}}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Canvas>

                        <!-- Literal preview overlays matching mock2's burned-into-the-picture metadata
                             layout (safe-area guide, callsign plate top-left, caption plate bottom-right);
                             not real data, since no MyCallsign/CaptionLine binding exists.
                             IsHitTestVisible="False" on all three so the real crop/overlay pointer
                             handlers on the Canvas above are unaffected. Safe-area guide is a
                             Rectangle (not a Border, which has no dash support in Avalonia) with
                             StrokeDashArray, matching mock2's own "1px dashed" guide exactly rather
                             than settling for a solid-line concession. Plates are composed inline
                             (accent-bordered box over an image, IndustryBg fill) rather than reusing
                             IndustryMini: mock2's plate border is accent-colored, not the standard
                             IndustryMini divider border, so it isn't a real match for that atom. -->
                        <Rectangle IsHitTestVisible="False" Margin="14"
                                   Stroke="{StaticResource IndustryAccent}" Opacity="0.55"
                                   StrokeThickness="1" StrokeDashArray="4,2" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,3"
                                BorderBrush="{StaticResource IndustryAccent}" BorderThickness="1"
                                Background="{StaticResource IndustryBg}" Opacity="0.92"
                                IsHitTestVisible="False">
                            <TextBlock FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="14" LetterSpacing="0.84"
                                       Foreground="{StaticResource IndustryText}"
                                       Text="{loc:Translate Panes.TxImageEditor.PlateCallsign}" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="7,2"
                                BorderBrush="{StaticResource IndustryAccent}" BorderThickness="1"
                                Background="{StaticResource IndustryBg}" Opacity="0.92"
                                IsHitTestVisible="False">
                            <TextBlock FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="11"
                                       Foreground="{StaticResource IndustryText}"
                                       Text="{loc:Translate Panes.TxImageEditor.PlateCaption}" />
                        </Border>
                        </Panel>
                    </ScrollViewer>

                </DockPanel>

                <!-- Side panel: real pipeline preview (mode-exact pixels, nearest-neighbor upscaled for
                     display so low-res SSTV fidelity is visible, not smoothed away) + the overlay
                     element list with numeric X/Y fields (legacy's own real precedent for text
                     placement precision, TextIn.h's SEX/SEY fields), alongside free drag, plus mock2
                     scaffolding cards below (Insert field/Text style/Saved templates) — each a nested
                     (non-blueprint) group box, same "gb inside gb blueprint" nesting as the Receive
                     tab's Incoming-frame/Previous-frames pair. -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" MinWidth="200">

                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.PreviewLabel}" />
                        </HeaderedContentControl.Header>
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               MaxHeight="200"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </HeaderedContentControl>

                    <!-- Overlay-element edit rows: no mock2 equivalent (real app-added editing UI).
                         Plain bordered box, not a titled group box — IndustryBlueprintBorderTheme
                         WITHOUT Classes="blueprint" is exactly this ("plain bordered, no title
                         notch"), matching the old design's own untitled "cardInner" semantic. -->
                    <ItemsControl ItemsSource="{Binding OverlayElements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OverlayElementViewModel">
                                <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Margin="0,0,0,4" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                                    <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBox Classes="Industry IndustryInput" Text="{Binding Text}" />
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding X}" Width="55" />
                                            <TextBox Classes="Industry IndustryInput" Text="{Binding Y}" Width="55" />
                                            <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary"
                                                    Content="{loc:Translate Panes.TxImageEditor.Remove}"
                                                    Command="{Binding RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Insert-field token chips. Only the 5 backed by real data this pass (MY CALL/MY
                         GRID/MY NAME/DATE/UTC, sourced from OperatorSettings + system clock via
                         MacroTextResolver) get a Command; HIS CALL/HIS GRID/FREQ/MODE/HIS RSV/DIST/BEAM
                         need a "current QSO" form concept this port doesn't have yet
                         (spec/14-roadmap.md's TX-macro/CW-ID backlog entry), so they're left as
                         literal, non-functional scaffolding, unchanged from before. Clicking a wired
                         chip appends its token to the selected overlay element's raw Text (no
                         caret-position tracking; append is simplest and matches what "insert" means
                         for the other chips' future no-selection-yet state too). -->
                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.InsertFieldHeader}" />
                        </HeaderedContentControl.Header>
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                            <WrapPanel>
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip1}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip2}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip3}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="%m" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip4}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{grid}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip5}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip6}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip7}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="%T" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip8}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="%D" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip9}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip10}"
                                        Command="{Binding InsertFieldCommand}" CommandParameter="{}{name}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip11}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip12}" />
                            </WrapPanel>
                            <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.SourceLabel}" />
                                <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxImageEditor.SourceValue}" />
                            </Grid></Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4" Margin="0,2,0,0">
                                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.TxImageEditor.FillAll}" />
                                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.TxImageEditor.ClearFields}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Mock2 scaffolding: text style (literal, applies to the selected overlay
                         element; no selection-tracking exists yet so nothing to bind to). -->
                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.TextStyleHeader}" />
                        </HeaderedContentControl.Header>
                        <StackPanel Classes="Industry IndustryRows">
                            <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontSizeLabel}" />
                                <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxImageEditor.FontSizeValue}" />
                            </Grid></Border>
                            <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FillStrokeLabel}" />
                                <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxImageEditor.FillStrokeValue}" />
                            </Grid></Border>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Mock2 scaffolding: saved templates list. Literal UniformGrid of example
                         cards (no store exists yet), Columns=2 matching mock2's own
                         grid-template-columns:1fr 1fr (Receive tab's Recently-sent thumbnail card
                         reused the same IndustryThumbnail/IndustryHatchPanel composition at
                         Columns=3 — same atoms, different column count per mock2's own layout). -->
                    <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.TemplatesHeader}" />
                        </HeaderedContentControl.Header>
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                            <UniformGrid Columns="2">
                                <Border Classes="IndustryThumbnail" Margin="0,0,5,5">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Bottom" Classes="IndustryThumbnailCaption">
                                            <StackPanel>
                                                <TextBlock Classes="IndustryThumbnailCall" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxImageEditor.Template1Name}" />
                                                <TextBlock Classes="IndustryThumbnailMeta" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxImageEditor.Template1Fields}" />
                                            </StackPanel>
                                        </Border>
                                        <Panel>
                                            <Border Classes="IndustryHatchPanel" MinHeight="55" />
                                            <Border Classes="Industry IndustryMini" Background="{StaticResource IndustryBg}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" IsHitTestVisible="False">
                                                <TextBlock Text="{loc:Translate Panes.TxImageEditor.Template1Mode}" />
                                            </Border>
                                        </Panel>
                                    </DockPanel>
                                </Border>
                                <Border Classes="IndustryThumbnail" Margin="0,0,0,5">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Bottom" Classes="IndustryThumbnailCaption">
                                            <StackPanel>
                                                <TextBlock Classes="IndustryThumbnailCall" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxImageEditor.Template2Name}" />
                                                <TextBlock Classes="IndustryThumbnailMeta" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxImageEditor.Template2Fields}" />
                                            </StackPanel>
                                        </Border>
                                        <Panel>
                                            <Border Classes="IndustryHatchPanel" MinHeight="55" />
                                            <Border Classes="Industry IndustryMini" Background="{StaticResource IndustryBg}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" IsHitTestVisible="False">
                                                <TextBlock Text="{loc:Translate Panes.TxImageEditor.Template2Mode}" />
                                            </Border>
                                        </Panel>
                                    </DockPanel>
                                </Border>
                                <Border Classes="IndustryThumbnail" Margin="0,0,5,0">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Bottom" Classes="IndustryThumbnailCaption">
                                            <StackPanel>
                                                <TextBlock Classes="IndustryThumbnailCall" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxImageEditor.Template3Name}" />
                                                <TextBlock Classes="IndustryThumbnailMeta" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxImageEditor.Template3Fields}" />
                                            </StackPanel>
                                        </Border>
                                        <Panel>
                                            <Border Classes="IndustryHatchPanel" MinHeight="55" />
                                            <Border Classes="Industry IndustryMini" Background="{StaticResource IndustryBg}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" IsHitTestVisible="False">
                                                <TextBlock Text="{loc:Translate Panes.TxImageEditor.Template3Mode}" />
                                            </Border>
                                        </Panel>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnPrimary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.TxImageEditor.FillAndSend}" />
                                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.TxImageEditor.SaveTemplate}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </HeaderedContentControl>

</UserControl>
