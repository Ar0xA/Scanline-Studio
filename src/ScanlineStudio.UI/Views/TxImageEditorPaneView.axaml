<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:conv="using:ScanlineStudio.UI.Converters"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             xmlns:controls="using:ScanlineStudio.UI.Controls"
             x:Class="ScanlineStudio.UI.Views.TxImageEditorPaneView"
             x:DataType="vm:TxImageEditorPaneViewModel"
             KeyDown="OnRootKeyDown">

    <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/"cardInner"/"caption"/
         "tool"/"small"/"halt"/"value"/"label"/"chip"/"kv"/"thumb"/"plot"/"pill"/"readoutSmall"/
         "safeArea"/"plate"/"plateText" styling). One of the design's 2 real "gb blueprint" (title
         notch + corner marks together) sites, per Atoms.axaml's own item-1 correction (the other is
         the Receive tab's Incoming-frame card, MainWindow.axaml — same
         Classes="Industry blueprint"/Theme={StaticResource IndustryGroupBoxTheme}/
         Padding={StaticResource IndustryGbPaddingWideDeep} pattern, reused here for consistency).
         Header merges the old split Title+right-aligned-Caption TextBlocks into ONE string (now
         bound to HeaderText, a computed VM property formatted from the real target mode's own
         dimensions/name — spec/18-path-to-1.0.md Medium item; originally a static
         Panes.TxImageEditor.CardHeader locale key hardcoding "640×496 · PD120" regardless of the
         actual mode being edited): the title-notch
         template only has room for a single Left-aligned ContentPresenter, matching every other
         ported card's own single-title-string precedent (RxImage.CardHeader etc.) and mock2's own
         single `<span class="gbt">` for this exact card. -->
    <!-- Margin top=6 (design-fidelity-agent re-check): the Transmit tab's outer Grid margin
         alone (fix above, 258,*,330 -> 236,*,312 / 9,11,9,8) wasn't quite enough clearance for
         THIS card specifically — unlike the Receive tab's Incoming-frame blueprint card (which
         sits below a sibling row and gets extra clearance from RowSpacing), this is the ONLY
         element in the centre column, so it only ever had the outer Grid's raw top margin. Same
         "headroom on the card itself, not just the ancestor" fix as TxControlsPaneView's own
         root Margin. -->
    <!-- Design-fidelity Phase B (mockups/Editwindow): the outer blueprint frame's own title notch
         (HeaderText: "640×496 · PD120"-style) is BLANKED here, not kept alongside the new context-bar
         row below — the mock's own outer corner-marked frame (mock lines 20-21) has no notch-title at
         that level either; "TX Image Editor" + the frame readout live as an ordinary content row
         instead (Grid.Row="0" below), matching the mock's own structure rather than showing the same
         dims/mode information twice in two different chrome idioms. -->
    <HeaderedContentControl Classes="Industry blueprint" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWideDeep}" ClipToBounds="False" Margin="0,6,0,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Context bar (design-fidelity Phase B, mockups/Editwindow lines 24-37): title + mono
                 frame readout + unsaved-edits chip, then right-grouped Undo/Redo/Revert. Undo/Redo
                 stay ALSO usable from the stage toolbar below (Row 1) — this is an added, more
                 discoverable location, not a relocation; removing them from the toolbar would be a
                 real functional regression for muscle memory built on the toolbar-Ctrl+Z pattern. -->
            <!-- design-fidelity Phase I (minor #2): hairline under the context bar (mock line 24's
                 own border-bottom) — was a bare bottom Margin with no rule at all, sampled as
                 uniform background across the full span in a real-window pixel check. Border wraps
                 the row instead of adding a sibling, so the rule spans the same Padding-inset width
                 the row's own content already does. -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource IndustryChromeBorder}" Padding="0,0,0,6" Margin="0,0,0,6">
            <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
            <!-- Backlog item (auditor usability review, 2026-08-17, item 11): "No error surface
                 anywhere in the editor." A dismissible-by-nature banner (it clears itself on the next
                 successful action, see StatusMessage's own doc comment) rather than a toast/dialog —
                 no such infrastructure exists anywhere in this codebase. Doubles as the Cancel/Recall
                 arm-confirm surface (items 2/17), placed at the TOP of the editor so it's visible
                 regardless of which inspector tab is open. -->
            <Border Classes="Industry IndustryMini" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource IndustryDangerTint}" BorderBrush="{DynamicResource IndustryDangerTintBorder}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource IndustryDangerTintText}" TextWrapping="Wrap" />
            </Border>
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
                <TextBlock Classes="IndustryGbTitle" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.ContextBarTitle}" />
                <Border Grid.Column="1" Width="1" Height="16" Margin="10,0" Background="{DynamicResource IndustryChromeBorder}" />
                <!-- design-fidelity Phase H (final confirming pass finding #5): IndustryRowValue is
                     a right-aligned, grey-data-field-background atom by design (Atoms.axaml:789-800)
                     — correct for real value cells, wrong for chrome/prose text like this readout,
                     which rendered inside an unintended grey lozenge. IndustryKicker (already used
                     for chrome text elsewhere on this screen, e.g. the CROP toolbar label) is the
                     correct atom here. Fixed at this call site only, not the shared atom itself,
                     which is correct for its real value-cell consumers elsewhere in the app. -->
                <TextBlock Grid.Column="2" Classes="IndustryKicker" VerticalAlignment="Center" Text="{Binding FrameReadoutText}" />
                <!-- design-fidelity Phase I (minor #4): tint + leading square marker (mock line 28),
                     matching the mock's own #d6ebff/#5980a6 tint pair — reused IndustrySelectTint/
                     IndustrySelectTintBorder directly (same tokens the segmented-control :checked
                     state already uses for "this is currently true," which is exactly the semantic
                     an unsaved-edits flag needs) rather than Border.IndustryMini.active's own
                     green/healthy tint, which means something else entirely (receiving status). -->
                <Border Grid.Column="3" Classes="Industry IndustryMini" Margin="10,0,0,0" IsVisible="{Binding HasUnsavedEdits}"
                        Background="{DynamicResource IndustrySelectTint}" BorderBrush="{DynamicResource IndustrySelectTintBorder}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="6" Height="6" Background="{DynamicResource IndustryAccent}" />
                        <TextBlock Text="{loc:Translate Panes.TxImageEditor.UnsavedEditsChip}" Foreground="{DynamicResource IndustrySelectTintText}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                    <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Command="{Binding UndoCommand}" Content="{loc:Translate Panes.TxImageEditor.Undo}" />
                    <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Command="{Binding RedoCommand}" Content="{loc:Translate Panes.TxImageEditor.Redo}" />
                    <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource IndustryChromeBorder}" />
                    <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Command="{Binding RevertCommand}" Content="{loc:Translate Panes.TxImageEditor.Revert}" />
                </StackPanel>
            </Grid>
            </StackPanel>
            </Border>

            <!-- All in one WrapPanel (not a fixed non-wrapping StackPanel/Grid), matching the old
                 design's own stated intent ("collapsed from 2 rows into 1 to match mock2's single
                 tool-strip row") while fixing a real containment risk that intent introduces: mock2's
                 row assumes a 1920px-wide design canvas, this column is far narrower at runtime, so a
                 non-wrapping row would clip; WrapPanel degrades to extra lines instead (containment
                 over an exact 1-line match, this project's #1 priority). -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                <!-- Phase 1 (spec/15-template-designer.md): the old EditorTool RadioButton group
                     (Move/Crop/Scale/Text/Box/Line/Mask/Pick) removed outright — 7 of its 8
                     members were already dead stubs implying tool-switching that doesn't exist, and
                     the 8th (Move) had no distinct behavior of its own to keep (drag always works
                     regardless of any "tool" selection) — a lone surviving radio with no group
                     siblings would look broken, not minimal. -->
                <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Command="{Binding UndoCommand}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Undo}" />
                <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Command="{Binding RedoCommand}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.Redo}" />
                <!-- Phase 7 (spec/15-template-designer.md): Fit needs the ScrollViewer's own runtime
                     viewport size (View knowledge), which a plain Command binding can't supply, so
                     Click reads EditorScrollViewer.Bounds in code-behind and calls vm.ApplyFit(w,h)
                     directly — a small necessary deviation from a zero-arg RelayCommand. 100% needs
                     no viewport data, so it stays a plain Command binding. -->
                <!-- design-fidelity Phase G (#16), re-grouped 2026-08-17 (user request): FIT is now
                     joined to the NEW Fit-modes dropdown (not to 100%, which moved out to stand on
                     its own with normal spacing) — "doesn't make sense to be in between zoom button
                     and slider". FIT keeps its normal border and loses its own right margin (glues
                     flush to the dropdown); the dropdown drops its left border via a per-instance
                     BorderThickness override so the two don't double up a 2px seam, same mechanism
                     Phase G originally used for FIT/100%. -->
                <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Click="OnFitButtonClick" Margin="0,0,0,4" Content="{loc:Translate Panes.TxImageEditor.Fit}" />
                <!-- Backlog item (user request, 2026-08-17): 3 more Fit variants (Fit Safe Area/Fit
                     Width/Fit Height) alongside the existing whole-frame Fit above. Button.Flyout is
                     Avalonia's own built-in mechanism for exactly this "click a button, reveal more
                     choices" shape; MenuItem.Click (not Command) since these need EditorScrollViewer's
                     own runtime viewport size the same way OnFitButtonClick's own Click handler does,
                     matching TxImageEditorPaneView.axaml.cs. -->
                <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" BorderThickness="0,1,1,1" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.FitModesGlyph}"
                        ToolTip.Tip="{loc:Translate Panes.TxImageEditor.FitModesTooltip}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitSafeArea}" Click="OnFitSafeAreaClick" />
                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitWidth}" Click="OnFitWidthClick" />
                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitHeight}" Click="OnFitHeightClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Command="{Binding ZoomActualCommand}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.ZoomActual}" />
                <!-- Task #23 (zoom slider addendum, plan-reviewed). Minimum/Maximum bound via
                     x:Static to the VM's own public MinZoomFactor/MaxZoomFactor consts — NOT
                     hardcoded XAML literals — since ZoomFactor's own property setter has no clamp;
                     a drifted slider Maximum would write an out-of-range value straight through with
                     nothing else to catch it (unlike the adjustment sliders below, whose bounds exist
                     nowhere else in the codebase). Explicit Width (a bare Slider has no intrinsic
                     width and would collapse to ~thumb size unconstrained inside this WrapPanel).
                     Unanchored (plan-review finding): unlike the scroll-wheel path, dragging this
                     slider does NOT adjust EditorScrollViewer.Offset to keep any particular canvas
                     point fixed — the user's eyes are on the slider while dragging it, not the
                     canvas, so center-anchoring only adds cross-path re-entrancy risk (both this
                     binding and the wheel handler write the same ZoomFactor) for little real benefit. -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}" Margin="0,0,4,4" VerticalAlignment="Center">
                    <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Zoom}" />
                    <Slider Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}"
                            Width="120"
                            Minimum="{x:Static vm:TxImageEditorPaneViewModel.MinZoomFactor}"
                            Maximum="{x:Static vm:TxImageEditorPaneViewModel.MaxZoomFactor}"
                            Value="{Binding ZoomFactor}"
                            VerticalAlignment="Center" />
                    <TextBlock Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding ZoomPercentText}" />
                </StackPanel>
                <ToggleButton Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" IsChecked="{Binding SnapToGrid}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.SnapGrid}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.SnapGrid.Help}" />
                <!-- App-wide stub survey Tier 1 item, re-verified 2026-08-26 while working the tier
                     list: the survey's "SafeAreaVisible doesn't exist" claim was already stale by
                     the time it was written down — Phase 6 (spec/15-template-designer.md) had
                     already added a real bool ObservableProperty backing field on
                     TxImageEditorPaneViewModel (default true), same one this toggle and the guide's
                     own IsVisible below (line ~554) both correctly bind to. No code change needed;
                     confirmed via a duplicate-declaration build error when the fix was attempted. -->
                <ToggleButton Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" IsChecked="{Binding SafeAreaVisible}" Margin="0,0,4,4" Content="{loc:Translate Panes.TxImageEditor.SafeArea}" />
                <!-- design-fidelity Phase G (#16): CROP mono label, matching the mock's own toolbar
                     grouping (a divider + "CROP" kicker ahead of the dimensions chip/aspect toggles).
                     No literal right-aligned flex spacer here — this row is a WrapPanel (Phase 1's
                     own deliberate choice, so a too-narrow column degrades to wrapping instead of
                     clipping), which has no flex/push-to-edge concept the way the mock's own flex:1
                     div does; a divider is the achievable part of "group these visually," not a
                     structural gap in this fix. -->
                <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource IndustryChromeBorder}" />
                <TextBlock Classes="IndustryKicker" VerticalAlignment="Center" Margin="0,0,4,4" Text="{loc:Translate Panes.TxImageEditor.CropLabel}" />
                <!-- design-fidelity Phase I (minor #1): Height="26" local override — every other
                     toolbar item in this row is IndustryBtn26 (26px); this chip was the 17px
                     Border.IndustryMini default, one of 3 different heights measured in this single
                     row (real-window finding). Local Height wins over the class's own Height=17
                     Setter (same precedence this codebase already relies on for Padding overrides
                     elsewhere), so IndustryMini's border/padding/font stay, only the height changes. -->
                <Border Classes="Industry IndustryMini" Height="{DynamicResource IndustryBtn26Height}" Margin="0,0,4,4"><TextBlock VerticalAlignment="Center" Text="{Binding DimensionsChipText}" /></Border>

                <!-- Real, wired: aspect toggle + add-text + apply/cancel. PreserveAspect has no
                     mockup equivalent (mock2's own row ends at the dimensions chip) — reuses
                     IndustryMiniToggleTheme per its own established "checkbox-like toggle with no
                     mockup equivalent" precedent (Peak-hold/SWR-cutoff), not a new CheckBox atom. -->
                <ToggleButton Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Margin="12,0,4,4"
                              IsChecked="{Binding PreserveAspect}"
                              Content="{loc:Translate Panes.TxImageEditor.PreserveAspect}" />
                <!-- Real, wired (spec/18-path-to-1.0.md High item 4): constrains crop-rect drag-resize
                     SHAPE to the target mode's own aspect ratio — orthogonal to PreserveAspect above,
                     which governs the separate letterbox-vs-stretch Resize step, not crop shape.
                     Combining this ON with PreserveAspect OFF (stretch) fills the mode's frame
                     edge-to-edge with zero distortion and zero letterboxing — the tooltip states
                     that combination explicitly since the two toggles' relationship isn't obvious
                     from the labels alone. -->
                <ToggleButton Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Margin="0,0,4,4"
                              IsChecked="{Binding LockAspectToMode}"
                              Content="{loc:Translate Panes.TxImageEditor.LockAspectToMode}"
                              ToolTip.Tip="{loc:Translate Panes.TxImageEditor.LockAspectToMode.Help}" />
                <!-- Real, wired (spec/18-path-to-1.0.md High item 3): a real action button, not a
                     RadioButton in the EditorTool group above — rotate is an instant 90°-clockwise
                     action (4 clicks returns to the original orientation), not a persistent
                     tool/mode the way Move conceptually is. Reuses the same
                     Panes.TxImageEditor.ToolRotate localization key the removed disabled
                     RadioButton used to occupy — that was its only other reference. -->
                <!-- EditWindow redesign Phase 2 (mockups/Editwindow): Add Text/Box/Image and
                     Duplicate moved OUT of this toolbar and into the ELEMENTS panel's own header
                     action group / insert row (mock's own IA rule, README gap #10: "view state and
                     object state are separated" — this toolbar is STAGE/view-state only now: zoom,
                     snap, safe-area, crop, and the whole-photo Rotate below, which is a crop/source
                     adjustment, not a per-element operation, so it stays here). Apply/Cancel ALSO
                     moved out, into the new SEND panel at the bottom of the card (Phase 4) — same
                     "object/frame action, not view state" reasoning. -->
                <!-- design-fidelity Phase I (minor #1): IndustryBtn22 -> IndustryBtn26, matching
                     every other item in this row (mock's own toolbar is a uniform height:26px). -->
                <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4"
                        Content="{loc:Translate Panes.TxImageEditor.ToolRotate}"
                        Command="{Binding RotateCommand}" />
            </WrapPanel>

            <!-- EditWindow redesign Phase 1 (mockups/Editwindow, user-provided design handoff,
                 2026-08-17): "four homes, one per workflow stage" — RECALL (rack/library rail) |
                 COMPOSE (stage: toolbar + canvas) | INSPECT (preview/elements/style), left to right.
                 Fixed 212/fluid/364 columns, matching the mock's own body proportions (rack 212px
                 fixed, stage fluid, inspector 364px fixed) — widened from the pre-redesign 186px
                 side column since the TEXT STYLE panel's real content (Phase 4/8) needs the room;
                 "spirit of the design over pixel-perfect" per the user's own explicit instruction,
                 so exact px values are a starting point, not a contract. Fill/QSO-fill/Send bottom
                 bar restructuring and inspector TAB splitting are later sub-phases of the same
                 redesign, not yet done here — this phase is the 3-column skeleton only. -->
            <Grid Grid.Row="2" ColumnDefinitions="212,*,364" ColumnSpacing="{StaticResource IndustrySpacingGutter}">

                <!-- RECALL rail (EditWindow redesign Phase 1, reshaped by design-fidelity Phase D,
                     mockups/Editwindow lines 42-73): two independent bordered panels, not one —
                     fixed READY RACK (9 numbered rows) on top, flex TEMPLATE LIBRARY (filter +
                     scrolling name list + save footer) filling the rest of the column.

                     yoniq-auditor-caught regression fix (2026-09-16): this rail used to be a plain
                     Grid RowDefinitions="Auto,*" with no outer ScrollViewer, matching the mock's own
                     two-block layout — but that gave LIBRARY's "*" row whatever was left of the
                     editor's fixed 834px total after RACK's own 9 fixed rows, which in practice was
                     ~0 visible height (RACK alone claims most of it) with no way to grow it without
                     ALSO growing 834 — and 834 is exactly this window's "no-scroll" viewport height
                     (MainWindow.axaml's own comment on the ContentControl above), so growing it
                     pushed the editor's own SEND bar below the fold instead. Fixed the other way:
                     the rail now gets its OWN ScrollViewer, decoupled from the shared 834 budget —
                     RACK and LIBRARY both keep a real, non-star (Auto+MinHeight/MaxHeight) desired
                     size (a "*" row would still collapse to 0 under this ScrollViewer's own infinite
                     offered height, same underlying mechanism as the original bug), and if the two
                     combined don't fit whatever height this column actually gets, THIS column alone
                     scrolls — same "internal scroll" intent as the original comment, just moved one
                     level up so 834/SEND's position are never touched by how many templates exist. -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource IndustrySpacingGroup}" Margin="0,6,4,0">

                    <!-- TEMPLATES (renamed from READY RACK, user request 2026-09-14): vertical list of
                         9 rows (design-fidelity Phase D reshape of the old 3x3 button grid, mock
                         lines 47-56), 1 = top, matching the same reading order as the number-key
                         accelerators (D1..D9, see TxImageEditorPaneView.axaml.cs's OnRootKeyDown). An
                         empty slot renders a dashed placeholder + a "pin from library" hint (mock's
                         own decorative label for the same underlying action — pinning a template from
                         the LIBRARY list below fills the first empty slot, see
                         ReadyRackViewModel.TogglePinAsync).

                         Templates rack rework: `ListBox` (was `ItemsControl`) for native
                         `SelectedItem` single-click selection — same pattern as the RX History
                         gallery (`MainWindow.axaml`'s own `FilteredEntries` ListBox). Each slot's own
                         `Button` became a plain `Border` (a `ListBoxItem`'s own selection handles what
                         the Button used to), with `DoubleTapped` for load (same
                         "code-behind pointer handler inside a DataTemplate" convention as
                         `MainWindow.axaml.cs`'s own gallery double-tap) and a `ContextMenu` for
                         right-click — items stay present but disabled on an empty slot (no Template)
                         rather than an absent menu, simpler XAML for the same "does nothing" result. -->
                    <HeaderedContentControl Grid.Row="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.TemplatesHeader}" />
                        </HeaderedContentControl.Header>
                        <!-- KEYS 1-9 hint moved from the header tab into the content's own top row
                             (real-window finding): the group-box title tab (IndustryGroupBoxTheme)
                             auto-sizes to its Header content instead of stretching to the card's own
                             width (it's a floating top-left tab, not a full-width bar like the mock's
                             own header row) — a Grid.ColumnDefinitions="*,Auto" inside it measures
                             under effectively infinite available width, so the star column collapses
                             to its content's own size instead of pushing the Auto column to the right
                             edge, and the two TextBlocks render jammed together with no gap. Every
                             other panel in this codebase already lives with a title-only tab for the
                             same reason — this is the first one that also needed a trailing badge. -->
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                            <!-- Backlog item (auditor usability review, 2026-08-17, item 11): rack-level
                                 error surface (a failed Refresh/Delete) — see
                                 ReadyRackViewModel.StatusMessage's own doc comment. -->
                            <TextBlock Classes="IndustryRowLabel" Foreground="{DynamicResource IndustryDanger}" TextWrapping="Wrap"
                                       Text="{Binding ReadyRack.StatusMessage}"
                                       IsVisible="{Binding ReadyRack.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="IndustryKicker" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxImageEditor.ReadyRackKeysHint}" />
                            <!-- IsEnabled-only busy state (no Opacity dim) — matches this file's own
                                 existing IsExporting/"IsEnabled binding, no visual dim" idiom, not a
                                 new spinner/dim control this codebase has no other precedent for. -->
                            <ListBox ItemsSource="{Binding ReadyRack.Slots}" SelectedItem="{Binding ReadyRack.SelectedSlot}"
                                     ItemContainerTheme="{StaticResource IndustryListBoxItemTheme}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     IsEnabled="{Binding !ReadyRack.IsLoadInFlight}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReadyRackSlotViewModel">
                                    <!-- design-fidelity Phase I (minor #5, nit: padding order): Margin
                                         dropped to 0 (rows touch instead of sitting in individually
                                         detached boxes) and BorderThickness reduced to bottom-only, a
                                         local override that wins over the theme's own implicit border
                                         via TemplateBinding (same local-value-wins precedence this
                                         codebase already relies on for Padding overrides elsewhere) —
                                         closer to the mock's own flush, hairline-separated list (mock
                                         lines 48-56) than the previous individually-boxed rows. Padding
                                         "4,3"->"6,4": Avalonia's 2-value Thickness is
                                         (horizontal,vertical), the mock's own CSS pair (padding:4px 6px)
                                         is (vertical,horizontal) — the value had been carried across in
                                         the wrong order. -->
                                    <Border Padding="6,4" Margin="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource IndustryChromeBorder}"
                                            DoubleTapped="OnReadyRackSlotDoubleTapped"
                                            ToolTip.Tip="{Binding Template.Name}">
                                        <Border.ContextMenu>
                                            <ContextMenu Classes="Industry">
                                                <MenuItem Header="{loc:Translate Panes.TxImageEditor.LoadTemplate}" IsEnabled="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                          Command="{Binding Template.LoadCommand}" CommandParameter="{Binding Template}" />
                                                <MenuItem Header="{loc:Translate Panes.TxImageEditor.UnpinTemplate}" IsEnabled="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                          Command="{Binding Template.TogglePinCommand}" CommandParameter="{Binding Template}" />
                                                <MenuItem Header="{loc:Translate Panes.TxImageEditor.ExportTemplate}" IsEnabled="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                          Command="{Binding Template.ExportCommand}" CommandParameter="{Binding Template}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Translate Panes.TxImageEditor.DeleteTemplate}" IsEnabled="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                          Command="{Binding Template.DeleteFromRackCommand}" CommandParameter="{Binding Template}" />
                                                <MenuItem Header="{loc:Translate Panes.TxImageEditor.RenameTemplate}" IsEnabled="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                          Click="OnRenameTemplateMenuClick" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="16,50,*" ColumnSpacing="7">
                                            <TextBlock Classes="IndustryKicker" Text="{Binding SlotNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Panel Grid.Column="1" Width="50" Height="36">
                                                <!-- design-fidelity Phase I (nit): dashed box + "+" glyph
                                                     (mock lines 54-56), replacing the solid-bordered
                                                     IndustryHatchPanel — Border has no dash support in
                                                     Avalonia (same reason the safe-area guide elsewhere
                                                     on this screen uses a Rectangle), so a Rectangle +
                                                     centered TextBlock overlay replaces it AT THIS CALL
                                                     SITE only; IndustryHatchPanel itself stays untouched
                                                     for its other consumers (e.g. the Receive tab's own
                                                     empty session-frames slots). -->
                                                <Grid IsVisible="{Binding Template, Converter={x:Static ObjectConverters.IsNull}}">
                                                    <Rectangle Stroke="{DynamicResource IndustryTextMuted55}" StrokeThickness="1" StrokeDashArray="3,2" />
                                                    <TextBlock Text="{loc:Translate Panes.TxImageEditor.EmptySlotGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource IndustryTextMuted55}" />
                                                </Grid>
                                                <Image Source="{Binding Template.Thumbnail}" Stretch="Uniform" IsVisible="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </Panel>
                                            <!-- design-fidelity Phase H (final confirming pass finding #5):
                                                 IndustryRowValue -> IndustryRowLabel — a rack slot's own
                                                 template name is an item identity/label, not a value cell,
                                                 and IndustryRowValue's own right-align + grey background
                                                 (correct for real value cells) rendered as an unintended
                                                 grey lozenge behind the name here. IndustryRowLabel is
                                                 legible left-aligned body text with no background, matching
                                                 what a list-row name actually needs. -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Classes="IndustryRowLabel" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Template.Name}" IsVisible="{Binding Template, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Classes="IndustryKicker" Text="{loc:Translate Panes.TxImageEditor.PinFromLibraryHint}" IsVisible="{Binding Template, Converter={x:Static ObjectConverters.IsNull}}" />
                                                <!-- Templates rack rework: the "which slot is the canvas
                                                     currently loaded from" indicator called out as
                                                     missing when this rack was still a plain ItemsControl
                                                     (see this file's own git history) — pushed by
                                                     ReadyRackViewModel.SetLoadedTemplate/SetCanvasDirty,
                                                     not a live binding (see those methods' own doc
                                                     comments). -->
                                                <TextBlock Classes="IndustryKicker" Foreground="{DynamicResource IndustryAccent}"
                                                           Text="{loc:Translate Panes.TxImageEditor.LoadedBadge}" IsVisible="{Binding IsLoadedOnly}" />
                                                <TextBlock Classes="IndustryKicker" Foreground="{DynamicResource IndustryAccent}"
                                                           Text="{loc:Translate Panes.TxImageEditor.LoadedEditedBadge}" IsVisible="{Binding IsLoadedAndEdited}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- Templates rack rework: the single-click action strip — Load/Unpin/
                                 Export/Delete plus inline rename, shown only while a filled slot is
                                 selected (an empty slot's Template is null, same guard the context menu
                                 above uses). OnTemplateRenameKeyDown commits on Enter, reverts on Esc.
                                 IsEnabled gated on IsLoadInFlight too (yoniq-auditor finding: only the
                                 ListBox itself was gated before, so these stayed clickable mid-load). -->
                            <!-- User-reported gap (2026-09-15), two separate bugs in one row:
                                 (1) TextBox + 4 buttons (LOAD/UNPIN/EXPORT/DELETE) on one
                                 Auto/*/Auto/Auto/Auto row never fit the rail's fixed 212px column —
                                 same class of overflow as the TEMPLATE LIBRARY header row fixed
                                 earlier this session. Rename box gets its own row; the 4 buttons go
                                 in a WrapPanel (not another fixed-column Grid) so they degrade to two
                                 rows instead of clipping if the column is ever narrower than their
                                 combined width, rather than assuming a specific pixel budget will
                                 always fit.
                                 (2) This whole row rendered VISIBLE on every app launch with nothing
                                 selected (verified permanent, not a startup flash — a fresh window sat
                                 for 12+ real seconds with zero interaction and never self-corrected;
                                 yoniq-auditor caught an earlier, wrong "async DataContext timing"
                                 framing of this same fix). Real cause: ReadyRack.SelectedSlot.Template
                                 is a TWO-STEP path, and the FIRST step (SelectedSlot) is null the
                                 entire time nothing's selected — a null intermediate makes Avalonia's
                                 binding engine yield UnsetValue for the whole path (the converter
                                 never even runs), and IsVisible falls back to ITS OWN property default,
                                 which is true, not false. (The Library strip below has no such gap —
                                 SelectedLibraryItem is a single-level path, so null there is a real
                                 value the converter sees and correctly turns into false; confirmed by
                                 testing that its own FallbackValue is a no-op.) FallbackValue=False is
                                 Avalonia's own mechanism for "this path can't be evaluated," same fix
                                 shape as this codebase's own ComboBox placeholder/FallbackValue gotcha
                                 elsewhere. -->
                            <StackPanel x:Name="RackActionStrip" Spacing="{StaticResource IndustrySpacingTight}"
                                        IsVisible="{Binding ReadyRack.SelectedSlot.Template, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                                        IsEnabled="{Binding !ReadyRack.IsLoadInFlight}">
                                <TextBox x:Name="TemplateRenameTextBox" Classes="Industry IndustryInput" Text="{Binding ReadyRack.SelectedSlot.Template.EditingName}"
                                         Watermark="{loc:Translate Panes.TxImageEditor.RenameTemplatePlaceholder}"
                                         KeyDown="OnTemplateRenameKeyDown" />
                                <WrapPanel>
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                            Content="{loc:Translate Panes.TxImageEditor.LoadTemplate}" Command="{Binding ReadyRack.LoadCommand}" CommandParameter="{Binding ReadyRack.SelectedSlot.Template}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                            Content="{loc:Translate Panes.TxImageEditor.UnpinTemplate}" Command="{Binding ReadyRack.TogglePinCommand}" CommandParameter="{Binding ReadyRack.SelectedSlot.Template}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                            IsEnabled="{Binding !ReadyRack.SelectedSlot.Template.IsExporting}"
                                            Content="{loc:Translate Panes.TxImageEditor.ExportTemplate}" Command="{Binding ReadyRack.ExportCommand}" CommandParameter="{Binding ReadyRack.SelectedSlot.Template}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                            Content="{loc:Translate Panes.TxImageEditor.DeleteTemplate}" Command="{Binding ReadyRack.DeleteFromRackCommand}" CommandParameter="{Binding ReadyRack.SelectedSlot.Template}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- TEMPLATE LIBRARY: independent scrolling panel, mock lines 60-72. Filter box
                         is a NEW, first-of-its-kind text-filter surface in this codebase (design-
                         fidelity Phase D plan's own note — no ICollectionView/FilterText precedent
                         anywhere else to copy), case-insensitive substring match against Name, empty
                         filter shows all (ReadyRackViewModel.RefreshFilteredTemplates). Save action
                         (name TextBox + Save button) moved here from the old panel's own top slot to
                         match the mock's own footer position — the mock's second footer action,
                         `UPDATE "<name>"` (overwrite the currently-loaded template in place), is real
                         NEW functionality with no existing command anywhere in this codebase (only
                         save-as-new exists); omitted, not stubbed, per this plan's own scope-
                         discipline note. -->
                    <HeaderedContentControl Grid.Row="1" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.TemplateLibraryHeader}" />
                        </HeaderedContentControl.Header>
                        <!-- Count badge moved from the header tab into row 0 of the content Grid —
                             same title-tab-doesn't-stretch finding as the READY RACK panel above. -->
                        <!-- Row 2 (the item list) is Auto, not "*" — this whole rail column now
                             lives inside its own ScrollViewer (see the rail Grid's own comment
                             above), and a "*" row measured under an ancestor ScrollViewer's infinite
                             offered height sizes to its own content instead of sharing leftover
                             space (same real-window finding this file already notes below, "the
                             star column collapses to its content's own size"). Auto avoids the row
                             stretching past its content when the ListBox arranges taller than its
                             own desired size. Row 2's own MinHeight/MaxHeight (below) is what
                             actually keeps this a real, bounded visible size. -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource IndustrySpacingTight}">
                            <!-- ui_transition_plan.md step 13: Import is panel-level (no row target,
                                 unlike Export below), so it lives in this header row rather than the
                                 per-row action grid further down. Expanded template selector: List/
                                 Grid segmented toggle added here too — same IndustrySegTheme/
                                 RadioButton/GroupName pattern already shipped for the sideband
                                 selector (RadioHeaderView.axaml), not a new control shape. Bound with
                                 this codebase's own `!`-negation-in-binding-path convention (already
                                 used e.g. IsEnabled="{Binding !ReadyRack.IsLoadInFlight}") rather than
                                 a second computed property.

                                 Two rows, not one (user-reported bug fix): the rail column is a fixed
                                 212px (line ~241) — Import + Import Legacy + the List/Grid toggle +
                                 the count badge don't fit on one Auto/*/Auto/Auto row at that width,
                                 so GRID rendered past the panel's own right edge into the canvas next
                                 to it. Import stays on row 0 with the count badge; List/Grid moves to
                                 its own row 1, both well inside 212px on their own. -->
                            <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="{StaticResource IndustrySpacingTight}">
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0"
                                            Content="{loc:Translate Panes.TxImageEditor.ImportTemplate}" Command="{Binding ReadyRack.ImportCommand}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0"
                                            Content="{loc:Translate Panes.TxImageEditor.ImportLegacyMtmTemplate}" Command="{Binding ReadyRack.ImportLegacyMtmCommand}" />
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="IndustryKicker" VerticalAlignment="Center" Text="{Binding ReadyRack.TemplateCount}" />
                                <!-- Debugging finding, yoniq-auditor-refined: a TwoWay-bound negated
                                     pair on IsChecked (!IsGridView / IsGridView) across two
                                     RadioButtons sharing one GroupName is SAFE for a single live
                                     view instance — see ReadyRackViewModel.IsGridView's own doc
                                     comment for why this exact negated-pair shape already ships
                                     safely elsewhere in this codebase, and for the real trigger
                                     (negated pair + TwoWay + MULTIPLE live instances of this view
                                     sharing one GroupName registry, which is what this specific view
                                     does per-editor and per-test). Fixed by making IsChecked purely
                                     Mode=OneWay (a read-only reflection of state) and switching modes
                                     through two explicit, parameterless commands instead — no TwoWay
                                     write path on IsChecked at all, which closes this regardless of
                                     instance count. -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="0">
                                    <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}"
                                                 GroupName="TemplateLibraryViewMode" IsChecked="{Binding !ReadyRack.IsGridView, Mode=OneWay}"
                                                 Command="{Binding ReadyRack.SelectListViewCommand}"
                                                 Content="{loc:Translate Panes.TxImageEditor.LibraryViewModeList}" />
                                    <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}"
                                                 GroupName="TemplateLibraryViewMode" IsChecked="{Binding ReadyRack.IsGridView, Mode=OneWay}"
                                                 Command="{Binding ReadyRack.SelectGridViewCommand}"
                                                 Content="{loc:Translate Panes.TxImageEditor.LibraryViewModeGrid}" />
                                </StackPanel>
                            </Grid>
                            <TextBox Grid.Row="1" Classes="Industry IndustryInput" Watermark="{loc:Translate Panes.TxImageEditor.LibraryFilterPlaceholder}" Text="{Binding ReadyRack.LibraryFilterText}" />

                            <!-- Expanded template selector: two ListBoxes (list/grid), mutually
                                 exclusive IsVisible off ReadyRack.IsGridView, sharing the SAME
                                 ItemsSource/SelectedItem — same "no dynamic ItemsPanel switching,
                                 just swap which control is visible" approach as the rack's own
                                 already-shipped click model (single-click selects/reveals the action
                                 strip below, double-click loads, right-click opens the context menu),
                                 which this reuses wholesale rather than inventing a second pattern.
                                 Delete stays on the Library's own existing DeleteCommand — a SEPARATE
                                 command from the rack's own DeleteFromRackCommand only because their
                                 confirm dialogs word the consequence differently, not because of a
                                 UX difference anymore (user-reported feedback, 2026-09-15: both now
                                 show the same real confirm dialog; DeleteCommand's own inline
                                 two-click arm/confirm is gone). -->
                            <!-- MinHeight guarantees a few real visible rows (and makes the two
                                 "no templates" placeholders below actually legible) regardless of
                                 how much of the rail's shared height RACK above has already spent.
                                 MaxHeight caps it so a large library doesn't dominate the rail —
                                 each ListBox already scrolls its own content past that. -->
                            <Grid Grid.Row="2" MinHeight="150" MaxHeight="260">
                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.NoTemplatesYet}" IsVisible="{Binding ReadyRack.HasNoTemplates}" />
                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.NoTemplatesMatchFilter}" IsVisible="{Binding ReadyRack.HasNoFilteredTemplates}" />

                                <ListBox ItemsSource="{Binding ReadyRack.FilteredTemplates}" SelectedItem="{Binding ReadyRack.SelectedLibraryItem}"
                                         ItemContainerTheme="{StaticResource IndustryListBoxItemTheme}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsVisible="{Binding !ReadyRack.IsGridView}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TemplateListRowViewModel">
                                            <Border Padding="6,4" Margin="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource IndustryChromeBorder}"
                                                    DoubleTapped="OnLibraryItemDoubleTapped" ToolTip.Tip="{Binding Name}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.LoadTemplate}" Command="{Binding LoadCommand}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.PinTemplate}" IsEnabled="{Binding CanPin}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.ExportTemplate}" Command="{Binding ExportCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.DeleteTemplate}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.RenameTemplate}" Click="OnRenameLibraryItemMenuClick" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="32,*" ColumnSpacing="7">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="32" Height="24" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Classes="IndustryRowLabel" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                        <TextBlock Classes="IndustryKicker" Foreground="{DynamicResource IndustryAccent}" Text="{loc:Translate Panes.TxImageEditor.PinnedBadge}" IsVisible="{Binding IsPinned}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- No outer ScrollViewer needed — a ListBox already scrolls
                                     internally (same as the plain list ListBox above and the rack's
                                     own), the WrapPanel just changes how items lay out inside it. -->
                                <ListBox ItemsSource="{Binding ReadyRack.FilteredTemplates}" SelectedItem="{Binding ReadyRack.SelectedLibraryItem}"
                                         ItemContainerTheme="{StaticResource IndustryListBoxItemTheme}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsVisible="{Binding ReadyRack.IsGridView}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- Fable's own sizing (2026-09-14 consult): ~96x72 tiles, 4:3 to match
                                                     SSTV aspect, 2-3 columns at this rail's width. -->
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TemplateListRowViewModel">
                                                <Border Width="96" Padding="4" Margin="2" BorderThickness="1" BorderBrush="{DynamicResource IndustryChromeBorder}"
                                                        DoubleTapped="OnLibraryItemDoubleTapped" ToolTip.Tip="{Binding Name}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu Classes="Industry">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.LoadTemplate}" Command="{Binding LoadCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.PinTemplate}" IsEnabled="{Binding CanPin}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.ExportTemplate}" Command="{Binding ExportCommand}" CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.DeleteTemplate}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.RenameTemplate}" Click="OnRenameLibraryItemMenuClick" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel>
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="88" Height="66" />
                                                        <TextBlock Classes="IndustryRowLabel" TextTrimming="CharacterEllipsis" Text="{Binding Name}" HorizontalAlignment="Center" />
                                                        <TextBlock Classes="IndustryKicker" Foreground="{DynamicResource IndustryAccent}" Text="{loc:Translate Panes.TxImageEditor.PinnedBadge}"
                                                                   HorizontalAlignment="Center" IsVisible="{Binding IsPinned}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                            </Grid>

                            <!-- Expanded template selector: the shared action strip, same shape as
                                 the rack's own (TxImageEditorPaneView.axaml's Templates block) —
                                 Load/Pin/Export/Delete plus inline rename, shown only while a Library
                                 item is selected. OnLibraryRenameKeyDown commits on Enter, reverts on
                                 Esc. Delete's own confirm dialog is unaffected by this row moving —
                                 see DeleteCommand's own doc comment. -->
                            <!-- User-reported gap (2026-09-15): same 212px overflow the rack's own
                                 action row had (see that row's own comment, above in this file), same
                                 WrapPanel fix. Does NOT share the rack row's other bug: SelectedLibraryItem
                                 is a single-level path (unlike SelectedSlot.Template's two-step one), so
                                 a null value here is a REAL null the converter correctly sees and turns
                                 into false — confirmed by testing that removing FallbackValue from just
                                 this binding changes nothing. Kept anyway as harmless defense-in-depth,
                                 matching the rack row's own shape. -->
                            <StackPanel x:Name="LibraryActionStrip" Grid.Row="3" Spacing="{StaticResource IndustrySpacingTight}"
                                        IsVisible="{Binding ReadyRack.SelectedLibraryItem, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                <TextBox x:Name="LibraryRenameTextBox" Classes="Industry IndustryInput" Text="{Binding ReadyRack.SelectedLibraryItem.EditingName}"
                                         Watermark="{loc:Translate Panes.TxImageEditor.RenameTemplatePlaceholder}"
                                         KeyDown="OnLibraryRenameKeyDown" />
                                <WrapPanel>
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                            Content="{loc:Translate Panes.TxImageEditor.LoadTemplate}" Command="{Binding ReadyRack.LoadCommand}" CommandParameter="{Binding ReadyRack.SelectedLibraryItem}" />
                                    <ToggleButton Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                                  IsChecked="{Binding ReadyRack.SelectedLibraryItem.IsPinned, Mode=OneWay}" IsEnabled="{Binding ReadyRack.SelectedLibraryItem.CanPin}"
                                                  Command="{Binding ReadyRack.TogglePinCommand}" CommandParameter="{Binding ReadyRack.SelectedLibraryItem}"
                                                  Content="{loc:Translate Panes.TxImageEditor.PinTemplate}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                            IsEnabled="{Binding !ReadyRack.SelectedLibraryItem.IsExporting}"
                                            Content="{loc:Translate Panes.TxImageEditor.ExportTemplate}" Command="{Binding ReadyRack.ExportCommand}" CommandParameter="{Binding ReadyRack.SelectedLibraryItem}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3"
                                            Content="{loc:Translate Panes.TxImageEditor.DeleteTemplate}" Command="{Binding ReadyRack.DeleteCommand}" CommandParameter="{Binding ReadyRack.SelectedLibraryItem}" />
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <TextBox x:Name="NewTemplateNameTextBox" Classes="Industry IndustryInput" Watermark="{loc:Translate Panes.TxImageEditor.TemplateNamePlaceholder}" Text="{Binding NewTemplateName}" />
                                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnPrimary" Padding="7,0"
                                        Content="{loc:Translate Panes.TxImageEditor.SaveTemplate}" Command="{Binding SaveTemplateCommand}" />
                            </Grid>
                        </Grid>
                    </HeaderedContentControl>
                </Grid>
                </ScrollViewer>

                <!-- Interactive canvas: crop rectangle (drag body to move, drag the corner handle to
                     resize; legacy's own real precedent has resize on the bottom-right corner only,
                     see PicRect.cpp) and draggable overlay text, both drawn over the pre-downsampled
                     working copy at native pixel size (Stretch="None") so on-screen pixels map
                     directly to normalized crop/overlay coordinates with no scale-factor math needed.
                     Crop border/handle recolored to IndustryAccent (was ScanlineStudioAccentColor)
                     for visual consistency with the new design system — purely cosmetic, no change
                     to the real pointer-handler logic below. -->
                <DockPanel Grid.Column="1" LastChildFill="True">

                    <!-- Bottom action bar removed: it was a decorative duplicate of the real
                         Transmit/Halt controls in TxControlsPaneView's left column (locked decision
                         #8, plan), with no Command wired at all — a confirmed duplicate of real UI
                         elsewhere, removed outright rather than left as a disabled ghost (matches
                         this project's own precedent for confirmed-duplicate stub UI). -->

                    <!-- EditWindow redesign Phase 3 (mockups/Editwindow): the 6 adjustment sliders
                         moved from here into the new IMAGE inspector tab — frees real canvas height
                         (one of the user's own stated complaints about the pre-redesign layout being
                         crowded/too horizontal) and matches the mock's own IA (adjustments are an
                         INSPECT-column concern, not something docked under the COMPOSE canvas). Same
                         bindings, same VM properties, just relocated — see the IMAGE tab's own block
                         further down in this file. -->

                    <!-- Instructional caption: NOT in mock2 (app-added disclaimer, real information
                         not mockup scaffolding) — kept, re-skinned with IndustryRowLabel (closest
                         semantic match: small muted body text). -->
                    <TextBlock DockPanel.Dock="Top"
                               Classes="IndustryRowLabel"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Text="{loc:Translate Panes.TxImageEditor.Caption}" />

                    <!-- Design-fidelity Phase C (mockups/Editwindow line 97): the canvas "well" —
                         IndustryNeutral200 is the SAME token this design system's own token file
                         already calls out as "the editor canvas's" background (AtomsTokens.axaml:333)
                         elsewhere in the app, reused here rather than a new hardcoded color; it's a
                         near-exact match to the mock's own #e9e9ea well fill anyway (#E7E7EA). -->
                    <!-- design-fidelity Phase H (final confirming pass finding #4): outer Panel added
                         so the footer hint lines below can be pinned to the WELL itself (outside the
                         ScrollViewer's own clipped/scrolled/zoomed viewport) instead of the zoomed
                         canvas content — at anything but Fit/100% they were scrolling and clipping
                         mid-word along with the photo, e.g. "WORKING COPY 640×475 · REND" truncated
                         at the well's own right edge. Same "ScrollViewer clips to its own viewport"
                         mechanism already documented for the corner "+" marks and the Phase A
                         panel-title fix. -->
                    <!-- Missing-feature sweep (2026-08-31): OS file drag-and-drop target — see
                         TxImageEditorPaneView.axaml.cs's own OnEditorDrop doc comment for why THIS
                         Border, not EditorScrollViewer or EditorCanvas, is the right element (it's
                         backgrounded everywhere, unlike the ScrollViewer's own un-backgrounded
                         centering gutter, so it's hit-testable regardless of zoom/scroll position). -->
                    <Border x:Name="EditorWell" Background="{DynamicResource IndustryNeutral200}" BorderBrush="{DynamicResource IndustryChromeBorder}" BorderThickness="1"
                            DragDrop.AllowDrop="True" DragDrop.Drop="OnEditorDrop" DragDrop.DragOver="OnEditorDragOver">
                    <Panel>
                    <ScrollViewer x:Name="EditorScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center">
                        <!-- Phase 7 (spec/15-template-designer.md): zoom is baked directly into
                             CanvasDisplayWidth/Height (= WorkingCopyWidth/Height * ZoomFactor, and
                             into every other on-screen pixel property — CropLeftPixels/LeftPixels/
                             CanvasWidthPixels/etc.) rather than a LayoutTransformControl/RenderTransform
                             wrapper. Real-window finding, post-implementation: the original
                             LayoutTransformControl design (kept a bare WorkingCopyWidth/Height-sized
                             Canvas, scaled the whole subtree via a render transform) looked correct in
                             plan-review and built clean, but its subtree did not reliably re-composite
                             on a descendant-only bounds change — confirmed via pixel-diffed screenshots
                             (an element drag updated its bound X/Y correctly and the mini-preview picked
                             it up, but the interactive canvas itself stayed visually frozen; reproduced
                             identically at exactly 1.0 zoom, so it wasn't a "only happens when scaled"
                             issue; three different Avalonia invalidation attempts all failed). Diagnosed
                             (auditor) as a render/composition-invalidation gap specific to that control,
                             not a layout bug — the Bounds were already right every time. This
                             rearchitecture uses only ordinary Avalonia data-binding invalidation, the
                             same mechanism every other property on this page already relies on with zero
                             issues, so it sidesteps the bug class instead of working around it — see
                             TxImageEditorPaneViewModel.ZoomFactor's own doc comment for the full story.
                             No transform/wrapper control of any kind between this ScrollViewer and the
                             Panel below anymore; the Panel's own children size themselves directly off
                             CanvasDisplayWidth/Height, so Auto scrollbars/extent just work. -->
                        <!-- Panel wrapper exists only so the safe-area guide below can use ordinary
                             Margin/HorizontalAlignment/VerticalAlignment positioning; that's a no-op
                             directly inside a Canvas. The Panel sizes to the Canvas's own bound
                             CanvasDisplayWidth/Height since the Canvas is the only size-driving child.
                             (Used to also host the plate text overlays, removed 2026-08-14 — see the
                             guide's own comment below.) -->
                        <Panel>
                        <Canvas x:Name="EditorCanvas"
                                Width="{Binding CanvasDisplayWidth}"
                                Height="{Binding CanvasDisplayHeight}"
                                Focusable="True"
                                Background="Transparent"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerReleased="OnCanvasPointerReleased"
                                PointerCaptureLost="OnEditorCanvasPointerCaptureLost">
                            <!-- TX workflow modernization plan, Phase 5: right-click on empty canvas
                                 previously did nothing (no ContextMenu existed at this level, only
                                 per-element ones). Avalonia's normal hit-testing means a right-click
                                 landing ON an element still opens that element's own ContextMenu
                                 first — this one only fires when the click lands on empty canvas
                                 area, so it doesn't shadow the per-element menus. "Add Text/Box/
                                 Image Here" at the click point is deliberately NOT here yet — it
                                 needs Phase 3a's target-rect parameter on AddOverlayElement/
                                 AddBoxElement, not built yet; add it once that lands. -->
                            <Canvas.ContextMenu>
                                <!-- User-reported gap (2026-09-14): the canvas had no "Save Template"
                                     entry anywhere except the small always-visible name field + button
                                     at the bottom of the Templates rail (easy to miss). Added here,
                                     disabled when the canvas has no elements to save (computed in
                                     OnCanvasContextMenuOpened — OverlayElements.Count has no live
                                     bound bool today, so this follows the same "View computes a
                                     View-owned check right before the menu shows" pattern already used
                                     by OnFitSafeAreaClick/etc for EditorScrollViewer.Bounds, rather than
                                     wiring a new CollectionChanged subscription into the VM for one
                                     MenuItem). Click focuses the name field instead of no-opping when
                                     no name has been typed yet (SaveTemplateCommand's own CanSaveTemplate
                                     gate gets called first — a typed name saves immediately, matching
                                     the existing Save button). -->
                                <ContextMenu Classes="Industry" Opened="OnCanvasContextMenuOpened">
                                    <MenuItem Header="{loc:Translate Panes.TxImageEditor.Paste}" InputGesture="Ctrl+V" Command="{Binding PasteElementCommand}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitSafeArea}" Click="OnFitSafeAreaClick" />
                                    <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitWidth}" Click="OnFitWidthClick" />
                                    <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitHeight}" Click="OnFitHeightClick" />
                                    <Separator />
                                    <MenuItem Header="{loc:Translate Panes.TxImageEditor.SnapGrid}" ToggleType="CheckBox" IsChecked="{Binding SnapToGrid, Mode=TwoWay}" />
                                    <Separator />
                                    <!-- Background/backdrop naming work (2026-09-15): background (the base
                                         photo loaded via Browse/Stock) and backdrop (a locked, full-frame
                                         image element, saved with templates) are separate concepts sharing
                                         the same visual result — see SetAsBackdrop's/PromoteBackgroundToBackdrop's
                                         own doc comments. This is the promote direction; the reverse ("Turn
                                         into background") lives on the backdrop element's own context menu.
                                         IsEnabled computed fresh by OnCanvasContextMenuOpened (same View-owned
                                         "no live bound bool today" pattern SaveTemplateMenuItem above already
                                         established), not a VM-level CanExecute — HasRealBackground has no
                                         [ObservableProperty]/notification of its own to bind against. -->
                                    <MenuItem x:Name="PromoteBackgroundMenuItem"
                                              Header="{loc:Translate Panes.TxImageEditor.PromoteBackgroundToBackdrop}"
                                              ToolTip.Tip="{loc:Translate Panes.TxImageEditor.PromoteBackgroundToBackdrop.Help}"
                                              Command="{Binding PromoteBackgroundToBackdropCommand}" />
                                    <!-- User-reported gap (2026-09-15): a plain destructive clear, distinct
                                         from Promote above (which PRESERVES the photo as a backdrop
                                         element) — see RemoveBackground's own doc comment. Same
                                         View-owned IsEnabled pattern as PromoteBackgroundMenuItem above. -->
                                    <MenuItem x:Name="RemoveBackgroundMenuItem"
                                              Header="{loc:Translate Panes.TxImageEditor.RemoveBackground}"
                                              ToolTip.Tip="{loc:Translate Panes.TxImageEditor.RemoveBackground.Help}"
                                              Command="{Binding RemoveBackgroundCommand}" />
                                    <Separator />
                                    <MenuItem x:Name="SaveTemplateMenuItem" Header="{loc:Translate Panes.TxImageEditor.SaveTemplate}" Click="OnSaveTemplateContextMenuClick" />
                                </ContextMenu>
                            </Canvas.ContextMenu>

                            <!-- Explicit Width/Height + Stretch="Fill" (was Stretch="None" with no
                                 explicit size, back when the Canvas was always native working-copy
                                 resolution and zoom didn't exist) — without this the bitmap would stay
                                 native-size while everything else on this canvas scales with zoom. -->
                            <Image Source="{Binding WorkingCopyBitmap}"
                                   Width="{Binding CanvasDisplayWidth}" Height="{Binding CanvasDisplayHeight}"
                                   Stretch="Fill" />

                            <!-- Design-fidelity Phase C: fill removed (was #22FFFF00) — the mock has
                                 no crop-rect fill at all (mockups/Editwindow line 105, outline only);
                                 crop == the working-copy frame conceptually, not a separate tinted
                                 region on top of it. -->
                            <Border Canvas.Left="{Binding CropLeftPixels}"
                                    Canvas.Top="{Binding CropTopPixels}"
                                    Width="{Binding CropWidthPixels}"
                                    Height="{Binding CropHeightPixels}"
                                    BorderBrush="{DynamicResource IndustryAccent}"
                                    BorderThickness="2"
                                    Background="Transparent"
                                    PointerPressed="OnCropBodyPointerPressed" />

                            <Border Canvas.Left="{Binding CropRightPixels}"
                                    Canvas.Top="{Binding CropBottomPixels}"
                                    RenderTransform="translate(-5px, -5px)"
                                    Width="10" Height="10"
                                    Background="{DynamicResource IndustryAccent}"
                                    PointerPressed="OnCropHandlePointerPressed" />

                            <!-- Safe-area guide: a visual crop-boundary indicator only (dashed
                                 rectangle), not fake content — kept. Rectangle (not a Border, which
                                 has no dash support in Avalonia) with StrokeDashArray, matching
                                 mock2's own "1px dashed" guide. Backlog fix (user real-window
                                 finding, 2026-08-17): moved from being a Margin-inset Panel sibling
                                 of EditorCanvas to a direct Canvas.Left/Top+Width/Height child of
                                 EditorCanvas itself — the same pixel-space positioning convention
                                 already proven reliable here for the crop rect/handle above and the
                                 overlay elements/selection badge below. The old Panel-sibling
                                 approach measured/arranged unreliably under the ScrollViewer's own
                                 viewport-driven sizing (confirmed via two rounds of real-window
                                 screenshot comparison): "the blue lines... stay the same place in
                                 the window" instead of tracking zoom was the reported symptom.
                                 IsHitTestVisible="False" so the real crop/overlay pointer handlers
                                 are unaffected. -->
                            <Rectangle IsHitTestVisible="False"
                                       Canvas.Left="{Binding SafeAreaInsetPixels}"
                                       Canvas.Top="{Binding SafeAreaInsetPixels}"
                                       Width="{Binding SafeAreaWidthPixels}"
                                       Height="{Binding SafeAreaHeightPixels}"
                                       IsVisible="{Binding SafeAreaVisible}"
                                       Stroke="{DynamicResource IndustryAccent}" Opacity="0.55"
                                       StrokeThickness="1" StrokeDashArray="4,2" />

                            <!-- Backlog item (auditor usability review, 2026-08-17, item 10): "SNAP TO
                                 GRID has no visible grid; snap only applies on drop, not to nudge/
                                 numeric entry." Visual-only fix — a real grid overlay so the operator
                                 can see the 5%-of-working-copy lines an element drag/resize snaps to
                                 (TxImageEditorPaneView.axaml.cs's own SnapElementBoundsToGrid gridSize
                                 default). Extending snap itself to keyboard nudge/numeric-entry stays
                                 explicitly out of scope — nudge is a precision 1px/16px keyboard
                                 control (PicRect.cpp's own real legacy mechanism, NudgeCropMove's own
                                 doc comment), a different use case a 5%-grid snap would fight against,
                                 not a gap. DrawingBrush tiled at 5%/5% of the rectangle's own bounding
                                 box (RelativeToBoundingBox, via the "%" suffix on DestinationRect) —
                                 this is why no VM-side pixel math is needed here, unlike every other
                                 pixel-space property on this canvas: the tile scales with
                                 CanvasDisplayWidth/Height for free. IsHitTestVisible="False" so the
                                 real crop/overlay pointer handlers stay unaffected, same as the safe-
                                 area guide just above. -->
                            <Rectangle IsHitTestVisible="False"
                                       Width="{Binding CanvasDisplayWidth}" Height="{Binding CanvasDisplayHeight}"
                                       IsVisible="{Binding SnapToGrid}"
                                       Opacity="0.3">
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile" Stretch="None" DestinationRect="0%,0%,5%,5%">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="{DynamicResource IndustryAccent}" Thickness="1" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Width/Height bound explicitly (real-window code-review finding, via
                                 Avalonia DevTools): a Canvas ItemsPanel does NOT auto-size to its
                                 children's Canvas.Left/Top-positioned content — with neither an
                                 explicit size NOR content-driven sizing, this ItemsControl's own
                                 Bounds/DesiredSize measured to (0,0,0,0) (directly observed on the live
                                 instance in DevTools' property inspector, ClipToBounds reading true on
                                 that instance too — its default control theme, not Visual's own
                                 documented false default). With zero size and clipping, nothing inside
                                 ever rendered regardless of Canvas.Left/Top/ZIndex on the elements
                                 themselves. This was a total rendering failure (not just a z-order or
                                 border-thickness issue); the fix (explicit size) is confirmed via a real
                                 running window, not inferred — round-3 code-review flagged the exact
                                 causal mechanism above as unverifiable from static docs alone, which is
                                 fair; treat it as "what DevTools showed," not a documented contract. -->
                            <ItemsControl x:Name="OverlayElementsHost" ItemsSource="{Binding OverlayElements}"
                                          Width="{Binding CanvasDisplayWidth}" Height="{Binding CanvasDisplayHeight}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <!-- Phase 7 real-window finding (post-implementation), root cause of a
                                     LIVE-UPDATE bug this codebase already had one documented symptom of
                                     (ZIndex, see the comment immediately below): Canvas.Left/Canvas.Top
                                     bound on a DataTemplate's own ROOT element only positions correctly
                                     on the FIRST layout pass. Avalonia wraps each ItemsControl item in
                                     its own generated container (a ContentPresenter here — ItemsControl
                                     has no SelectingItemsControl-style item container), and the attached
                                     Canvas.Left/Top properties are read by the OUTER ItemsPanel Canvas
                                     against THAT container, not against whatever's inside the
                                     DataTemplate — so AffectsParentArrange's invalidation, triggered by
                                     LeftPixels/TopPixels changing, never reaches the actual owning Canvas
                                     when the properties are set one level too deep. A full top-down
                                     layout pass (initial render, or anything that invalidates the whole
                                     subtree) still happens to place things correctly once, which is why
                                     this went unnoticed until a live, isolated drag was actually tested
                                     (confirmed via direct user observation on the running app: dragging
                                     an element updates the mini-preview immediately but the interactive
                                     canvas itself never visibly moves). Fixed below by moving Canvas.Left/
                                     Top onto the actual generated container via a Style targeting
                                     "ItemsControl#OverlayElementsHost > ContentPresenter" instead of the
                                     DataTemplate roots — see that Style, right after this ItemsControl's
                                     own DataTemplates. -->
                                <ItemsControl.Styles>
                                    <Style Selector="ItemsControl#OverlayElementsHost &gt; ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding LeftPixels}" />
                                        <Setter Property="Canvas.Top" Value="{Binding TopPixels}" />
                                    </Style>
                                </ItemsControl.Styles>
                                <!-- Phase 1 (spec/15-template-designer.md): polymorphic per-type
                                     DataTemplates (ItemsControl.DataTemplates, NOT a single
                                     ItemTemplate — Avalonia selects by the item's own runtime type)
                                     replace the pre-Phase-1 text-only ItemTemplate. Each template's
                                     ROOT is itself a Canvas sized (NOT positioned — see the Style
                                     above for why Canvas.Left/Top moved off this root) via the
                                     element's own CanvasWidthPixels/CanvasHeightPixels; its CHILDREN
                                     position within that inner Canvas's own coordinate space, same
                                     nested-Canvas technique the crop body/handle pair above already
                                     uses one level up. 8 resize handles per element — corners + edge
                                     midpoints (auditor usability review follow-up, 2026-08-18:
                                     upgraded from the earlier single-bottom-right-only handle, a
                                     legacy-precedent choice at the time — PicRect.cpp — that the "UI/
                                     editing improved on, not replicated" project rule (CLAUDE.md §2)
                                     doesn't bind here, since this is new interaction-model
                                     functionality, not a port). Hidden while Locked (code-behind is
                                     the real gate; this is the visual cue). Shift-drag a CORNER handle
                                     to preserve aspect ratio — see
                                     TxImageEditorPaneView.ComputeElementResize's own doc comment. -->
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:OverlayElementViewModel">
                                        <!-- No ZIndex binding here (real-window code-review finding, via
                                             Avalonia DevTools: a ZIndex bound on this DataTemplate root had
                                             NO effect — Avalonia wraps each ItemsControl item in its own
                                             container and doesn't forward the attached property to reorder
                                             those containers). Draw order instead comes from plain Canvas
                                             child order, which TxImageEditorPaneViewModel keeps in sync with
                                             Z itself (MoveElementUp/Down physically move the item within
                                             OverlayElements, not just its Z value) — see that method's own
                                             doc comment. -->
                                        <Canvas Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}">
                                            <!-- FontSize/FontFamily bound so the canvas chrome
                                                 actually matches what TransmitImagePreparer.
                                                 ApplyTemplate bakes into the transmitted image
                                                 (spec/18-path-to-1.0.md Medium item, overlay-text
                                                 WYSIWYG; Phase 1 generalized the underlying fit
                                                 computation to real shrink-to-fit). CanvasFontSize
                                                 is computed by the parent VM (not a converter here,
                                                 since it depends on the crop rect, PreserveAspect,
                                                 the element's own box, and the target mode's own
                                                 dimensions, none of which this DataTemplate's own
                                                 DataContext has access to). Foreground bound to the
                                                 element's own Color (Phase 1 fix: this was hardcoded
                                                 White pre-Phase-1 despite Color being a real,
                                                 editable, undo-tracked property — same fix class as
                                                 the box fill/border below, not a separate concern). -->
                                            <!-- RenderTransform bound to RotationTransform (Phase 8
                                                 canvas-preview amendment) — on the OUTER Border, not
                                                 either TextBlock individually, so rotation carries the
                                                 shadow copy along with the real text as one unit,
                                                 matching the real pipeline's own behavior of rotating
                                                 the whole offscreen sub-bitmap together. -->
                                            <Border Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}"
                                                    RenderTransform="{Binding RotationTransform}"
                                                    Background="{DynamicResource IndustryOverlayFill}"
                                                    BorderBrush="{DynamicResource IndustryAccent}" BorderThickness="1"
                                                    PointerPressed="OnOverlayElementPointerPressed">
                                                <!-- Task #24 (right-click context menu addendum, plan-reviewed):
                                                     declared INLINE (not a shared resource) so DataContext
                                                     inheritance resolves {Binding XCommand} against THIS
                                                     element (plan-review finding: a shared instance would be
                                                     reparented to whichever control attached last, silently
                                                     breaking every binding — same failure class RemoveCommand's
                                                     own doc comment already documents for $parent bindings).
                                                     Lock uses MenuItem's native ToggleType="CheckBox" +
                                                     IsChecked (plan-review finding: no new command needed,
                                                     mirrors the sidebar's own ToggleButton exactly — Locked has
                                                     no undo/preview hook, confirmed via OnOverlayElementPropertyChanged's
                                                     own filter list). Duplicate/AddPlate bind the SAME
                                                     parameterless VM-level commands the toolbar already uses,
                                                     with NO CommandParameter (see DuplicateCommand's own
                                                     interface doc comment for why this is still correct). A
                                                     LOCKED background image element is unreachable by
                                                     right-click here (IsHitTestVisible="{Binding !BlocksHitTesting}"
                                                     on the image template) — a stated, known limitation, not
                                                     fixed by this addendum; the sidebar's own Lock toggle stays
                                                     the recovery path for that one case. -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Lock}" ToggleType="CheckBox" IsChecked="{Binding Locked, Mode=TwoWay}" />
                                                        <Separator />
                                                        <!-- Round-1 (TX workflow modernization plan): Cut/Copy/Paste wire the
                                                             already-existing element clipboard (Ctrl+C/X/V in
                                                             TxImageEditorPaneView.axaml.cs) — the commands were shipped
                                                             2026-08-17 but never reachable from these menus until now. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Cut}" InputGesture="Ctrl+X" Command="{Binding CutCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Copy}" InputGesture="Ctrl+C" Command="{Binding CopyCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Paste}" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.CopyStyle}" InputGesture="Ctrl+Shift+C" Command="{Binding CopyStyleCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.PasteStyle}" InputGesture="Ctrl+Shift+V" Command="{Binding PasteStyleCommand}" />
                                                        <Separator />
                                                        <!-- EditWindow redesign Phase 6 (mockups/Editwindow): Insert Field/Align to Crop
                                                             submenus. Both reuse the SAME parent-pushed/toolbar-shared commands the
                                                             TEXT STYLE/GEOMETRY tabs already use (InsertFieldCommand,
                                                             AlignSelectedElementToCropCommand) — right-click already sets
                                                             SelectedOverlayElement to THIS element before the menu opens (same
                                                             reasoning as DuplicateCommand's own doc comment), so
                                                             AlignSelectedElementToCropCommand acts on the right element with no
                                                             CommandParameter needed for the element itself, only the alignment string.
                                                             "Edit text… (F2)" and "Apply text preset" from the mock are NOT built here
                                                             — inline canvas text editing and a text-style-preset system are both
                                                             genuinely new subsystems, not reachable by relocating existing commands,
                                                             explicitly deferred rather than silently dropped. -->
                                                        <!-- Macros help plan, item A: same 3-way grouping as the TEXT STYLE tab's own
                                                             chip row (its own comment explains the membership) — Separators here since
                                                             a MenuItem submenu has no room for a kicker sub-label the way the sidebar
                                                             does; ToolTip.Tip carries the same explanation on groups 2/3. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.InsertFieldMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip3}" Command="{Binding InsertFieldCommand}" CommandParameter="%m" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip10}" Command="{Binding InsertFieldCommand}" CommandParameter="{}{name}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip4}" Command="{Binding InsertFieldCommand}" CommandParameter="{}{grid}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip8}" Command="{Binding InsertFieldCommand}" CommandParameter="%D" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip7}" Command="{Binding InsertFieldCommand}" CommandParameter="%T" />
                                                            <Separator />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip5}" Command="{Binding InsertFieldCommand}" CommandParameter="{}{freq}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldRadioHint}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip6}" Command="{Binding InsertFieldCommand}" CommandParameter="{}{mode}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldRadioHint}" />
                                                            <Separator />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip1}" Command="{Binding InsertFieldCommand}" CommandParameter="{}{his_call}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip2}" Command="{Binding InsertFieldCommand}" CommandParameter="{}{his_grid}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.Chip9}" Command="{Binding InsertFieldCommand}" CommandParameter="{}{rsv}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                                        </MenuItem>
                                                        <!-- Backlog item (user request, 2026-08-17): quick-pick submenus for font size/text
                                                             color, same discrete-CommandParameter shape as Align to Crop above — a native
                                                             ContextMenu isn't a reliable host for an embedded slider/color-picker, so these
                                                             are curated presets, not the full continuous control (that stays the TEXT STYLE
                                                             tab). Font FAMILY is deliberately NOT added here: AvailableFontFamilies' names
                                                             are platform-dependent (the default entry is the OS's own default family, not a
                                                             fixed literal), so a static preset list would be wrong, and a dynamically
                                                             ItemsSource-generated submenu risks the same silently-broken-binding failure
                                                             class already hit once this session (EditWindow Phase 6's Insert Field/Align to
                                                             Crop submenus, before their command-wiring fix) — font family selection stays
                                                             the TEXT STYLE tab's own ComboBox. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.FontSizeMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FontSizeSmall}" Command="{Binding SetFontSizePresetCommand}" CommandParameter="Small" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FontSizeMedium}" Command="{Binding SetFontSizePresetCommand}" CommandParameter="Medium" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FontSizeLarge}" Command="{Binding SetFontSizePresetCommand}" CommandParameter="Large" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FontSizeXLarge}" Command="{Binding SetFontSizePresetCommand}" CommandParameter="XLarge" />
                                                        </MenuItem>
                                                        <!-- User-requested (2026-09-15): growing a text box previously never grew the
                                                             font past its last explicitly-set size (shrink-to-fit only, no grow-to-fit).
                                                             Session-only per-element toggle, same "no command, direct TwoWay IsChecked"
                                                             pattern as Lock above — not persisted (see GrowToFillEnabled's own doc
                                                             comment), so it always resets off on reload/reopen, matching the user's own
                                                             explicit choice not to remember it. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.GrowToFillEnabled}" ToggleType="CheckBox" IsChecked="{Binding GrowToFillEnabled, Mode=TwoWay}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.GrowToFillEnabledHint}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.TextColorMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.ColorWhite}" Command="{Binding SetTextColorPresetCommand}" CommandParameter="White" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.ColorBlack}" Command="{Binding SetTextColorPresetCommand}" CommandParameter="Black" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.ColorYellow}" Command="{Binding SetTextColorPresetCommand}" CommandParameter="Yellow" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.ColorRed}" Command="{Binding SetTextColorPresetCommand}" CommandParameter="Red" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.ColorGreen}" Command="{Binding SetTextColorPresetCommand}" CommandParameter="Green" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.ColorBlue}" Command="{Binding SetTextColorPresetCommand}" CommandParameter="Blue" />
                                                        </MenuItem>
                                                        <!-- TX workflow modernization plan, Phase 1 — Quick Style Flyout. The two preset
                                                             submenus above stay curated/discrete; this opens the SAME continuous font-size/
                                                             color pickers the TEXT STYLE tab already has, without leaving the canvas. One
                                                             combined flyout, not two — FlyoutBase.AttachedFlyout is single-valued, so a
                                                             "More Sizes…" flyout and a "More Colors…" flyout can't both live on this row's
                                                             Border at once. OnOpenElementQuickStyleFlyout resolves the anchor via
                                                             _lastContextMenuAnchor (see that handler's own doc comment for the real,
                                                             PointerPressed-based capture mechanism — NOT ContextMenu.PlacementTarget,
                                                             which Avalonia never populates on a real right-click). -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.QuickStyleMenu}" Click="OnOpenElementQuickStyleFlyout" />
                                                        <!-- User-reported gap (2026-09-15): setting a picture fill (Inspector's own TEXT
                                                             STYLE tab, PICTURE FILL row) had no way to unset it from the context menu — the
                                                             ONLY place it could be cleared before was that same docked sidebar button
                                                             (ClearTextBitmapFillCommand, already existed, just never exposed here).
                                                             IsEnabled matches that sidebar button's own gate exactly (element-scoped here,
                                                             since this DataTemplate's own DataContext already IS the element — same
                                                             direct-bind precedent as GrowToFillEnabled above, not SelectedTextElement.*). -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.ClearPictureFillMenu}" Command="{Binding ClearTextBitmapFillCommand}" IsEnabled="{Binding BitmapFillEnabled}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignToCropMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignLeft}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Left" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignCenter}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Center" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignRight}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Right" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignTop}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Top" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignMiddle}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Middle" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignBottom}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Bottom" />
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Duplicate}" InputGesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.AddPlate}" Command="{Binding AddPlateCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.ArrangeMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" Command="{Binding BringToFrontCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringForward}" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendBackward}" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" Command="{Binding SendToBackCommand}" CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.FlattenElement}" Command="{Binding FlattenCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Remove}" InputGesture="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <!-- TX workflow modernization plan, Phase 1 — Quick Style Flyout content, shown
                                                     via OnOpenElementQuickStyleFlyout (code-behind). Same "declared inline, not a
                                                     shared resource" reasoning as Border.ContextMenu's own doc comment just above
                                                     — DataContext inheritance must resolve against THIS element. ColorView (not
                                                     ColorPicker) so the picker is immediately interactive with no second click —
                                                     ColorPicker is itself just a button that opens one of these. -->
                                                <FlyoutBase.AttachedFlyout>
                                                    <Flyout Placement="Right">
                                                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" MinWidth="200">
                                                            <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontSizeLabel}" />
                                                                <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                                                         Text="{Binding FontSizePx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid></Border>
                                                            <ColorView Color="{Binding Color, Converter={x:Static conv:Rgb24ToColorConverter.Instance}, Mode=TwoWay}"
                                                                       IsAlphaEnabled="False" IsAccentColorsVisible="False" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </FlyoutBase.AttachedFlyout>
                                                <!-- Phase 8 canvas-preview amendment: shadow copy,
                                                     drawn BEHIND the real text (declared first, same
                                                     draw-order convention as the real pipeline's own
                                                     shadow-pre-pass), offset via ShadowRenderTransform,
                                                     IsVisible-gated on HasShadow. Avalonia's TextBlock
                                                     has no native drop-shadow primitive, so this fakes
                                                     it the same way the real pipeline does: a second,
                                                     offset copy of the glyph run. -->
                                                <!-- Outer Panel: Border only accepts a single Child —
                                                     this wraps the display Panel below and the inline
                                                     edit TextBox as siblings (see that TextBox's own
                                                     doc comment). -->
                                                <Panel>
                                                <Panel IsVisible="{Binding !IsEditingText}">
                                                    <TextBlock Text="{Binding ResolvedText}"
                                                               FontSize="{Binding CanvasFontSize}"
                                                               FontFamily="{Binding FontFamily, Converter={x:Static conv:PipelineFontFamilyNameConverter.Instance}}"
                                                               FontWeight="{Binding CanvasFontWeight}"
                                                               FontStyle="{Binding CanvasFontStyle}"
                                                               Foreground="{Binding ShadowColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                               RenderTransform="{Binding ShadowRenderTransform}"
                                                               IsVisible="{Binding HasShadow}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               IsHitTestVisible="False" />
                                                    <!-- Phase 4: FontFamily now bound to the element's own
                                                         selected family (was hardcoded IndustryMonoFontFamily)
                                                         via PipelineFontFamilyNameConverter, mapping the
                                                         pipeline's plain family name to the matching bundled
                                                         avares:// resource. Fill bound to ForegroundBrush
                                                         (Phase 8 canvas-preview amendment — a plain solid
                                                         brush from Color, or a real Avalonia gradient brush
                                                         when GradientEnabled is set). Backlog item (user
                                                         request, 2026-08-17): stroke now DOES render here too
                                                         — StrokedTextBlock (draws fill+stroke via
                                                         FormattedText.BuildGeometry, stroke first per its own
                                                         doc comment) replaces the plain TextBlock this used to
                                                         be; superseded the prior "stroke isn't shown here,
                                                         Avalonia's TextBlock has no outline capability" scope
                                                         note. CanvasStrokeThicknessPixels is 0 whenever
                                                         StrokeColor is null, so StrokedTextBlock's own
                                                         `Stroke is not null && StrokeThickness > 0` guard means
                                                         no-stroke elements render byte-identically to before. -->
                                                    <controls:StrokedTextBlock Text="{Binding ResolvedText}"
                                                               FontSize="{Binding CanvasFontSize}"
                                                               FontFamily="{Binding FontFamily, Converter={x:Static conv:PipelineFontFamilyNameConverter.Instance}}"
                                                               FontWeight="{Binding CanvasFontWeight}"
                                                               FontStyle="{Binding CanvasFontStyle}"
                                                               Fill="{Binding ForegroundBrush}"
                                                               FillWidth="{Binding CanvasWidthPixels}"
                                                               FillHeight="{Binding CanvasHeightPixels}"
                                                               Stroke="{Binding StrokeColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                               StrokeThickness="{Binding CanvasStrokeThicknessPixels}"
                                                               StackFill="{Binding StackColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                               StackStepXPixels="{Binding CanvasStackStepXPixels}"
                                                               StackStepYPixels="{Binding CanvasStackStepYPixels}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsHitTestVisible="False" />
                                                </Panel>
                                                <!-- Backlog item (auditor usability review,
                                                     2026-08-17, item 14): "No inline canvas text
                                                     editing (no double-click/F2)." Two-way bound
                                                     straight to Text, the SAME property the ELEMENTS
                                                     panel's own row TextBox already commits through
                                                     — no separate commit/cancel plumbing needed, only
                                                     IsEditingText's own show/hide. Entered via
                                                     double-click (OnOverlayElementPointerPressed) or
                                                     F2 (OnRootKeyDown); exited via LostFocus, Enter,
                                                     or Escape (OnElementTextEditLostFocus/
                                                     OnElementTextEditKeyDown/OnRootKeyDown). -->
                                                <TextBox Text="{Binding Text}"
                                                         IsVisible="{Binding IsEditingText}"
                                                         Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}"
                                                         Classes="Industry IndustryInput"
                                                         FontSize="{Binding CanvasFontSize}"
                                                         FontFamily="{Binding FontFamily, Converter={x:Static conv:PipelineFontFamilyNameConverter.Instance}}"
                                                         FontWeight="{Binding CanvasFontWeight}"
                                                         FontStyle="{Binding CanvasFontStyle}"
                                                         TextWrapping="NoWrap" AcceptsReturn="False"
                                                         VerticalContentAlignment="Center"
                                                         LostFocus="OnElementTextEditLostFocus"
                                                         KeyDown="OnElementTextEditKeyDown" />
                                                </Panel>
                                            </Border>
                                            <Border Canvas.Left="0" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="TopLeftCorner" Tag="TopLeft"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="TopSide" Tag="Top"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="TopRightCorner" Tag="TopRight"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="RightSide" Tag="Right"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="BottomRightCorner" Tag="BottomRight"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="BottomSide" Tag="Bottom"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="0" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="BottomLeftCorner" Tag="BottomLeft"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="0" Canvas.Top="{Binding CanvasHeightPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="LeftSide" Tag="Left"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                        </Canvas>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:BoxElementViewModel">
                                        <!-- No ZIndex binding here either — see the text DataTemplate's own
                                             comment above; same non-effect, same fix (collection order). -->
                                        <Canvas Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}">
                                            <!-- BorderThickness bound to CanvasBorderThicknessPixels via
                                                 DoubleToThicknessConverter (round-3 code-review finding: a bare
                                                 double->Thickness value binding has no implicit conversion path
                                                 in Avalonia and fails silently, leaving BorderThickness at 0 —
                                                 see that converter's own doc comment; this was hardcoded to a
                                                 literal 1 before that, which also ignored the element's own
                                                 normalized BorderThickness). A null BorderColor yields a null
                                                 brush, which Avalonia treats as "no border" — matching
                                                 TemplateBoxElement's own BorderColor==null="no border" contract. -->
                                            <!-- TX editor gap-items plan, item 3 (perspective transform) —
                                                 Background/BorderThickness/Opacity bind to the Effective*
                                                 properties, not the raw FillBrush/CanvasBorderThicknessPixels/
                                                 Opacity ones — Avalonia is LocalValue-beats-Style, so a Style
                                                 selector on PerspectiveEnabled could never override these same
                                                 3 already-local bindings; Effective* itself is the
                                                 PerspectiveEnabled-aware switch instead (see that property's
                                                 own doc comment on BoxElementViewModel). Pixel-identical to the
                                                 raw properties when perspective is off. -->
                                            <Border Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}"
                                                    Background="{Binding EffectiveBackground}"
                                                    BorderBrush="{Binding BorderColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                    BorderThickness="{Binding EffectiveBorderThicknessPixels, Converter={x:Static conv:DoubleToThicknessConverter.Instance}}"
                                                    CornerRadius="{Binding CanvasCornerRadiusPixels, Converter={x:Static conv:DoubleToCornerRadiusConverter.Instance}}"
                                                    Opacity="{Binding EffectiveOpacity}"
                                                    PointerPressed="OnOverlayElementPointerPressed">
                                                <!-- Task #24: same inline-ContextMenu reasoning as the text
                                                     DataTemplate above — no Add Plate item (text-only) or
                                                     Set as Background item (image-only). -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Lock}" ToggleType="CheckBox" IsChecked="{Binding Locked, Mode=TwoWay}" />
                                                        <Separator />
                                                        <!-- Round-1 (TX workflow modernization plan): Cut/Copy/Paste wire the
                                                             already-existing element clipboard (Ctrl+C/X/V in
                                                             TxImageEditorPaneView.axaml.cs) — the commands were shipped
                                                             2026-08-17 but never reachable from these menus until now. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Cut}" InputGesture="Ctrl+X" Command="{Binding CutCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Copy}" InputGesture="Ctrl+C" Command="{Binding CopyCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Paste}" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.CopyStyle}" InputGesture="Ctrl+Shift+C" Command="{Binding CopyStyleCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.PasteStyle}" InputGesture="Ctrl+Shift+V" Command="{Binding PasteStyleCommand}" />
                                                        <Separator />
                                                        <!-- EditWindow redesign Phase 6: Align to Crop submenu — see the text
                                                             element's own ContextMenu doc comment for the full reasoning
                                                             (AlignSelectedElementToCropCommand is generic across element types). -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignToCropMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignLeft}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Left" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignCenter}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Center" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignRight}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Right" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignTop}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Top" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignMiddle}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Middle" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignBottom}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Bottom" />
                                                        </MenuItem>
                                                        <!-- TX workflow modernization plan, Phase 1 — Fill & Border flyout. Before this,
                                                             a box element's fill/border/opacity/corner-radius had NO entry point outside
                                                             the sidebar GEOMETRY tab's Box Style block — this is its first. Same
                                                             single-combined-flyout mechanism as the text element's Quick Style Flyout
                                                             above (OnOpenElementQuickStyleFlyout's own doc comment has the full
                                                             reasoning, including the real PointerPressed-based anchor capture). -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.FillBorderMenu}" Click="OnOpenElementQuickStyleFlyout" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Duplicate}" InputGesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.ArrangeMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" Command="{Binding BringToFrontCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringForward}" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendBackward}" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" Command="{Binding SendToBackCommand}" CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.FlattenElement}" Command="{Binding FlattenCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Remove}" InputGesture="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <FlyoutBase.AttachedFlyout>
                                                    <Flyout Placement="Right">
                                                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" MinWidth="220">
                                                            <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.FillColorLabel}"
                                                                      IsChecked="{Binding FillEnabled}" />
                                                            <ColorView IsEnabled="{Binding FillEnabled}"
                                                                       Color="{Binding FillColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}, Mode=TwoWay}"
                                                                       IsAlphaEnabled="False" IsAccentColorsVisible="False" />
                                                            <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.BorderLabel}"
                                                                      IsChecked="{Binding HasBorder}" />
                                                            <ColorView IsEnabled="{Binding HasBorder}"
                                                                       Color="{Binding BorderColorForPicker, Converter={x:Static conv:Rgb24ToColorConverter.Instance}, Mode=TwoWay}"
                                                                       IsAlphaEnabled="False" IsAccentColorsVisible="False" />
                                                            <Border Classes="IndustryRow" IsEnabled="{Binding HasBorder}"><Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.BorderThicknessLabel}" />
                                                                <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                                                         Text="{Binding BorderThicknessPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid></Border>
                                                            <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.CornerRadiusLabel}" />
                                                                <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                                                         Text="{Binding CornerRadiusPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid></Border>
                                                            <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.OpacityLabel}" />
                                                                <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0"
                                                                        Minimum="0" Maximum="1" Value="{Binding Opacity}" VerticalAlignment="Center" />
                                                            </Grid></Border>
                                                        </StackPanel>
                                                    </Flyout>
                                                </FlyoutBase.AttachedFlyout>
                                                <!-- TX editor gap-items plan, item 3 — the warped-preview
                                                     visual. The Border stays the ONLY hit-test/context-menu/
                                                     flyout surface regardless of PerspectiveEnabled (see this
                                                     Border's own Background/BorderThickness/Opacity comment
                                                     above) — this Image is purely decorative, sized/shaped
                                                     exactly to the target already (RenderWarpedElementPreview's
                                                     own contract), so Stretch="Fill" is hardcoded, not bound to
                                                     any Fit concept (boxes have none). -->
                                                <Image Source="{Binding WarpedCanvasBitmap}" Stretch="Fill" IsHitTestVisible="False"
                                                       IsVisible="{Binding PerspectiveEnabled}" />
                                            </Border>
                                            <Border Canvas.Left="0" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="TopLeftCorner" Tag="TopLeft"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="TopSide" Tag="Top"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="TopRightCorner" Tag="TopRight"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="RightSide" Tag="Right"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="BottomRightCorner" Tag="BottomRight"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="BottomSide" Tag="Bottom"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="0" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="BottomLeftCorner" Tag="BottomLeft"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="0" Canvas.Top="{Binding CanvasHeightPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="LeftSide" Tag="Left"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <!-- TX editor gap-items plan, item 3 — 4 perspective-corner
                                                 handles, NOT the 8 axis-aligned resize handles above (see
                                                 DragMode.PerspectiveCorner's own doc comment) — same 10x10
                                                 accent-square visual, positioned via
                                                 CanvasCorner0Point..3Point (container-relative, same
                                                 convention the line element's own CanvasStartPoint/EndPoint
                                                 already use). -->
                                            <Border Canvas.Left="{Binding CanvasCorner0Point.X}" Canvas.Top="{Binding CanvasCorner0Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner0"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasCorner1Point.X}" Canvas.Top="{Binding CanvasCorner1Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner1"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasCorner2Point.X}" Canvas.Top="{Binding CanvasCorner2Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner2"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasCorner3Point.X}" Canvas.Top="{Binding CanvasCorner3Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner3"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                        </Canvas>
                                    </DataTemplate>
                                    <!-- TX editor gap-items plan, line element (2026-09-01) — 4th
                                         polymorphic canvas branch. ClipToBounds="False" (unlike box's
                                         own Canvas above, which never needs it) — a perfectly
                                         horizontal/vertical line has a genuinely zero-height/width
                                         Canvas, and the endpoint handles/hit-line still need to
                                         render past that degenerate bound. Real Line's own
                                         StartPoint/EndPoint bind directly to CanvasStartPoint/
                                         CanvasEndPoint (container-relative, see those properties' own
                                         doc comment on LineElementViewModel) — no Canvas.Left/Top
                                         needed on the Line itself, unlike every other element's own
                                         root content control. A SECOND, invisible line underneath
                                         carries the real hit-testing/context-menu/drag surface at a
                                         constant, comfortably-clickable 14px width — the visible
                                         stroke itself is often only 2-3px, effectively unclickable on
                                         its own (Fable's own design note). -->
                                    <DataTemplate DataType="vm:LineElementViewModel">
                                        <Canvas Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}" ClipToBounds="False">
                                            <Line StartPoint="{Binding CanvasStartPoint}" EndPoint="{Binding CanvasEndPoint}"
                                                  Stroke="Transparent" StrokeThickness="14"
                                                  PointerPressed="OnOverlayElementPointerPressed">
                                                <!-- Task #24: same inline-ContextMenu reasoning as the box
                                                     DataTemplate above — no Fill & Border flyout item (a
                                                     line has no fill; sidebar-only style editing in v1,
                                                     Fable's own scoped-down design), no Add Plate/Set as
                                                     Background items (text/image-only). -->
                                                <Line.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Lock}" ToggleType="CheckBox" IsChecked="{Binding Locked, Mode=TwoWay}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Cut}" InputGesture="Ctrl+X" Command="{Binding CutCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Copy}" InputGesture="Ctrl+C" Command="{Binding CopyCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Paste}" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.CopyStyle}" InputGesture="Ctrl+Shift+C" Command="{Binding CopyStyleCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.PasteStyle}" InputGesture="Ctrl+Shift+V" Command="{Binding PasteStyleCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignToCropMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignLeft}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Left" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignCenter}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Center" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignRight}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Right" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignTop}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Top" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignMiddle}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Middle" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignBottom}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Bottom" />
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Duplicate}" InputGesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.ArrangeMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" Command="{Binding BringToFrontCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringForward}" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendBackward}" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" Command="{Binding SendToBackCommand}" CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.FlattenElement}" Command="{Binding FlattenCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Remove}" InputGesture="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Line.ContextMenu>
                                            </Line>
                                            <Line StartPoint="{Binding CanvasStartPoint}" EndPoint="{Binding CanvasEndPoint}" IsHitTestVisible="False"
                                                  Stroke="{Binding StrokeColor, Converter={x:Static conv:Rgb24ToBrushConverter.Instance}}"
                                                  StrokeThickness="{Binding CanvasStrokeThicknessPixels}"
                                                  Opacity="{Binding Opacity}" />
                                            <!-- 2 endpoint handles, NOT the box's own 8 resize handles (see
                                                 DragMode.LineEndpoint's own doc comment) — same 10x10
                                                 accent-square visual as the box's own corner handles. -->
                                            <Border Canvas.Left="{Binding CanvasStartPoint.X}" Canvas.Top="{Binding CanvasStartPoint.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="Cross" Tag="Endpoint1"
                                                    PointerPressed="OnLineEndpointHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasEndPoint.X}" Canvas.Top="{Binding CanvasEndPoint.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding !Locked}" Cursor="Cross" Tag="Endpoint2"
                                                    PointerPressed="OnLineEndpointHandlePointerPressed" />
                                        </Canvas>
                                    </DataTemplate>
                                    <!-- Phase 2 (spec/15-template-designer.md): third polymorphic branch,
                                         image elements. CanvasBitmap is a cached WriteableBitmap on the
                                         VM itself (rebuilt only when Source changes, not per-frame) —
                                         see ImageElementViewModel's own doc comment. Backlog item
                                         (auditor usability review, 2026-08-17): Stretch now bound via
                                         ImageFitModeToStretchConverter instead of a hardcoded Fill — the
                                         GEOMETRY tab's new image-only Fit row (see that tab, further
                                         down this file) makes Fit user-editable, so the canvas is now
                                         WYSIWYG for Fit mode too, not just position/size. -->
                                    <DataTemplate DataType="vm:ImageElementViewModel">
                                        <Canvas Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}">
                                            <!-- Image has NO explicit Width/Height (code-review nit fixed
                                                 here): the text DataTemplate's own TextBlock above doesn't
                                                 set them either, relying on Border's own default
                                                 Stretch-to-content-area child layout — setting them here
                                                 to the SAME CanvasWidth/HeightPixels as the outer Border
                                                 (which is already inset by its own 1px BorderThickness)
                                                 made the image overflow the border by ~1px right/bottom. -->
                                            <!-- User-reported bug (2026-09-15): IsHitTestVisible bound to
                                                 !BlocksHitTesting (Phase 6, spec/15-template-designer.md)
                                                 used to make a LOCKED backdrop element stop intercepting
                                                 canvas clicks ENTIRELY — that let left-click-drag reach the
                                                 crop rect underneath (the original point), but also meant a
                                                 RIGHT-click fell all the way through to the canvas's own
                                                 empty-area menu instead of opening the backdrop's own
                                                 ("load a background, add an image, Set as backdrop, then
                                                 right-click it" showed the wrong menu even with the mouse
                                                 directly over the backdrop). This Border now stays
                                                 unconditionally hit-testable — right-click always resolves
                                                 to whatever's visually on top, correctly — and
                                                 OnOverlayElementPointerPressed's own code-behind explicitly
                                                 redirects a LEFT-press on a locked backdrop to the crop
                                                 rect's own drag instead (see that method's own comment),
                                                 preserving the original Phase 6 crop-reachability intent
                                                 without also breaking right-click. -->
                                            <Border Width="{Binding CanvasWidthPixels}" Height="{Binding CanvasHeightPixels}"
                                                    BorderBrush="{DynamicResource IndustryAccent}" BorderThickness="1"
                                                    Background="Transparent"
                                                    PointerPressed="OnOverlayElementPointerPressed">
                                                <!-- Task #24: same inline-ContextMenu reasoning as the text
                                                     DataTemplate above, plus Set as Background (image-only).
                                                     Reachable via right-click even when Locked+IsBackground
                                                     (2026-09-15 fix, see this Border's own comment above) -->
                                                <Border.ContextMenu>
                                                    <ContextMenu Classes="Industry">
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Lock}" ToggleType="CheckBox" IsChecked="{Binding Locked, Mode=TwoWay}" />
                                                        <Separator />
                                                        <!-- Round-1 (TX workflow modernization plan): Cut/Copy/Paste wire the
                                                             already-existing element clipboard (Ctrl+C/X/V in
                                                             TxImageEditorPaneView.axaml.cs) — the commands were shipped
                                                             2026-08-17 but never reachable from these menus until now. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Cut}" InputGesture="Ctrl+X" Command="{Binding CutCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Copy}" InputGesture="Ctrl+C" Command="{Binding CopyCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Paste}" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
                                                        <Separator />
                                                        <!-- EditWindow redesign Phase 6: Align to Crop submenu — see the text
                                                             element's own ContextMenu doc comment for the full reasoning. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignToCropMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignLeft}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Left" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignCenter}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Center" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignRight}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Right" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignTop}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Top" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignMiddle}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Middle" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.AlignBottom}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Bottom" />
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Duplicate}" InputGesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.SetAsBackdrop}"
                                                                  ToolTip.Tip="{loc:Translate Panes.TxImageEditor.SetAsBackdrop.Help}"
                                                                  Command="{Binding SetAsBackdropCommand}" CommandParameter="{Binding}" />
                                                        <!-- Background/backdrop naming work (2026-09-15): the demote direction —
                                                             see PromoteBackgroundToBackdrop's own doc comment for the promote side
                                                             on the canvas's own empty-area context menu. IsEnabled binds directly to
                                                             IsBackground (this DataTemplate's own DataContext already IS the element,
                                                             same direct-bind precedent as GrowToFillEnabled/ClearPictureFillMenu on the
                                                             text element's menu) — the command's own CanExecute would refuse a
                                                             non-backdrop element anyway, this just stops the menu item from rendering
                                                             enabled-but-inert. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.DemoteBackdropToBackground}"
                                                                  ToolTip.Tip="{loc:Translate Panes.TxImageEditor.DemoteBackdropToBackground.Help}"
                                                                  Command="{Binding DemoteToBackgroundCommand}" CommandParameter="{Binding}"
                                                                  IsEnabled="{Binding IsBackground}" />
                                                        <!-- User-reported bug (2026-09-15): resetting a LOCKED backdrop to its
                                                             natural size left it in a broken, self-contradictory state —
                                                             still Locked+IsBackground=true (still the frame's backdrop by every
                                                             other check) but no longer covering the frame. IsEnabled binds
                                                             directly to !Locked, same "command's own CanExecute would refuse
                                                             anyway, this just stops the menu item rendering enabled-but-inert"
                                                             reasoning as DemoteBackdropToBackground's own IsEnabled bind above. -->
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.ResetToOriginalSize}"
                                                                  Command="{Binding ResetToOriginalSizeCommand}" CommandParameter="{Binding}"
                                                                  IsEnabled="{Binding !Locked}" />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitStretch}" Command="{Binding FitCommand}" CommandParameter="Stretch" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitContain}" Command="{Binding FitCommand}" CommandParameter="Contain" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.FitCover}" Command="{Binding FitCommand}" CommandParameter="Cover" />
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.ArrangeMenu}">
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" Command="{Binding BringToFrontCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.BringForward}" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendBackward}" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" Command="{Binding SendToBackCommand}" CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.FlattenElement}" Command="{Binding FlattenCommand}" CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Translate Panes.TxImageEditor.Remove}" InputGesture="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <!-- TX editor gap-items plan, item 3 (perspective transform) —
                                                     Border.Child can only hold ONE control, so the plain and
                                                     warped visuals live as 2 IsVisible-toggled siblings inside
                                                     a Grid wrapper (both occupy the same single cell). -->
                                                <Grid>
                                                    <Image Source="{Binding CanvasBitmap}"
                                                           Stretch="{Binding Fit, Converter={x:Static conv:ImageFitModeToStretchConverter.Instance}}"
                                                           IsHitTestVisible="False" IsVisible="{Binding !PerspectiveEnabled}" />
                                                    <!-- Stretch="Fill" hardcoded, not bound to Fit — the warp
                                                         render always fills the quad exactly, ignoring Fit
                                                         entirely (see RenderWarpedElementPreview's own
                                                         contract). -->
                                                    <Image Source="{Binding WarpedCanvasBitmap}" Stretch="Fill"
                                                           IsHitTestVisible="False" IsVisible="{Binding PerspectiveEnabled}" />
                                                </Grid>
                                            </Border>
                                            <Border Canvas.Left="0" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="TopLeftCorner" Tag="TopLeft"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="TopSide" Tag="Top"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="0"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="TopRightCorner" Tag="TopRight"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="RightSide" Tag="Right"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="BottomRightCorner" Tag="BottomRight"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasWidthPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="BottomSide" Tag="Bottom"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="0" Canvas.Top="{Binding CanvasHeightPixels}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="BottomLeftCorner" Tag="BottomLeft"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <Border Canvas.Left="0" Canvas.Top="{Binding CanvasHeightPixels, Converter={x:Static conv:DoubleToHalfConverter.Instance}}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowResizeHandles}" Cursor="LeftSide" Tag="Left"
                                                    PointerPressed="OnElementResizeHandlePointerPressed" />
                                            <!-- TX editor gap-items plan, item 3 — 4 perspective-corner
                                                 handles, same shape as the box DataTemplate's own identical
                                                 set above. -->
                                            <Border Canvas.Left="{Binding CanvasCorner0Point.X}" Canvas.Top="{Binding CanvasCorner0Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner0"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasCorner1Point.X}" Canvas.Top="{Binding CanvasCorner1Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner1"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasCorner2Point.X}" Canvas.Top="{Binding CanvasCorner2Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner2"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                            <Border Canvas.Left="{Binding CanvasCorner3Point.X}" Canvas.Top="{Binding CanvasCorner3Point.Y}"
                                                    RenderTransform="translate(-5px, -5px)"
                                                    Width="10" Height="10"
                                                    Background="{DynamicResource IndustryAccent}"
                                                    IsVisible="{Binding ShowPerspectiveCornerHandles}" Cursor="Cross" Tag="Corner3"
                                                    PointerPressed="OnPerspectiveCornerHandlePointerPressed" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>

                            <!-- design-fidelity Phase E (#15, mockups/Editwindow line 108): selection
                                 readout badge — positioned via the same Canvas.Left/Top + LeftPixels/
                                 TopPixels convention every overlay element already uses (no ancestor
                                 transform in this coordinate space, see Phase 7's own doc comment), a
                                 negative Margin shifts it up above the element's own top edge without
                                 needing subtraction inside the binding (no arithmetic-in-binding
                                 converter exists in this codebase for that). A sibling of
                                 OverlayElementsHost, not inside its DataTemplate — this is ONE badge
                                 for the current selection, not a per-item template concern.
                                 User-requested (2026-09-16): now also a drag handle for the selected
                                 element (same as clicking the element's own body) — IsHitTestVisible
                                 was False before, so clicking this badge did nothing. Not Locked-gated
                                 here in AXAML (OnSelectionReadoutBadgePointerPressed's own shared
                                 StartElementMoveDrag helper already re-checks Locked, same real-gate
                                 convention as every other drag entry point in this file). yoniq-auditor
                                 finding: Margin was -20 (unchanged since the badge's own first design-
                                 fidelity pass, when it was purely decorative) — now that it's a real
                                 hit-test target too, that overlapped the element's own top/top-left/
                                 top-right resize handles (10x10, centered on the element's own top
                                 edge, so spanning [top-5, top+5]) at the Large font-size preset, where
                                 the badge's own rendered height grows to ~21px. -28 keeps the badge's
                                 own bottom edge above that band at both font-size presets. -->
                            <Border x:Name="SelectionReadoutBadge"
                                    Canvas.Left="{Binding SelectedOverlayElement.LeftPixels}"
                                    Canvas.Top="{Binding SelectedOverlayElement.TopPixels}"
                                    Margin="0,-28,0,0" Padding="4,2" Cursor="SizeAll"
                                    Background="{DynamicResource IndustryAccent}"
                                    IsVisible="{Binding SelectedOverlayElement, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    PointerPressed="OnSelectionReadoutBadgePointerPressed">
                                <TextBlock Text="{Binding SelectionReadoutText}" FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="{DynamicResource IndustryTxSelectionReadoutFontSize}" Foreground="{DynamicResource IndustryBg}" />
                            </Border>

                            <!-- Follow-up visual-polish pass: live rubber-band preview (draw-to-place)
                                 and alignment guide lines, the two known gaps Phase 3a/3c's own doc
                                 comments tracked. Declared LAST (topmost Z-order on a Canvas) so they
                                 render over every element/crop-rect/grid/safe-area guide already
                                 above. IsHitTestVisible="False" on all three — transient display only,
                                 must never intercept a pointer event meant for the crop/element/
                                 resize-handle hit-testing underneath.
                                 Differentiated from the existing IndustryAccent overlays already on
                                 this canvas (grid: solid 1px @0.3, safe-area: dashed 1px @0.55) by
                                 full opacity + 2px, so a live guide/preview always reads as the
                                 brightest thing on screen, not a coincidental grid line. Dashed for
                                 the rubber band (distinguishes it from the crop rect's own solid 2px
                                 border, the only other IndustryAccent RECTANGLE on this canvas); solid
                                 for the guide lines (matches every mainstream design tool's own smart-
                                 guide convention, and there's no other full-span LINE on this canvas
                                 to be confused with). -->
                            <Rectangle IsHitTestVisible="False"
                                       Canvas.Left="{Binding PlacementPreviewLeftPixels}"
                                       Canvas.Top="{Binding PlacementPreviewTopPixels}"
                                       Width="{Binding PlacementPreviewWidthPixels}"
                                       Height="{Binding PlacementPreviewHeightPixels}"
                                       IsVisible="{Binding IsPlacementPreviewVisible}"
                                       Stroke="{DynamicResource IndustryAccent}" StrokeThickness="2" StrokeDashArray="4,2" />
                            <!-- TX editor gap-items plan, line element — the line counterpart to the
                                 rubber-band Rectangle immediately above (see PlacementPreviewLine's
                                 own doc comment on the VM for why a Rectangle can't represent a
                                 line's direction). Same dashed-2px styling. -->
                            <Line IsHitTestVisible="False"
                                  StartPoint="{Binding PlacementPreviewLineStart}"
                                  EndPoint="{Binding PlacementPreviewLineEnd}"
                                  IsVisible="{Binding IsPlacementPreviewLineVisible}"
                                  Stroke="{DynamicResource IndustryAccent}" StrokeThickness="2" StrokeDashArray="4,2" />
                            <Rectangle IsHitTestVisible="False"
                                       Canvas.Left="{Binding GuideLineXPixels}" Canvas.Top="0"
                                       Width="2" Height="{Binding CanvasDisplayHeight}"
                                       IsVisible="{Binding IsGuideLineXVisible}"
                                       Fill="{DynamicResource IndustryAccent}" />
                            <Rectangle IsHitTestVisible="False"
                                       Canvas.Left="0" Canvas.Top="{Binding GuideLineYPixels}"
                                       Width="{Binding CanvasDisplayWidth}" Height="2"
                                       IsVisible="{Binding IsGuideLineYVisible}"
                                       Fill="{DynamicResource IndustryAccent}" />

                        </Canvas>

                        <!-- Design-fidelity Phase C (mockups/Editwindow line 99): a thin frame around
                             the working-copy bounds. The mock's own 4 corner "+" marks (lines
                             127-128) are DELIBERATELY NOT built here, not silently dropped — tried
                             first, but this ScrollViewer clips its content to its own viewport (same
                             mechanism Phase A's panel-title fix worked around), which forces any mark
                             positioned at the frame's true edge to render ON TOP of the photo itself
                             rather than on neutral chrome outside it (unlike the mock, whose outer
                             frame always has padding/neutral background around the photo). A subtle
                             muted-gray "+" against arbitrary photo content is unreliable — sometimes
                             invisible, sometimes fine — so it's a real functional regression risk
                             for a purely decorative element. Fixing this properly needs padding
                             around the working copy inside the well (a real, if small, layout change,
                             not attempted in this pass). IsHitTestVisible="False" — decorative,
                             must not steal crop/element pointer events. -->
                        <Border Width="{Binding CanvasDisplayWidth}" Height="{Binding CanvasDisplayHeight}"
                                BorderBrush="{DynamicResource IndustryChromeBorder}" BorderThickness="1"
                                IsHitTestVisible="False" />

                        </Panel>
                    </ScrollViewer>

                    <!-- Footer hint lines (mockups/Editwindow lines 130-131): bottom-left crop
                         dims/lock state, bottom-right working-copy/render size. Pinned to the WELL
                         (this outer Panel, a sibling of the ScrollViewer) — see this region's own
                         Phase H doc comment above for why these moved out of the scrolled/zoomed
                         content they used to live inside. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,6" IsHitTestVisible="False">
                        <TextBlock Classes="IndustryRowLabel" Text="{Binding CropFooterText}" />
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.LockedToModeSuffix}" IsVisible="{Binding LockAspectToMode}" />
                    </StackPanel>
                    <TextBlock Classes="IndustryRowLabel" Text="{Binding WorkingCopyFooterText}" IsHitTestVisible="False"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                    </Panel>
                    </Border>

                </DockPanel>

                <!-- Side panel: real pipeline preview (mode-exact pixels, nearest-neighbor upscaled for
                     display so low-res SSTV fidelity is visible, not smoothed away) + the overlay
                     element list with numeric X/Y fields (legacy's own real precedent for text
                     placement precision, TextIn.h's SEX/SEY fields), alongside free drag, plus mock2
                     scaffolding cards below (Insert field/Text style/Saved templates) — each a nested
                     (non-blueprint) group box, same "gb inside gb blueprint" nesting as the Receive
                     tab's Incoming-frame/Previous-frames pair. -->
                <!-- design-fidelity Phase E (#6): outer ScrollViewer+StackPanel replaced with a
                     Grid RowDefinitions="Auto,Auto,*" — PREVIEW/ELEMENTS stay Auto-height, INSPECTOR
                     fills whatever height remains (mock's own right-column proportions leave
                     INSPECTOR filling the card's bottom, not ~450px of dead space below a
                     short-content ScrollViewer). Same rail-column restructuring pattern as design-
                     fidelity Phase D's READY RACK/TEMPLATE LIBRARY split — INSPECTOR now owns its
                     own internal ScrollViewer (below) instead of the whole column sharing one. -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource IndustrySpacingGroup}" Margin="0,6,12,0">

                    <!-- Margin right of 12 (outer Grid, above) clears Fluent's overlay vertical
                         scrollbar (it floats over content rather than reserving a column) —
                         confirmed via real-window testing that without this, the scrollbar thumb
                         visually overlaps and silently eats clicks on the right-edge Save button
                         (Phase 5). Margin top=6 (Phase A design-fidelity fix): same first-card
                         title-notch clip fix as the rail column above. -->
                    <HeaderedContentControl Grid.Row="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.PreviewLabel}" />
                        </HeaderedContentControl.Header>
                        <!-- design-fidelity Phase H (final confirming pass finding #6): MaxHeight
                             bound to the real target mode height (was hardcoded 200), so a 256-line
                             mode's mode-exact preview renders literal 1:1 as the mock does, instead
                             of always being downscaled to 78%. -->
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               MaxHeight="{Binding PreviewMaxHeight}"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </HeaderedContentControl>

                    <!-- ELEMENTS panel (EditWindow redesign Phase 2, mockups/Editwindow): header
                         action group (Front/Back/Duplicate/Remove, acting on whatever is currently
                         selected — CommandParameter="{Binding SelectedOverlayElement}" reaches the
                         pane VM's own property since this Grid's DataContext is the pane itself, not
                         a per-element DataTemplate) + an insert row (+Text/+Image/+Box, reusing the
                         SAME AddOverlayElement/AddBoxElement commands and Add-Image flyout the
                         toolbar already had) + compact single-line rows below (type badge, name/text
                         preview, z-index, Lock toggle) — replaces the old bulky per-element card
                         (X/Y/W/H TextBoxes + a stack of buttons stacked vertically). Numeric
                         X/Y/W/H moves to the new GEOMETRY inspector tab (task #27, a later sub-phase
                         of this same redesign) — not dropped, just relocated; deliberately NOT
                         removed from here until that tab actually ships, to avoid a real gap where
                         numeric placement is briefly unreachable from anywhere.
                         [Deferred, noted not silently dropped] Two mock behaviors NOT built in this
                         pass: (1) the "V" (visible/hidden) toggle — genuinely new VM state, no
                         IsVisible/Hidden concept exists anywhere in this codebase's element model
                         today; (2) click-a-row-to-select / highlighting the selected row — the
                         canvas's own existing click-to-select already covers the core workflow
                         (selection is shared VM state, so a canvas click already updates what THIS
                         list implicitly reflects via its Lock/Front/Back state), row-click is a
                         smaller, separable follow-up. -->
                    <!-- design-fidelity Phase F (#8): the plan's own original text called for moving
                         this action group ONTO THE SAME LINE as the "ELEMENTS" title (mock's own
                         flex header bar, title-left/actions-right). Not achievable with this shared
                         IndustryGroupBoxTheme: its title tab is a floating, Left/Top-aligned Border
                         sized purely to its own Header content (see Phase E's own doc comment on the
                         READY RACK/TEMPLATE LIBRARY headers for the first time this was hit) — it
                         never stretches to the card's real width, so there is no "right edge of the
                         card" for a right-aligned action group inside Header to hug. Kept as today's
                         top-of-content row (already right-aligned) instead of a deeper theme change
                         that would ripple to every other panel using this same template. -->
                    <HeaderedContentControl Grid.Row="1" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.ElementsHeader}" />
                        </HeaderedContentControl.Header>
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource IndustrySpacingTight}">
                                <!-- design-fidelity Phase H (final confirming pass finding #1): these
                                     4 IndustryBtn21 buttons had no Padding override, unlike every
                                     other IndustryBtn call site in this file — Fluent's default
                                     vertical button padding ate the line box at this 21px/10.5pt
                                     size, vertically clipping the glyphs (confirmed via a real-window
                                     zoom: a straight cut ~7px inside the button's own border). Phase
                                     A's own fix here was horizontal only (DUPLICATE->DUP); this is
                                     the separate vertical clip that fix didn't touch. -->
                                <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="{DynamicResource IndustryTxHeaderBtnPadding}"
                                        Content="{loc:Translate Panes.TxImageEditor.BringToFront}"
                                        Command="{Binding BringToFrontCommand}" CommandParameter="{Binding SelectedOverlayElement}"
                                        ToolTip.Tip="{loc:Translate Panes.TxImageEditor.BringToFrontMenu}" />
                                <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="{DynamicResource IndustryTxHeaderBtnPadding}"
                                        Content="{loc:Translate Panes.TxImageEditor.SendToBack}"
                                        Command="{Binding SendToBackCommand}" CommandParameter="{Binding SelectedOverlayElement}"
                                        ToolTip.Tip="{loc:Translate Panes.TxImageEditor.SendToBackMenu}" />
                                <!-- Phase A design-fidelity fix: dedicated Header-action keys
                                     (DuplicateHeaderAction/RemoveHeaderAction), NOT the shared
                                     Duplicate/Remove keys the context menu (Task #24) also binds —
                                     those stay sentence-case matching the mock's own context-menu
                                     convention, while these compact 21px header buttons need the
                                     mock's own abbreviated DUP/DEL to avoid clipping ("DUPLICATE"
                                     visibly overflowed this button width at this font size). -->
                                <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="{DynamicResource IndustryTxHeaderBtnPadding}"
                                        Content="{loc:Translate Panes.TxImageEditor.DuplicateHeaderAction}"
                                        Command="{Binding DuplicateCommand}" />
                                <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="{DynamicResource IndustryTxHeaderBtnPadding}"
                                        Content="{loc:Translate Panes.TxImageEditor.RemoveHeaderAction}"
                                        Command="{Binding RemoveOverlayElementCommand}" CommandParameter="{Binding SelectedOverlayElement}" />
                            </StackPanel>
                            <!-- design-fidelity Phase F (#8): StackPanel -> UniformGrid. A Button's
                                 own HorizontalAlignment="Stretch" is a no-op on a StackPanel's stack
                                 axis (Orientation="Horizontal" here means Width, the axis Stretch
                                 can't affect) — confirmed real, the 3 buttons rendered at their own
                                 content-driven widths, not equal thirds. UniformGrid genuinely divides
                                 its own width into N equal columns, which Stretch then fills. -->
                            <UniformGrid Columns="4">
                                <!-- TX workflow modernization plan, Phase 3a: draw-to-place. NOT a
                                     Command binding — pointer-press handling instead, so Shift
                                     (sticky placement) is readable via KeyModifiers at arm time,
                                     which a plain Click event carries no way to see. Clicking this
                                     button arms the tool (crosshair cursor); the actual element is
                                     created by a canvas press/release, not by this button itself. No
                                     PointerPressed="..." attribute here — see the code-behind
                                     constructor's AddHandler(..., RoutingStrategies.Tunnel) calls for
                                     this button and the other 2 below (a plain bubbling attribute
                                     never fires on a Button, see that call site's own comment). -->
                                <Button x:Name="AddTextButton" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                                        Content="{loc:Translate Panes.TxImageEditor.AddText}" />
                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                                        Content="{loc:Translate Panes.TxImageEditor.AddImage}">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Spacing="4" MinWidth="180">
                                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{loc:Translate Panes.TxImageEditor.AddImageFromFile}"
                                                        Command="{Binding AddImageFromFileCommand}" />
                                                <!-- Auditor usability review follow-up (2026-08-18):
                                                     4th source, clipboard paste — Phase 2's own
                                                     logged scope cut ("zero precedent for either
                                                     [clipboard-paste/OS drag-drop] anywhere in this
                                                     codebase"), picked back up now that
                                                     ClipboardExtensions.TryGetBitmapAsync gives a
                                                     real, cross-platform precedent. Silently no-ops
                                                     (no toast/dialog) if there's nothing image-shaped
                                                     on the clipboard — same "nothing to add yet"
                                                     shape as AddLastRxImageCommand's own empty-buffer
                                                     case just below. -->
                                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{loc:Translate Panes.TxImageEditor.AddImageFromClipboard}"
                                                        Command="{Binding AddImageFromClipboardCommand}" />
                                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{loc:Translate Panes.TxImageEditor.AddImageFromLastRx}"
                                                        Command="{Binding AddLastRxImageCommand}" />
                                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{loc:Translate Panes.TxImageEditor.AddImageFromRxHistory}"
                                                        Command="{Binding RefreshRxHistoryPickerCommand}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="RightEdgeAlignedTop">
                                                            <ScrollViewer MaxHeight="280">
                                                                <ItemsControl ItemsSource="{Binding RxHistoryPickerEntries}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="vm:TxImageEditorPaneViewModel+RxHistoryPickerEntry">
                                                                            <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary"
                                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                    Margin="0,0,0,2"
                                                                                    Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <Image Source="{Binding Thumbnail}" Width="32" Height="32" Stretch="Uniform" />
                                                                                    <TextBlock Text="{Binding ReceivedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <!-- Same reasoning as the AddText button above. -->
                                <Button x:Name="AddBoxButton" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                                        Content="{loc:Translate Panes.TxImageEditor.ToolBox}" />
                                <!-- TX editor gap-items plan, line element — same draw-to-place
                                     reasoning as the AddText button above. -->
                                <Button x:Name="AddLineButton" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.ToolLine}" />
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding OverlayElements}">
                                <!-- Phase 1: polymorphic per-type DataTemplates (same technique as the
                                     canvas ItemsControl above) — geometry/lock/reorder/etc. now live
                                     on the header action group and the (future) GEOMETRY tab, not
                                     duplicated per row; extending/replacing the original Phase 1 row
                                     layout, not a separate new panel. -->
                                <!-- Backlog item (auditor usability review, 2026-08-17, item 13):
                                     "ELEMENTS rows don't select or highlight on click." Each row Grid
                                     dynamically toggles the "elementRowSelected" class off
                                     IsSelected (ITemplateElementViewModel.IsSelected, parent-pushed by
                                     TxImageEditorPaneViewModel.OnSelectedOverlayElementChanged) —
                                     this Style just supplies the visual for that class, reusing the
                                     same accent-tint tokens the context bar's own UNSAVED EDITS chip
                                     already established for "this is currently true." -->
                                <ItemsControl.Styles>
                                    <Style Selector="Grid.elementRowSelected">
                                        <Setter Property="Background" Value="{DynamicResource IndustrySelectTint}" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:OverlayElementViewModel">
                                        <Grid ColumnDefinitions="26,*,Auto,20,20,20" Margin="0,0,0,2"
                                              Classes.elementRowSelected="{Binding IsSelected}"
                                              PointerPressed="OnElementRowPointerPressed">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.TypeBadgeText}" />
                                            <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding Text}" IsEnabled="{Binding !Locked}" Margin="2,0" />
                                            <TextBlock Grid.Column="2" Classes="IndustryRowLabel" VerticalAlignment="Center" Margin="4,0" Text="{Binding Z, StringFormat='z{0}'}" />
                                            <ToggleButton Grid.Column="3" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0"
                                                          IsChecked="{Binding Locked}" Content="{loc:Translate Panes.TxImageEditor.LockGlyph}" HorizontalContentAlignment="Center"
                                                          ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Lock}" />
                                            <!-- TX workflow modernization plan, Phase 8: layers-list/
                                                 context-menu parity, so the two surfaces don't drift
                                                 apart again — that drift is exactly how the old Font-
                                                 Size/Text-Color preset inconsistency happened. Same
                                                 parent-pushed DuplicateCommand the context menu's own
                                                 Duplicate item binds — parameterless (reads
                                                 SelectedOverlayElement), safe here because this row's
                                                 own Grid.PointerPressed (OnElementRowPointerPressed)
                                                 already selects THIS element before any child
                                                 button's Click fires, same "any button in the row
                                                 selects first" precedent RemoveCommand's own comment
                                                 below already documents. -->
                                            <Button Grid.Column="4" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.DuplicateRowGlyph}"
                                                    Command="{Binding DuplicateCommand}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Duplicate}" />
                                            <!-- Backlog item (user request, 2026-08-17): per-row delete, no
                                                 header-group-only path needed. RemoveCommand is the SAME
                                                 parent-pushed instance the context menu's own Remove item
                                                 already binds — CommandParameter="{Binding}" resolves
                                                 against this row's own DataContext (the element itself,
                                                 not SelectedOverlayElement), matching that item's own
                                                 precedent exactly. -->
                                            <Button Grid.Column="5" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.RemoveRowGlyph}"
                                                    Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Remove}" />
                                        </Grid>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:BoxElementViewModel">
                                        <Grid ColumnDefinitions="26,*,Auto,20,20,20" Margin="0,0,0,2"
                                              Classes.elementRowSelected="{Binding IsSelected}"
                                              PointerPressed="OnElementRowPointerPressed">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.TypeBadgeBox}" />
                                            <TextBlock Grid.Column="1" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.ToolBox}" />
                                            <TextBlock Grid.Column="2" Classes="IndustryRowLabel" VerticalAlignment="Center" Margin="4,0" Text="{Binding Z, StringFormat='z{0}'}" />
                                            <ToggleButton Grid.Column="3" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0"
                                                          IsChecked="{Binding Locked}" Content="{loc:Translate Panes.TxImageEditor.LockGlyph}" HorizontalContentAlignment="Center"
                                                          ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Lock}" />
                                            <!-- TX workflow modernization plan, Phase 8: layers-list/
                                                 context-menu parity, so the two surfaces don't drift
                                                 apart again — that drift is exactly how the old Font-
                                                 Size/Text-Color preset inconsistency happened. Same
                                                 parent-pushed DuplicateCommand the context menu's own
                                                 Duplicate item binds — parameterless (reads
                                                 SelectedOverlayElement), safe here because this row's
                                                 own Grid.PointerPressed (OnElementRowPointerPressed)
                                                 already selects THIS element before any child
                                                 button's Click fires, same "any button in the row
                                                 selects first" precedent RemoveCommand's own comment
                                                 below already documents. -->
                                            <Button Grid.Column="4" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.DuplicateRowGlyph}"
                                                    Command="{Binding DuplicateCommand}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Duplicate}" />
                                            <!-- Backlog item (user request, 2026-08-17): per-row delete, no
                                                 header-group-only path needed. RemoveCommand is the SAME
                                                 parent-pushed instance the context menu's own Remove item
                                                 already binds — CommandParameter="{Binding}" resolves
                                                 against this row's own DataContext (the element itself,
                                                 not SelectedOverlayElement), matching that item's own
                                                 precedent exactly. -->
                                            <Button Grid.Column="5" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.RemoveRowGlyph}"
                                                    Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Remove}" />
                                        </Grid>
                                    </DataTemplate>
                                    <!-- TX editor gap-items plan, line element — 4th polymorphic branch,
                                         mirroring the box row immediately above exactly (same column
                                         layout/lock/duplicate/remove wiring). -->
                                    <DataTemplate DataType="vm:LineElementViewModel">
                                        <Grid ColumnDefinitions="26,*,Auto,20,20,20" Margin="0,0,0,2"
                                              Classes.elementRowSelected="{Binding IsSelected}"
                                              PointerPressed="OnElementRowPointerPressed">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.TypeBadgeLine}" />
                                            <TextBlock Grid.Column="1" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.ToolLine}" />
                                            <TextBlock Grid.Column="2" Classes="IndustryRowLabel" VerticalAlignment="Center" Margin="4,0" Text="{Binding Z, StringFormat='z{0}'}" />
                                            <ToggleButton Grid.Column="3" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0"
                                                          IsChecked="{Binding Locked}" Content="{loc:Translate Panes.TxImageEditor.LockGlyph}" HorizontalContentAlignment="Center"
                                                          ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Lock}" />
                                            <Button Grid.Column="4" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.DuplicateRowGlyph}"
                                                    Command="{Binding DuplicateCommand}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Duplicate}" />
                                            <Button Grid.Column="5" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.RemoveRowGlyph}"
                                                    Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Remove}" />
                                        </Grid>
                                    </DataTemplate>
                                    <!-- Phase 2: third polymorphic branch, image elements — WITHOUT this,
                                         an inserted image would still render fine on the canvas (that
                                         ItemsControl has its own separate 3rd DataTemplate above) but show
                                         as an uncontrollable fallback row here — real-window-review-caught
                                         bug class from Phase 1, avoided here by doing both in the same pass.
                                         "Set as background" has no room in the compact row (it's
                                         image-only and not part of the shared header group) — reachable
                                         via the row's own context menu instead (Task #24, already ships
                                         this item). -->
                                    <DataTemplate DataType="vm:ImageElementViewModel">
                                        <Grid ColumnDefinitions="26,*,Auto,20,20,20,20,20" Margin="0,0,0,2"
                                              Classes.elementRowSelected="{Binding IsSelected}"
                                              PointerPressed="OnElementRowPointerPressed">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.TypeBadgeImage}" />
                                            <TextBlock Grid.Column="1" Classes="IndustryRowValue" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxImageEditor.AddImage}" />
                                            <TextBlock Grid.Column="2" Classes="IndustryRowLabel" VerticalAlignment="Center" Margin="4,0" Text="{Binding Z, StringFormat='z{0}'}" />
                                            <ToggleButton Grid.Column="3" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0"
                                                          IsChecked="{Binding Locked}" Content="{loc:Translate Panes.TxImageEditor.LockGlyph}" HorizontalContentAlignment="Center"
                                                          ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Lock}" />
                                            <!-- User-reported gap (2026-09-15): a LOCKED backdrop element has
                                                 IsHitTestVisible="{Binding !BlocksHitTesting}" = False on the
                                                 canvas's own Border for it (pre-existing, documented limitation,
                                                 see that Border's own comment) — right-click on a backdrop
                                                 falls through to whatever's underneath (the crop rect / canvas
                                                 empty-area menu) instead of reaching the backdrop's own
                                                 SetAsBackdrop/DemoteToBackground/Remove menu. This row is NOT
                                                 gated by canvas hit-testing at all, so it's the reliable place
                                                 to reach them — same Phase 8 "layers-list/context-menu parity"
                                                 precedent Duplicate/Remove above already established, applied
                                                 to the promote/demote pair specifically because THIS pair is
                                                 the one the canvas menu can silently lose access to. Two
                                                 mutually-exclusive buttons (not a converter), same glyph — a
                                                 raw IsChecked TwoWay bind to IsBackground itself would skip
                                                 the geometry/invariant side effects only SetAsBackdropCommand/
                                                 DemoteToBackgroundCommand perform. Each gets its OWN column,
                                                 not a shared one — an earlier draft had these two buttons
                                                 share one column instead; see the dedicated comment on the
                                                 demote button below for why that changed (the real cause was
                                                 a stale test reference, not Grid.Column overlap itself). -->
                                            <Button Grid.Column="4" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.BackdropRowGlyph}"
                                                    Command="{Binding SetAsBackdropCommand}" CommandParameter="{Binding}"
                                                    IsVisible="{Binding IsNotBackground}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.SetAsBackdrop.Help}" />
                                            <!-- Real-window test finding (2026-09-15, ImageElementLayersRow_BackdropToggleButtons...):
                                                 an earlier draft had this button share ONE Grid.Column
                                                 with the promote button above via complementary IsVisible
                                                 bindings. auditor correction: Grid.Column overlap was NOT
                                                 the actual cause of the reactivity failure that draft hit
                                                 (Grid attached properties don't affect binding reactivity)
                                                 — the real cause was the TEST holding a Button reference
                                                 captured BEFORE SetAsBackdropCommand's own
                                                 OverlayElements.Move(index, 0) call, which detaches/rebuilds
                                                 the row's container even for a same-index move; a FRESH
                                                 query after the move saw the correct state all along (see
                                                 that test's own doc comment). Kept on its own dedicated
                                                 column anyway — no correctness reason to revert, and it
                                                 reads more clearly than two controls sharing one cell. -->
                                            <Button Grid.Column="5" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.BackdropRowGlyph}"
                                                    Command="{Binding DemoteToBackgroundCommand}" CommandParameter="{Binding}"
                                                    IsVisible="{Binding IsBackground}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.DemoteBackdropToBackground.Help}" />
                                            <!-- TX workflow modernization plan, Phase 8: layers-list/
                                                 context-menu parity, so the two surfaces don't drift
                                                 apart again — that drift is exactly how the old Font-
                                                 Size/Text-Color preset inconsistency happened. Same
                                                 parent-pushed DuplicateCommand the context menu's own
                                                 Duplicate item binds — parameterless (reads
                                                 SelectedOverlayElement), safe here because this row's
                                                 own Grid.PointerPressed (OnElementRowPointerPressed)
                                                 already selects THIS element before any child
                                                 button's Click fires, same "any button in the row
                                                 selects first" precedent RemoveCommand's own comment
                                                 below already documents. -->
                                            <Button Grid.Column="6" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.DuplicateRowGlyph}"
                                                    Command="{Binding DuplicateCommand}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Duplicate}" />
                                            <!-- Backlog item (user request, 2026-08-17): per-row delete, no
                                                 header-group-only path needed. RemoveCommand is the SAME
                                                 parent-pushed instance the context menu's own Remove item
                                                 already binds — CommandParameter="{Binding}" resolves
                                                 against this row's own DataContext (the element itself,
                                                 not SelectedOverlayElement), matching that item's own
                                                 precedent exactly. Reachable here regardless of Locked/
                                                 IsBackground — unlike the canvas's own context menu, this
                                                 row is never gated by canvas hit-testing, so it's the
                                                 reliable way to remove a backdrop element (2026-09-15). -->
                                            <Button Grid.Column="7" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Width="{DynamicResource IndustryMiniIconButtonSize}" Height="{DynamicResource IndustryMiniIconButtonSize}" Padding="0" Margin="2,0,0,0"
                                                    Content="{loc:Translate Panes.TxImageEditor.RemoveRowGlyph}"
                                                    Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Remove}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Phase 4 (spec/15-template-designer.md): real, selection-tracking-driven
                         controls replacing the 3 fake rows above (font/size, fill/stroke, plate).
                         Bound via path bindings through SelectedTextElement (a computed property on
                         THIS view's own DataContext, narrowed from SelectedOverlayElement) rather
                         than a nested DataContext override — keeps every control reachable via a
                         plain path binding, no $parent/DataContext-override complexity to fight the
                         "$parent[ItemsControl].((vm:Type)DataContext)..." binding-path crash this
                         codebase has already hit elsewhere (see ITemplateElementViewModel.RemoveCommand's
                         own doc comment) — not the same shape here (this isn't inside an
                         ItemsControl DataTemplate), but the same simpler-binding preference applies. -->
                    <!-- EditWindow redesign Phase 3 (mockups/Editwindow): TEXT STYLE (Phase 4/8's own
                         content, unchanged) is now one of three tabs — GEOMETRY (new, this phase:
                         numeric X/Y/W/H + align-to-crop) and IMAGE (the 6 adjustment sliders,
                         relocated here from below the canvas) join it. Three plain bool
                         ObservableProperty flags drive tab selection (see
                         TxImageEditorPaneViewModel.IsTextStyleTabSelected's own doc comment for why
                         not an enum+converter) — Button.Click-style Commands, not a real TabControl,
                         to keep every tab's own content a plain IsVisible-gated StackPanel (matches
                         this file's own established preference for simple path bindings over
                         template/selector machinery elsewhere). -->
                    <HeaderedContentControl Grid.Row="2" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.InspectorHeader}" />
                        </HeaderedContentControl.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                            <!-- design-fidelity Phase E (#4): converted from a plain Button strip
                                 (no active-state feedback at all) to RadioButton.IndustrySeg — an
                                 already-existing, purpose-built "segmented control" atom (tint fill +
                                 border + bold text on :checked), same GroupName + direct TwoWay
                                 IsChecked-to-bool convention already used by the Waterfall view-mode
                                 selector (MainWindow.axaml) and the RX/TX Auto/Manual selectors —
                                 no new style needed, and mutual exclusivity comes for free from
                                 GroupName + the three existing IsTextStyleTabSelected/
                                 IsGeometryTabSelected/IsImageTabSelected bools (unchanged from
                                 Phase 3), matching that established pattern exactly rather than also
                                 keeping the old SelectXTabCommand wiring (still real, tested VM APIs —
                                 just no longer the AXAML's own interaction path, same as those other
                                 3 call sites). -->
                            <!-- design-fidelity Phase H (final confirming pass finding #2): StackPanel
                                 -> UniformGrid + the "stretched" IndustrySeg variant (same fix Phase F
                                 already applied to the ELEMENTS panel's +TEXT/+IMAGE/+BOX row for the
                                 identical StackPanel-Stretch-is-a-no-op reason). Mock's own tab strip
                                 is 3 equal flex:1 segments spanning the panel's full width; this was
                                 3 content-width buttons occupying roughly half the panel with gaps. -->
                            <UniformGrid Columns="3">
                                <RadioButton Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="InspectorTab"
                                             IsChecked="{Binding IsTextStyleTabSelected}"
                                             Content="{loc:Translate Panes.TxImageEditor.InspectorTabText}" />
                                <RadioButton Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="InspectorTab"
                                             IsChecked="{Binding IsGeometryTabSelected}"
                                             Content="{loc:Translate Panes.TxImageEditor.InspectorTabGeometry}" />
                                <RadioButton Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="InspectorTab"
                                             IsChecked="{Binding IsImageTabSelected}"
                                             Content="{loc:Translate Panes.TxImageEditor.InspectorTabImage}" />
                            </UniformGrid>

                    <StackPanel Classes="Industry IndustryRows" IsVisible="{Binding IsTextStyleTabSelected}">
                            <!-- design-fidelity Phase H (final confirming pass finding #5): same
                                 IndustryRowValue->IndustryRowLabel fix — empty-state prose, not a
                                 value cell. -->
                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.NoTextSelected}"
                                       IsVisible="{Binding SelectedTextElement, Converter={x:Static ObjectConverters.IsNull}}" />
                            <StackPanel Spacing="{StaticResource IndustrySpacingTight}"
                                        IsVisible="{Binding SelectedTextElement, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontFamilyLabel}" />
                                    <ComboBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding FontFamilyPickerItems}"
                                              SelectedItem="{Binding SelectedTextElement.FontFamily}" />
                                    <!-- Phase 6: warning glyph, visible only when the selected text
                                         element's own FontFamily isn't one of this build's real
                                         bundled families (see IsFontUnavailable's own doc comment) —
                                         the transmitted image silently falls back to the default font
                                         in this case, with nothing else in this panel indicating it. -->
                                    <TextBlock Grid.Column="2" Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontUnavailableGlyph}" Margin="4,0,0,0"
                                               Foreground="{DynamicResource IndustryDanger}"
                                               IsVisible="{Binding IsFontUnavailable}"
                                               ToolTip.Tip="{loc:Translate Panes.TxImageEditor.FontUnavailableWarning}" />
                                </Grid></Border>
                                <!-- Auditor usability review follow-up (2026-08-18): "missing yoniq
                                     text effects" (from the user's original 2026-08-16 checklist —
                                     color/shadow/gradient/rotation shipped in Phase 4/8, bold/italic
                                     never started). Requires a real bundled Bold/Italic font FILE for
                                     the selected family (see FontSpec's own doc comment) — both
                                     bundled families (DejaVu Sans Mono, Barlow) now have all 4
                                     weight/style variants vendored, so this is always reachable for
                                     either. -->
                                <Border Classes="IndustryRow"><StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingGroup}">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.BoldLabel}"
                                              IsChecked="{Binding SelectedTextElement.Bold}" />
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.ItalicLabel}"
                                              IsChecked="{Binding SelectedTextElement.Italic}" />
                                </StackPanel></Border>
                                <!-- Backlog item (user request, 2026-08-17): "text size should be in px not 0.1 or
                                     0.16 etc" — bound to the parent VM's own SelectedTextElementFontSizePx
                                     (a real pixel count against the TARGET mode's height) instead of the raw
                                     FontSizeRelative fraction; FontSizeRelative itself stays the underlying
                                     storage (deliberately mode-portable), this is a display/edit-side
                                     conversion only. -->
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FontSizeLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElementFontSizePx}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FillColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedTextElement.Color, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.OutlineLabel}"
                                              IsChecked="{Binding SelectedTextElement.HasStroke}" />
                                    <ColorPicker Grid.Column="2" HorizontalAlignment="Right"
                                                 IsEnabled="{Binding SelectedTextElement.HasStroke}"
                                                 Color="{Binding SelectedTextElement.StrokeColorForPicker, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasStroke}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.OutlineThicknessLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElementStrokeThicknessPx}" />
                                </Grid></Border>

                                <!-- Phase 8 (spec/15-template-designer.md, YONIQ-style text-effects
                                     follow-up): Shadow/Rotation/Gradient rows, same
                                     HasStroke/StrokeColor/StrokeThickness row pattern as Outline
                                     above — a checkbox-wrapped nullable color (HasShadow/
                                     ShadowColor, same reasoning as HasStroke) plus two offset
                                     TextBoxes. Canvas TextBlock cannot preview any of shadow/
                                     rotation/gradient (Avalonia's plain TextBlock has none of these
                                     capabilities) — same stated, accepted scope decision Phase 4
                                     already made for stroke; only the mini-preview (real
                                     ApplyTemplate pipeline) shows the actual result. -->
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.ShadowLabel}"
                                              IsChecked="{Binding SelectedTextElement.HasShadow}" />
                                    <ColorPicker Grid.Column="2" HorizontalAlignment="Right"
                                                 IsEnabled="{Binding SelectedTextElement.HasShadow}"
                                                 Color="{Binding SelectedTextElement.ShadowColorForPicker, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasShadow}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.ShadowOffsetXLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElementShadowOffsetXPx}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasShadow}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.ShadowOffsetYLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElementShadowOffsetYPx}" />
                                </Grid></Border>

                                <!-- Auditor usability review follow-up (2026-08-18): "3D"/Stack rows
                                     — legacy YONIQ's real CBStack/m_StackPara mechanism (TextIn.cpp/
                                     Draw.cpp), NOT a 3D transform — same HasShadow/ShadowColor/
                                     ShadowOffset row pattern immediately above, just a second,
                                     independent offset-copy effect (can be combined with Shadow). The
                                     canvas shows the real N-copy extrusion here (StrokedTextBlock's
                                     own StackFill/StackStepXPixels/StackStepYPixels), not just a
                                     mini-preview-only approximation — an earlier single-offset "hint"
                                     version was upgraded after a real, user-caught side-by-side
                                     mismatch against the "PREVIEW (mode-exact)" panel. -->
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.StackLabel}"
                                              IsChecked="{Binding SelectedTextElement.HasStack}" />
                                    <ColorPicker Grid.Column="2" HorizontalAlignment="Right"
                                                 IsEnabled="{Binding SelectedTextElement.HasStack}"
                                                 Color="{Binding SelectedTextElement.StackColorForPicker, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasStack}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.StackStepXLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElementStackStepXPx}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.HasStack}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.StackStepYLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElementStackStepYPx}" />
                                </Grid></Border>

                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.RotationLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedTextElement.RotationDegrees}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.GradientLabel}"
                                              IsChecked="{Binding SelectedTextElement.GradientEnabled}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientKindLabel}" />
                                    <ComboBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableGradientKinds}"
                                              SelectedItem="{Binding SelectedTextElement.GradientKind}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientStartColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedTextElement.GradientStartColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedTextElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientEndColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedTextElement.GradientEndColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>

                                <!-- TX editor gap-items plan, item 4b (picture fill, 2026-09-01) —
                                     a THIRD fill mode, a sibling of GRADIENT above, not a shared
                                     3-way selector (OverlayElementViewModel.BitmapFillEnabled's own
                                     doc comment: enforced mutually exclusive at the setter level, no
                                     shared UI toggle needed). No CheckBox — FROM FILE/FROM CLIPBOARD
                                     enable it directly (picking a picture always turns it on), CLEAR
                                     turns it back off without discarding the last-picked picture
                                     (ClearTextBitmapFillCommand's own doc comment). Labeled "PICTURE
                                     FILL", deliberately not "Bitmap" — GradientKindLabel's own
                                     ComboBox already renders the raw TextGradientKind.BitmapPattern
                                     enum name unstyled in this same panel; a second, differently-
                                     meaning "Bitmap" label here would collide with it. -->
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.PictureFillLabel}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow">
                                    <WrapPanel>
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,3"
                                                Content="{loc:Translate Panes.TxImageEditor.PictureFillFromFile}"
                                                Command="{Binding PickTextBitmapFillFromFileCommand}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,3"
                                                Content="{loc:Translate Panes.TxImageEditor.PictureFillFromClipboard}"
                                                Command="{Binding PickTextBitmapFillFromClipboardCommand}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Margin="0,0,0,3"
                                                Content="{loc:Translate Panes.TxImageEditor.PictureFillClear}"
                                                Command="{Binding ClearTextBitmapFillCommand}"
                                                IsEnabled="{Binding SelectedTextElement.BitmapFillEnabled}" />
                                    </WrapPanel>
                                </Border>

                                <!-- EditWindow redesign Phase 4 (mockups/Editwindow): insert-field
                                     chips relocated INTO the TEXT STYLE tab (mock's own placement —
                                     "INSERT FIELD → CARET" sits inside the text-style inspector, not
                                     the bottom QSO-fill bar; the bottom bar is FILL-IN VALUES only,
                                     this is macro/variable-TOKEN insertion). All 12 chips (including
                                     DIST/BEAM, wired 2026-08-18 via MaidenheadLocator) are backed by
                                     real data and have a Command — see this block's own original
                                     comment (moved from its old standalone panel, unchanged
                                     otherwise) for the full reasoning. -->
                                <Border Classes="IndustryRow"><TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.InsertFieldHeader}" /></Border>
                                <!-- Macros help plan, item A: 3 visual groups, not a flat 12-chip row —
                                     these chips insert 3 genuinely different behaviors (MacroTextResolver.cs
                                     :150-164), a flat row gave no hint which is which. Membership is
                                     pinned by plan-review, not arbitrary: group 1 (always resolve, no
                                     dependency) gets no per-chip annotation, only the section kicker;
                                     group 2 (radio-dependent, resolves to EMPTY with no rig) and group 3
                                     (needs a QSO FILL bar value first) each get a shared ToolTip.Tip
                                     explaining why. -->
                                <TextBlock Classes="IndustryKicker" Margin="0,2,0,2" Text="{loc:Translate Panes.TxImageEditor.InsertFieldGroupMySide}" />
                                <WrapPanel>
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip3}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="%m" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip10}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{name}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip4}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{grid}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip8}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="%D" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip7}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="%T" />
                                </WrapPanel>
                                <TextBlock Classes="IndustryKicker" Margin="0,4,0,2" Text="{loc:Translate Panes.TxImageEditor.InsertFieldGroupRadio}" />
                                <WrapPanel>
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip5}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{freq}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldRadioHint}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip6}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{mode}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldRadioHint}" />
                                </WrapPanel>
                                <TextBlock Classes="IndustryKicker" Margin="0,4,0,2" Text="{loc:Translate Panes.TxImageEditor.InsertFieldGroupPerQso}" />
                                <WrapPanel>
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip1}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{his_call}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip2}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{his_grid}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip9}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{rsv}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip11}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{dist}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="6,0" Margin="0,0,3,3" Content="{loc:Translate Panes.TxImageEditor.Chip12}"
                                            Command="{Binding InsertFieldCommand}" CommandParameter="{}{bearing}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.InsertFieldPerQsoHint}" />
                                </WrapPanel>

                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AddPlate}"
                                        Command="{Binding AddPlateBehindTextCommand}" />
                            </StackPanel>
                    </StackPanel>

                    <!-- GEOMETRY tab (EditWindow redesign Phase 3, new): numeric X/Y/W/H bound
                         through SelectedOverlayElement — the SHARED ITemplateElementViewModel
                         interface, so this works for any element type (text/box/image), not just
                         text (unlike the TEXT STYLE tab above, which is real text-only). Align-to-
                         crop calls the new AlignSelectedElementToCropCommand (see its own doc
                         comment for the center-vs-top-left-anchored coordinate conversion). Snap
                         reuses the SAME SnapToGrid property the STAGE toolbar's own toggle already
                         writes — one piece of state, two surfaces, not a duplicate. -->
                    <StackPanel Classes="Industry IndustryRows" Spacing="{StaticResource IndustrySpacingTight}" IsVisible="{Binding IsGeometryTabSelected}">
                        <!-- design-fidelity Phase H (final confirming pass finding #5): same
                             IndustryRowValue->IndustryRowLabel fix — empty-state prose. -->
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.NoElementSelected}"
                                   IsVisible="{Binding SelectedOverlayElement, Converter={x:Static ObjectConverters.IsNull}}" />
                        <StackPanel Spacing="{StaticResource IndustrySpacingTight}"
                                    IsVisible="{Binding SelectedOverlayElement, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <!-- Backlog item (auditor usability review, 2026-08-17, item 8): "GEOMETRY
                                 X/Y/W/H are raw full-precision doubles, no px option." Bound through
                                 the parent VM's new SelectedElement*Px properties instead of the raw
                                 [0,1]-normalized X/Y/Width/Height — same target/working-copy-pixel
                                 conversion convention SIZE (PX) already established for text (see
                                 SelectedElementLeftPx's own doc comment). Label text unchanged
                                 (GeometryXLabel etc.) but now reads "X (PX)" style via the updated
                                 locale strings. -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                <StackPanel>
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GeometryXLabel}" />
                                    <TextBox Classes="Industry IndustryInput" HorizontalContentAlignment="Right" Text="{Binding SelectedElementLeftPx}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GeometryYLabel}" />
                                    <TextBox Classes="Industry IndustryInput" HorizontalContentAlignment="Right" Text="{Binding SelectedElementTopPx}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GeometryWidthLabel}" />
                                    <TextBox Classes="Industry IndustryInput" HorizontalContentAlignment="Right" Text="{Binding SelectedElementWidthPx}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GeometryHeightLabel}" />
                                    <TextBox Classes="Industry IndustryInput" HorizontalContentAlignment="Right" Text="{Binding SelectedElementHeightPx}" />
                                </StackPanel>
                            </Grid>

                            <!-- TX editor gap-items plan, item 3 (perspective transform) — ONE shared
                                 row (not duplicated inside BOX STYLE and IMAGE STYLE below), since
                                 both element kinds support it identically. IsChecked binds ONE-WAY
                                 (SelectedElementPerspectiveEnabled has no setter) purely to reflect
                                 current state; the actual toggle happens via Command, which seeds/
                                 writes-back the 4 corners as a real side effect a plain two-way
                                 IsChecked binding could never perform correctly (see that command's
                                 own doc comment on ImageElementViewModel). -->
                            <Border Classes="IndustryRow" IsVisible="{Binding IsPerspectiveEligibleElementSelected}"><Grid ColumnDefinitions="Auto,*">
                                <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.PerspectiveLabel}"
                                          IsChecked="{Binding SelectedElementPerspectiveEnabled}"
                                          Command="{Binding TogglePerspectiveCommand}" CommandParameter="{Binding SelectedOverlayElement}" />
                            </Grid></Border>

                            <!-- Backlog item (auditor usability review, 2026-08-17, item 5): "Box
                                 elements have no style UI at all." Lives here (GEOMETRY, the one tab
                                 shared across all 3 element types) rather than TEXT STYLE, which is
                                 real text-only (SelectedTextElement narrows to OverlayElementViewModel
                                 specifically) — gated on SelectedOverlayElement being a BoxElementViewModel,
                                 mutually exclusive with the text-only TEXT STYLE tab's own content. -->
                            <StackPanel Spacing="{StaticResource IndustrySpacingTight}"
                                        IsVisible="{Binding SelectedOverlayElement, Converter={x:Static conv:IsBoxElementConverter.Instance}}">
                                <TextBlock Classes="IndustryGbTitle" Margin="0,4,0,0" Text="{loc:Translate Panes.TxImageEditor.BoxStyleHeader}" />
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.FillColorLabel}"
                                              IsChecked="{Binding SelectedBoxElement.FillEnabled}" />
                                    <ColorPicker Grid.Column="2" HorizontalAlignment="Right"
                                                 IsEnabled="{Binding SelectedBoxElement.FillEnabled}"
                                                 Color="{Binding SelectedBoxElement.FillColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.BorderLabel}"
                                              IsChecked="{Binding SelectedBoxElement.HasBorder}" />
                                    <ColorPicker Grid.Column="2" HorizontalAlignment="Right"
                                                 IsEnabled="{Binding SelectedBoxElement.HasBorder}"
                                                 Color="{Binding SelectedBoxElement.BorderColorForPicker, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedBoxElement.HasBorder}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.BorderThicknessLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedBoxElementBorderThicknessPx}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.OpacityLabel}" />
                                    <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0"
                                            Minimum="0" Maximum="1" Value="{Binding SelectedBoxElement.Opacity}" VerticalAlignment="Center" />
                                </Grid></Border>
                                <!-- Auditor usability review follow-up (2026-08-18): "missing item"
                                     against spec/15-template-designer.md's own box-elements friction
                                     risk ("need border, corner-radius, and opacity"). Built via a
                                     hand-rolled rounded-rectangle path (no ImageSharp.Drawing
                                     primitive at this project's pinned version, see
                                     TransmitImagePreparer.BuildBoxPath's own doc comment) on the
                                     pipeline side; Avalonia's native Border.CornerRadius on the
                                     canvas side. -->
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.CornerRadiusLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedBoxElementCornerRadiusPx}" />
                                </Grid></Border>
                                <!-- TX editor gap-items plan (2026-09-01, box gradient fill) — same
                                     4-row Gradient block TEXT STYLE has above, same AvailableGradientKinds
                                     ItemsSource (shared, TextGradientKind isn't text-specific despite
                                     the name — see TemplateBoxElement.Gradient's own doc comment). -->
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Classes="Industry" Content="{loc:Translate Panes.TxImageEditor.GradientLabel}"
                                              IsChecked="{Binding SelectedBoxElement.GradientEnabled}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedBoxElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientKindLabel}" />
                                    <ComboBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableGradientKinds}"
                                              SelectedItem="{Binding SelectedBoxElement.GradientKind}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedBoxElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientStartColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedBoxElement.GradientStartColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow" IsEnabled="{Binding SelectedBoxElement.GradientEnabled}"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.GradientEndColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedBoxElement.GradientEndColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                            </StackPanel>

                            <!-- TX editor gap-items plan, line element (2026-09-01) — LINE STYLE,
                                 same gated-block shape as BOX STYLE above (user-approved: reuses the
                                 generic X/Y/Width/Height GEOMETRY fields above rather than dedicated
                                 X1/Y1/X2/Y2 fields, so this block is stroke-only — no fill/border/
                                 corner-radius/gradient, a line has none of those). Gated on
                                 SelectedLineElement itself (ObjectConverters.IsNotNull), matching
                                 IMAGE STYLE's own simpler shape below rather than BOX STYLE's
                                 IsBoxElementConverter (both are equivalent; SelectedLineElement
                                 already exists as the narrowed-cast property this needs). -->
                            <StackPanel Spacing="{StaticResource IndustrySpacingTight}"
                                        IsVisible="{Binding SelectedLineElement, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="IndustryGbTitle" Margin="0,4,0,0" Text="{loc:Translate Panes.TxImageEditor.LineStyleHeader}" />
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.StrokeColorLabel}" />
                                    <ColorPicker Grid.Column="1" HorizontalAlignment="Right"
                                                 Color="{Binding SelectedLineElement.StrokeColor, Converter={x:Static conv:Rgb24ToColorConverter.Instance}}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.StrokeThicknessLabel}" />
                                    <TextBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Right" Width="70"
                                             Text="{Binding SelectedLineElement.StrokeThicknessPx}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.OpacityLabel}" />
                                    <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0"
                                            Minimum="0" Maximum="1" Value="{Binding SelectedLineElement.Opacity}" VerticalAlignment="Center" />
                                </Grid></Border>
                            </StackPanel>

                            <!-- Backlog item (auditor usability review, 2026-08-17, item 6): "Image
                                 elements' Fit mode isn't editable." Same gated-block shape as BOX STYLE
                                 above. -->
                            <StackPanel Spacing="{StaticResource IndustrySpacingTight}"
                                        IsVisible="{Binding SelectedImageElement, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="IndustryGbTitle" Margin="0,4,0,0" Text="{loc:Translate Panes.TxImageEditor.ImageStyleHeader}" />
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.FitModeLabel}" />
                                    <ComboBox Grid.Column="1" Classes="Industry IndustryInput" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableImageFitModes}"
                                              SelectedItem="{Binding SelectedImageElement.Fit}" />
                                </Grid></Border>
                            </StackPanel>

                            <TextBlock Classes="IndustryRowLabel" Margin="0,4,0,0" Text="{loc:Translate Panes.TxImageEditor.AlignToCropLabel}" />
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="3">
                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AlignLeft}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Left" />
                                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AlignCenter}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Center" />
                                <Button Grid.Column="2" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AlignRight}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Right" />
                                <Button Grid.Column="3" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AlignTop}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Top" />
                                <Button Grid.Column="4" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AlignMiddle}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Middle" />
                                <Button Grid.Column="5" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.AlignBottom}" Command="{Binding AlignSelectedElementToCropCommand}" CommandParameter="Bottom" />
                            </Grid>
                            <ToggleButton Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Margin="0,4,0,0"
                                          IsChecked="{Binding SnapToGrid}" Content="{loc:Translate Panes.TxImageEditor.SnapGrid}" ToolTip.Tip="{loc:Translate Panes.TxImageEditor.SnapGrid.Help}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- IMAGE tab (EditWindow redesign Phase 3): the 6 adjustment sliders, relocated
                         here from below the canvas — same bindings, same VM properties (they apply
                         to the whole working-copy photo, not per-element; this tab is the same
                         global adjustment surface just given a real home instead of being docked
                         under the canvas). See the original block's own doc comment (removed from
                         its old location, preserved in spirit here) for why StringFormat={}{0:0} is
                         used on every readout. -->
                    <StackPanel Spacing="{StaticResource IndustrySpacingTight}" IsVisible="{Binding IsImageTabSelected}">
                        <!-- design-fidelity Phase H (final confirming pass finding #3): label column
                             fixed at 76px (matching the mock's own literal width:76px, mockups/
                             Editwindow line 223) across all 6 rows below, replacing each row's own
                             independent Auto column — 6 separate Grids with no shared column meant
                             the slider track's own left edge was ragged (measured up to 27 DIP of
                             spread) instead of aligned, since each label sized to its own text. -->
                        <Grid ColumnDefinitions="76,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Brightness}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-50" Maximum="50" Value="{Binding Brightness}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Brightness, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="76,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Contrast}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-50" Maximum="50" Value="{Binding Contrast}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Contrast, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="76,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Saturation}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-50" Maximum="50" Value="{Binding Saturation}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Saturation, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="76,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Gamma}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="-100" Maximum="100" Value="{Binding Gamma}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Gamma, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="76,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Sharpen}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="0" Maximum="100" Value="{Binding Sharpen}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Sharpen, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid ColumnDefinitions="76,*,Auto">
                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.TxImageEditor.Denoise}" />
                            <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0" Minimum="0" Maximum="100" Value="{Binding Denoise}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="IndustryRowValue" VerticalAlignment="Center" Text="{Binding Denoise, StringFormat={}{0:0}}" />
                        </Grid>
                        <!-- design-fidelity Phase G (#12, mockups/Editwindow line 227): static note
                             only — LOOK PRESET/RESET ALL/AUTO LEVEL/REPLACE (mock lines 223-226) are
                             genuinely new functionality (a preset system, auto-white-balance, a
                             second image-replace path), already deferred by the plan's own scope-
                             discipline note; this phase is layout/label additions only, not new
                             commands. -->
                        <TextBlock Classes="IndustryKicker" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{loc:Translate Panes.TxImageEditor.AdjustmentsNonDestructiveNote}" />
                    </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </HeaderedContentControl>

                </Grid>

            </Grid>

            <!-- EditWindow redesign Phase 4 (mockups/Editwindow): QSO FILL + SEND bottom bar — the
                 mock's own "the only tinted region on the screen," since it's the live-QSO path.
                 IndustryAccent100 (#EEF6FF) already matches the mock's own tint value by coincidence
                 of shared design-system lineage (see this file's Phase 1 doc comment on that same
                 point) — reused directly, no new token added, per the user's own explicit "stick with
                 the current template design items" call. Left (fluid): the fill-bar this project
                 already had (Phase 3's own TemplateVariableRows + Clear Fields), relocated from its
                 old standalone side panel — same VM state, same bindings. Right (fixed 220): Apply/
                 Cancel, relocated from the STAGE toolbar (object-state actions belong here, not
                 mixed with view-state per this redesign's own IA rule, Phase 2's own reasoning).
                 [Deferred, stated not silently dropped] The mock's own PULL FROM RX DECODE / FROM
                 LOGBOOK / QUEUE &amp; TRANSMIT are NOT built here — all three are genuinely new
                 cross-cutting features (RX-decode/logbook integration; QUEUE &amp; TRANSMIT specifically
                 needs new cross-VM wiring, since "Apply" and "Transmit" are two separate commands on
                 two separate VMs today — TxImageEditorPaneViewModel.Applied is an event the PARENT
                 TxControlsPaneViewModel subscribes to, with no existing "apply then transmit" chain),
                 not pure layout — out of this redesign pass's own scope. -->
            <!-- design-fidelity Phase F (#9, mockups/Editwindow line 239/255): QSO FILL's title row
                 becomes a real flex header (title + token-count note + spacer + Clear), matching the
                 mock's own header-bar shape — this Grid is a plain StackPanel child, not inside a
                 HeaderedContentControl.Header slot, so the "*,Auto doesn't stretch" constraint
                 Phase D/E/F's own group-box headers hit does NOT apply here; a bare Grid genuinely
                 gets the StackPanel's own available width. Clear moved here from its old bottom-left
                 spot (Phase 3). SEND side becomes a real side-by-side row (110px secondary + flex
                 primary, matching the mock's own APPLY-ONLY/QUEUE-&amp;-TRANSMIT proportions) instead of
                 stacked full-width buttons, plus a compact mode/duration meta line (SWR omitted, see
                 SendMetaText's own doc comment for why). -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="8" Background="{DynamicResource IndustryAccent100}" BorderBrush="{DynamicResource IndustryAccent}" BorderThickness="1">
                <!-- design-fidelity Phase I (minor #3): explicit Auto divider column added (mock's
                     own full-height 1px rule between the two halves, line 251) — ColumnSpacing
                     alone (still kept, for the gap either side of the divider) left no visible rule
                     between QSO FILL and SEND. -->
                <Grid ColumnDefinitions="*,Auto,220" ColumnSpacing="{StaticResource IndustrySpacingGutter}">
                    <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{StaticResource IndustrySpacingTight}">
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.QsoFillHeader}" />
                            <TextBlock Grid.Column="1" Classes="IndustryKicker" VerticalAlignment="Center"
                                       Text="{Binding TemplateVariableCountText}" IsVisible="{Binding !HasNoTemplateVariableRows}" />
                            <!-- Macros help plan (2026-09-01), item B: 5th column added, Clear
                                 re-indexed 3→4 — reaches the same Macros reference window
                                 `Tools ▸ Macros` does, so an operator mid-template-edit doesn't have to
                                 remember that menu exists. -->
                            <Button Grid.Column="3" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0"
                                    Content="{loc:Translate Panes.TxImageEditor.MacrosButton}"
                                    Command="{Binding OpenMacrosReferenceCommand}" />
                            <!-- "Fill all" dropped outright (Phase 3 plan-review decision, not just left
                                 disabled) — no real default-value source exists yet (OperatorSettings is
                                 MY-side only; spec/15 frames any logbook-based prefill as future/
                                 additive). "Clear" is the one real, spec-backed action (spec/15: "one
                                 'clear fields' action after the QSO") — moved here (Phase F) from its
                                 old bottom-left spot to match the mock's own header-row placement. -->
                            <Button Grid.Column="4" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0"
                                    Content="{loc:Translate Panes.TxImageEditor.ClearFields}"
                                    Command="{Binding ClearTemplateVariablesCommand}" />
                        </Grid>
                        <!-- design-fidelity Phase H (final confirming pass finding #5): same
                             IndustryRowValue->IndustryRowLabel fix — was rendering right-aligned in
                             a grey box hard against the CLEAR button instead of reading as a plain
                             message under the QSO FILL title. -->
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxImageEditor.NoQsoFields}" IsVisible="{Binding HasNoTemplateVariableRows}" />
                        <ItemsControl ItemsSource="{Binding TemplateVariableRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TemplateVariableRowViewModel">
                                    <StackPanel Margin="0,0,10,4" MinWidth="120">
                                        <TextBlock Classes="IndustryRowLabel" Text="{Binding Key}" />
                                        <TextBox Classes="Industry IndustryInput" Text="{Binding Value}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource IndustryChromeBorder}" />
                    <StackPanel Grid.Column="2" Spacing="{StaticResource IndustrySpacingTight}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxImageEditor.SendHeader}" />
                            <TextBlock Grid.Column="1" Classes="IndustryKicker" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SendMetaText}" />
                        </Grid>
                        <!-- ui_transition_plan.md step 2 (T1-2): SEND used to mean apply-only, with
                             the real Transmit button off in TxControlsPaneView's own sidebar column
                             (potentially below its scroll position) — a human finishing a card
                             expects the large action HERE to send it. The primary action here demotes
                             plain Apply (still real, still needed for a card the operator wants staged
                             but not sent yet) to Secondary.
                             User-requested (2026-09-16): the sidebar's own Transmit button is gone now
                             (removed entirely, not just deprioritized) — this button is the ONLY way
                             to send a picture, so it gets its own dedicated color (IndustryBtnTransmit,
                             Atoms.axaml) instead of the generic IndustryBtnPrimary accent shared by
                             ~16 other OK/Save/Confirm buttons across the app, and a plain "TRANSMIT"
                             label instead of the combined "Apply & Transmit" verb phrase — the command
                             itself is unchanged, it still applies pending edits before sending. -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource IndustrySpacingTight}">
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="{StaticResource IndustrySpacingTight}">
                                <!-- Backlog item (auditor usability review, 2026-08-17, item 2): "Cancel
                                     discards all edits with no confirmation." User-reported feedback
                                     (2026-09-15): the original arm/confirm (a second click on this SAME
                                     button, swapping its own label to "DISCARD?") is gone — Cancel now
                                     shows a real Yes/No dialog via CancelAsync/ConfirmRequested instead,
                                     same shape as template recall's own dialog. This button is a plain,
                                     always-"CANCEL" button again. -->
                                <Button x:Name="CancelButton" Classes="Industry IndustryBtn IndustryBtn36 IndustryBtnSecondary"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.Cancel}" Command="{Binding CancelCommand}" />
                                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn36 IndustryBtnSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.TxImageEditor.Apply}"
                                        ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Apply.Help}"
                                        Command="{Binding ApplyCommand}" />
                            </Grid>
                            <Button Grid.Row="1" Classes="Industry IndustryBtn IndustryBtn36 IndustryBtnTransmit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{loc:Translate Panes.TxImageEditor.Transmit}"
                                    ToolTip.Tip="{loc:Translate Panes.TxImageEditor.Transmit.Help}"
                                    Command="{Binding ApplyAndTransmitCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </HeaderedContentControl>

</UserControl>
