<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="ScanlineStudio.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{loc:Translate MainWindow.Title}"
        Width="1600" Height="900"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <!-- MainViewModel now requires AppDockFactory via DI, so no Design.DataContext previewer
         instance; see App.axaml.cs for how the real DataContext is resolved at runtime. -->

    <!-- Default/minimum size: user requirement, direct quote: "renderable without issue on a
         fullHD screen... keep in mind the taskbar at the bottom... that helps set the floor for
         'it should run on a fullHD laptop'." 1600x900 leaves a real margin under 1920x1080 even
         after a Windows taskbar (~40-48px), a GNOME top bar, or a macOS menu bar + dock, so the
         window opens fully visible without the user needing to move/resize it. MinWidth/MinHeight
         (1024x600) is a separate, lower floor: how small the window can be resized down to before
         panes stop being usable, not the fullHD target itself. -->

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Minimal View menu (spec/09-ui.md's "Pane visibility" section): the only reopen path for
             a closed dockable Tool pane; legacy itself has a real menu bar with a View-related item
             (Main.h's TMenuItem *KView), so this is legacy-consistent chrome, not a modern-SaaS
             deviation from the Aesthetic Directive. -->
        <Menu Grid.Row="0">
            <MenuItem Header="{loc:Translate MainWindow.ViewMenu}">
                <MenuItem Header="{loc:Translate Panes.Waterfall.Title}" Command="{Binding DockFactory.ShowWaterfallCommand}" />
                <MenuItem Header="{loc:Translate Panes.RxImage.Title}" Command="{Binding DockFactory.ShowRxImageCommand}" />
                <MenuItem Header="{loc:Translate Panes.RxHistory.Title}" Command="{Binding DockFactory.ShowRxHistoryCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.OptionsMenuItem}" Command="{Binding OpenOptionsCommand}" />
        </Menu>

        <!-- Fixed radio/frequency status strip: MainWindow chrome, not a dockable pane
             (Phase-3 plan decision #9's scope trim). Connecting happens once at ScanlineStudio.Host
             startup from persisted settings, not from this strip; frequency/mode/TX volume/
             presets/Tune are all live controls here (Piece 5), always visible regardless of which
             pane tab is active, matching where WSJT-X/Nexus both keep these controls (design
             decision #4). -->
        <Border Grid.Row="1" Classes="ScanlineStudioPanelHeader" DataContext="{Binding RadioStatus}">
          <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingMedium}">

                    <!-- Frequency/mode readout + editable control, one module. -->
                    <Border Classes="ScanlineStudioModuleGroup">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" VerticalAlignment="Center">
                            <TextBlock Classes="ScanlineStudioReadout" Text="{Binding FrequencyDisplay}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding FrequencyInputMhz}"
                                     Watermark="{loc:Translate RadioStatus.FrequencyPlaceholder}"
                                     Width="90" VerticalAlignment="Center" />
                            <Button Content="{loc:Translate RadioStatus.SetFrequency}" Command="{Binding SetFrequencyCommand}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedRadioMode}" Width="80" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Frequency memory presets: click applies both frequency+mode in one action
                         (WSJT-X band-shortcut convention). Membership user-configured via the
                         "Edit presets..." popup, backed by FrequencyPresetsSettings. -->
                    <Border Classes="ScanlineStudioModuleGroup">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" VerticalAlignment="Center">
                            <TextBlock Classes="ScanlineStudioReadout" FontSize="10" Text="{loc:Translate RadioStatus.PresetsLabel}" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FrequencyPresetButtonViewModel">
                                        <Button Content="{Binding Label}"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding Preset}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{loc:Translate RadioStatus.EditPresets}" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}" MinWidth="320">
                                            <ItemsControl ItemsSource="{Binding EditorRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FrequencyPresetEditorRowViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                                            <TextBox Text="{Binding Label}" Watermark="{loc:Translate RadioStatus.PresetLabelPlaceholder}" Width="110" />
                                                            <TextBox Text="{Binding FrequencyMhzText}" Width="90" />
                                                            <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}" Width="80" />
                                                            <Button Content="{loc:Translate RadioStatus.RemovePreset}" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                                <Button Content="{loc:Translate RadioStatus.AddPreset}" Command="{Binding AddPresetRowCommand}" />
                                                <Button Content="{loc:Translate RadioStatus.SavePresets}" Command="{Binding SavePresetsCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- TX output volume: a post-encode playback gain, not an encoder/DSP
                         parameter (design decision #3); matches WSJT-X's own documented Pwr
                         slider semantics ("adjust it down until the RF output just starts to
                         fall"). Persists to AudioDeviceSettings.TxVolumePercent, debounced. -->
                    <Border Classes="ScanlineStudioModuleGroup">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" VerticalAlignment="Center">
                            <TextBlock Classes="ScanlineStudioReadout" FontSize="10" Text="{loc:Translate RadioStatus.TxVolumeLabel}" VerticalAlignment="Center" />
                            <Slider Value="{Binding TxVolumePercent}" Minimum="0" Maximum="100" Width="120" VerticalAlignment="Center" />
                            <TextBlock Classes="ScanlineStudioReadout" Text="{Binding TxVolumePercent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Tune: keys PTT and plays a steady test tone so the other station's
                         AFC/tuning can lock on (legacy Option.cpp's TuneFreq, default 1750Hz).
                         Frequency/duration are one-off per-use fields, not a persisted setting. -->
                    <Border Classes="ScanlineStudioModuleGroup">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" VerticalAlignment="Center">
                            <TextBlock Classes="ScanlineStudioHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate RadioStatus.Tune.Help}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding TuneFrequencyHz}" Width="60" VerticalAlignment="Center" />
                            <TextBlock Classes="ScanlineStudioReadout" Text="{loc:Translate RadioStatus.Tune.HertzUnit}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding TuneDurationSeconds}" Width="50" VerticalAlignment="Center" />
                            <TextBlock Classes="ScanlineStudioReadout" Text="{loc:Translate RadioStatus.Tune.SecondsUnit}" VerticalAlignment="Center" />
                            <Button Content="{loc:Translate RadioStatus.Tune}" Command="{Binding TuneCommand}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ScanlineStudioTxActiveColor}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <DockControl Grid.Row="2" Layout="{Binding Layout}" />
    </Grid>

</Window>
