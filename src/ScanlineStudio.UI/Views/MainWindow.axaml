<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        xmlns:views="using:ScanlineStudio.UI.Views"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:sstv="using:ScanlineStudio.Abstractions.Sstv"
        xmlns:logbook="using:ScanlineStudio.Abstractions.Logbook"
        xmlns:conv="using:ScanlineStudio.UI.Converters"
        xmlns:controls="using:ScanlineStudio.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="ScanlineStudio.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="{loc:Translate MainWindow.Title}"
        Width="1920" Height="1032"
        MinWidth="1920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource IndustryBg}">

    <!-- MainViewModel now requires AppDockFactory via DI, so no Design.DataContext previewer
         instance; see App.axaml.cs for how the real DataContext is resolved at runtime. -->

    <!-- Default size: user requirement, direct quote: "renderable without issue on a fullHD
         screen... keep in mind the taskbar at the bottom... that helps set the floor for 'it
         should run on a fullHD laptop'." FullHD is 1920x1080; 1032 reserves 48px off the height
         for a Windows taskbar / GNOME top bar / macOS menu bar + dock, so the window opens fully
         visible without the user needing to move/resize it.

         MinHeight (2026-08-23 user request, supersedes this comment's own earlier "pinned to
         1920x1032, can only grow" note): shrinkable down to 640 so the bottom status bar stays
         reachable on a shorter screen/window arrangement instead of being pushed off-window with
         no way to shrink around it. The outer Grid below (RowDefinitions="26,102,*,25") already
         reserves the menu row, header-cards row, and status-bar row as fixed heights — only the
         "*" row (tab strip + its content) actually shrinks, so the status bar stays visible and
         anchored at any height down to this floor, it just leaves less room for the tab content
         above it. MinWidth stays pinned to 1920 — this request was about vertical height only. -->

    <!-- UI-redesign Phase 2/3: outer bands per LAYOUT-SPEC §1, no Auto — the 3rd fixed band, the
         tab strip, is produced by the TabControl's own default header-sizing behavior driven by
         TabItem.Height=26, not a literal 4th row here; see Atoms.axaml's TabItem.Industry block
         comment for why no TabControl template replacement was needed to achieve this split
         safely. Band 2 corrected from LAYOUT-SPEC's stated 81 to 102: real-window debug-bounds
         measurement PLUS a faithful headless-Firefox render of the source mockup HTML (local
         Barlow/Barlow-Condensed/DejaVu-Mono @font-face substitutes, matching what this app
         actually embeds, no network font fetch) both show the VFO/Favourites/Transceiver group
         boxes' own natural stretched content height is 87px, not LAYOUT-SPEC's implied ~67 —
         87 + the row's own 7px top/bottom padding = 101, +1 for browser rounding/hairline = 102.
         This is what was actually cutting off Favourites' bottom row and Transceiver's TX-level
         row (both previously blamed on card-internal layout, which was a real but secondary bug —
         see RadioHeaderView.axaml's Favourites card comment). -->
    <Grid RowDefinitions="26,102,*,25">
        <!-- Menu bar: mock2's own 6 top-level menus reproduced (File/Configurations/Rig & PTT/
             Calibration/Tools/Help), minus View (the fixed Receive/Transmit/Gallery TabControl
             below has nothing closable, so View's reopen-a-closed-pane purpose doesn't apply here,
             spec/09-ui.md) and minus Rig & PTT (removed per direct user request, 2026-08-25 —
             see that menu's own former location below for why). Only File > Open image (routes into
             the real TX image editor via TxControlsPaneViewModel.SelectImageCommand) and File >
             Exit are wired to real
             commands; every other item is IsEnabled="False" with a "not yet implemented" tooltip,
             the same convention as the Options window's own disabled-placeholder items. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <!-- Brand label ("SSTV / CONSOLE") removed per direct user request — no bound state, purely
             decorative chrome, so nothing else to preserve when dropping it. Menu stays at its own
             Grid.Column="1" (the row's "*" star column) unchanged; column 0 (Auto) just collapses to
             0 width now that nothing occupies it, and the callsign chip stays anchored at
             Grid.Column="2". -->
        <Menu Grid.Column="1" Classes="Industry">
            <MenuItem Header="{loc:Translate MainWindow.Menu.File}">
                <!-- spec/18-path-to-1.0.md Medium item 5: same SelectImageCommand as the Transmit
                     pane's own "Browse..." button. A disabled MenuItem also suppresses its own
                     InputGesture, so this closes the Ctrl+O accelerator too, not just the click. -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.File.OpenImage}" InputGesture="Ctrl+O" Command="{Binding TxControls.SelectImageCommand}" IsEnabled="{Binding TxControls.CanChangeSourceOrMode}" />
                <!-- Stub survey Tier 1 (2026-08-26): same RxImagePaneViewModel.SaveFrameCommand the
                     Receive tab's own "Save frame" button uses (action bar below) — one feature,
                     two entry points, matching Tools > Re-decode's own pattern above. -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.File.SaveFrameAs}" InputGesture="Ctrl+S" Command="{Binding RxImage.SaveFrameCommand}" />
                <Separator />
                <MenuItem Header="{loc:Translate MainWindow.Menu.File.Exit}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <!-- Station/Audio-devices pruned (now redundant with Options' TX/Audio tabs, which
                 have the real fields this stub only ever pointed at); Storage and Macros both
                 wired 2026-08-26 (stub survey Tier 2/Tier 3, see below) — no Options equivalent
                 exists for either (Gallery's own Storage panel is read-only display, not an
                 editable settings section). -->
            <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations}">
                <!-- Stub survey Tier 2 (2026-08-26): "naming" dropped, auditor's own recommendation
                     over shipping a promised-but-absent section — no filename-pattern setting
                     exists anywhere (ReceiveHistoryRecorder hardcodes it), so the label and the
                     dialog it opens only ever cover Storage. -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations.StorageNaming}" Command="{Binding OpenStorageSettingsCommand}" />
                <!-- Stub survey Tier 3 (2026-08-26): user narrowed this to a read-only token
                     reference + live preview (AskUserQuestion) — IMacroTextResolver has no
                     user-extensible macro list, only fixed known tokens, so there is nothing to
                     "edit." -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations.Macros}" Command="{Binding OpenMacrosReferenceCommand}" />
            </MenuItem>
            <!-- Rig & PTT removed per direct user request (2026-08-25) — all 3 items (PTT method,
                 Frequency memories, Test PTT) were disabled stubs, never wired to a real command;
                 no docs/removed-features.md entry needed (that doc covers dropping a PORTED legacy
                 capability, and nothing here was ever functional to drop). Frequency memories/Test
                 PTT both have real equivalents elsewhere already (the header's own M1-M7 favourites;
                 Options' Radio/CAT tab Test PTT), so nothing here still lacks a home if implemented. -->
            <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration}">
                <!-- Clock calibration (legacy ClockAdj.cpp, a live master-clock wizard) removed
                     2026-08-26 (user decision, "maybe one day") after investigation: Auto Slant
                     already auto-corrects per-line clock drift on every reception, tested to a 1%
                     mismatch (spec/06-sstv-dsp.md, SlantTests.cs) — well past real-world sound-card
                     clock error. The manual wizard's only edge (faster initial-line lock) didn't
                     justify the build cost once a live-port plan-review surfaced real defects
                     (wrong scroll geometry, a click-anchor bug, a missing intensity mapping). See
                     spec/14-roadmap.md's backlog. -->
                <!-- Stub survey Tier 3 (2026-08-26): one-shot software preview — encode the TX
                     pane's currently loaded image/mode, decode it back in-process, show the result
                     in a dedicated dialog. NOT legacy's RGLoopBack hardware loopback (see
                     ISstvSessionService.RunLoopbackSelfTestAsync's own doc comment and
                     docs/removed-features.md). Same binding-path reasoning as Macros/Storage above
                     (TxControls, not RadioStatus) — this needs the currently loaded TX image/mode,
                     which lives on TxControlsPaneViewModel. -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration.LoopbackSelfTest}" Command="{Binding TxControls.RunLoopbackSelfTestCommand}" />
                <!-- Stub survey Tier 2 (2026-08-26): opens the new general-purpose Tone Generator
                     dialog, reusing RadioStatusViewModel.TuneCommand (already real, previously
                     unexposed) — see FavouritesEditorWindowView/ToneGeneratorWindowView's own
                     comments for why the header's own RadioStatusViewModel is the DataContext. -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration.ToneGenerator}" Command="{Binding RadioStatus.OpenToneGeneratorCommand}" />
                <!-- Slant reference removed 2026-08-26 (user decision, "maybe one day") — no legacy
                     precedent found at all (grep across yoniq-old/YONIQ-main turned up nothing), no
                     documented intent for what it would even do. See spec/14-roadmap.md's backlog
                     entry. -->
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.Menu.Tools}">
                <!-- Piece C2 (RX tab Re-decode port): same command RxImage's own "Re-decode" button
                     uses (MainWindow.axaml's action bar below) — one feature, two entry points. -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.Tools.RedecodeFromWav}" Command="{Binding RxImage.RedecodeCommand}" />
                <!-- Stub survey Tier 1 (2026-08-26): "session log" means the QSO log (the Logbook
                     tab's own ADIF export), not the debug log (Help > Open application log covers
                     that separately) — same LogbookPaneViewModel.ExportAdifCommand the Logbook
                     tab's own "Export" button uses. -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.Tools.ExportSessionLog}" Command="{Binding Logbook.ExportAdifCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.OptionsMenuItem}" Command="{Binding OpenOptionsCommand}" />
            <!-- Help moved behind Options (user request, 2026-08-26) — Options no longer dangles
                 as the sole trailing item. -->
            <MenuItem Header="{loc:Translate MainWindow.Menu.Help}">
                <MenuItem Header="{loc:Translate MainWindow.Menu.Help.OpenOnGitHub}" Command="{Binding OpenOnGitHubCommand}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Help.OpenApplicationLog}" Command="{Binding OpenApplicationLogCommand}" />
                <!-- About stays the last item, per direct user request (2026-08-26). -->
                <MenuItem Header="{loc:Translate MainWindow.Menu.Help.About}" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Operator's own callsign (mock2's own top-right green chip on the menu line) - real,
             loaded from OptionsSettingsService/OperatorSettings by MainViewModel; falls back to
             the standard ham-radio placeholder "N0CALL" until the user sets a real one in
             Options, so the chip is always present like mock2's own. No cfg/grid alongside it,
             per direct user request: mock2 also shows a "cfg: <profile>" chip and a grid-locator
             suffix here, both skipped since neither has a real backing concept yet (preserved
             product decision, UI-redesign Phase 2 design doc §1). 2026-08-14: dropped the old
             accentOutline (blue) — an identity badge is neither a selection nor a status, so under
             mockups/colors/SSTV-Color-Scheme.md's four-hue rule it owns no hue at all, same
             reasoning already applied to group-box titles/kicker text going grey. A plain Button
             (not a static Border) since a real click target — opens Options straight to the TX
             tab, where Callsign/OperatorName/OperatorGrid actually live — was previously entirely
             missing here (user report: clicking the chip did nothing). IndustryMiniButtonTheme is
             the same border/transparent-background chip look as the old static Border, just on a
             clickable Button (already used this way throughout the app, e.g. RadioHeaderView's own
             mini buttons), with Padding overridden back to this chip's own original dimensions. -->
        <Button Grid.Column="2" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                Padding="8,1,8,1" Margin="0,0,8,0" VerticalAlignment="Center"
                Command="{Binding OpenOptionsToTxTabCommand}"
                ToolTip.Tip="{loc:Translate MainWindow.CallsignChip.Help}">
            <!-- Overrides IndustryMini's default 10px/mono metrics — this chip's own spec (design
               doc §1) is 12px with .08em letter-spacing = .08*12 = 0.96 device px, not the
               standard chip size, so set directly on the TextBlock rather than relying on the
               atom's own default Style. -->
            <TextBlock Text="{Binding CallsignDisplay}" FontWeight="Medium" FontSize="12" LetterSpacing="0.96" />
        </Button>
        </Grid>

        <!-- VFO / Favourites / Transceiver header cards: see Views/RadioHeaderView.axaml.
             Always visible regardless of which tab is active. -->
        <views:RadioHeaderView Grid.Row="1" DataContext="{Binding RadioStatus}" />

        <!-- Fixed Receive/Transmit/Gallery/Logbook tabs (spec/09-ui.md), replacing the former
             Dock.Avalonia DockControl. Each pane view-model is a plain DI singleton, rendered via
             ContentControl plus the app-wide ViewLocator (same auto-resolution Dock relied on before;
             see ViewLocator.cs's own doc comment).

             UI-redesign Phase 2: TabControl keeps Fluent's own default template entirely (no
             ControlTheme replacement — see Atoms.axaml's TabItem.Industry block comment); the
             right-aligned status-chip row is a SIBLING in this same Grid.Row, not baked into any
             shared control theme (design doc §0's blocker-2 fix — a shared TabControl theme reused
             later by the Options window's own unrelated TabControl would otherwise inherit this
             row bound against the wrong DataContext). -->
        <Grid Grid.Row="2">
        <TabControl Classes="Industry" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Receive}">
                <!-- Phase 3: 236,*,312 columns, gap 9, padding 9,11,9,8 (LAYOUT-SPEC §5 Band 4a /
                     PADDING-NORMALIZATION.md), was 258,*,330 / gap 4 / uniform 4. -->
                <Grid ColumnDefinitions="236,*,312" ColumnSpacing="{StaticResource IndustrySpacingGutter}" Margin="9,11,9,8">

                    <!-- Left column: re-skinned to Industry atoms (Phase 3). Every real binding
                         preserved exactly (see original per-card comments migrated below); row SETS
                         also preserved exactly as they exist today even where the mockup's own
                         Input-chain row set differs (mockup shows "SNR est."/"DC offset" as its 5th/
                         8th rows; this app's real telemetry has AGC gain/Noise floor there instead —
                         keeping the real AgcGainDisplay binding, not relabeling to match a mockup
                         row this app doesn't actually measure). Slant ppm/Sync offset stay
                         READ-ONLY value rows, not interactive steppers, despite the mockup showing
                         stepper controls there: RxImagePaneViewModel exposes these as formatted
                         DISPLAY strings only (SlantPpmDisplay/SyncOffsetSamplesDisplay), not
                         editable numeric properties — this port has no real "manually adjust slant"
                         feature (Re-sync exists instead), so binding a stepper's Value to a string
                         isn't possible without inventing a fake editable property; same
                         preserve-real-behavior discipline as Phase 2's RX-level meter staying
                         display-only. -->
                    <ScrollViewer Grid.Column="0">
                        <!-- Margin top=6 (not the outer Grid's own padding — this is INSIDE the
                             ScrollViewer): a ScrollViewer necessarily clips its content to its own
                             viewport, so unlike a plain Grid cell (fixed via ClipToBounds=False on
                             the atom itself), the FIRST card's title notch here still needs literal
                             headroom reserved before it, or it clips against the viewport's own top
                             edge regardless of the atom-level fix. -->
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Classes="Industry" Margin="0,6,0,0">
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxImage.ModeCardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <!-- Segmented control needs BOTH Classes (for the item-0b marker
                                       + IndustrySeg's Padding/interaction-state Style selectors)
                                       AND an explicit Theme= (a ControlTheme is not applied by
                                       Classes alone — same rule as every other named ControlTheme
                                       atom in this file); missing Theme= here silently fell back to
                                       Fluent's default RadioButton bullet-dot look, caught via a
                                       real-window screenshot. Also needs a horizontal 2-column
                                       Grid, not bare StackPanel children (StackPanel's default
                                       Orientation is Vertical, which stacked the segments instead
                                       of placing them side by side). -->
                                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,2">
                                        <RadioButton Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="RxModeAutoLocked" IsChecked="True" Content="{loc:Translate Panes.RxImage.AutoLockedAuto}" />
                                        <RadioButton Grid.Column="1" Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="RxModeAutoLocked" Content="{loc:Translate Panes.RxImage.AutoLockedLocked}" IsEnabled="False" ToolTip.Tip="{loc:Translate Panes.RxImage.LockedMode.Help}" />
                                    </Grid>
                                    <ComboBox Classes="Industry IndustryInput" HorizontalAlignment="Stretch" SelectedIndex="0" ToolTip.Tip="{loc:Translate Panes.RxImage.ModeOverride.Help}">
                                        <ComboBoxItem Content="{Binding DetectedModeDisplay}" />
                                    </ComboBox>
                                    <!-- spec/18-path-to-1.0.md High item 7: quick-mode buttons force the NEXT
                                       decode into a specific mode via QuickSelectModeCommand (ISstvDecoder.ForceMode,
                                       a one-shot kick, not a persistent lock: see DetectedMode's own doc comment).
                                       CommandParameter is each mode's real SstvModeDefinition.Id, not the pill's own
                                       display label. M3/M4 were relabeled from non-existent "Martin M3/M4" to the
                                       real R24/PD240 modes (see the plan doc for that judgment call). -->
                                    <UniformGrid Columns="4" Rows="4">
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.SC1}" Command="{Binding QuickSelectModeCommand}" CommandParameter="scottie-s1" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.SC2}" Command="{Binding QuickSelectModeCommand}" CommandParameter="scottie-s2" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.SCDX}" Command="{Binding QuickSelectModeCommand}" CommandParameter="scottie-dx" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.M1}" Command="{Binding QuickSelectModeCommand}" CommandParameter="martin-m1" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.M2}" Command="{Binding QuickSelectModeCommand}" CommandParameter="martin-m2" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.M3}" Command="{Binding QuickSelectModeCommand}" CommandParameter="r24" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.M4}" Command="{Binding QuickSelectModeCommand}" CommandParameter="pd240" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.R36}" Command="{Binding QuickSelectModeCommand}" CommandParameter="robot-36" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.R72}" Command="{Binding QuickSelectModeCommand}" CommandParameter="robot-72" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.PD50}" Command="{Binding QuickSelectModeCommand}" CommandParameter="pd50" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.PD90}" Command="{Binding QuickSelectModeCommand}" CommandParameter="pd90" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.PD120}" Command="{Binding QuickSelectModeCommand}" CommandParameter="pd120" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.PD160}" Command="{Binding QuickSelectModeCommand}" CommandParameter="pd160" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.PD180}" Command="{Binding QuickSelectModeCommand}" CommandParameter="pd180" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.PD290}" Command="{Binding QuickSelectModeCommand}" CommandParameter="pd290" />
                                        <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="1" Content="{loc:Translate Panes.QuickModeGrid.SC2180}" Command="{Binding QuickSelectModeCommand}" CommandParameter="sc2-180" />
                                    </UniformGrid>
                                    <!-- Wired 2026-08-25 (elegant-wondering-hinton.md): port of legacy's
                                         RX-page SBAuto toggle (TMmsstv::RxAutoPush, Main.cpp:6042-6060)
                                         — a SEPARATE, distinct control from the Auto/Locked segment
                                         above (that one is about mode-selection persistence, a
                                         different concept, still an unresolved stub from an earlier
                                         audit — not repurposed here). Pausing stops the decoder from
                                         searching for/decoding pictures; the waterfall keeps running,
                                         but the signal-level meter and station-ID decode pause too
                                         (session-layer design, not decoder-owned — see
                                         ISstvSessionService.SetAutoDetectPaused's own doc comment for
                                         the four-round plan-review reasoning). Forcing a specific mode
                                         (the quick-mode buttons above) automatically resumes. -->
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.RxImage.AutoDetect}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Panes.RxImage.AutoDetect.Help}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,2">
                                        <RadioButton Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="RxAutoDetectPause" Content="{loc:Translate Panes.RxImage.AutoDetectListening}" IsChecked="{Binding !IsAutoDetectPaused}" />
                                        <RadioButton Grid.Column="1" Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="RxAutoDetectPause" Content="{loc:Translate Panes.RxImage.AutoDetectPaused}" IsChecked="{Binding IsAutoDetectPaused}" />
                                    </Grid>
                                    <StackPanel Classes="Industry IndustryRows">
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxImage.LineTime}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding LineTimeText}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxImage.Lines}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding LinesText}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxImage.Remaining}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding RemainingText}" /></Grid></Border>
                                    </StackPanel>
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Sync & slant: Slant ppm/Sync offset/Auto-correct/Re-sync/Correct-slant/
                                 Source are real, wired to RxImagePaneViewModel
                                 (spec/17-rx-telemetry-feasibility.md). VIS threshold has no row here
                                 yet at all (elegant-wondering-hinton.md item 6, a later batch). Reset
                                 and Advanced Timing (Sample clock/Sync window/Drop-line) were removed
                                 2026-08-25 — see the removal comment further down this card. -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxSync.CardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <StackPanel Classes="Industry IndustryRows">
                                        <!-- Wired 2026-08-25 (elegant-wondering-hinton.md item 5):
                                             SyncSourceDisplay, a live-polled 3-value classification
                                             (Idle/Locked/AvtTraining), not the originally-planned
                                             4-way Search/VisLock/Forced/AvtTraining split — see
                                             SstvSyncSource's own doc comment for why that split isn't
                                             honestly derivable from existing decoder state. -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.Source}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SyncSourceDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.SlantPpm}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SlantPpmDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.SyncOffset}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SyncOffsetSamplesDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.AutoCorrect}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding AutoCorrectDisplay}" /></Grid></Border>
                                        <!-- Wired 2026-08-25 (elegant-wondering-hinton.md item 6): a
                                             plain row, not behind the removed Advanced Timing
                                             disclosure — VisThresholdDisplay shows the preset NAME
                                             (Very low/Low/High/Very high), not a raw number; see that
                                             property's own doc comment for why a raw value or the
                                             original stub's fake "−26 dB" would both be dishonest. -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.VisThreshold}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding VisThresholdDisplay}" /></Grid></Border>
                                    </StackPanel>
                                    <!-- "Reset" button removed 2026-08-25: legacy DOES have a real
                                         Slant-Reset (Main.cpp:13186-13193, cited in ISstvDecoder.cs's
                                         own SlantPpm doc comment), but this port rebuilds its slant
                                         tracker per lock and tears it down at end-of-image, making a
                                         reset structurally inert against this port's own architecture
                                         — not a missing port, a structural mismatch. "Advanced Timing"
                                         disclosure (Sample clock/Sync window/Drop-line children) also
                                         removed same date: Sample clock's legacy equivalent is a manual
                                         calibration dialog (ClockAdj.cpp), not a passive readout, and
                                         this port's own Slant ppm row above is already the modern
                                         automatic equivalent; Sync window is static across a decoder
                                         instance's lifetime and its old placeholder value ("±4.8 ms")
                                         matched none of the real ported lock-timing constants; Drop-line
                                         has zero legacy grounding, identical to the already-removed
                                         Frame Metadata "Dropped lines" row. All per
                                         spec/17-rx-telemetry-feasibility.md. VIS threshold survives as
                                         a real value — see its own plain row below, not behind a
                                         disclosure. -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                        <!-- Padding="6,0" (design-fidelity-caught fix): IndustryBtn22's
                                             fixed 22px box was clipping the label's descenders/baseline
                                             against Fluent's own default Button padding. -->
                                        <Button Classes="Industry IndustryBtn22 IndustryBtnSecondary" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.RxSync.Resync}" Command="{Binding RequestReSyncCommand}" />
                                        <Button Grid.Column="1" Classes="Industry IndustryBtn22 IndustryBtnSecondary" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.RxSync.CorrectSlant}" Command="{Binding RequestCorrectSlantCommand}" />
                                    </Grid>
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Input chain: Device/BPF/Buffer/Clipping/AGC gain are real. Row SET
                                 preserved as this app's real telemetry (not the mockup's own
                                 "SNR est./DC offset" example rows, which this app doesn't compute -
                                 see block comment above). -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxInput.CardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <StackPanel Classes="Industry IndustryRows">
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Device}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding CaptureDeviceNameDisplay}" /></Grid></Border>
                                        <!-- "Squelch"/"Noise floor" removed 2026-08-25: legacy's only
                                             "squelch"-labeled control is a mistranslation of the VIS-lock
                                             sensitivity threshold (Option.cpp's Spanish "Nivel de
                                             Squelch" binds to m_SenseLvl, the same quantity as the Sync
                                             & Slant card's own "VIS threshold" row) — not a real RF
                                             squelch, so this row had no honest concept behind it distinct
                                             from that other row. Noise floor has zero legacy equivalent
                                             anywhere, same undefined-measurement class as the SNR rows
                                             already removed from Signal Quality. -->
                                        <!-- Wired 2026-08-25 (elegant-wondering-hinton.md item 7):
                                             RxBpfDisplay shows the preset NAME only, not a cutoff
                                             figure — the locked-filter cutoff differs from the
                                             search/pre-lock cutoff, so a single number would be wrong
                                             whenever this reads while unlocked (see
                                             ISstvDecoder.RxBpfPreset's own doc comment). Reuses the
                                             Options window's own real preset names. -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Bpf}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding RxBpfDisplay}" /></Grid></Border>
                                        <!-- Un-stub-RX-tab Piece A3: canonical state lives on WaterfallPaneViewModel
                                             (see its own NotchEnabled doc comment for why), reached from this
                                             row's own RxImage-scoped DataContext via $parent[Window].DataContext,
                                             same precedent as the RxFrameMeta card's own Frequency row reaching
                                             RadioStatus. Toggle chip mirrors PeakHold's own IndustryMiniToggleTheme
                                             two-way IsChecked binding. -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Notch}" />
                                            <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding $parent[Window].DataContext.Waterfall.NotchStatusDisplay}" />
                                            <ToggleButton Grid.Column="2" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="4,0,0,0"
                                                          IsChecked="{Binding $parent[Window].DataContext.Waterfall.NotchEnabled}"
                                                          Content="{loc:Translate Panes.RxInput.NotchToggle}"
                                                          ToolTip.Tip="{loc:Translate Panes.RxInput.NotchTooltip}" />
                                        </Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Agc}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding AgcGainDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Buffer}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding BufferedSampleCountDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Clipping}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding ClippingDisplay}" /></Grid></Border>
                                    </StackPanel>
                                    <!-- Stereo L/R level meters removed 2026-08-25: this port's demod
                                         path is deliberately mono-only, so a stereo meter needs a real
                                         architecture decision (does stereo capture belong in this port
                                         at all) before any code, not just wiring. Moved to
                                         spec/14-roadmap.md's "Explicitly deferred beyond v1" list. -->
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Signal quality: only Sync tone and Clip lo/hi are backed by real
                                 measurements. The SNR-per-line plot, Min/Max, luminance histogram,
                                 and Black/White tone rows were removed 2026-08-25 — no per-line SNR
                                 or histogram computation exists, and Black/White tone isn't a
                                 well-defined measurement even in principle (spec/17-rx-telemetry-
                                 feasibility.md). -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" VerticalAlignment="Stretch" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxSignal.CardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Classes="Industry IndustryRows">
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSignal.ClipLoHi}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding ClipLoHiDisplay}" /></Grid></Border>
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSignal.SyncTone}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SyncToneDisplay}" /></Grid></Border>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Centre: Spectrum & waterfall + Incoming frame, both restyled in place
                         (Border Classes="IndustryPlot" now lives inside WaterfallPaneView.axaml/
                         RxImagePaneView.axaml themselves); no new PlotView abstraction. Row 0
                         reverted from 154 back to 182 (design-fidelity-caught fix, user-reported):
                         the earlier 180->154 reversion assumed the ONLY reason 180 was ever needed was a
                         since-fixed NumericUpDown clipping bug, but the settings column's real
                         content (Bins/px + Start + Span + Gain + Zero + Peak hold + the Both/Spec/WF
                         segment, 7 stacked items) genuinely doesn't fit in 154 even now that the
                         whole card is re-skinned to the compact Industry atoms: Peak hold rendered
                         flush against the card's own bottom border with near-zero clearance, and the
                         segment row below it was clipped out of existence entirely, invisible. -->
                    <!-- User-reported fix (2026-08-23): wrapped in a ScrollViewer with the inner
                         Grid pinned to its own current computed height (834 — Window
                         Height=1032, minus 26/menu + 102/header-cards + 25/status-bar rows, minus
                         the tab strip's own 26px, minus this tab's own Margin top/bottom 11+8;
                         see MainWindow.axaml's own Window-element doc comment for why the window
                         itself is resizable shorter now) rather than letting Row 1 below ("*")
                         keep dividing whatever space happens to be left. A window shorter than
                         its old fixed 1032 floor used to make this Grid's "*" row shrink for
                         real — most visibly, the Incoming-frame preview's Viewbox scaling the
                         320x256 image down to near-illegible — instead of the window just
                         scrolling to reveal the rest, which is what every other "too much
                         content, not enough window" case in this app already does. Pinning the
                         Grid's own Height keeps 100% of its internal "182,*,150" math (and every
                         pixel-tuned value inside it) running exactly as before; only the
                         ScrollViewer around it is new. -->
                    <ScrollViewer Grid.Column="1">
                    <!-- Margin top=6, same fix/reasoning as the left column's own ScrollViewer
                         content above: a ScrollViewer clips to its own viewport regardless of a
                         child's own ClipToBounds="False", so the first card's title notch (drawn
                         above its own border, per IndustryGroupBoxTheme's notch-over-border
                         recipe) needs literal headroom here or it clips against the viewport's
                         top edge when scrolled fully up (user-caught, 2026-08-23: "Spectrum &
                         Waterfall" text chopped off at the top after this ScrollViewer wrap). -->
                    <!-- Row 0 trimmed 182 to 166 (user-caught, live screenshot measurement): the
                         plot area (SpectrumTraceControl/WaterfallPaneView, both stretch to fill this
                         row) was rendering ~16px taller than the settings column beside it actually
                         needs (Bins/px through the Both/Spec/WF segmented row), leaving a visible
                         strip of empty IndustryPlot background under the waterfall with nothing on
                         the right to match it. Height stays 834 total — the freed 16px is absorbed
                         by row 1's own "*" (Incoming Frame grows slightly), not subtracted from the
                         whole card. -->
                    <Grid Height="834" Margin="0,6,0,0" RowDefinitions="166,*,150" RowSpacing="{StaticResource IndustrySpacingGroup}">
                        <!-- Spectrum & waterfall (batch 8b): SpectrumTraceControl (new, real FFT
                             line trace + markers + peak-hold) fills what was the literal "Spectrum"
                             placeholder; WaterfallPaneView (ContentControl bound to Waterfall) is
                             the existing real scrolling waterfall. Both plot columns are bound
                             directly against MainViewModel's own Waterfall child property (dotted
                             path), same pattern the settings column below already used for Gain/
                             Zero; SpectrumTraceControl does NOT need to be inside
                             WaterfallPaneView.axaml's own view for this to work. Column widths are
                             driven by ViewMode via WaterfallViewModeToColumnWidthConverter, not
                             IsVisible alone (auditor-caught: IsVisible would leave the collapsed
                             plot's own Star column at half width, producing a half-empty card
                             instead of the other plot expanding to fill it). -->
                        <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/
                             "caption"/"plot"/"label"/"tight"/"seg" styling). RangeCaption moved
                             from the notch-title row into the card body (same precedent as the
                             header row's own UTC-clock readout): the notch title's wrapping Border
                             is HorizontalAlignment="Left" with no explicit Width, so a "*" column
                             inside it has nothing finite to divide against; putting the caption in
                             the body instead avoids that trap entirely. -->
                        <HeaderedContentControl Grid.Row="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWide}">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.Waterfall.CardHeader}" />
                            </HeaderedContentControl.Header>
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="10"
                                           Foreground="{StaticResource IndustryLabel}" HorizontalAlignment="Right"
                                           Margin="0,0,0,4" Text="{Binding Waterfall.RangeCaptionDisplay}" />
                                <Grid Grid.Row="1" ColumnSpacing="{StaticResource IndustrySpacingWide}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Waterfall.ViewMode, Converter={x:Static conv:WaterfallViewModeToColumnWidthConverter.Instance}, ConverterParameter=Spectrum}" />
                                        <ColumnDefinition Width="{Binding Waterfall.ViewMode, Converter={x:Static conv:WaterfallViewModeToColumnWidthConverter.Instance}, ConverterParameter=Waterfall}" />
                                        <ColumnDefinition Width="146" />
                                    </Grid.ColumnDefinitions>
                                    <Border Classes="IndustryPlot">
                                        <controls:SpectrumTraceControl Frame="{Binding Waterfall.LatestFrame}"
                                                                        ZeroDb="{Binding Waterfall.ZeroDb}"
                                                                        GainDb="{Binding Waterfall.GainDb}"
                                                                        StartHz="{Binding Waterfall.StartHz}"
                                                                        SpanHz="{Binding Waterfall.SpanHz}"
                                                                        PeakHoldEnabled="{Binding Waterfall.PeakHoldEnabled}"
                                                                        CurrentMode="{Binding Waterfall.CurrentMode}"
                                                                        NotchEnabled="{Binding Waterfall.NotchEnabled}"
                                                                        NotchFrequencyHz="{Binding Waterfall.NotchFrequencyHz}"
                                                                        NotchTuneRequestedCommand="{Binding Waterfall.TuneNotchCommand}"
                                                                        BinsPerPixel="{Binding Waterfall.BinsPerPixel, Mode=OneWayToSource}" />
                                    </Border>
                                    <ContentControl Grid.Column="1" Content="{Binding Waterfall}" />
                                    <StackPanel Grid.Column="2" Classes="Industry IndustryRows" Spacing="1">
                                        <!-- Read-only: a live readout of what Start/Span/this
                                             control's own actual rendered width currently work out
                                             to, not an independent user input (auditor round-2
                                             finding: three independent knobs for two real degrees
                                             of freedom is over-determined and inconsistent). -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.BinsPerPixel}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" MinWidth="62" HorizontalAlignment="Right" IsEnabled="False" Value="{Binding Waterfall.BinsPerPixel}" />
                                        </Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Start}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" MinWidth="72" HorizontalAlignment="Right" Increment="100" Value="{Binding Waterfall.StartHz}" />
                                        </Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Span}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" MinWidth="72" HorizontalAlignment="Right" Increment="100" Value="{Binding Waterfall.SpanHz}" />
                                        </Grid></Border>
                                        <!-- Gain/Zero share one row (mockup's own layout, not two
                                             full-width slider rows), real now (batch 8a); drive
                                             both WaterfallControl's color mapping AND
                                             SpectrumTraceControl's vertical scale (see
                                             SpectrumTraceMath.MapDbToY's own doc comment for why the
                                             same sliders control both). Minimum/Maximum are load-
                                             bearing: RangeBase coerces Value into [Minimum,Maximum]
                                             and Value is TwoWay by default, so if these were ever
                                             dropped a -70 ZeroDb default would clamp against
                                             RangeBase's own default 0..100 range and silently write
                                             the clamped value back into the view-model. -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,38,Auto,38" ColumnSpacing="6">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Gain}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustrySliderTheme}" Minimum="20" Maximum="80" Value="{Binding Waterfall.GainDb}" />
                                            <TextBlock Grid.Column="2" Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Zero}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="3" Classes="Industry" Theme="{StaticResource IndustrySliderTheme}" Minimum="-70" Maximum="30" Value="{Binding Waterfall.ZeroDb}" />
                                        </Grid></Border>
                                        <!-- No mockup CheckBox atom exists (the "Peak hold" toggle is
                                             real app functionality, batch 8b, with no mockup
                                             equivalent), represented as a .mini toggle chip instead,
                                             matching the app's own established convention for real-
                                             functionality toggles without a direct mockup site (e.g.
                                             the header row's CAT-linked chip). Own row, since the
                                             mockup's segment row (below) has no Peak-hold sibling to
                                             model a combined layout on. -->
                                        <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" HorizontalAlignment="Left" Margin="0,2,0,0" IsChecked="{Binding Waterfall.PeakHoldEnabled}" Content="{loc:Translate Panes.Waterfall.PeakHold}" />
                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,2,0,0">
                                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}" GroupName="PlotView" IsChecked="{Binding Waterfall.IsViewBoth}" Content="{loc:Translate Panes.Waterfall.ViewBoth}" />
                                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}" GroupName="PlotView" IsChecked="{Binding Waterfall.IsViewSpectrumOnly}" Content="{loc:Translate Panes.Waterfall.ViewSpec}" />
                                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}" GroupName="PlotView" IsChecked="{Binding Waterfall.IsViewWaterfallOnly}" Content="{loc:Translate Panes.Waterfall.ViewWf}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </HeaderedContentControl>
                        <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/
                             "primary"/"value"/"caption"/"thumb"/"pill"/"readoutSmall" styling).
                             One of the design's 2 real "gb blueprint" (title notch + corner marks
                             together) sites, per Atoms.axaml's own item-1 correction. -->
                        <HeaderedContentControl Grid.Row="1" Classes="Industry blueprint" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWideDeep}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxImage.CardHeader}" />
                            </HeaderedContentControl.Header>
                            <DockPanel LastChildFill="True">
                                <!-- Bottom action bar: Abort wired 2026-08-26 (stub survey Tier 1) —
                                     ISstvSessionService.AbortReception, an invented UI affordance
                                     with no legacy precedent (RequestAbandonReception exists but
                                     nothing in legacy exposes it as a user-facing button). Log
                                     QSO is real (wired 2026-08-15, see the inner comment below).
                                     Record/Re-decode wired as Piece C1/C2 (RX tab Re-decode port).
                                     Progress bar/count are real too (spec/18-path-to-1.0.md High
                                     item 9): RxImage.Progress/LineProgressText, the same properties
                                     already bound in the status bar (:1483-ish). DockPanel (not
                                     StackPanel): buttons left, count
                                     pinned far right (no "Ln" prefix - just the raw x/y count),
                                     progress bar fills the middle gap between them - matches
                                     mock2's own bar-fills-the-row shape while keeping the frame
                                     count visible per direct user request. The redundant top-right
                                     header caption (same value, different spot) was dropped. -->
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingSnug}">
                                        <!-- Save Frame/Copy-to-TX wired 2026-08-18 (RxImagePaneViewModel.
                                             SaveFrameCommand / TxControlsPaneViewModel.CopyReceivedImageToTxCommand
                                             — see their own doc comments; Copy-to-TX has a real legacy
                                             precedent, fileview.cpp's CopyRectBitmap(pBitmapTXM)).
                                             This DockPanel's own DataContext is MainViewModel, not
                                             RxImage/TxControls, so
                                             every binding here is explicitly qualified. -->
                                        <Button Classes="Industry IndustryBtn IndustryBtn25 IndustryBtnPrimary" Content="{loc:Translate Panes.RxImage.SaveFrame}" Command="{Binding RxImage.SaveFrameCommand}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn25 IndustryBtnSecondary" Content="{loc:Translate Panes.RxImage.Abort}" Command="{Binding RxImage.AbortCommand}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn25 IndustryBtnSecondary" Content="{Binding RxImage.RecordButtonLabel}" Command="{Binding RxImage.ToggleRecordingCommand}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn25 IndustryBtnSecondary" Content="{loc:Translate Panes.RxImage.RedecodeAction}" Command="{Binding RxImage.RedecodeCommand}" />
                                        <!-- Round-1 code-review finding: without this, a genuine
                                             in-progress edit (CanChangeSourceOrMode false) left the
                                             button looking live while TryClaimEditorSlotForNewSource
                                             silently refused it — the same bindable check Browse/
                                             Stock already use (TxControlsPaneView.axaml). -->
                                        <Button Classes="Industry IndustryBtn IndustryBtn25 IndustryBtnSecondary" Content="{loc:Translate Panes.RxImage.CopyToTx}" Command="{Binding TxControls.CopyReceivedImageToTxCommand}" IsEnabled="{Binding TxControls.CanChangeSourceOrMode}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn25 IndustryBtnSecondary" Content="{loc:Translate Panes.RxImage.LogQso}" Command="{Binding RxImage.LogQsoCommand}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Classes="IndustryRowValue" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding RxImage.LineProgressText}" />
                                    <ProgressBar Classes="Industry" VerticalAlignment="Center" Margin="12,0,0,0" Minimum="0" Maximum="1" Value="{Binding RxImage.Progress, TargetNullValue=0}" />
                                </DockPanel>
                                <!-- Same IsNotNull-gated error-text pattern as QrzLookupErrorMessage
                                     above (Panes.RxFrameMeta card) — SaveFrameErrorMessage's own doc
                                     comment on RxImagePaneViewModel. -->
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" Text="{Binding RxImage.SaveFrameErrorMessage}"
                                           Foreground="{StaticResource IndustryDanger}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding RxImage.SaveFrameErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <!-- Piece C1/C2: same IsNotNull-gated error-text pattern. -->
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" Text="{Binding RxImage.RecordErrorMessage}"
                                           Foreground="{StaticResource IndustryDanger}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding RxImage.RecordErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" Text="{Binding RxImage.RedecodeErrorMessage}"
                                           Foreground="{StaticResource IndustryDanger}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding RxImage.RedecodeErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <!-- Previous-frames strip relocated here from its own right-column
                                     card, matching mock2's own placement (inside the Incoming-frame
                                     card, beside the image); still the same real
                                     RxHistoryPaneViewModel.Entries binding, just repositioned and
                                     widened 160->266 to match mock2. Mode-pill badge overlay and
                                     callsign line are literal: ReceiveHistoryEntry has no
                                     callsign field (see RxHistoryPaneViewModel.cs's own doc
                                     comment), same precedent as Frame metadata's static text. -->
                                <!-- Frame column is Auto, not a fixed/star width: a plain Border/
                                     Image (no PlotView/aspect-ratio-converter exists in this
                                     codebase) has no intrinsic size, so a star column just
                                     stretched it edge-to-edge with no 5:4 constraint at all.
                                     Viewbox around a fixed 320x256 box (real SSTV frame
                                     dimensions) uniformly scales to the row's available height
                                     and reports that scaled width back to the Auto column -
                                     no C# measure override needed. Previous-frames now gets
                                     whatever's left, matching mock2's own intent. -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource IndustrySpacingGutter}" Margin="0,4,0,0">
                                    <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                                        <Border Width="320" Height="256">
                                            <ContentControl Content="{Binding RxImage}" />
                                        </Border>
                                    </Viewbox>
                                    <!-- Nested group box (mockup's own "gb" inside "gb blueprint"),
                                         not a bare caption + list, design-fidelity-agent-caught fix:
                                         this nesting was missing entirely before. -->
                                    <HeaderedContentControl Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingNested}" ClipToBounds="False">
                                        <HeaderedContentControl.Header>
                                            <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxHistory.PreviousFramesHeader}" />
                                        </HeaderedContentControl.Header>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Top" Classes="IndustryRowValue"
                                                       Text="{loc:Translate Panes.RxHistory.NoHistoryYet}"
                                                       IsVisible="{Binding !RxHistory.Entries.Count}" />
                                            <ScrollViewer>
                                                <!-- UniformGrid Columns=2, not WrapPanel/fixed-Width
                                                     thumbs (design-fidelity-agent-caught fix): the
                                                     mockup's own grid-template-columns:repeat(2,1fr)
                                                     is a proportional 2-column grid, not a fixed
                                                     120px-per-item wrap; the old literal Width="120"
                                                     was ~2.9x smaller than the mockup's real fluid
                                                     cell size. -->
                                                <ItemsControl ItemsSource="{Binding RxHistory.Entries}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RxHistoryEntryViewModel">
                                                            <Border Classes="IndustryThumbnail" Margin="0,0,6,6">
                                                                <DockPanel LastChildFill="True">
                                                                    <Border DockPanel.Dock="Bottom" Classes="IndustryThumbnailCaption">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Classes="IndustryThumbnailCall" Text="{loc:Translate Panes.RxHistory.ThumbCallsignValue}" />
                                                                            <TextBlock Grid.Column="1" Classes="IndustryThumbnailMeta" Text="{Binding Entry.ReceivedAt, StringFormat=HH:mm:ss}" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <Panel>
                                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                                        <Border Classes="Industry IndustryMini" Background="{StaticResource IndustryBg}"
                                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" IsHitTestVisible="False">
                                                                            <TextBlock Text="{Binding Entry.ModeId}" />
                                                                        </Border>
                                                                    </Panel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </HeaderedContentControl>
                                </Grid>
                            </DockPanel>
                        </HeaderedContentControl>

                        <!-- Ported to Industry atoms. Visual scaffolding only, header-only (no
                             ItemsSource); no structured decode-history event log exists yet,
                             distinct from ReceiveHistoryStore (spec/14-roadmap.md backlog).
                             DataGrid replaced with a plain Grid/IndustryTable atom per the design
                             doc's own item-10 decision (a real Avalonia.Controls.DataGrid fights
                             the design system's chrome for no benefit on a static, currently
                             header-only 9-column table; package removal deferred to whichever
                             phase confirms nothing else still references the old DataGrid theme). -->
                        <!-- Decoder Trace moved out of this card 2026-08-25 (user-suggested layout
                             fix, live-observed): the right column below (Grid.Column="2") had a
                             completely empty row since the Unattended-RX/Session-Frames cards were
                             removed, with far more real height and width (312px, not this card's own
                             squeezed 250px sub-column) available to it there. Back to the plain
                             single-content table this card had before Piece B2. -->
                        <HeaderedContentControl Grid.Row="2" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWide}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxDecodeLog.CardHeader}" />
                            </HeaderedContentControl.Header>
                            <!-- LastChildFill="False" (design-fidelity-caught fix, round 2): this
                                 DockPanel has only ONE child, so LastChildFill's own default of True
                                 made it (also being the last child) fill the WHOLE card body
                                 regardless of its Dock="Top": the header row's bottom rule ended up
                                 flush against the card's bottom edge instead of directly under the
                                 header text. -->
                            <DockPanel LastChildFill="False">
                                <!-- Border-per-cell (design-fidelity-caught fix over the first
                                     draft): mockup's <th style="padding:2px 5px"> pads EACH
                                     header cell individually, not just the row's own outer
                                     edges; a single Border wrapping the whole Grid would only
                                     apply IndustryTableHeaderRule's padding at the row's far
                                     left/right. -->
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*,*,*,*,*,*">
                                    <Border Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColUtc}" /></Border>
                                    <Border Grid.Column="1" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColFreq}" /></Border>
                                    <Border Grid.Column="2" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColMode}" /></Border>
                                    <Border Grid.Column="3" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColCallsign}" /></Border>
                                    <Border Grid.Column="4" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColGrid}" /></Border>
                                    <Border Grid.Column="5" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColSnr}" /></Border>
                                    <Border Grid.Column="6" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColSlant}" /></Border>
                                    <Border Grid.Column="7" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColLines}" /></Border>
                                    <Border Grid.Column="8" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.RxDecodeLog.ColState}" /></Border>
                                </Grid>
                                <!-- No data rows yet (header-only scaffolding, see above); an
                                     ItemsControl would need a real ItemsSource to add
                                     IndustryTableRowRule rows against, left empty until a real
                                     decode-history event log exists. -->
                            </DockPanel>
                        </HeaderedContentControl>
                    </Grid>
                    </ScrollViewer>

                    <!-- Right column, ported to Industry atoms (was old Cards.axaml "card"/
                         "cardHeader"/"kv"/"label"/"value"/"caption"/"small"/"readoutSmall"
                         styling). Frame metadata's "Started" and "Size on disk" rows are real
                         (spec/17-rx-telemetry-feasibility.md), wired to RxImagePaneViewModel (file
                         size only populates once the frame's own save completes; see
                         FileSizeBytes' own doc comment; a still-in-progress or abandoned/partial
                         frame reads "—"). Callsign, QRZ lookup, and note/override-callsign are also
                         real now (see their own row comments below); Frequency, Mode/VIS, and grid/
                         dist's distance half remain unwired, and Unattended RX's scan/watch state
                         has no backing data or feature at all yet (spec/14-roadmap.md backlog:
                         "Frame metadata card"/"Unattended RX"). Row
                         SET (both cards) deliberately kept as this app's EXISTING real+literal
                         field inventory, not the mockup's own row set (which shows extra "File"/
                         "Sidecar"/"Disk" rows this app doesn't compute) — same preserve-real-
                         behavior precedent as the left column's Input-chain card. Session frames
                         is a distinct placeholder list matching mock2's own Callsign/Mode/Meta
                         text format; not a second copy of the real thumbnail strip, which lives in
                         the Incoming-frame card above.

                         DEFERRED, off-scope for this pass: the mockup's own 4th card, "Macros"
                         (F1-F6 mini-chip buttons), doesn't exist anywhere in this app today (no
                         backing command/feature) — building it is new scope, not a re-skin of an
                         existing old-design card, so it's not added here; would need a real
                         product decision on what F1-F6 actually invoke first. -->
                    <!-- Same ScrollViewer + pinned-Height fix as the middle column above, and same
                         834 figure — this column is a sibling in the same outer Grid row, so it
                         gets exactly the same available height. Auditor code-review correction
                         (2026-08-25): this comment used to describe a Row 2 ("*", Session Frames)
                         that no longer exists — that card was removed and Decoder Trace now
                         occupies the row instead, see this Grid's own RowDefinitions comment
                         below. -->
                    <ScrollViewer Grid.Column="2">
                    <!-- Same top-headroom fix as the middle column above (and the pre-existing
                         left column) — ScrollViewer clips to its own viewport, so the first
                         card's title notch needs literal headroom or it clips when scrolled fully
                         up. -->
                    <!-- RowDefinitions simplified from "Auto,Auto,*" to "Auto,*" 2026-08-25: the
                         middle Auto row existed for the since-removed Unattended-RX card; Decoder
                         Trace (moved in below, replacing it and the also-removed Session Frames
                         card) is the row's only remaining occupant, so it gets a plain "*" row and
                         a plain Grid.Row="1", no RowSpan needed and no Auto/Star sizing mismatch
                         to reason about. -->
                    <Grid Height="834" Margin="0,6,0,0" RowDefinitions="Auto,*" RowSpacing="{StaticResource IndustrySpacingGroup}">
                        <HeaderedContentControl Grid.Row="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxFrameMeta.CardHeader}" />
                            </HeaderedContentControl.Header>
                            <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                <StackPanel Classes="Industry IndustryRows">
                                    <!-- Real FSK-decoded-callsign fix (0.9-beta UI-honesty pass):
                                         bound to CallsignDisplay, which mirrors the editable
                                         "Override callsign" TextBox below (both read OverrideCallsign,
                                         auto-filled by OnStationIdDecoded) instead of a hardcoded
                                         "EA7KDT" literal. Label trimmed to plain "Callsign" — the
                                         value no longer comes from OCR (which still doesn't exist),
                                         so keeping "· OCR" in the label would misattribute the source. -->
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.Callsign}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding CallsignDisplay}" /></Grid></Border>
                                    <!-- Wired 2026-08-11: real QRZ.com lookup (QrzCallsignLookup.cs).
                                         Name/QTH have no legacy-equivalent row in this card's original
                                         inventory (mock2 draws none), added because the lookup itself
                                         is real and needs somewhere to show its result. -->
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.NameLabel}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" TextTrimming="CharacterEllipsis" Text="{Binding NameDisplay}" /></Grid></Border>
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.QthLabel}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" TextTrimming="CharacterEllipsis" Text="{Binding QthDisplay}" /></Grid></Border>
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.GridDistance}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding GridDisplay}" /></Grid></Border>
                                    <!-- Ancestor-relative binding, not a new RxImagePaneViewModel
                                         dependency: RadioStatus lives on the root MainViewModel (this
                                         card's own DataContext is scoped to RxImage). This project
                                         does not enable Avalonia compiled bindings (no
                                         x:CompileBindings/AvaloniaUseCompiledBindingsByDefault
                                         anywhere) — this is a reflection binding, so a typo here
                                         would NOT fail the build, only log a binding error at
                                         runtime and render blank. Verify by running the app, not by
                                         trusting a green build alone (auditor-caught, 2026-08-25).
                                         FrequencyDisplayOrPlaceholder, not FrequencyDisplay: the
                                         status bar's own {Binding RadioStatus.FrequencyDisplay}
                                         (further down this file) deliberately shows a
                                         "000.000.000" idle readout with no rig connected — correct
                                         for a 7-segment-style status pill, but a fake-live literal
                                         if reused in this card of otherwise-honest "—" placeholder
                                         rows. Also live-VFO, not latched to the displayed frame's
                                         own receive frequency — ReceiveHistoryEntry carries no
                                         frequency field to latch from, so retuning after a decode
                                         will change what this row shows for an already-completed
                                         frame. Documented tradeoff, not an oversight. -->
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.Frequency}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding $parent[Window].DataContext.RadioStatus.FrequencyDisplayOrPlaceholder}" /></Grid></Border>
                                    <!-- DetectedModeDisplay is the same "{DisplayName} — VIS {VisCode}"
                                         property already used by the Mode panel's ComboBox. For a
                                         forced-mode reception there was no real VIS decode — this
                                         shows the locked mode's own expected VIS code, not a raw
                                         decoded byte (no raw byte is captured anywhere in the RX
                                         decode pipeline; VisLockStateMachine discards it after the
                                         registry lookup that resolves the mode). -->
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.ModeVis}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding DetectedModeDisplay}" /></Grid></Border>
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.Started}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding StartedDisplay}" /></Grid></Border>
                                    <!-- OCR row removed 2026-08-25: OCR itself is user-deferred to
                                         "maybe one day" (spec/14-roadmap.md's "Explicitly deferred
                                         beyond v1", Tier 3), not an active goal — no code or data
                                         stub for it remains in this card. -->
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.FileSize}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding FileSizeDisplay}" /></Grid></Border>
                                </StackPanel>
                                <!-- Plain 11px label, not a kicker (design-fidelity-caught fix
                                     over the first draft): mockup's <label style="font-size:11px">
                                     has no text-transform/letter-spacing/accent-color, unlike
                                     every other IndustryKicker use in this app. -->
                                <TextBlock Classes="IndustryRowLabel" Margin="0,2,0,0" Text="{loc:Translate Panes.RxFrameMeta.NoteLabel}" />
                                <!-- Wired 2026-08-18: was disabled — "this pane has no way to learn
                                     a just-saved frame's ReceiveHistoryEntry id yet"
                                     (spec/16-gui-wiring-survey.md's own PARTIAL finding). Closed via
                                     IReceiveHistoryStore.Recorded correlation (RxImagePaneViewModel.
                                     OnHistoryRecorded's own doc comment) — same real
                                     IReceiveHistoryStore.SetNoteAsync write the Gallery tab's own
                                     Note field already used, just reachable from here too now.
                                     CanEditFrameMetadata is false until that correlation lands. -->
                                <TextBox Classes="Industry IndustryInput" Text="{Binding Note}" Watermark="{loc:Translate Panes.RxFrameMeta.NoteWatermark}" IsEnabled="{Binding CanEditFrameMetadata}" />
                                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxFrameMeta.OverrideCallsignLabel}" />
                                <TextBox Classes="Industry IndustryInput" Watermark="{loc:Translate Panes.RxFrameMeta.CallsignValue}" Text="{Binding OverrideCallsign}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4" Margin="0,2,0,0">
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.RxFrameMeta.LookupQrz}" Command="{Binding LookupQrzCommand}" />
                                    <!-- Wired 2026-08-18: same real IReceiveHistoryStore.SetFlaggedAsync
                                         write as the Note field above — see that control's own
                                         comment. ToggleButton (not Button), matching the Gallery tab's
                                         own real flag toggle and this app's established
                                         IsChecked-bound-toggle-with-Industry-button-classes convention
                                         (e.g. the Transceiver card's Receiving toggle). -->
                                    <ToggleButton Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.RxFrameMeta.Flag}" IsChecked="{Binding IsFlagged}" IsEnabled="{Binding CanEditFrameMetadata}" />
                                </Grid>
                                <TextBlock Text="{Binding FrameMetadataErrorMessage}"
                                           Foreground="{StaticResource IndustryDanger}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding FrameMetadataErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding QrzLookupErrorMessage}"
                                           Foreground="{StaticResource IndustryDanger}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding QrzLookupErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Unattended RX and Session Frames cards removed 2026-08-25: neither had
                             a defined concept behind it — no scan/watch feature spec, no per-session
                             frame log design. Moved to spec/14-roadmap.md's "Explicitly deferred
                             beyond v1" list rather than left as UI stubs with no backing design. -->

                        <!-- Un-stub-RX-tab Piece B2: real Decoder Trace oscilloscope, moved here
                             2026-08-25 (user-suggested layout fix, live-observed) from a squeezed
                             250px sub-column inside the Decode Activity card. This column's own
                             row below Frame Metadata was completely empty (its Auto/Star pair
                             collapsed into a single "*" row above, once the since-removed
                             Unattended-RX/Session-Frames cards that used to occupy it were gone), so
                             the plot now gets both more width (this column's full 312px) and all the
                             remaining vertical space via that "*" row, instead of a fixed squeeze.
                             Capture button (legacy's real manual TrigNext trigger, Scope.cpp:83-89)
                             plus pan/zoom/gain buttons (legacy's real LeftBtn/RightBtn/SBUpW/SBDownW/
                             UpBtn/DownBtn, Scope.cpp:247-324, exact step math ported in
                             DecoderTracePaneViewModel, not invented) plus the two-channel trace plot
                             itself (DecoderTraceControl). -->
                        <HeaderedContentControl Grid.Row="1" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWide}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxDecodeLog.TraceHeader}" />
                            </HeaderedContentControl.Header>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Top" Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{loc:Translate Panes.RxDecodeLog.TraceCapture}" Command="{Binding DecoderTrace.CaptureCommand}" />
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="2" Margin="0,0,0,4">
                                    <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="{loc:Translate Panes.RxDecodeLog.TracePanLeft}" Command="{Binding DecoderTrace.PanLeftCommand}" IsEnabled="{Binding DecoderTrace.CanPanLeft}" ToolTip.Tip="{loc:Translate Panes.RxDecodeLog.TracePanTooltip}" />
                                    <Button Grid.Column="1" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="{loc:Translate Panes.RxDecodeLog.TracePanRight}" Command="{Binding DecoderTrace.PanRightCommand}" IsEnabled="{Binding DecoderTrace.CanPanRight}" ToolTip.Tip="{loc:Translate Panes.RxDecodeLog.TracePanTooltip}" />
                                    <Button Grid.Column="2" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="{loc:Translate Panes.RxDecodeLog.TraceZoomIn}" Command="{Binding DecoderTrace.NarrowWindowCommand}" IsEnabled="{Binding DecoderTrace.CanNarrowWindow}" ToolTip.Tip="{loc:Translate Panes.RxDecodeLog.TraceZoomTooltip}" />
                                    <Button Grid.Column="3" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="{loc:Translate Panes.RxDecodeLog.TraceZoomOut}" Command="{Binding DecoderTrace.WidenWindowCommand}" IsEnabled="{Binding DecoderTrace.CanWidenWindow}" ToolTip.Tip="{loc:Translate Panes.RxDecodeLog.TraceZoomTooltip}" />
                                    <Button Grid.Column="4" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="{loc:Translate Panes.RxDecodeLog.TraceGainDown}" Command="{Binding DecoderTrace.GainDownCommand}" ToolTip.Tip="{loc:Translate Panes.RxDecodeLog.TraceGainTooltip}" />
                                    <Button Grid.Column="5" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="{loc:Translate Panes.RxDecodeLog.TraceGainUp}" Command="{Binding DecoderTrace.GainUpCommand}" ToolTip.Tip="{loc:Translate Panes.RxDecodeLog.TraceGainTooltip}" />
                                    <Button Grid.Column="6" Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="{loc:Translate Panes.RxDecodeLog.TraceAutoGain}" Command="{Binding DecoderTrace.AutoGainCommand}" />
                                </Grid>
                                <Border Classes="IndustryPlot" ToolTip.Tip="{Binding DecoderTrace.WindowRangeDisplay}">
                                    <controls:DecoderTraceControl Channel0="{Binding DecoderTrace.Channel0Snapshot}"
                                                                   Channel1="{Binding DecoderTrace.Channel1Snapshot}"
                                                                   XOffset="{Binding DecoderTrace.XOffset}"
                                                                   XWindow="{Binding DecoderTrace.XWindow}"
                                                                   Gain="{Binding DecoderTrace.Gain}" />
                                </Border>
                            </DockPanel>
                        </HeaderedContentControl>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Transmit}">
                <!-- 236,* columns, gap 9, padding 9,11,9,8 (LAYOUT-SPEC §5 Band 4a /
                     PADDING-NORMALIZATION.md), same fix as the Receive tab (Phase 3) — this tab's
                     own outer Grid never got the token update, design-fidelity-agent-caught. Was
                     236,*,312 (a third, right-hand column) until the Mode-timing-reference card
                     that lived there was removed 2026-08-25 (user decision) — the editor column
                     absorbs the freed width automatically since it was already the "*" column. -->
                <Grid ColumnDefinitions="236,*" ColumnSpacing="{StaticResource IndustrySpacingGutter}" Margin="9,11,9,8">

                    <!-- Left: TxControlsPaneView's own restyled Mode/Identification/Output/Stock
                         cards. The TX volume slider now lives inside its Output card, ancestor-bound
                         to this same RadioStatus.TxVolumePercent value rather than a separate
                         standalone card here. Top headroom for the first card's title notch lives
                         INSIDE TxControlsPaneView.axaml's own root StackPanel (same fix, same
                         reasoning, as the Receive tab's own left column). A Margin on this
                         ScrollViewer element itself was tried first and did NOT fix the clipping
                         (confirmed empirically, real-window screenshot), only moving it onto the
                         scrolled CONTENT did. -->
                    <ScrollViewer Grid.Column="0">
                        <ContentControl Content="{Binding TxControls}" />
                    </ScrollViewer>

                    <!-- Centre: TX image editor, swapped in per Piece 2's nullable ActiveEditor
                         (a null Content just renders nothing, no visibility toggle needed). -->
                    <!-- User-reported fix (2026-08-23): same ScrollViewer + pinned-Height treatment
                         as the Receive tab's own middle/right columns, and the same 834 figure
                         (this tab shares the identical outer Grid shape, per this file's own
                         comment above). TxImageEditorPaneView.axaml's own root Grid
                         (RowDefinitions="Auto,Auto,*,Auto") stretches to fill whatever height its
                         host gives it, so pinning the height here keeps every nested "*" row
                         inside the editor computing against the same fixed total it always has,
                         rather than shrinking (and rescaling the TX canvas) when the window does. -->
                    <!-- Centre column now takes the full remaining width — was 236,*,312 (a
                         Mode-timing-reference card sat in the third, 312px column) until that card
                         was removed 2026-08-25 (user decision), so the editor gets that space
                         instead of leaving it empty. -->
                    <ScrollViewer Grid.Column="1">
                    <ContentControl Height="834" Margin="0,6,0,0" Content="{Binding ActiveEditor}" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Gallery}">
                <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/"caption"/
                     "segment"/"seg"/"small"/"thumb"/"pill"/"value"/"readoutSmall"/"plot"/"kv"/
                     "label"/"accentValue"/"primary" styling). *,312 grid (mock2's own layout, per
                     the plan doc), no blueprint corner marks on either card (mock2's own ".gb" here
                     has no "blueprint" class, unlike the Receive tab's Incoming-frame card). -->
                <Grid ColumnDefinitions="*,312" ColumnSpacing="{StaticResource IndustrySpacingGutter}" Margin="9,11,9,8" DataContext="{Binding RxHistory}">

                    <!-- Received-frame grid: All/Today filter is real (IReceiveHistoryStore's own
                         From/To fields, IndustryMiniRadioTheme chips matching mock2's own ALL/TODAY
                         .mini shape, not a .seg control); mock2's band/Unlogged/Flagged/free-text
                         filters and sort-by-callsign/SNR are omitted; ReceiveHistoryEntry has no
                         frequency/callsign/grid field to filter or sort by, and LinkedQsoId is never
                         set non-null by any code path today (spec/14-roadmap.md backlog). IsFlagged
                         is now a real field too (added after this comment was first written) but
                         has no consuming filter logic or per-entry set-flag UI yet either, see
                         spec/16-gui-wiring-survey.md's "Discovered 2026-08-11" note. Sort/Size
                         are literal IndustryMini chips (not the old design's unbound ComboBox —
                         mock2's own row shows these as static chips, not a real dropdown, and the
                         ComboBox never had a binding either). This list (and the Receive tab's own
                         Previous-frames strip, same shared VM instance) now refreshes live as new
                         frames land, not just at construction/manual-refresh/filter-change (batch 7,
                         IReceiveHistoryStore.Recorded). "Latest" button (SelectLatestCommand) is a
                         port of legacy's own SBPrim speed button, new UI since mock2's own draft has
                         no slot for it; "Refresh" kept for the same reason. All in one WrapPanel
                         (containment over an exact single-row match, same reasoning as every other
                         Phase 4 toolbar row). -->
                    <HeaderedContentControl Grid.Column="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWide}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxHistory.GalleryHeader}" />
                                <TextBlock Classes="IndustryGbTitle" Margin="4,0,0,0" Text="{Binding EntryCountText}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <DockPanel LastChildFill="True">
                            <!-- Top margin dropped (design-fidelity-agent-caught fix): mock2's own
                                 12px gap above the search row is entirely the card's own 11px
                                 padding + 1px border, this WrapPanel needs no additional top
                                 offset of its own. -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBox Classes="Industry IndustryInput" Width="230" Margin="0,0,4,4" Text="{Binding SearchText}" Watermark="{loc:Translate Panes.RxHistory.SearchWatermark}" />
                                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="GalleryFilter" Margin="0,0,4,4" IsChecked="{Binding !ShowTodayOnly}" Content="{loc:Translate Panes.RxHistory.FilterAll}" />
                                <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" GroupName="GalleryFilter" Margin="0,0,4,4" IsChecked="{Binding ShowTodayOnly}" Content="{loc:Translate Panes.RxHistory.FilterToday}" />
                                <!-- "14 MHz" frequency filter removed 2026-08-26 (user decision, "maybe
                                     one day") — ReceiveHistoryEntry has no frequency field to filter by,
                                     see spec/14-roadmap.md's backlog entry. Sort/Size chips removed
                                     outright 2026-08-26, same decision — both were static Borders
                                     (Panes.RxHistory.SortChip/SizeChip = "SORT NEWEST"/"SIZE M")
                                     asserting an active sort order / thumbnail-size setting that never
                                     existed (spec/16-gui-wiring-survey.md's own FAKE-LIVE finding,
                                     never previously actioned); no sort/size-selection logic exists
                                     anywhere in RxHistoryPaneViewModel. See spec/14-roadmap.md's
                                     backlog entry. -->
                                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="0,0,4,4" IsChecked="{Binding FilterUnloggedOnly}" Content="{loc:Translate Panes.RxHistory.FilterUnlogged}" />
                                <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="0,0,4,4" IsChecked="{Binding FilterFlaggedOnly}" Content="{loc:Translate Panes.RxHistory.FilterFlagged}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,4,4" Content="{loc:Translate Panes.RxHistory.Latest}" Command="{Binding SelectLatestCommand}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,0,4" Content="{loc:Translate Panes.RxHistory.Refresh}" Command="{Binding RefreshCommand}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="IndustryRowLabel"
                                       Text="{loc:Translate Panes.RxHistory.NoHistoryYet}"
                                       IsVisible="{Binding !Entries.Count}" />
                            <!-- Margin top=3 (design-fidelity-agent-caught fix): mock2's own 7px
                                 gap between the filter row and the thumbnail grid, on top of the
                                 filter row's own 4px bottom margin above. -->
                            <ScrollViewer Margin="0,3,0,0">
                                <!-- UniformGrid Columns=6 (mock2's own grid-template-columns:repeat(6,1fr)),
                                     not WrapPanel/fixed-Width thumbs — same fix class as the Receive
                                     tab's Previous-frames card. ListBox retained (not a bare
                                     ItemsControl) for the real SelectedEntry TwoWay binding.
                                     ItemContainerTheme (design-fidelity-agent-caught addition): this
                                     is the only Industry thumbnail grid built on a real ListBox
                                     (needed for SelectedEntry) rather than a plain ItemsControl, so
                                     without a matching container theme, default FluentTheme
                                     ListBoxItem chrome (padding, pointerover/selected fills) would
                                     leak around each figure — see the atom's own doc comment. -->
                                <ListBox ItemsSource="{Binding FilteredEntries}"
                                         SelectedItem="{Binding SelectedEntry}"
                                         ItemContainerTheme="{StaticResource IndustryListBoxItemTheme}"
                                         Background="Transparent"
                                         BorderThickness="0" Padding="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RxHistoryEntryViewModel">
                                            <!-- Mode badge overlaid top-left on the image (real Entry.ModeId);
                                                 IsHitTestVisible="False" so it never steals the click that
                                                 selects the ListBoxItem underneath. The bottom caption bar
                                                 (callsign/meta) was removed outright, stub sweep 2026-08-26:
                                                 ReceiveHistoryEntry has no such fields, so it was rendering
                                                 as two literal em-dashes under every thumbnail. -->
                                            <Border Classes="IndustryThumbnail" Margin="0,0,7,7">
                                                <Panel>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                    <Border Classes="Industry IndustryMini" Background="{StaticResource IndustryBg}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" IsHitTestVisible="False">
                                                        <TextBlock Text="{Binding Entry.ModeId}" />
                                                    </Border>
                                                </Panel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </HeaderedContentControl>

                    <!-- Right: selected-frame inspector (File/Mode/ReceivedAt only; no OCR/QRZ/
                         Log-entry fields exist — GridDistValue/LogEntryValue deliberately show
                         an honest em-dash placeholder / "Not logged", not mock2's own fake
                         "IM76 · 1,842 km"/"linked #4412" literal data, since this row has a REAL
                         selected entry with
                         some real fields mixed with genuinely-absent ones; showing fabricated data
                         next to real data would be misleading, unlike the TX tab's now-removed
                         Queue/TX-log cards, which had no real data mixed in at all) + Storage card
                         (real ImagesDirectory, resolved via
                         IReceiveHistoryStore.GetImagesDirectoryAsync). Disk-free is now real too
                         (RxHistory.DiskFreeDisplay, DriveInfo-based, stub sweep 2026-08-26). The
                         Sidecar-format row was removed outright in that same sweep — no
                         sidecar-file feature exists anywhere in this app, so it was a permanent
                         literal em-dash, unlike disk-free which just needed the DriveInfo read
                         wired up. -->
                    <!-- Same ScrollViewer + pinned-Height + top-headroom fix as the Receive/
                         Transmit tabs' own right columns — same 834 figure (identical outer Grid
                         shape/margins). Column 0's own gallery grid needs no equivalent fix: its
                         ListBox is already wrapped in its own ScrollViewer (a proper "arbitrarily
                         many thumbnails" scroll, unrelated to window height). -->
                    <ScrollViewer Grid.Column="1">
                    <Grid Height="834" Margin="0,6,0,0" RowDefinitions="*,Auto" RowSpacing="{StaticResource IndustrySpacingGroup}">
                        <HeaderedContentControl Grid.Row="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxHistory.SelectedFrameHeader}" />
                            </HeaderedContentControl.Header>
                            <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                <!-- §7.4 fixed exception: received-frame pane is content, not
                                     UI — ControlBorder (#A0A0A0), not ChromeBorder. -->
                                <Border BorderBrush="{StaticResource IndustryControlBorder}" BorderThickness="1" Height="190">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Classes="Industry IndustryRows">
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxHistory.FileLabel}" />
                                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" TextTrimming="CharacterEllipsis" Text="{Binding SelectedEntry.Entry.FilePath}" />
                                    </Grid></Border>
                                    <!-- Combined rows matching mock2's own layout: Mode is real
                                         (Entry.ModeId), SNR is literal (no per-frame SNR is tracked
                                         anywhere today, deliberately accepted placeholder). Time is
                                         real (Entry.ReceivedAt); the Frequency half was removed
                                         outright, stub sweep 2026-08-26 — ReceiveHistoryEntry has
                                         no captured-frequency field, so it was a literal em-dash, and
                                         the row's own label renamed from "Freq / time" to "Time" to
                                         match. HorizontalAlignment="Right" on the ModeSnr StackPanel
                                         itself (not just each child TextBlock, which IndustryRowValue
                                         already right-aligns within its OWN bounds to no visible
                                         effect inside a StackPanel) so that 2-part group sits at the
                                         row's right edge, matching every single-value row's own
                                         convention. -->
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxHistory.ModeSnrLabel}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <TextBlock Classes="IndustryRowValue" Text="{Binding SelectedEntry.Entry.ModeId}" />
                                            <TextBlock Classes="IndustryRowValue" Text="{loc:Translate Panes.RxHistory.SnrSuffixValue}" />
                                        </StackPanel>
                                    </Grid></Border>
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxHistory.FreqTimeLabel}" />
                                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" HorizontalAlignment="Right" Text="{Binding SelectedEntry.Entry.ReceivedAt, StringFormat=HH:mm:ss}" />
                                    </Grid></Border>
                                    <!-- Grid/dist row removed outright 2026-08-26 (user decision, "maybe
                                         one day") — was a static two-dashes-both-sides placeholder
                                         (spec/16-gui-wiring-survey.md's own PLACEHOLDER finding). The
                                         Receive tab's OWN Grid/dist row is real (RxImagePaneViewModel.
                                         GridDisplay, wired 2026-08-25) but its LookupGrid comes from a
                                         live FSK station-ID decode at reception time, reset to null at
                                         the start of the next reception — ReceiveHistoryEntry has no
                                         grid field at all, so there is nothing to show for a past
                                         entry without a real persistence change (either a new
                                         ReceiveHistoryEntry field, or falling back to the logged QSO's
                                         own GridSquare via LinkedQsoId for entries that have one). See
                                         spec/14-roadmap.md's backlog entry. -->
                                    <!-- Wired 2026-08-11: ReceiveHistoryEntry.LinkedQsoId is a real field,
                                         backed by IReceiveHistoryStore.SetLinkedQsoIdAsync. "Open in Log"
                                         below is now wired too (OpenInLogCommand, via QsoLinkWindowView),
                                         so this read-side badge now reflects a real write path. -->
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxHistory.LogEntryLabel}" />
                                        <Panel Grid.Column="1">
                                            <TextBlock Classes="IndustryRowValue" Text="{loc:Translate Panes.RxHistory.LogEntryValue}" IsVisible="{Binding SelectedEntry.Entry.LinkedQsoId, Converter={x:Static ObjectConverters.IsNull}}" />
                                            <TextBlock Classes="IndustryRowValue" Text="{loc:Translate Panes.RxHistory.LogEntryLoggedValue}" IsVisible="{Binding SelectedEntry.Entry.LinkedQsoId, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </Panel>
                                    </Grid></Border>
                                </StackPanel>
                                <!-- New UI, no mock2 slot for it (same "new UI, real gap" precedent as
                                     SelectLatestCommand elsewhere in this pane), backs the real,
                                     previously-unwired IReceiveHistoryStore.SetNoteAsync/SetFlaggedAsync
                                     (see spec/16-gui-wiring-survey.md's "Discovered 2026-08-11" note).
                                     Both disabled with nothing selected. -->
                                <TextBlock Classes="IndustryRowLabel" Margin="0,2,0,0" Text="{loc:Translate Panes.RxHistory.NoteLabel}" />
                                <TextBox Classes="Industry IndustryInput" Watermark="{loc:Translate Panes.RxHistory.NoteWatermark}"
                                         Text="{Binding SelectedEntryNote}"
                                         IsEnabled="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Panes.RxHistory.FlagLabel}"
                                          IsChecked="{Binding SelectedEntryIsFlagged}"
                                          IsEnabled="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <!-- Left-aligned, content-width buttons (design-fidelity-agent-caught
                                     fix): mock2's own row is NOT stretched — a "*,*,*" Grid was
                                     filling the whole 296px row width, ballooning each button ~20%
                                     wider than its own text needs and leaving no trailing gap, unlike
                                     mock2's own ~78px of empty space after "Re-decode". IndustryBtn24
                                     (not 25): mock2's own height:24px/font-size:11px for this
                                     specific row.
                                     Export wired 2026-08-15 (ExportFrameCommand, saves the selected
                                     frame's already-auto-saved PNG to a user-chosen location,
                                     optionally re-encoded as JPEG). Re-decode removed outright
                                     2026-08-26 (user decision, "maybe one day") — needs per-history-
                                     entry audio attachment, a materially bigger feature than the
                                     Receive tab's own record/play-a-file Re-decode; see
                                     spec/14-roadmap.md's backlog entry. -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0" Content="{loc:Translate Panes.RxHistory.OpenInLog}" Command="{Binding OpenInLogCommand}" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Panes.RxHistory.ExportFrame}" Command="{Binding ExportFrameCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource IndustryDanger}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding ExportStatusMessage}"
                                           Classes="IndustryRowLabel"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ExportStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Grid.Row="1" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxHistory.StorageHeader}" />
                            </HeaderedContentControl.Header>
                            <StackPanel Classes="Industry IndustryRows">
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxHistory.FolderLabel}" />
                                    <TextBlock Grid.Column="1" Classes="IndustryRowValue" TextTrimming="CharacterEllipsis" Text="{Binding ImagesDirectory}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxHistory.NamingLabel}" />
                                    <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxHistory.NamingValue}" />
                                </Grid></Border>
                                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxHistory.DiskLabel}" />
                                    <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding DiskFreeDisplay}" />
                                </Grid></Border>
                            </StackPanel>
                        </HeaderedContentControl>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Logbook}">
                <!-- No direct mockup for this tab (plan doc: "extrapolate using Phase 1's atom set
                     ... own lighter design-review pass since this is new composition, not a pixel
                     port"). Laid out to match what's normal in general ham-radio logbook software
                     (Log4OM/N1MM/DXKeeper-style): a sortable-looking multi-column QSO table on the
                     left (UTC/Callsign/Mode/RST-S/RST-R/Grid/Name — the real IndustryTable atoms,
                     first real ItemsSource-bound consumer of that pattern) rather than the old
                     design's 3-field single-line list, with the add/edit form + ADIF import/export
                     on the right, same *,380 two-column shape as every other tab. Same token
                     pattern as the pixel-matched tabs (ColumnSpacing=IndustrySpacingGutter,
                     Margin=9,11,9,8) for visual consistency with the rest of the app even though
                     nothing here is measured against a mockup. -->
                <Grid ColumnDefinitions="*,380" ColumnSpacing="{StaticResource IndustrySpacingGutter}" Margin="9,11,9,8" DataContext="{Binding Logbook}">

                    <!-- Left: search/browse. CallsignFilter is an exact, case-insensitive match
                         (SqliteLogbookRepository's own COLLATE NOCASE), not a substring search;
                         no watermark claims otherwise. FromDate defaults to 30 days ago on first
                         load (cheap paging insurance, spec/14-roadmap.md); ToDate is end-of-day
                         inclusive when set. DatePicker left un-re-skinned (accepted concession):
                         it's a composite control with its own popup calendar surface, deep enough
                         to re-theme that it isn't proportionate effort for a phase with no pixel
                         target — every other control on this tab uses real Industry atoms. -->
                    <HeaderedContentControl Grid.Column="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWide}" ClipToBounds="False">
                        <HeaderedContentControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.Logbook.CardHeader}" />
                                <TextBlock Classes="IndustryGbTitle" Margin="4,0,0,0" Text="{Binding EntryCountDisplay}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBox Classes="Industry IndustryInput" Width="180" Margin="0,0,4,4" Text="{Binding CallsignFilter}" Watermark="{loc:Translate Panes.Logbook.CallsignFilterWatermark}" />
                                <!-- TextBox, not DatePicker (containment fix): the default
                                     FluentTheme DatePicker template is a month/day/year spinner
                                     triplet whose own internal MinWidth ignores an explicit Width
                                     entirely (measured ~330px per picker, not the requested 130) —
                                     a real risk on a narrower window. Reuses UtcTimestampTextConverter
                                     (same converter/format the form's own Start/End fields already
                                     use, ConverterParameter=AllowNull since both filter bounds are
                                     optional) for a consistent, compact text-entry convention across
                                     the whole tab instead. -->
                                <TextBox Classes="Industry IndustryInput" Width="140" Margin="0,0,4,4" Watermark="{loc:Translate Panes.Logbook.FromWatermark}" Text="{Binding FromDate, Converter={x:Static conv:UtcTimestampTextConverter.Instance}, ConverterParameter=AllowNull}" />
                                <TextBox Classes="Industry IndustryInput" Width="140" Margin="0,0,4,4" Watermark="{loc:Translate Panes.Logbook.ToWatermark}" Text="{Binding ToDate, Converter={x:Static conv:UtcTimestampTextConverter.Instance}, ConverterParameter=AllowNull}" />
                                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Margin="0,0,0,4" Content="{loc:Translate Panes.Logbook.Refresh}" Command="{Binding RefreshCommand}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="IndustryRowLabel"
                                       Text="{loc:Translate Panes.Logbook.NoEntriesYet}"
                                       IsVisible="{Binding !Entries.Count}" />
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="120,85,55,45,45,55,90,*" ColumnSpacing="{StaticResource IndustrySpacingTight}" Margin="0,3,0,0">
                                <Border Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColUtc}" /></Border>
                                <Border Grid.Column="1" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColCallsign}" /></Border>
                                <Border Grid.Column="2" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColMode}" /></Border>
                                <Border Grid.Column="3" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColRstSent}" /></Border>
                                <Border Grid.Column="4" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColRstReceived}" /></Border>
                                <Border Grid.Column="5" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColGrid}" /></Border>
                                <Border Grid.Column="6" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColName}" /></Border>
                                <Border Grid.Column="7" Classes="IndustryTableHeaderRule"><TextBlock Classes="IndustryTableHeader" Text="{loc:Translate Panes.Logbook.ColNotes}" /></Border>
                            </Grid>
                            <ScrollViewer>
                                <!-- ItemContainerTheme (see IndustryListBoxItemTheme's own doc
                                     comment): a real ListBox, needed for SelectedEntry, would
                                     otherwise wrap every row in default FluentTheme ListBoxItem
                                     chrome. Mode column is the real SSTV sub-mode (SstvModeId),
                                     not the RadioMode enum (Usb/Lsb/Cw/...) — for an SSTV-focused
                                     log, the SSTV mode is the informative column; RadioMode is
                                     still edited in the form on the right. -->
                                <ListBox ItemsSource="{Binding Entries}"
                                         SelectedItem="{Binding SelectedEntry}"
                                         ItemContainerTheme="{StaticResource IndustryListBoxItemTheme}"
                                         Background="Transparent"
                                         BorderThickness="0" Padding="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="logbook:QsoRecord">
                                            <Grid ColumnDefinitions="120,85,55,45,45,55,90,*" ColumnSpacing="{StaticResource IndustrySpacingTight}">
                                                <Border Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" Text="{Binding StartUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" /></Border>
                                                <Border Grid.Column="1" Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" TextTrimming="CharacterEllipsis" Text="{Binding Callsign}" /></Border>
                                                <Border Grid.Column="2" Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" Text="{Binding SstvModeId}" /></Border>
                                                <Border Grid.Column="3" Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" Text="{Binding RstSent}" /></Border>
                                                <Border Grid.Column="4" Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" Text="{Binding RstReceived}" /></Border>
                                                <Border Grid.Column="5" Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" Text="{Binding GridSquare}" /></Border>
                                                <Border Grid.Column="6" Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" TextTrimming="CharacterEllipsis" Text="{Binding Name}" /></Border>
                                                <Border Grid.Column="7" Classes="IndustryTableRowRule"><TextBlock Classes="IndustryTableCell" TextTrimming="CharacterEllipsis" Text="{Binding Notes}" /></Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </HeaderedContentControl>

                    <!-- Right: add/edit form + ADIF import/export. Every timestamp shown/edited
                         here is raw UTC; no local-time conversion anywhere in this pane. Labeled
                         rows (Auto,* Grid: IndustryRowLabel + a real editable IndustryInput
                         control) for fields the old design already labeled explicitly; the
                         simpler free-text fields (Callsign/Name/QTH/Grid/Country/Notes) stay
                         Watermark-only TextBoxes, same convention as before. -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="{StaticResource IndustrySpacingGroup}">
                        <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.Logbook.FormHeader}" />
                            </HeaderedContentControl.Header>
                            <ScrollViewer>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <!-- "New" moved out of the header row (Industry's title notch
                                         has no room for a second, right-aligned element the way
                                         the old free-standing "cardHeader" row did) and into the
                                         form body instead. -->
                                    <Button Classes="Industry IndustryBtn IndustryBtn22 IndustryBtnSecondary" Padding="7,0" HorizontalAlignment="Right" Content="{loc:Translate Panes.Logbook.New}" Command="{Binding NewCommand}" />

                                    <TextBox Classes="Industry IndustryInput" Text="{Binding FormCallsign}" Watermark="{loc:Translate Panes.Logbook.Form.CallsignWatermark}" />

                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.Logbook.Form.StartLabel}" />
                                        <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding FormStartUtc, Converter={x:Static conv:UtcTimestampTextConverter.Instance}}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.Logbook.Form.EndLabel}" />
                                        <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding FormEndUtc, Converter={x:Static conv:UtcTimestampTextConverter.Instance}, ConverterParameter=AllowNull}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.Logbook.Form.FrequencyLabel}" />
                                        <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding FormFrequencyHz}" />
                                    </Grid>
                                    <!-- SelectedValueBinding/SelectedValue, NOT SelectedItem: AvailableModes'
                                         element type (RadioModeOption) differs from FormMode's type
                                         (RadioMode?); SelectedItem would never match an item and would
                                         silently null out FormMode on every selection (see RadioModeOption's
                                         own doc comment). -->
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.Logbook.Form.ModeLabel}" />
                                        <ComboBox Grid.Column="1" Classes="Industry IndustryInput" ItemsSource="{Binding AvailableModes}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding FormMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RadioModeOption">
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static conv:RadioModeDisplayConverter.Instance}">
                                                                <Binding />
                                                                <loc:Translate Key="Panes.Logbook.Form.NoModeOption" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <!-- Same SelectedValueBinding/SelectedValue reasoning as Mode above:
                                         AvailableSstvModes' element type is SstvModeDefinition, FormSstvModeId
                                         is string?. -->
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.Logbook.Form.SstvModeLabel}" />
                                        <ComboBox Grid.Column="1" Classes="Industry IndustryInput" ItemsSource="{Binding AvailableSstvModes}" SelectedValueBinding="{Binding Id}" SelectedValue="{Binding FormSstvModeId, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="sstv:SstvModeDefinition">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.Logbook.Form.RstSentLabel}" />
                                        <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding FormRstSent}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Panes.Logbook.Form.RstReceivedLabel}" />
                                        <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding FormRstReceived}" />
                                    </Grid>
                                    <TextBox Classes="Industry IndustryInput" Text="{Binding FormName}" Watermark="{loc:Translate Panes.Logbook.Form.NameWatermark}" />
                                    <TextBox Classes="Industry IndustryInput" Text="{Binding FormQth}" Watermark="{loc:Translate Panes.Logbook.Form.QthWatermark}" />
                                    <TextBox Classes="Industry IndustryInput" Text="{Binding FormGridSquare}" Watermark="{loc:Translate Panes.Logbook.Form.GridSquareWatermark}" />
                                    <TextBox Classes="Industry IndustryInput" Text="{Binding FormCountry}" Watermark="{loc:Translate Panes.Logbook.Form.CountryWatermark}" />
                                    <TextBox Classes="Industry IndustryInput" Text="{Binding FormNotes}" Watermark="{loc:Translate Panes.Logbook.Form.NotesWatermark}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.Logbook.Log}" Command="{Binding LogCommand}" IsVisible="{Binding !IsEditing}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.Logbook.Update}" Command="{Binding UpdateCommand}" IsVisible="{Binding IsEditing}" />
                                    </Grid>

                                    <TextBlock Text="{Binding StatusMessage}"
                                               TextWrapping="Wrap"
                                               Classes="IndustryRowLabel"
                                               IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </HeaderedContentControl>

                        <HeaderedContentControl Grid.Row="1" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.Logbook.AdifHeader}" />
                            </HeaderedContentControl.Header>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.Logbook.Import}" Command="{Binding ImportAdifCommand}" />
                                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.Logbook.Export}" Command="{Binding ExportAdifCommand}" />
                            </Grid>
                        </HeaderedContentControl>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Right-aligned status-chip row: new UI surface (design doc §3), none of this existed
             anywhere in the live app's tab-strip area before. Reuses real bindings where they
             exist rather than inventing parallel ones: DetectedModeDisplay/AutoCorrectDisplay/
             SlantPpmStatusBarDisplay are the SAME RxImagePaneViewModel properties the Receive tab's
             own cards and the status bar below already use — this duplicates that surface (matches
             LAYOUT-SPEC's own mockup, which shows slant/SNR on both bands, not a mistake). SNR has
             no backing property but is an honest "—" placeholder (assets/locale/en.json), same
             convention as the status bar's own SnrValue below. 2026-08-14: the detected-mode chip
             is now the real LED+lozenge atom (spec §6) — green LED, NEUTRAL lozenge (checklist
             "only TX-active and TX-inhibited lozenges are tinted" — this is the app's only real
             "decode locked" state, previously tinted, which tripped that rule). LED is conditional
             on a mode actually being detected — it was unconditionally green even while showing
             the "—" empty state, which read as fake-live once color started carrying real meaning.
             AutosaveOn was a plain affirmative "AUTOSAVE ON" claim with zero backing property,
             genuinely fake-live at the time — un-stubbed 2026-08-26 (stub survey Tier 1) once
             confirmed RX images ARE unconditionally auto-saved by ReceiveHistoryRecorder (no
             setting gates it), so the claim is simply true and needs no backing property at all. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="26" Margin="0,0,6,0" Spacing="5">
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{loc:Translate MainWindow.TabStrip.AutoDetect}" />
            </Border>
            <Border Classes="Industry IndustryStatus">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle Classes="Industry IndustryLed" Classes.active="{Binding RxImage.DetectedMode, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RxImage.DetectedModeDisplay}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{Binding RxImage.AutoCorrectDisplay}" />
            </Border>
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{Binding RxImage.SlantPpmStatusBarDisplay}" />
            </Border>
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{loc:Translate MainWindow.TabStrip.SnrValue}" />
            </Border>
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{loc:Translate MainWindow.TabStrip.AutosaveOn}" />
            </Border>
        </StackPanel>
        </Grid>

        <!-- Bottom status bar (mock2's own persistent readout row): a slim flat bar (top border
             only, no full card chrome), not part of any tab or header card. Left/right split via
             DockPanel matches mock2's own layout exactly ; "frames today/log" pinned to the far
             right edge, everything else flowing left. Receiving uses mock2's own accent-pill
             treatment (real IsReceiving, text "Receiving" not "RX" to match mock2's literal
             wording); TX-inhibit stays an LED dot + label ; a distinct alert state, not a mode
             indicator; mock2's own static render doesn't happen to show a not-inhibited state but
             the concept/wiring is real and kept per direct user request. TX-inhibit lights up when
             the last transmit attempt ended in an error/SWR-cutoff (TxControls.ErrorMessage); this
             app has no persistent transmit-lockout state to reflect more literally than that; see
             TxControlsPaneViewModel's own SWR-cutoff design for why. Frequency/Mode/DetectedMode/
             LineProgress/Slant/Buffer/FramesToday/LogSize are real (RadioStatus.FrequencyDisplay/
             ModeDisplay, RxImage.DetectedModeText/LineProgressText/SlantPpmStatusBarDisplay/
             BufferedSampleCountStatusBarDisplay, RxHistory.FramesTodayDisplay, Logbook.LogSizeDisplay,
             spec/17-rx-telemetry-feasibility.md). Buffer's own "· N XRUN" half (a separate
             audio-engine dropped-frame counter, not this decoder's own sample buffer) is real too
             now, recombined into mock2's original single format; see
             RxImagePaneViewModel.BufferedSampleCountStatusBarDisplay's own doc comment. SNR still
             has no backing property anywhere in the app (true per-line SNR still doesn't exist) and
             is a literal placeholder matching mock2's own exact wording, same precedent as the
             Receive tab's own scaffolding cards — a deliberately accepted gap, not a stray one
             (stub sweep, 2026-08-26). The Memory chip that used to sit here (same placeholder
             class) was removed outright in that same sweep — no memory-channel concept exists
             anywhere in IRadioSessionService to back it, unlike Disk below. Disk is now real
             (RxHistory.DiskFreeDisplay, DriveInfo-based, stub sweep 2026-08-26) — no longer a
             placeholder. -->
        <!-- UI-redesign Phase 2: height corrected to LAYOUT-SPEC's real 25 (was a pre-existing
             24px literal), all chips re-skinned to the .mini atom (design doc §4). Deliberately
             kept as separate Frequency/Mode chips, not merged into the mockup's one interpolated
             string — merging independently-live-updating bindings into a single formatted string
             is a real behavior change, not a pure re-skin (design doc §4's own flagged deviation).
             DISK was FAKE-LIVE as of this phase (no disk-space binding existed yet, matching the
             SnrValue/MemoryTag precedent of that time) — since made real, see the comment above.
             The TX-inhibit LED keeps its original visual unchanged (kept per direct user
             request, LAYOUT-SPEC's own static render just doesn't happen to show one) — Phase 7
             ported it 1:1 into Ellipse.IndustryLed/TextBlock.IndustryReadoutSmall (Atoms.axaml),
             same colors, just relocated off the deleted old-design files. -->
        <Border Grid.Row="3" Height="25" Classes="Industry" Background="{StaticResource IndustryBg}"
                BorderBrush="{StaticResource IndustryChromeBorder}" BorderThickness="0,1,0,0">
            <!-- Margin 8,3,8,3 (was 8,4,8,4, 2026-08-14): the new LED+lozenge status chips below
                 are the spec's real 19px (§6), 2px taller than the existing 17px IndustryMini
                 chips — loosened here to fit them without clipping; the 17px chips just sit
                 vertically centered in the now-slightly-taller row. -->
            <DockPanel Margin="8,3,8,3">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxHistory.FramesTodayDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding Logbook.LogSizeDisplay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <!-- LED+lozenge (spec §6): the app's only real "receiving" indicator plays the
                         primary-RX-banner role despite being a small status-bar chip, so it keeps
                         the green tint (user decision, 2026-08-14) with an LED added. -->
                    <Border Classes="Industry IndustryStatus" Classes.healthyTint="{Binding RadioStatus.IsReceiving}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Classes="Industry IndustryLed" Classes.active="{Binding RadioStatus.IsReceiving}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Translate MainWindow.StatusBar.Rx}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- LED+lozenge (spec §6): amber "TX error" row, not the red "fault" row —
                         still .attentionTint/.attention, not .dangerTint/.alert (that distinction
                         from the 2026-08-14 decision stands). Renamed from "TX INHIBIT" 2026-08-26
                         (direct user correction): the chip never actually inhibits/blocks a new
                         Transmit (see its own Help text, unchanged) — it is a status readout of
                         whether the LAST attempt errored or hit an automatic SWR cutoff, so "TX
                         ERROR" states what it actually is instead of implying a block that doesn't
                         exist. Was a bare Rectangle+TextBlock pair with no lozenge chrome at all. -->
                    <Border Classes="Industry IndustryStatus" Classes.attentionTint="{Binding TxControls.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{loc:Translate MainWindow.StatusBar.TxError.Help}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Classes="Industry IndustryLed" Classes.attention="{Binding TxControls.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Translate MainWindow.StatusBar.TxError}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- spec/18-path-to-1.0.md High item 10: live PTT/keyed readback from the
                         connected rig (RadioStatus.IsKeyed: RadioState.IsTransmitting, cleared
                         on CAT loss, see that property's own doc comment). Red "Transmitting" row
                         (mockups/colors/SSTV-Color-Scheme.md), distinct from the amber TX-ERROR
                         chip just above (.dangerTint/.alert, not .attentionTint/.attention). -->
                    <Border Classes="Industry IndustryStatus" Classes.dangerTint="{Binding RadioStatus.IsKeyed}"
                            ToolTip.Tip="{loc:Translate MainWindow.StatusBar.TxKeyed.Help}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Classes="Industry IndustryLed" Classes.alert="{Binding RadioStatus.IsKeyed}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Translate MainWindow.StatusBar.TxKeyed}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RadioStatus.FrequencyDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RadioStatus.ModeDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.DetectedModeText}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.LineProgressText}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{loc:Translate MainWindow.StatusBar.SnrValue}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.SlantPpmStatusBarDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.BufferedSampleCountStatusBarDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxHistory.DiskFreeDisplay}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>

</Window>
