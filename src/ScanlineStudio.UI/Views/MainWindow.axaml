<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        xmlns:views="using:ScanlineStudio.UI.Views"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:sstv="using:ScanlineStudio.Abstractions.Sstv"
        xmlns:logbook="using:ScanlineStudio.Abstractions.Logbook"
        xmlns:conv="using:ScanlineStudio.UI.Converters"
        xmlns:controls="using:ScanlineStudio.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="ScanlineStudio.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{loc:Translate MainWindow.Title}"
        Width="1920" Height="1032"
        MinWidth="1920" MinHeight="1032"
        WindowStartupLocation="CenterScreen">

    <!-- MainViewModel now requires AppDockFactory via DI, so no Design.DataContext previewer
         instance; see App.axaml.cs for how the real DataContext is resolved at runtime. -->

    <!-- Default/minimum size: user requirement, direct quote: "renderable without issue on a
         fullHD screen... keep in mind the taskbar at the bottom... that helps set the floor for
         'it should run on a fullHD laptop'." FullHD is 1920x1080; 1032 reserves 48px off the
         height for a Windows taskbar / GNOME top bar / macOS menu bar + dock, so the window
         opens fully visible without the user needing to move/resize it. MinWidth/MinHeight are
         pinned to that same 1920x1032 - the user can only grow the window, never shrink it below
         the fullHD-safe floor (per-pane alignment at that floor is a follow-up, not yet
         tuned). -->

    <!-- UI-redesign Phase 2/3: outer bands per LAYOUT-SPEC §1, no Auto — the 3rd fixed band, the
         tab strip, is produced by the TabControl's own default header-sizing behavior driven by
         TabItem.Height=26, not a literal 4th row here; see Atoms.axaml's TabItem.Industry block
         comment for why no TabControl template replacement was needed to achieve this split
         safely. Band 2 corrected from LAYOUT-SPEC's stated 81 to 102: real-window debug-bounds
         measurement PLUS a faithful headless-Firefox render of the source mockup HTML (local
         Barlow/Barlow-Condensed/DejaVu-Mono @font-face substitutes, matching what this app
         actually embeds, no network font fetch) both show the VFO/Favourites/Transceiver group
         boxes' own natural stretched content height is 87px, not LAYOUT-SPEC's implied ~67 —
         87 + the row's own 7px top/bottom padding = 101, +1 for browser rounding/hairline = 102.
         This is what was actually cutting off Favourites' bottom row and Transceiver's TX-level
         row (both previously blamed on card-internal layout, which was a real but secondary bug —
         see RadioHeaderView.axaml's Favourites card comment). -->
    <Grid RowDefinitions="26,102,*,25">
        <!-- Menu bar: mock2's own 6 top-level menus reproduced (File/Configurations/Rig & PTT/
             Calibration/Tools/Help), minus View: the fixed Receive/Transmit/Gallery TabControl
             below has nothing closable, so View's reopen-a-closed-pane purpose doesn't apply here
             (spec/09-ui.md). Only File > Open image (routes into the real TX image editor via
             TxControlsPaneViewModel.SelectImageCommand) and File > Exit are wired to real
             commands; every other item is IsEnabled="False" with a "not yet implemented" tooltip,
             the same convention as the Options window's own disabled-placeholder items. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <!-- Brand label: mock2 has one, the pre-redesign app didn't (just menus directly) — new,
             non-databound literal, three Runs so the "/" alone can carry the accent color per
             LAYOUT-SPEC §5 Band 1. -->
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4,0,12,0"
                   FontFamily="{StaticResource IndustryHeadingFontFamily}" FontSize="12"
                   LetterSpacing="0.6">
            <!-- .05em * 12px = 0.6 device px. -->
            <Run Text="{loc:Translate MainWindow.Brand.Name}" Foreground="{StaticResource IndustryText}" />
            <Run Text="{loc:Translate MainWindow.Brand.Slash}" Foreground="{StaticResource IndustryAccent}" />
            <Run Text="{loc:Translate MainWindow.Brand.Suite}" Foreground="{StaticResource IndustryText}" />
        </TextBlock>
        <Menu Grid.Column="1" Classes="Industry">
            <MenuItem Header="{loc:Translate MainWindow.Menu.File}">
                <MenuItem Header="{loc:Translate MainWindow.Menu.File.OpenImage}" InputGesture="Ctrl+O" Command="{Binding TxControls.SelectImageCommand}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.File.SaveFrameAs}" InputGesture="Ctrl+S" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <Separator />
                <MenuItem Header="{loc:Translate MainWindow.Menu.File.Exit}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations}">
                <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations.Station}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations.AudioDevices}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations.StorageNaming}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Configurations.Macros}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.Menu.RigPtt}">
                <MenuItem Header="{loc:Translate MainWindow.Menu.RigPtt.CatInterface}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.RigPtt.PttMethod}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.RigPtt.FrequencyMemories}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.RigPtt.TestPtt}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration}">
                <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration.ClockCalibration}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration.LoopbackSelfTest}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration.ToneGenerator}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Calibration.SlantReference}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.Menu.Tools}">
                <MenuItem Header="{loc:Translate MainWindow.Menu.Tools.RedecodeFromWav}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                <MenuItem Header="{loc:Translate MainWindow.Menu.Tools.ExportSessionLog}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
            </MenuItem>
            <MenuItem Header="{loc:Translate MainWindow.Menu.Help}" />
            <MenuItem Header="{loc:Translate MainWindow.OptionsMenuItem}" Command="{Binding OpenOptionsCommand}" />
        </Menu>

        <!-- Operator's own callsign (mock2's own top-right green chip on the menu line) - real,
             loaded from OptionsSettingsService/OperatorSettings by MainViewModel; falls back to
             the standard ham-radio placeholder "N0CALL" until the user sets a real one in
             Options, so the chip is always present like mock2's own. No cfg/grid alongside it,
             per direct user request: mock2 also shows a "cfg: <profile>" chip and a grid-locator
             suffix here, both skipped since neither has a real backing concept yet (preserved
             product decision, UI-redesign Phase 2 design doc §1). -->
        <Border Grid.Column="2" Classes="Industry IndustryMini accentOutline" BorderThickness="1"
                Padding="8,1,8,1" Margin="0,0,8,0" VerticalAlignment="Center">
            <!-- Overrides IndustryMini's default 10px/mono metrics — this chip's own spec (design
               doc §1) is 12px with .08em letter-spacing = .08*12 = 0.96 device px, not the
               standard chip size, so set directly on the TextBlock rather than relying on the
               atom's own default Style. -->
            <TextBlock Text="{Binding CallsignDisplay}" FontWeight="Medium" FontSize="12" LetterSpacing="0.96" />
        </Border>
        </Grid>

        <!-- VFO / Favourites / Transceiver header cards: see Views/RadioHeaderView.axaml.
             Always visible regardless of which tab is active. -->
        <views:RadioHeaderView Grid.Row="1" DataContext="{Binding RadioStatus}" />

        <!-- Fixed Receive/Transmit/Gallery/Logbook tabs (spec/09-ui.md), replacing the former
             Dock.Avalonia DockControl. Each pane view-model is a plain DI singleton, rendered via
             ContentControl plus the app-wide ViewLocator (same auto-resolution Dock relied on before;
             see ViewLocator.cs's own doc comment).

             UI-redesign Phase 2: TabControl keeps Fluent's own default template entirely (no
             ControlTheme replacement — see Atoms.axaml's TabItem.Industry block comment); the
             right-aligned status-chip row is a SIBLING in this same Grid.Row, not baked into any
             shared control theme (design doc §0's blocker-2 fix — a shared TabControl theme reused
             later by the Options window's own unrelated TabControl would otherwise inherit this
             row bound against the wrong DataContext). -->
        <Grid Grid.Row="2">
        <TabControl Classes="Industry">
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Receive}">
                <!-- Phase 3: 236,*,312 columns, gap 9, padding 9,11,9,8 (LAYOUT-SPEC §5 Band 4a /
                     PADDING-NORMALIZATION.md), was 258,*,330 / gap 4 / uniform 4. -->
                <Grid ColumnDefinitions="236,*,312" ColumnSpacing="{StaticResource IndustrySpacingGutter}" Margin="9,11,9,8">

                    <!-- Left column: re-skinned to Industry atoms (Phase 3). Every real binding
                         preserved exactly (see original per-card comments migrated below); row SETS
                         also preserved exactly as they exist today even where the mockup's own
                         Input-chain row set differs (mockup shows "SNR est."/"DC offset" as its 5th/
                         8th rows; this app's real telemetry has AGC gain/Noise floor there instead —
                         keeping the real AgcGainDisplay binding, not relabeling to match a mockup
                         row this app doesn't actually measure). Slant ppm/Sync offset stay
                         READ-ONLY value rows, not interactive steppers, despite the mockup showing
                         stepper controls there: RxImagePaneViewModel exposes these as formatted
                         DISPLAY strings only (SlantPpmDisplay/SyncOffsetSamplesDisplay), not
                         editable numeric properties — this port has no real "manually adjust slant"
                         feature (Re-sync exists instead), so binding a stepper's Value to a string
                         isn't possible without inventing a fake editable property; same
                         preserve-real-behavior discipline as Phase 2's RX-level meter staying
                         display-only. -->
                    <ScrollViewer Grid.Column="0">
                        <!-- Margin top=6 (not the outer Grid's own padding — this is INSIDE the
                             ScrollViewer): a ScrollViewer necessarily clips its content to its own
                             viewport, so unlike a plain Grid cell (fixed via ClipToBounds=False on
                             the atom itself), the FIRST card's title notch here still needs literal
                             headroom reserved before it, or it clips against the viewport's own top
                             edge regardless of the atom-level fix. -->
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Classes="Industry" Margin="0,6,0,0">
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxImage.ModeCardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <!-- Segmented control needs BOTH Classes (for the item-0b marker
                                       + IndustrySeg's Padding/interaction-state Style selectors)
                                       AND an explicit Theme= (a ControlTheme is not applied by
                                       Classes alone — same rule as every other named ControlTheme
                                       atom in this file); missing Theme= here silently fell back to
                                       Fluent's default RadioButton bullet-dot look, caught via a
                                       real-window screenshot. Also needs a horizontal 2-column
                                       Grid, not bare StackPanel children (StackPanel's default
                                       Orientation is Vertical, which stacked the segments instead
                                       of placing them side by side). -->
                                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,2">
                                        <RadioButton Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="RxModeAutoLocked" IsChecked="True" Content="{loc:Translate Panes.RxImage.AutoLockedAuto}" />
                                        <RadioButton Grid.Column="1" Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="RxModeAutoLocked" Content="{loc:Translate Panes.RxImage.AutoLockedLocked}" />
                                    </Grid>
                                    <ComboBox Classes="Industry IndustryInput" HorizontalAlignment="Stretch" SelectedIndex="0" ToolTip.Tip="{loc:Translate Panes.RxImage.ModeOverride.Help}">
                                        <ComboBoxItem Content="{Binding DetectedModeDisplay}" />
                                    </ComboBox>
                                    <UniformGrid Columns="4" Rows="4">
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SC1}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SC2}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SCDX}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M1}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M2}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M3}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M4}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.R36}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.R72}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD50}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD90}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD120}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD160}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD180}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD290}" /></Border>
                                        <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SC2180}" /></Border>
                                    </UniformGrid>
                                    <StackPanel Classes="Industry IndustryRows">
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxImage.LineTime}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding LineTimeText}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxImage.Lines}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding LinesText}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxImage.Remaining}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxImage.RemainingValue}" /></Grid></Border>
                                    </StackPanel>
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Sync & slant: Slant ppm/Sync offset/Auto-correct/Re-sync are real,
                                 wired to RxImagePaneViewModel (spec/17-rx-telemetry-feasibility.md).
                                 Source/Reset/Advanced-timing remain unwired. -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxSync.CardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <StackPanel Classes="Industry IndustryRows">
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.Source}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSync.SourceValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.SlantPpm}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SlantPpmDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.SyncOffset}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SyncOffsetSamplesDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.AutoCorrect}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Foreground="{StaticResource IndustryAccent700}" Text="{Binding AutoCorrectDisplay}" /></Grid></Border>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                        <!-- Padding="6,0" (design-fidelity-caught fix): IndustryBtn22's
                                             fixed 22px box was clipping the label's descenders/baseline
                                             against Fluent's own default Button padding. -->
                                        <Button Classes="Industry IndustryBtn22 IndustryBtnSecondary" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.RxSync.Resync}" Command="{Binding RequestReSyncCommand}" />
                                        <Button Grid.Column="1" Classes="Industry IndustryBtn22 IndustryBtnSecondary" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{loc:Translate Panes.RxSync.Reset}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </Grid>
                                    <ToggleButton x:Name="AdvancedTimingToggle" Classes="Industry IndustryDisclosure" Theme="{StaticResource IndustryDisclosureToggleTheme}" Content="{loc:Translate Panes.RxSync.AdvancedTiming}" />
                                    <StackPanel Classes="Industry IndustryRows" IsVisible="{Binding #AdvancedTimingToggle.IsChecked}">
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.SampleClock}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSync.SampleClockValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.SyncWindow}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSync.SyncWindowValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.VisThreshold}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSync.VisThresholdValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSync.DropLine}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSync.DropLineValue}" /></Grid></Border>
                                    </StackPanel>
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Input chain: Device/Buffer/Clipping/AGC gain are real. Row SET
                                 preserved as this app's real telemetry (not the mockup's own
                                 "SNR est./DC offset" example rows, which this app doesn't compute -
                                 see block comment above). -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxInput.CardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <StackPanel Classes="Industry IndustryRows">
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Device}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding CaptureDeviceNameDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Squelch}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxInput.SquelchValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Bpf}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxInput.BpfValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Notch}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxInput.NotchValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Agc}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding AgcGainDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Buffer}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding BufferedSampleCountDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.Clipping}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding ClippingDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.NoiseFloor}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxInput.NoiseFloorValue}" /></Grid></Border>
                                    </StackPanel>
                                    <!-- Border top-rule + fill as star-column percentages (design-fidelity-caught
                                         fixes): matches IndustryRows' own automatic top-rule-between-blocks
                                         convention, and the literal Width="149"/"142" only matched the
                                         mockup's 63%/60% example by coincidence at one specific card width
                                         (same bug class fixed in the header row's RX-level meter). -->
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource IndustryRowRule6}" Padding="0,4,0,0">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.LevelL}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxInput.LevelLValue}" /></Grid>
                                            <Grid Classes="IndustryMeter">
                                                <Border Classes="IndustryMeterTrack" Height="6" />
                                                <Grid ColumnDefinitions="63*,37*"><Border Grid.Column="0" Classes="IndustryMeterFill" Height="6" HorizontalAlignment="Stretch" /></Grid>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxInput.LevelR}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxInput.LevelRValue}" /></Grid>
                                            <Grid Classes="IndustryMeter">
                                                <Border Classes="IndustryMeterTrack" Height="6" />
                                                <Grid ColumnDefinitions="60*,40*"><Border Grid.Column="0" Classes="IndustryMeterFill" Height="6" HorizontalAlignment="Stretch" /></Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Signal quality: Sync tone and Clip lo/hi are real. SNR/Min-Max/
                                 histogram/Black·White tone remain unwired (no per-line SNR or
                                 histogram computation exists; Black/White tone isn't a well-defined
                                 measurement even in principle, unlike Sync tone). -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" DataContext="{Binding RxImage}" VerticalAlignment="Stretch" ClipToBounds="False">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.RxSignal.CardHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                                    <TextBlock Classes="Industry IndustryKicker" Text="{loc:Translate Panes.RxSignal.SnrPerLine}" />
                                    <Border Classes="IndustryHatchPanel" MinHeight="26" />
                                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSignal.MinMax}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSignal.MinMaxValue}" /></Grid></Border>
                                    <TextBlock Classes="Industry IndustryKicker" Text="{loc:Translate Panes.RxSignal.LuminanceHistogram}" />
                                    <Border Classes="IndustryHatchPanel" MinHeight="26" />
                                    <StackPanel Classes="Industry IndustryRows">
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSignal.ClipLoHi}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding ClipLoHiDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSignal.SyncTone}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SyncToneDisplay}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSignal.BlackTone}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSignal.BlackToneValue}" /></Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*"><TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.RxSignal.WhiteTone}" /><TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.RxSignal.WhiteToneValue}" /></Grid></Border>
                                    </StackPanel>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Centre: Spectrum & waterfall + Incoming frame, both restyled in place
                         (Border Classes="plot" now lives inside WaterfallPaneView.axaml/
                         RxImagePaneView.axaml themselves); no new PlotView abstraction. Row 0
                         reverted from 154 back to 182 (design-fidelity-caught fix, user-reported):
                         the earlier 180->154 reversion assumed the ONLY reason 180 was ever needed was a
                         since-fixed NumericUpDown clipping bug, but the settings column's real
                         content (Bins/px + Start + Span + Gain + Zero + Peak hold + the Both/Spec/WF
                         segment, 7 stacked items, none yet re-skinned to the compact Industry atoms,
                         this whole card is still pre-redesign old-style, a separate larger port not
                         done in this pass) genuinely doesn't fit in 154: Peak hold rendered
                         flush against the card's own bottom border with near-zero clearance, and the
                         segment row below it was clipped out of existence entirely, invisible. -->
                    <Grid Grid.Column="1" RowDefinitions="182,*,150" RowSpacing="{DynamicResource ScanlineStudioSpacingMedium}">
                        <!-- Spectrum & waterfall (batch 8b): SpectrumTraceControl (new, real FFT
                             line trace + markers + peak-hold) fills what was the literal "Spectrum"
                             placeholder; WaterfallPaneView (ContentControl bound to Waterfall) is
                             the existing real scrolling waterfall. Both plot columns are bound
                             directly against MainViewModel's own Waterfall child property (dotted
                             path), same pattern the settings column below already used for Gain/
                             Zero; SpectrumTraceControl does NOT need to be inside
                             WaterfallPaneView.axaml's own view for this to work. Column widths are
                             driven by ViewMode via WaterfallViewModeToColumnWidthConverter, not
                             IsVisible alone (auditor-caught: IsVisible would leave the collapsed
                             plot's own Star column at half width, producing a half-empty card
                             instead of the other plot expanding to fill it). -->
                        <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/
                             "caption"/"plot"/"label"/"tight"/"seg" styling). RangeCaption moved
                             from the notch-title row into the card body (same precedent as the
                             header row's own UTC-clock readout): the notch title's wrapping Border
                             is HorizontalAlignment="Left" with no explicit Width, so a "*" column
                             inside it has nothing finite to divide against; putting the caption in
                             the body instead avoids that trap entirely. -->
                        <HeaderedContentControl Grid.Row="0" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" Padding="{StaticResource IndustryGbPaddingWide}">
                            <HeaderedContentControl.Header>
                                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.Waterfall.CardHeader}" />
                            </HeaderedContentControl.Header>
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="10"
                                           Foreground="{StaticResource IndustryTextMuted50}" HorizontalAlignment="Right"
                                           Margin="0,0,0,4" Text="{loc:Translate Panes.Waterfall.RangeCaption}" />
                                <Grid Grid.Row="1" ColumnSpacing="{StaticResource IndustrySpacingWide}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Waterfall.ViewMode, Converter={x:Static conv:WaterfallViewModeToColumnWidthConverter.Instance}, ConverterParameter=Spectrum}" />
                                        <ColumnDefinition Width="{Binding Waterfall.ViewMode, Converter={x:Static conv:WaterfallViewModeToColumnWidthConverter.Instance}, ConverterParameter=Waterfall}" />
                                        <ColumnDefinition Width="146" />
                                    </Grid.ColumnDefinitions>
                                    <Border Classes="IndustryPlot">
                                        <controls:SpectrumTraceControl Frame="{Binding Waterfall.LatestFrame}"
                                                                        ZeroDb="{Binding Waterfall.ZeroDb}"
                                                                        GainDb="{Binding Waterfall.GainDb}"
                                                                        StartHz="{Binding Waterfall.StartHz}"
                                                                        SpanHz="{Binding Waterfall.SpanHz}"
                                                                        PeakHoldEnabled="{Binding Waterfall.PeakHoldEnabled}"
                                                                        CurrentMode="{Binding Waterfall.CurrentMode}"
                                                                        BinsPerPixel="{Binding Waterfall.BinsPerPixel, Mode=OneWayToSource}" />
                                    </Border>
                                    <ContentControl Grid.Column="1" Content="{Binding Waterfall}" />
                                    <StackPanel Grid.Column="2" Classes="Industry IndustryRows" Spacing="1">
                                        <!-- Read-only: a live readout of what Start/Span/this
                                             control's own actual rendered width currently work out
                                             to, not an independent user input (auditor round-2
                                             finding: three independent knobs for two real degrees
                                             of freedom is over-determined and inconsistent). -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.BinsPerPixel}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" MinWidth="62" HorizontalAlignment="Right" IsEnabled="False" Value="{Binding Waterfall.BinsPerPixel}" />
                                        </Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Start}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" MinWidth="72" HorizontalAlignment="Right" Increment="100" Value="{Binding Waterfall.StartHz}" />
                                        </Grid></Border>
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Span}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" MinWidth="72" HorizontalAlignment="Right" Increment="100" Value="{Binding Waterfall.SpanHz}" />
                                        </Grid></Border>
                                        <!-- Gain/Zero share one row (mockup's own layout, not two
                                             full-width slider rows), real now (batch 8a); drive
                                             both WaterfallControl's color mapping AND
                                             SpectrumTraceControl's vertical scale (see
                                             SpectrumTraceMath.MapDbToY's own doc comment for why the
                                             same sliders control both). Minimum/Maximum are load-
                                             bearing: RangeBase coerces Value into [Minimum,Maximum]
                                             and Value is TwoWay by default, so if these were ever
                                             dropped a -70 ZeroDb default would clamp against
                                             RangeBase's own default 0..100 range and silently write
                                             the clamped value back into the view-model. -->
                                        <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,38,Auto,38" ColumnSpacing="6">
                                            <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Gain}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustrySliderTheme}" Minimum="20" Maximum="80" Value="{Binding Waterfall.GainDb}" />
                                            <TextBlock Grid.Column="2" Classes="IndustryRowLabel" Text="{loc:Translate Panes.Waterfall.Zero}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="3" Classes="Industry" Theme="{StaticResource IndustrySliderTheme}" Minimum="-70" Maximum="30" Value="{Binding Waterfall.ZeroDb}" />
                                        </Grid></Border>
                                        <!-- No mockup CheckBox atom exists (the "Peak hold" toggle is
                                             real app functionality, batch 8b, with no mockup
                                             equivalent), represented as a .mini toggle chip instead,
                                             matching the app's own established convention for real-
                                             functionality toggles without a direct mockup site (e.g.
                                             the header row's CAT-linked chip). Own row, since the
                                             mockup's segment row (below) has no Peak-hold sibling to
                                             model a combined layout on. -->
                                        <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" HorizontalAlignment="Left" Margin="0,2,0,0" IsChecked="{Binding Waterfall.PeakHoldEnabled}" Content="{loc:Translate Panes.Waterfall.PeakHold}" />
                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,2,0,0">
                                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}" GroupName="PlotView" IsChecked="{Binding Waterfall.IsViewBoth}" Content="{loc:Translate Panes.Waterfall.ViewBoth}" />
                                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}" GroupName="PlotView" IsChecked="{Binding Waterfall.IsViewSpectrumOnly}" Content="{loc:Translate Panes.Waterfall.ViewSpec}" />
                                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}" GroupName="PlotView" IsChecked="{Binding Waterfall.IsViewWaterfallOnly}" Content="{loc:Translate Panes.Waterfall.ViewWf}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </HeaderedContentControl>
                        <Border Grid.Row="1" Classes="card">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.RxImage.CardHeader}" />
                                <!-- Bottom action bar: literal/no-op. RxImagePaneViewModel has
                                     no Save/Abort/Re-decode/Copy-to-TX/Log-QSO commands today
                                     (spec/14-roadmap.md backlog); progress bar/count are likewise
                                     literal. DockPanel (not StackPanel): buttons left, count
                                     pinned far right (no "Ln" prefix - just the raw x/y count),
                                     progress bar fills the middle gap between them - matches
                                     mock2's own bar-fills-the-row shape while keeping the frame
                                     count visible per direct user request. The redundant top-right
                                     header caption (same value, different spot) was dropped. -->
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                        <Button Classes="primary" Content="{loc:Translate Panes.RxImage.SaveFrame}" />
                                        <Button Content="{loc:Translate Panes.RxImage.Abort}" />
                                        <Button Content="{loc:Translate Panes.RxImage.RedecodeAction}" />
                                        <Button Content="{loc:Translate Panes.RxImage.CopyToTx}" />
                                        <Button Content="{loc:Translate Panes.RxImage.LogQso}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Classes="value" VerticalAlignment="Center" Margin="12,0,0,0" Text="{loc:Translate Panes.RxImage.FrameLineCount}" />
                                    <ProgressBar Height="6" VerticalAlignment="Center" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="70" />
                                </DockPanel>
                                <!-- Previous-frames strip relocated here from its own right-column
                                     card, matching mock2's own placement (inside the Incoming-frame
                                     card, beside the image); still the same real
                                     RxHistoryPaneViewModel.Entries binding, just repositioned and
                                     widened 160->266 to match mock2. Mode-pill badge overlay and
                                     callsign line are literal: ReceiveHistoryEntry has no
                                     callsign field (see RxHistoryPaneViewModel.cs's own doc
                                     comment), same precedent as Frame metadata's static text. -->
                                <!-- Frame column is Auto, not a fixed/star width: a plain Border/
                                     Image (no PlotView/aspect-ratio-converter exists in this
                                     codebase) has no intrinsic size, so a star column just
                                     stretched it edge-to-edge with no 5:4 constraint at all.
                                     Viewbox around a fixed 320x256 box (real SSTV frame
                                     dimensions) uniformly scales to the row's available height
                                     and reports that scaled width back to the Auto column -
                                     no C# measure override needed. Previous-frames now gets
                                     whatever's left, matching mock2's own intent. -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="0,4,0,0">
                                    <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                                        <Border Width="320" Height="256">
                                            <ContentControl Content="{Binding RxImage}" />
                                        </Border>
                                    </Viewbox>
                                    <DockPanel Grid.Column="1" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{loc:Translate Panes.RxHistory.PreviousFramesHeader}" Margin="0,0,0,4" />
                                        <TextBlock DockPanel.Dock="Top" Classes="caption"
                                                   Text="{loc:Translate Panes.RxHistory.NoHistoryYet}"
                                                   IsVisible="{Binding !RxHistory.Entries.Count}" />
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding RxHistory.Entries}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RxHistoryEntryViewModel">
                                                        <!-- 120x96 = 5:4, the real SSTV frame aspect ratio (was
                                                             120x72 = 5:3, letterboxing every real thumbnail). -->
                                                        <Border Classes="thumb" Width="120" Margin="0,0,6,6">
                                                            <StackPanel>
                                                                <Panel>
                                                                    <Image Source="{Binding Thumbnail}" Height="96" Stretch="Uniform" />
                                                                    <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" IsHitTestVisible="False">
                                                                        <TextBlock Text="{Binding Entry.ModeId}" />
                                                                    </Border>
                                                                </Panel>
                                                                <TextBlock Classes="value" Text="{loc:Translate Panes.RxHistory.ThumbCallsignValue}" HorizontalAlignment="Center" />
                                                                <TextBlock Classes="readoutSmall" Text="{Binding Entry.ReceivedAt, StringFormat=HH:mm:ss}" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Decode activity: visual scaffolding only, header-only DataGrid (no
                             ItemsSource); no structured decode-history event log exists yet,
                             distinct from ReceiveHistoryStore (spec/14-roadmap.md backlog). -->
                        <Border Grid.Row="2" Classes="card">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.RxDecodeLog.CardHeader}" />
                                <Grid ColumnDefinitions="*,266" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="0,4,0,0">
                                    <DataGrid IsReadOnly="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColUtc}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColFreq}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColMode}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColCallsign}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColGrid}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColSnr}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColSlant}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColLines}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.RxDecodeLog.ColState}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Column="1" BorderBrush="{DynamicResource ScanlineStudioCardBorderColor}" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{loc:Translate Panes.RxDecodeLog.TraceHeader}" />
                                            <ScrollViewer>
                                                <ItemsControl />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Right column: mostly visual scaffolding still. Frame metadata's "Started" and
                         "Size on disk" rows are real (spec/17-rx-telemetry-feasibility.md), wired to
                         RxImagePaneViewModel (file size only populates once the frame's own save
                         completes; see FileSizeBytes' own doc comment; a still-in-progress or
                         abandoned/partial frame reads "—"). Its other fields (Callsign/OCR, QRZ
                         lookup, Frequency/Mode/VIS, SNR/slant, dropped-lines, note/override-callsign)
                         and Unattended RX's scan/watch state have no backing data or feature at all
                         yet (spec/14-roadmap.md backlog: "Frame metadata card"/"Unattended RX").
                         Session frames is a distinct placeholder list matching mock2's own
                         Callsign/Mode/Meta text format; not a second copy of the real thumbnail
                         strip, which lives in the Incoming-frame card above. -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ScanlineStudioSpacingMedium}">
                        <Border Grid.Row="0" Classes="card" DataContext="{Binding RxImage}">
                            <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxFrameMeta.CardHeader}" />
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.Callsign}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxFrameMeta.CallsignValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.GridDistance}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxFrameMeta.GridDistanceValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.Frequency}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxFrameMeta.FrequencyValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.ModeVis}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxFrameMeta.ModeVisValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.Started}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding StartedDisplay}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.SnrSlant}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxFrameMeta.SnrSlantValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.OcrConfidence}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxFrameMeta.OcrConfidenceValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.DroppedLines}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxFrameMeta.DroppedLinesValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxFrameMeta.FileSize}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding FileSizeDisplay}" />
                                </Grid>
                                <TextBlock Classes="caption" Text="{loc:Translate Panes.RxFrameMeta.NoteLabel}" />
                                <TextBox Text="{loc:Translate Panes.RxFrameMeta.NoteValue}" />
                                <TextBlock Classes="caption" Text="{loc:Translate Panes.RxFrameMeta.OverrideCallsignLabel}" />
                                <TextBox Watermark="{loc:Translate Panes.RxFrameMeta.CallsignValue}" Text="{loc:Translate Panes.RxFrameMeta.OverrideCallsignValue}" />
                                <UniformGrid Columns="2">
                                    <Button Classes="small" Margin="0,0,3,0" Content="{loc:Translate Panes.RxFrameMeta.LookupQrz}" />
                                    <Button Classes="small" Margin="3,0,0,0" Content="{loc:Translate Panes.RxFrameMeta.Flag}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Classes="card">
                            <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxUnattended.CardHeader}" />
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxUnattended.Watch}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxUnattended.WatchValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxUnattended.ScanDwell}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxUnattended.ScanDwellValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxUnattended.Alert}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxUnattended.AlertValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxUnattended.Session}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxUnattended.SessionValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Session frames: literal scrollable list (SessionFrames isn't a real
                             bindable property anywhere in the app: grepped repo-wide, only
                             exists in mockups/); a scrollable 15-row list fills the column height
                             the way a real ItemsSource-bound list would, instead of 3 static rows
                             leaving a large empty gap (spec/14-roadmap.md backlog). -->
                        <Border Grid.Row="2" Classes="card">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.RxSessionFrames.CardHeader}" />
                                <ScrollViewer Margin="0,4,0,0">
                                    <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row1Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row1Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row1Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row2Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row2Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row2Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row3Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row3Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row3Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row4Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row4Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row4Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row5Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row5Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row5Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row6Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row6Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row6Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row7Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row7Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row7Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row8Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row8Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row8Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row9Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row9Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row9Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row10Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row10Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row10Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row11Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row11Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row11Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row12Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row12Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row12Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row13Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row13Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row13Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row14Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row14Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row14Meta}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                            <TextBlock Classes="value" Text="{loc:Translate Panes.RxSessionFrames.Row15Callsign}" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Translate Panes.RxSessionFrames.Row15Mode}" />
                                            <TextBlock Grid.Column="2" Classes="readoutSmall" HorizontalAlignment="Right" Text="{loc:Translate Panes.RxSessionFrames.Row15Meta}" />
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Transmit}">
                <Grid ColumnDefinitions="258,*,330" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="{DynamicResource ScanlineStudioPaddingMedium}">

                    <!-- Left: TxControlsPaneView's own restyled Mode/Identification/Output/Stock
                         cards. The Drive slider now lives inside its Output card, ancestor-bound
                         to this same RadioStatus.TxVolumePercent value rather than a separate
                         standalone card here. -->
                    <ScrollViewer Grid.Column="0">
                        <ContentControl Content="{Binding TxControls}" />
                    </ScrollViewer>

                    <!-- Centre: TX image editor, swapped in per Piece 2's nullable ActiveEditor
                         (a null Content just renders nothing, no visibility toggle needed). -->
                    <ContentControl Grid.Column="1" Content="{Binding ActiveEditor}" />

                    <!-- Right: Queue (new placeholder) / Mode-timing-reference (real, untouched) /
                         TX log (new placeholder) / Recently sent (new placeholder). -->
                    <ScrollViewer Grid.Column="2">
                        <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingMedium}">

                            <!-- New: queue of frames waiting to transmit. Literal rows matching
                                 mock2's own QueueItem shape (no queueing feature exists yet). -->
                            <Border Classes="card">
                                <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                    <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.TxQueue.Header}" />
                                    <Grid Classes="kv" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{loc:Translate Panes.TxQueue.Row1FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.TxQueue.Row1Mode}" />
                                    </Grid>
                                    <Grid Classes="kv" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{loc:Translate Panes.TxQueue.Row2FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.TxQueue.Row2Mode}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.TxQueue.BetweenFrames}" />
                                        <TextBlock Grid.Column="1" Classes="value" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxQueue.BetweenFramesValue}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Mode-timing-reference table, fully real; computed from
                                 SstvModeDefinition's own LineDurationMs/ImageHeight, zero new data. -->
                            <Border Classes="card">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.TxControls.ModeTimingHeader}" />
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,46,60,56" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}" Margin="0,4,0,2">
                                        <TextBlock Classes="caption" Text="{loc:Translate Panes.TxControls.ModeTimingMode}" />
                                        <TextBlock Grid.Column="1" Classes="caption" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxControls.ModeTimingLines}" />
                                        <TextBlock Grid.Column="2" Classes="caption" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxControls.ModeTimingLineMs}" />
                                        <TextBlock Grid.Column="3" Classes="caption" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxControls.ModeTimingFrame}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TxControls.ModeTimingRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModeTimingRowViewModel">
                                                <Grid ColumnDefinitions="*,46,60,56" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                                    <TextBlock Classes="value" HorizontalAlignment="Left" Text="{Binding ModeName}" />
                                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Lines}" />
                                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding LineMs, StringFormat={}{0:0.0}}" />
                                                    <TextBlock Grid.Column="3" Classes="value" Text="{Binding FrameSeconds, StringFormat={}{0:0.0}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>

                            <!-- New: sent-frame log (no logging-of-sent-frames feature exists yet;
                                 header-only DataGrid, no ItemsSource). -->
                            <Border Classes="card">
                                <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                    <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.TxLog.Header}" />
                                    <DataGrid IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="10.5" MinHeight="90">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.TxLog.Utc}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.TxLog.Mode}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.TxLog.Dur}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.TxLog.Drive}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.TxLog.Swr}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn>
                                                <DataGridTextColumn.Header><TextBlock Text="{loc:Translate Panes.TxLog.Result}" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- New: recently-sent frames. Literal thumb grid matching mock2's own
                                 FrameTemplate shape (no send-history feature exists yet); buttons
                                 are no-ops, same convention as every other placeholder this pass. -->
                            <Border Classes="card">
                                <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                    <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.TxRecentlySent.Header}" />
                                    <UniformGrid Columns="2">
                                        <Button Classes="primary small" Margin="0,0,3,0" Content="{loc:Translate Panes.TxRecentlySent.RefillAndQueue}" />
                                        <Button Classes="small" Margin="3,0,0,0" Content="{loc:Translate Panes.TxRecentlySent.OpenInEditor}" />
                                    </UniformGrid>
                                    <WrapPanel>
                                        <Border Classes="thumb" Width="90" Margin="0,0,6,6">
                                            <StackPanel>
                                                <Panel>
                                                    <Border Classes="plot" Height="60" />
                                                    <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                                                        <TextBlock Text="{loc:Translate Panes.TxRecentlySent.Item1Mode}" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel Margin="5,3">
                                                    <TextBlock Classes="value" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxRecentlySent.Item1Name}" />
                                                    <TextBlock Classes="readoutSmall" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxRecentlySent.Item1Fields}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="thumb" Width="90" Margin="0,0,6,6">
                                            <StackPanel>
                                                <Panel>
                                                    <Border Classes="plot" Height="60" />
                                                    <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                                                        <TextBlock Text="{loc:Translate Panes.TxRecentlySent.Item2Mode}" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel Margin="5,3">
                                                    <TextBlock Classes="value" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxRecentlySent.Item2Name}" />
                                                    <TextBlock Classes="readoutSmall" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxRecentlySent.Item2Fields}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="thumb" Width="90" Margin="0,0,6,6">
                                            <StackPanel>
                                                <Panel>
                                                    <Border Classes="plot" Height="60" />
                                                    <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                                                        <TextBlock Text="{loc:Translate Panes.TxRecentlySent.Item3Mode}" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel Margin="5,3">
                                                    <TextBlock Classes="value" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxRecentlySent.Item3Name}" />
                                                    <TextBlock Classes="readoutSmall" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.TxRecentlySent.Item3Fields}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Gallery}">
                <Grid ColumnDefinitions="*,330" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="{DynamicResource ScanlineStudioPaddingMedium}" DataContext="{Binding RxHistory}">

                    <!-- Received-frame grid: All/Today filter is real (IReceiveHistoryStore's own
                         From/To fields); mock2's band/Unlogged/Flagged/free-text filters and
                         sort-by-callsign/SNR are omitted; ReceiveHistoryEntry has no frequency/
                         callsign/grid field to filter or sort by, and LinkedQsoId is never set
                         non-null by any code path today (spec/14-roadmap.md backlog). This list
                         (and the Receive tab's own Previous-frames strip, same shared VM instance)
                         now refreshes live as new frames land, not just at construction/manual-
                         refresh/filter-change (batch 7, IReceiveHistoryStore.Recorded). New real
                         "Latest" button below (SelectLatestCommand) is a port of legacy's own
                         SBLatest speed button, new UI since mock2's own draft has no slot for it. -->
                    <Border Grid.Column="0" Classes="card">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxHistory.GalleryHeader}" />
                                <TextBlock Grid.Column="1" Classes="caption" HorizontalAlignment="Right" Text="{Binding EntryCountText}" />
                            </Grid>
                            <!-- Single filter row (mock2's own layout): search box takes the
                                 remaining width, then the real All/Today segment + real Refresh
                                 button (kept exactly as-is, not replaced by the mock's plain
                                 ToggleButtons) alongside the literal 14MHz/Unlogged/Flagged
                                 toggles and sort combo. -->
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}" Margin="0,4,0,4">
                                <TextBox Watermark="{loc:Translate Panes.RxHistory.SearchWatermark}" />
                                <Border Grid.Column="1" Classes="segment">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Classes="seg" GroupName="GalleryFilter" Content="{loc:Translate Panes.RxHistory.FilterAll}" IsChecked="{Binding !ShowTodayOnly}" />
                                        <RadioButton Classes="seg" GroupName="GalleryFilter" Content="{loc:Translate Panes.RxHistory.FilterToday}" IsChecked="{Binding ShowTodayOnly}" />
                                    </StackPanel>
                                </Border>
                                <ToggleButton Grid.Column="2" Classes="small" Content="{loc:Translate Panes.RxHistory.Filter14Mhz}" />
                                <ToggleButton Grid.Column="3" Classes="small" Content="{loc:Translate Panes.RxHistory.FilterUnlogged}" />
                                <ToggleButton Grid.Column="4" Classes="small" Content="{loc:Translate Panes.RxHistory.FilterFlagged}" />
                                <ComboBox Grid.Column="5" SelectedIndex="0">
                                    <ComboBoxItem Content="{loc:Translate Panes.RxHistory.SortNewest}" />
                                    <ComboBoxItem Content="{loc:Translate Panes.RxHistory.SortCallsign}" />
                                    <ComboBoxItem Content="{loc:Translate Panes.RxHistory.SortSnr}" />
                                </ComboBox>
                                <!-- Real: port of legacy's SBPrim "jump to most recent" speed button;
                                     NOT SBLatest despite that name's misleading English reading
                                     (SBLatest actually jumps to the OLDEST buffered frame; see
                                     RxHistoryPaneViewModel.SelectLatest's own doc comment for the
                                     full Main.cpp citation trail, and docs/removed-features.md's
                                     "History-tab navigation" entry). No slot for this in mock2's own
                                     draft, added as new UI since the underlying gap is real and
                                     legacy-documented (spec/14-roadmap.md backlog item), not invented.
                                     Selects Entries' own first item (already newest-first), no new
                                     query. -->
                                <Button Grid.Column="6" Classes="small" Content="{loc:Translate Panes.RxHistory.Latest}" Command="{Binding SelectLatestCommand}" />
                                <Button Grid.Column="7" Classes="small" Content="{loc:Translate Panes.RxHistory.Refresh}" Command="{Binding RefreshCommand}" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" Classes="caption"
                                       Text="{loc:Translate Panes.RxHistory.NoHistoryYet}"
                                       IsVisible="{Binding !Entries.Count}" />
                            <ScrollViewer>
                                <ListBox ItemsSource="{Binding Entries}"
                                         SelectedItem="{Binding SelectedEntry}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RxHistoryEntryViewModel">
                                            <!-- Mode badge overlaid top-left on the image (real Entry.ModeId);
                                                 IsHitTestVisible="False" so it never steals the click that
                                                 selects the ListBoxItem underneath. Callsign/meta line is
                                                 literal: ReceiveHistoryEntry has no such fields today. -->
                                            <!-- 190x152 = 5:4, the real SSTV frame aspect ratio (was
                                                 190x110 = 1.73:1, letterboxing every real thumbnail). -->
                                            <Border Classes="thumb" Width="190" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <Panel>
                                                        <Image Source="{Binding Thumbnail}" Height="152" Stretch="Uniform" />
                                                        <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding Entry.ModeId}" />
                                                        </Border>
                                                    </Panel>
                                                    <StackPanel Margin="6,3">
                                                        <TextBlock Classes="value" Text="{loc:Translate Panes.RxHistory.ThumbCallsignValue}" />
                                                        <TextBlock Classes="readoutSmall" TextTrimming="CharacterEllipsis" Text="{loc:Translate Panes.RxHistory.ThumbMetaValue}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Right: selected-frame inspector (File/Mode/ReceivedAt only; no OCR/QRZ/
                         Log-entry fields exist) + Storage card (real ImagesDirectory, resolved via
                         IReceiveHistoryStore.GetImagesDirectoryAsync). Sidecar-format and disk-free
                         rows ARE rendered below, as literals, since neither is tracked anywhere
                         today; they are not omitted, contrary to what an earlier pass's comment
                         here used to claim. -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="{DynamicResource ScanlineStudioSpacingMedium}">
                        <Border Classes="card">
                            <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxHistory.SelectedFrameHeader}" />
                                <Border Classes="plot" Height="248">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                </Border>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.FileLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding SelectedEntry.Entry.FilePath}" />
                                </Grid>
                                <!-- Combined rows matching mock2's own layout: Mode is real
                                     (Entry.ModeId), SNR is literal (no per-frame SNR is tracked
                                     anywhere today); frequency is literal, time is real
                                     (Entry.ReceivedAt). -->
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.ModeSnrLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="value" Text="{Binding SelectedEntry.Entry.ModeId}" />
                                        <TextBlock Classes="value" Text="{loc:Translate Panes.RxHistory.SnrSuffixValue}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.FreqTimeLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="value" Text="{loc:Translate Panes.RxHistory.FreqPrefixValue}" />
                                        <TextBlock Classes="value" Text="{Binding SelectedEntry.Entry.ReceivedAt, StringFormat=HH:mm:ss}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.GridDistLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxHistory.GridDistValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.LogEntryLabel}" />
                                    <TextBlock Grid.Column="1" Classes="accentValue" Text="{loc:Translate Panes.RxHistory.LogEntryValue}" />
                                </Grid>
                                <UniformGrid Columns="3">
                                    <Button Classes="primary small" Margin="0,0,3,0" Content="{loc:Translate Panes.RxHistory.OpenInLog}" />
                                    <Button Classes="small" Margin="3,0" Content="{loc:Translate Panes.RxHistory.ExportFrame}" />
                                    <Button Classes="small" Margin="3,0,0,0" Content="{loc:Translate Panes.RxHistory.Redecode}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Classes="card">
                            <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxHistory.StorageHeader}" />
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.FolderLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding ImagesDirectory}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.NamingLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxHistory.NamingValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.SidecarLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxHistory.SidecarValue}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.DiskLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{loc:Translate Panes.RxHistory.DiskValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Classes="Industry" Header="{loc:Translate MainWindow.Tabs.Logbook}">
                <Grid ColumnDefinitions="*,380" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="{DynamicResource ScanlineStudioPaddingMedium}" DataContext="{Binding Logbook}">

                    <!-- Left: search/browse. CallsignFilter is an exact, case-insensitive match
                         (SqliteLogbookRepository's own COLLATE NOCASE), not a substring search;
                         no watermark claims otherwise. FromDate defaults to 30 days ago on first
                         load (cheap paging insurance, spec/14-roadmap.md); ToDate is end-of-day
                         inclusive when set. -->
                    <Border Grid.Column="0" Classes="card">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.Logbook.SearchHeader}" />
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}" Margin="0,4,0,4">
                                <TextBox Text="{Binding CallsignFilter}" Watermark="{loc:Translate Panes.Logbook.CallsignFilterWatermark}" />
                                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" />
                                <DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}" />
                                <Button Grid.Column="3" Classes="small" Content="{loc:Translate Panes.Logbook.Refresh}" Command="{Binding RefreshCommand}" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" Classes="caption"
                                       Text="{loc:Translate Panes.Logbook.NoEntriesYet}"
                                       IsVisible="{Binding !Entries.Count}" />
                            <ScrollViewer>
                                <ListBox ItemsSource="{Binding Entries}"
                                         SelectedItem="{Binding SelectedEntry}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="logbook:QsoRecord">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                <TextBlock Classes="value" FontWeight="Bold" Text="{Binding Callsign}" />
                                                <TextBlock Grid.Column="1" Classes="caption" Margin="8,0" Text="{Binding StartUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm} UTC'}" />
                                                <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Mode}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Right: add/edit form + ADIF import/export. Every timestamp shown/edited
                         here is raw UTC; no local-time conversion anywhere in this pane. -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="{DynamicResource ScanlineStudioSpacingMedium}">
                        <Border Classes="card">
                            <ScrollViewer>
                                <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.Logbook.FormHeader}" />
                                        <Button Grid.Column="1" Classes="small" HorizontalAlignment="Right" Content="{loc:Translate Panes.Logbook.New}" Command="{Binding NewCommand}" />
                                    </Grid>

                                    <TextBox Text="{Binding FormCallsign}" Watermark="{loc:Translate Panes.Logbook.Form.CallsignWatermark}" />

                                    <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.Logbook.Form.StartLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding FormStartUtc, Converter={x:Static conv:UtcTimestampTextConverter.Instance}}" />
                                    </Grid>
                                    <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.Logbook.Form.EndLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding FormEndUtc, Converter={x:Static conv:UtcTimestampTextConverter.Instance}, ConverterParameter=AllowNull}" />
                                    </Grid>
                                    <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.Logbook.Form.FrequencyLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding FormFrequencyHz}" />
                                    </Grid>
                                    <!-- SelectedValueBinding/SelectedValue, NOT SelectedItem: AvailableModes'
                                         element type (RadioModeOption) differs from FormMode's type
                                         (RadioMode?); SelectedItem would never match an item and would
                                         silently null out FormMode on every selection (see RadioModeOption's
                                         own doc comment). -->
                                    <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.Logbook.Form.ModeLabel}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModes}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding FormMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RadioModeOption">
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static conv:RadioModeDisplayConverter.Instance}">
                                                                <Binding />
                                                                <loc:Translate Key="Panes.Logbook.Form.NoModeOption" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <!-- Same SelectedValueBinding/SelectedValue reasoning as Mode above:
                                         AvailableSstvModes' element type is SstvModeDefinition, FormSstvModeId
                                         is string?. -->
                                    <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.Logbook.Form.SstvModeLabel}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSstvModes}" SelectedValueBinding="{Binding Id}" SelectedValue="{Binding FormSstvModeId, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="sstv:SstvModeDefinition">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.Logbook.Form.RstSentLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding FormRstSent}" />
                                    </Grid>
                                    <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.Logbook.Form.RstReceivedLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding FormRstReceived}" />
                                    </Grid>
                                    <TextBox Text="{Binding FormName}" Watermark="{loc:Translate Panes.Logbook.Form.NameWatermark}" />
                                    <TextBox Text="{Binding FormQth}" Watermark="{loc:Translate Panes.Logbook.Form.QthWatermark}" />
                                    <TextBox Text="{Binding FormGridSquare}" Watermark="{loc:Translate Panes.Logbook.Form.GridSquareWatermark}" />
                                    <TextBox Text="{Binding FormCountry}" Watermark="{loc:Translate Panes.Logbook.Form.CountryWatermark}" />
                                    <TextBox Text="{Binding FormNotes}" Watermark="{loc:Translate Panes.Logbook.Form.NotesWatermark}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

                                    <UniformGrid Columns="2">
                                        <Button Classes="primary small" Margin="0,0,3,0" Content="{loc:Translate Panes.Logbook.Log}" Command="{Binding LogCommand}" IsVisible="{Binding !IsEditing}" />
                                        <Button Classes="primary small" Margin="0,0,3,0" Content="{loc:Translate Panes.Logbook.Update}" Command="{Binding UpdateCommand}" IsVisible="{Binding IsEditing}" />
                                    </UniformGrid>

                                    <TextBlock Text="{Binding StatusMessage}"
                                               TextWrapping="Wrap"
                                               Classes="caption"
                                               IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="1" Classes="card">
                            <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.Logbook.AdifHeader}" />
                                <UniformGrid Columns="2">
                                    <Button Classes="small" Margin="0,0,3,0" Content="{loc:Translate Panes.Logbook.Import}" Command="{Binding ImportAdifCommand}" />
                                    <Button Classes="small" Margin="3,0,0,0" Content="{loc:Translate Panes.Logbook.Export}" Command="{Binding ExportAdifCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Right-aligned status-chip row: new UI surface (design doc §3), none of this existed
             anywhere in the live app's tab-strip area before. Reuses real bindings where they
             exist rather than inventing parallel ones: DetectedModeDisplay/AutoCorrectDisplay/
             SlantPpmStatusBarDisplay are the SAME RxImagePaneViewModel properties the Receive tab's
             own cards and the status bar below already use — this duplicates that surface (matches
             LAYOUT-SPEC's own mockup, which shows slant/SNR on both bands, not a mistake). SNR and
             Autosave have no backing property anywhere in this codebase (confirmed against
             spec/16-gui-wiring-survey.md) — literal FAKE-LIVE placeholders, same established
             convention as the status bar's own SnrValue. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="26" Margin="0,0,6,0" Spacing="5">
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{loc:Translate MainWindow.TabStrip.AutoDetect}" />
            </Border>
            <Border Classes="Industry IndustryMini active" BorderThickness="1">
                <TextBlock Text="{Binding RxImage.DetectedModeDisplay}" />
            </Border>
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{Binding RxImage.AutoCorrectDisplay}" />
            </Border>
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{Binding RxImage.SlantPpmStatusBarDisplay}" />
            </Border>
            <Border Classes="Industry IndustryMini" BorderThickness="1">
                <TextBlock Text="{loc:Translate MainWindow.TabStrip.SnrValue}" />
            </Border>
            <Border Classes="Industry IndustryMini accentOutline" BorderThickness="1">
                <TextBlock Text="{loc:Translate MainWindow.TabStrip.AutosaveOn}" />
            </Border>
        </StackPanel>
        </Grid>

        <!-- Bottom status bar (mock2's own persistent readout row): a slim flat bar (top border
             only, no full card chrome), not part of any tab or header card. Left/right split via
             DockPanel matches mock2's own layout exactly ; "frames today/log" pinned to the far
             right edge, everything else flowing left. Receiving uses mock2's own accent-pill
             treatment (real IsReceiving, text "Receiving" not "RX" to match mock2's literal
             wording); TX-inhibit stays an LED dot + label ; a distinct alert state, not a mode
             indicator; mock2's own static render doesn't happen to show a not-inhibited state but
             the concept/wiring is real and kept per direct user request. TX-inhibit lights up when
             the last transmit attempt ended in an error/SWR-cutoff (TxControls.ErrorMessage); this
             app has no persistent transmit-lockout state to reflect more literally than that; see
             TxControlsPaneViewModel's own SWR-cutoff design for why. Frequency/Mode/DetectedMode/
             LineProgress/Slant/Buffer/FramesToday/LogSize are real (RadioStatus.FrequencyDisplay/
             ModeDisplay, RxImage.DetectedModeText/LineProgressText/SlantPpmStatusBarDisplay/
             BufferedSampleCountStatusBarDisplay, RxHistory.FramesTodayDisplay, Logbook.LogSizeDisplay,
             spec/17-rx-telemetry-feasibility.md). Buffer's own "· N XRUN" half (a separate
             audio-engine dropped-frame counter, not this decoder's own sample buffer) is real too
             now, recombined into mock2's original single format; see
             RxImagePaneViewModel.BufferedSampleCountStatusBarDisplay's own doc comment. M1/SNR still
             have no backing property anywhere in the app (true per-line
             SNR still doesn't exist) and are literal placeholders matching mock2's own exact
             values/wording, same precedent as the Receive tab's own scaffolding cards. -->
        <!-- UI-redesign Phase 2: height corrected to LAYOUT-SPEC's real 25 (was a pre-existing
             24px literal), all chips re-skinned to the .mini atom (design doc §4). Deliberately
             kept as 3 separate Frequency/Mode/Memory chips, not merged into the mockup's one
             interpolated string — merging independently-live-updating bindings into a single
             formatted string is a real behavior change, not a pure re-skin (design doc §4's own
             flagged deviation). DISK is new: no disk-space binding exists anywhere in this
             codebase today, literal FAKE-LIVE placeholder matching the SnrValue/MemoryTag
             precedent already established in this exact bar, not a real feature added in this
             phase. The TX-inhibit LED keeps its existing Ellipse.led visual unchanged (not an
             Industry atom — no LED/indicator-dot atom exists in Phase 1/2's inventory, and
             inventing one wasn't called for by the design doc; this is real, kept per direct
             user request, LAYOUT-SPEC's own static render just doesn't happen to show one). -->
        <Border Grid.Row="3" Height="25" Classes="Industry" Background="{StaticResource IndustryBg}"
                BorderBrush="{StaticResource IndustryDivider}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,4,8,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxHistory.FramesTodayDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding Logbook.LogSizeDisplay}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <Border Classes="Industry IndustryMini" Classes.active="{Binding RadioStatus.IsReceiving}" BorderThickness="1">
                        <TextBlock Text="{loc:Translate MainWindow.StatusBar.Rx}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Classes="led" Classes.alert="{Binding TxControls.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
                        <TextBlock Classes="readoutSmall" Text="{loc:Translate MainWindow.StatusBar.TxInhibit}" ToolTip.Tip="{loc:Translate MainWindow.StatusBar.TxInhibit.Help}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RadioStatus.FrequencyDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RadioStatus.ModeDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{loc:Translate MainWindow.StatusBar.MemoryTag}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.DetectedModeText}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.LineProgressText}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{loc:Translate MainWindow.StatusBar.SnrValue}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.SlantPpmStatusBarDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{Binding RxImage.BufferedSampleCountStatusBarDisplay}" />
                    </Border>
                    <Border Classes="Industry IndustryMini" BorderThickness="1">
                        <TextBlock Text="{loc:Translate MainWindow.StatusBar.DiskValue}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>

</Window>
