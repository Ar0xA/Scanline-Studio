<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="ScanlineStudio.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{loc:Translate MainWindow.Title}"
        Width="1600" Height="900"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <!-- MainViewModel now requires AppDockFactory via DI, so no Design.DataContext previewer
         instance; see App.axaml.cs for how the real DataContext is resolved at runtime. -->

    <!-- Default/minimum size: user requirement, direct quote: "renderable without issue on a
         fullHD screen... keep in mind the taskbar at the bottom... that helps set the floor for
         'it should run on a fullHD laptop'." 1600x900 leaves a real margin under 1920x1080 even
         after a Windows taskbar (~40-48px), a GNOME top bar, or a macOS menu bar + dock, so the
         window opens fully visible without the user needing to move/resize it. MinWidth/MinHeight
         (1024x600) is a separate, lower floor: how small the window can be resized down to before
         panes stop being usable, not the fullHD target itself. -->

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- No View menu anymore: the fixed Receive/Transmit/Gallery TabControl below has nothing
             closable, so there's no reopen path to provide (spec/09-ui.md). -->
        <Menu Grid.Row="0">
            <MenuItem Header="{loc:Translate MainWindow.OptionsMenuItem}" Command="{Binding OpenOptionsCommand}" />
        </Menu>

        <!-- VFO / Favourites / Transceiver header cards (spec/09-ui.md, mock2's own 3-column
             header row): MainWindow chrome, not a dockable pane (Phase-3 plan decision #9's
             scope trim). Connecting happens once at ScanlineStudio.Host startup from persisted
             settings, not from this strip; always visible regardless of which tab is active. -->
        <Border Grid.Row="1" Classes="ScanlineStudioPanelHeader" DataContext="{Binding RadioStatus}">
          <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
            <Grid ColumnDefinitions="Auto,*,260" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}">

                <!-- VFO card: frequency/mode readout+edit, CAT-link status. -->
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                        <TextBlock Classes="cardHeader" Text="{loc:Translate RadioStatus.VfoHeader}" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" VerticalAlignment="Center">
                            <TextBlock Classes="value" FontSize="20" Text="{Binding FrequencyDisplay}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding FrequencyInputMhz}"
                                     Watermark="{loc:Translate RadioStatus.FrequencyPlaceholder}"
                                     Width="90" VerticalAlignment="Center" />
                            <Button Content="{loc:Translate RadioStatus.SetFrequency}" Command="{Binding SetFrequencyCommand}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedRadioMode}" Width="80" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Classes="pill" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Classes="led" Classes.active="{Binding CatLinked}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate RadioStatus.CatLinked}" IsVisible="{Binding CatLinked}" />
                                <TextBlock Text="{loc:Translate RadioStatus.CatNotLinked}" IsVisible="{Binding !CatLinked}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Favourites card: frequency memory presets; click applies both frequency+mode
                     in one action (WSJT-X band-shortcut convention). Membership user-configured
                     via the "Edit favourites..." popup, backed by FrequencyPresetsSettings. -->
                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                        <TextBlock Classes="cardHeader" Text="{loc:Translate RadioStatus.FavouritesHeader}" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FrequencyPresetButtonViewModel">
                                        <Button Content="{Binding Label}"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding Preset}"
                                                Margin="0,0,4,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{loc:Translate RadioStatus.EditPresets}" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}" MinWidth="320">
                                            <ItemsControl ItemsSource="{Binding EditorRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FrequencyPresetEditorRowViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                                            <TextBox Text="{Binding Label}" Watermark="{loc:Translate RadioStatus.PresetLabelPlaceholder}" Width="110" />
                                                            <TextBox Text="{Binding FrequencyMhzText}" Width="90" />
                                                            <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}" Width="80" />
                                                            <Button Content="{loc:Translate RadioStatus.RemovePreset}" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                                <Button Content="{loc:Translate RadioStatus.AddPreset}" Command="{Binding AddPresetRowCommand}" />
                                                <Button Content="{loc:Translate RadioStatus.SavePresets}" Command="{Binding SavePresetsCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Transceiver card: Receiving/Halt (real ISstvSessionService.IsReceiving state),
                     TX output volume (a post-encode playback gain, not an encoder/DSP parameter;
                     matches WSJT-X's own documented Pwr slider semantics), Tune (keys PTT and plays
                     a steady test tone so the other station's AFC/tuning can lock on, legacy
                     Option.cpp's TuneFreq, default 1750Hz). RX-level slider from the mock2 draft is
                     omitted; no gain parameter exists anywhere for it (spec/14-roadmap.md
                     backlog). -->
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                        <TextBlock Classes="cardHeader" Text="{loc:Translate RadioStatus.TransceiverHeader}" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                            <ToggleButton Classes="receiving" IsChecked="{Binding IsReceiving}" Content="{loc:Translate RadioStatus.Receiving}" />
                            <Button Classes="halt" Content="{loc:Translate RadioStatus.Halt}" Command="{Binding HaltReceivingCommand}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                            <TextBlock Classes="label" Text="{loc:Translate RadioStatus.TxVolumeLabel}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Value="{Binding TxVolumePercent}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="value" Text="{Binding TxVolumePercent}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                            <TextBlock Classes="ScanlineStudioHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate RadioStatus.Tune.Help}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding TuneFrequencyHz}" Width="55" VerticalAlignment="Center" />
                            <TextBlock Classes="label" Text="{loc:Translate RadioStatus.Tune.HertzUnit}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding TuneDurationSeconds}" Width="45" VerticalAlignment="Center" />
                            <TextBlock Classes="label" Text="{loc:Translate RadioStatus.Tune.SecondsUnit}" VerticalAlignment="Center" />
                            <Button Content="{loc:Translate RadioStatus.Tune}" Command="{Binding TuneCommand}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ScanlineStudioTxActiveColor}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <!-- Fixed Receive/Transmit/Gallery tabs (spec/09-ui.md), replacing the former
             Dock.Avalonia DockControl. Each pane view-model is a plain DI singleton, rendered via
             ContentControl plus the app-wide ViewLocator (same auto-resolution Dock relied on before;
             see ViewLocator.cs's own doc comment). This interim per-tab arrangement is deliberately
             minimal: Pieces 4-6 replace each tab's content with the full mock2 card layout. -->
        <TabControl Grid.Row="2">
            <TabItem Header="{loc:Translate MainWindow.Tabs.Receive}">
                <Grid ColumnDefinitions="258,*,330" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="{DynamicResource ScanlineStudioPaddingMedium}">

                    <!-- Mode card: real-data-only. mock2's Auto/Locked segmented control and
                         quick-mode-button grid are omitted; ISstvDecoder always auto-detects via
                         the VIS header, there is no manual "lock to a mode" decode feature to wire
                         them to (see RxImagePaneViewModel.DetectedMode's own doc comment;
                         spec/14-roadmap.md backlog). -->
                    <Border Grid.Column="0" Classes="card" DataContext="{Binding RxImage}">
                        <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                            <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxImage.ModeCardHeader}" />
                            <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="label" Text="{loc:Translate Panes.RxImage.DetectedMode}" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding DetectedModeText}" />
                            </Grid>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="label" Text="{loc:Translate Panes.RxImage.LineTime}" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding LineTimeText}" />
                            </Grid>
                            <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="label" Text="{loc:Translate Panes.RxImage.Lines}" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding LinesText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Centre: Spectrum & waterfall + Incoming frame, both restyled in place
                         (Border Classes="plot" now lives inside WaterfallPaneView.axaml/
                         RxImagePaneView.axaml themselves); no new PlotView abstraction. -->
                    <Grid Grid.Column="1" RowDefinitions="180,*" RowSpacing="{DynamicResource ScanlineStudioSpacingMedium}">
                        <Border Grid.Row="0" Classes="card">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.Waterfall.CardHeader}" />
                                <ContentControl Content="{Binding Waterfall}" Margin="0,4,0,0" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Classes="card">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.RxImage.CardHeader}" />
                                <ContentControl Content="{Binding RxImage}" Margin="0,4,0,0" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Right: previous-frames strip; reuses RxHistoryPaneViewModel.Entries
                         directly (mode+timestamp only, no fabricated callsign field; that data
                         doesn't exist on ReceiveHistoryEntry). -->
                    <Border Grid.Column="2" Classes="card">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.RxHistory.PreviousFramesHeader}" />
                            <TextBlock DockPanel.Dock="Top" Classes="caption"
                                       Text="{loc:Translate Panes.RxHistory.NoHistoryYet}"
                                       IsVisible="{Binding !RxHistory.Entries.Count}" />
                            <ScrollViewer Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding RxHistory.Entries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RxHistoryEntryViewModel">
                                            <Border Classes="thumb" Width="96" Margin="0,0,4,4">
                                                <StackPanel>
                                                    <Image Source="{Binding Thumbnail}" Height="72" Stretch="Uniform" />
                                                    <TextBlock Classes="readoutSmall" Text="{Binding Entry.ModeId}" HorizontalAlignment="Center" />
                                                    <TextBlock Classes="readoutSmall" Text="{Binding Entry.ReceivedAt, StringFormat=HH:mm:ss}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:Translate MainWindow.Tabs.Transmit}">
                <Grid ColumnDefinitions="258,*,330" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="{DynamicResource ScanlineStudioPaddingMedium}">

                    <!-- Left: Drive (shared TxVolumePercent, same value as the header's TX volume
                         slider, not a separate parameter) + TxControlsPaneView's own restyled
                         mode/favorites/stock/telemetry cards. -->
                    <ScrollViewer Grid.Column="0">
                        <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingMedium}">
                            <Border Classes="card">
                                <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                    <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.TxControls.OutputLabel}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                        <TextBlock Classes="label" Text="{loc:Translate Panes.TxControls.DriveLabel}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Value="{Binding RadioStatus.TxVolumePercent}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding RadioStatus.TxVolumePercent}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <ContentControl Content="{Binding TxControls}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Centre: TX image editor, swapped in per Piece 2's nullable ActiveEditor
                         (a null Content just renders nothing, no visibility toggle needed). -->
                    <ContentControl Grid.Column="1" Content="{Binding ActiveEditor}" />

                    <!-- Right: mode-timing-reference table, fully real; computed from
                         SstvModeDefinition's own LineDurationMs/ImageHeight, zero new data. -->
                    <Border Grid.Column="2" Classes="card">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.TxControls.ModeTimingHeader}" />
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,46,60,56" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}" Margin="0,4,0,2">
                                <TextBlock Classes="caption" Text="{loc:Translate Panes.TxControls.ModeTimingMode}" />
                                <TextBlock Grid.Column="1" Classes="caption" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxControls.ModeTimingLines}" />
                                <TextBlock Grid.Column="2" Classes="caption" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxControls.ModeTimingLineMs}" />
                                <TextBlock Grid.Column="3" Classes="caption" HorizontalAlignment="Right" Text="{loc:Translate Panes.TxControls.ModeTimingFrame}" />
                            </Grid>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding TxControls.ModeTimingRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModeTimingRowViewModel">
                                            <Grid ColumnDefinitions="*,46,60,56" ColumnSpacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                                <TextBlock Classes="value" HorizontalAlignment="Left" Text="{Binding ModeName}" />
                                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding Lines}" />
                                                <TextBlock Grid.Column="2" Classes="value" Text="{Binding LineMs, StringFormat={}{0:0.0}}" />
                                                <TextBlock Grid.Column="3" Classes="value" Text="{Binding FrameSeconds, StringFormat={}{0:0.0}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:Translate MainWindow.Tabs.Gallery}">
                <Grid ColumnDefinitions="*,330" ColumnSpacing="{DynamicResource ScanlineStudioSpacingMedium}" Margin="{DynamicResource ScanlineStudioPaddingMedium}" DataContext="{Binding RxHistory}">

                    <!-- Received-frame grid: All/Today filter is real (IReceiveHistoryStore's own
                         From/To fields); mock2's band/Unlogged/Flagged/free-text filters and
                         sort-by-callsign/SNR are omitted; ReceiveHistoryEntry has no frequency/
                         callsign/grid field to filter or sort by, and LinkedQsoId is never set
                         non-null by any code path today (spec/14-roadmap.md backlog). -->
                    <Border Grid.Column="0" Classes="card">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Classes="cardHeader" Text="{loc:Translate Panes.RxHistory.GalleryHeader}" />
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource ScanlineStudioSpacingSmall}" Margin="0,4,0,4">
                                <Border Classes="segment">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Classes="seg" GroupName="GalleryFilter" Content="{loc:Translate Panes.RxHistory.FilterAll}" IsChecked="{Binding !ShowTodayOnly}" />
                                        <RadioButton Classes="seg" GroupName="GalleryFilter" Content="{loc:Translate Panes.RxHistory.FilterToday}" IsChecked="{Binding ShowTodayOnly}" />
                                    </StackPanel>
                                </Border>
                                <Button Classes="small" Content="{loc:Translate Panes.RxHistory.Refresh}" Command="{Binding RefreshCommand}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="caption"
                                       Text="{loc:Translate Panes.RxHistory.NoHistoryYet}"
                                       IsVisible="{Binding !Entries.Count}" />
                            <ScrollViewer>
                                <ListBox ItemsSource="{Binding Entries}"
                                         SelectedItem="{Binding SelectedEntry}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RxHistoryEntryViewModel">
                                            <Border Classes="thumb" Width="150" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <Image Source="{Binding Thumbnail}" Height="110" Stretch="Uniform" />
                                                    <TextBlock Classes="readoutSmall" Text="{Binding Entry.ModeId}" HorizontalAlignment="Center" />
                                                    <TextBlock Classes="readoutSmall" Text="{Binding Entry.ReceivedAt, StringFormat=HH:mm:ss}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Right: selected-frame inspector (File/Mode/ReceivedAt only; no OCR/QRZ/
                         Log-entry fields exist) + Storage card (real ImagesDirectory, resolved via
                         IReceiveHistoryStore.GetImagesDirectoryAsync). Sidecar-format and disk-free
                         readouts from mock2 are omitted; neither is tracked anywhere today. -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="{DynamicResource ScanlineStudioSpacingMedium}">
                        <Border Classes="card">
                            <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxHistory.SelectedFrameHeader}" />
                                <Border Classes="plot" Height="200">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                </Border>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.FileLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding SelectedEntry.Entry.FilePath}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.ModeLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding SelectedEntry.Entry.ModeId}" />
                                </Grid>
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.ReceivedAtLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding SelectedEntry.Entry.ReceivedAt}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Classes="card">
                            <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                                <TextBlock Classes="cardHeader" Text="{loc:Translate Panes.RxHistory.StorageHeader}" />
                                <Grid Classes="kv" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{loc:Translate Panes.RxHistory.FolderLabel}" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding ImagesDirectory}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom status bar (mock2's own persistent readout row): RX/TX-inhibit LEDs are the
             one thing not part of any tab or header card. TX-inhibit lights up when the last
             transmit attempt ended in an error/SWR-cutoff (TxControls.ErrorMessage); this app
             has no persistent transmit-lockout state to reflect more literally than that; see
             TxControlsPaneViewModel's own SWR-cutoff design for why. -->
        <Border Grid.Row="3" Classes="card">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse Classes="led" Classes.active="{Binding RadioStatus.IsReceiving}" VerticalAlignment="Center" />
                    <TextBlock Classes="readoutSmall" Text="{loc:Translate MainWindow.StatusBar.Rx}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse Classes="led" Classes.alert="{Binding TxControls.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
                    <TextBlock Classes="readoutSmall" Text="{loc:Translate MainWindow.StatusBar.TxInhibit}" ToolTip.Tip="{loc:Translate MainWindow.StatusBar.TxInhibit.Help}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="readout" Text="{Binding RadioStatus.FrequencyDisplay}" VerticalAlignment="Center" />
                <TextBlock Classes="readout" Text="{Binding RadioStatus.ModeDisplay}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
