<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             xmlns:controls="using:ScanlineStudio.UI.Controls"
             x:Class="ScanlineStudio.UI.Views.WaterfallPaneView"
             x:DataType="vm:WaterfallPaneViewModel">

    <Border Classes="IndustryPlot">
        <controls:WaterfallControl Frame="{Binding LatestFrame}" ZeroDb="{Binding ZeroDb}" GainDb="{Binding GainDb}" />
    </Border>

</UserControl>
