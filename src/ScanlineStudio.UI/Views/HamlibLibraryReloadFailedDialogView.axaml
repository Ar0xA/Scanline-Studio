<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        x:Class="ScanlineStudio.UI.Views.HamlibLibraryReloadFailedDialogView"
        x:DataType="vm:HamlibLibraryReloadFailedDialogViewModel"
        Title="{loc:Translate Options.HamlibLibraryReloadFailedDialog.Title}"
        Width="420" SizeToContent="Height"
        MinWidth="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <!-- Minimal OK-only acknowledgement — see HamlibLibraryReloadFailedDialogViewModel's own doc
         comment. Same shape as RestartRequiredDialogView.axaml/SampleRateChangeDeferredDialogView.axaml,
         except Text binds to the ViewModel's own Message property instead of a static locale string,
         since this dialog carries a real per-attempt failure detail. Phase 2 font-size presets:
         SizeToContent="Height" (was a fixed Height), matching ConfirmActionDialogView's own
         precedent. Slightly wider than its two siblings to give that longer message room to
         wrap without an excessive number of lines. -->

    <Border Background="{DynamicResource IndustryBg}">
        <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource IndustryPaddingGroup}" RowSpacing="{StaticResource IndustrySpacingGroup}">
            <TextBlock Grid.Row="0" Classes="IndustryRowValue" TextWrapping="Wrap"
                       Text="{Binding Message}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0"
                        Content="{loc:Translate Options.HamlibLibraryReloadFailedDialog.OkButton}" Command="{Binding CloseCommand}"
                        IsDefault="True" IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
