<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             xmlns:sstv="using:ScanlineStudio.Abstractions.Sstv"
             x:Class="ScanlineStudio.UI.Views.TxControlsPaneView"
             x:DataType="vm:TxControlsPaneViewModel">

    <Border Classes="ScanlineStudioPanelBody">
        <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingMedium}">

            <!-- Rigid grouping (Aesthetic Directive): the mode selector reads as its own
                 instrument module, not a loose control floating in the pane. -->
            <Border Classes="ScanlineStudioModuleGroup">
                <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                    <TextBlock Classes="ScanlineStudioReadout" FontSize="10" Text="{loc:Translate Panes.TxControls.ModeLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableModes}"
                              SelectedItem="{Binding SelectedMode}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="sstv:SstvModeDefinition">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Classes="ScanlineStudioModuleGroup">
                <StackPanel Spacing="{DynamicResource ScanlineStudioSpacingSmall}">
                    <TextBlock Classes="ScanlineStudioReadout" FontSize="10" Text="{loc:Translate Panes.TxControls.StockLabel}" />
                    <ListBox ItemsSource="{Binding StockEntries}"
                             MaxHeight="120">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StockEntryViewModel">
                                <Button Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding Entry}"
                                        ToolTip.Tip="{Binding Entry.FileName}">
                                    <Image Source="{Binding Thumbnail}" Width="64" Height="64" Stretch="Uniform" />
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="{loc:Translate Panes.TxControls.SelectImage}"
                            Command="{Binding SelectImageCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding SelectedFileName}"
                       IsVisible="{Binding SelectedFileName, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Image Source="{Binding PreviewImage}"
                   Stretch="Uniform"
                   MaxHeight="200"
                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ScanlineStudioTxActiveColor}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <ToggleButton Content="{loc:Translate Panes.TxControls.Transmit}"
                          Theme="{StaticResource ScanlineStudioTxToggleButtonTheme}"
                          Command="{Binding TransmitCommand}"
                          IsChecked="{Binding IsTransmitting, Mode=OneWay}"
                          HorizontalAlignment="Stretch" />

        </StackPanel>
    </Border>

</UserControl>
