<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             xmlns:sstv="using:ScanlineStudio.Abstractions.Sstv"
             x:Class="ScanlineStudio.UI.Views.TxControlsPaneView"
             x:DataType="vm:TxControlsPaneViewModel">

    <!-- Ported to Industry atoms (was old Cards.axaml "card"/"cardHeader"/"kv"/"label"/"value"/
         "caption"/"pill"/"segment"/"seg"/"small"/"plot" styling). Transmit/Stop toggle row: Phase 7
         finally ported the last landmine (ScanlineStudioTxToggleButtonTheme, flagged in the
         original redesign plan's own round-1 auditor review as a StaticResource that would crash
         the pane at XAML load once Tokens/Cards/ChromeOverrides were deleted) to a real
         IndustryTxToggle atom (Atoms.axaml) — same behavior (plain at rest, solid red while
         transmitting), just relocated. -->
    <!-- Margin top=6 (real-window-caught fix, same reasoning as the Receive tab's own left
         column): the ScrollViewer wrapping this UserControl in MainWindow.axaml necessarily clips
         its content to its own viewport, so the FIRST card's title notch here needs literal
         headroom reserved before it, or it clips against the viewport's own top edge; confirmed
         this margin has to live on the scrolled CONTENT itself, not on the ScrollViewer element
         (tried that first, it did not fix the clipping). -->
    <StackPanel Classes="Industry" Spacing="{StaticResource IndustrySpacingGroup}" Margin="0,6,0,0">

        <!-- TX mode card: mode selector + favorite-mode quick buttons. Membership is user-
             configured via the "Edit favorites..." popup, backed by TxPaneUiSettings.FavoriteModeIds. -->
        <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
            <HeaderedContentControl.Header>
                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxControls.ModeLabel}" />
            </HeaderedContentControl.Header>
            <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                <!-- Auto/Manual segment replaces the old plain CheckBox as the real affordance
                     for AutoFollowRxMode; same underlying real property, mock2's own control
                     shape (a two-option segment reads better than a checkbox for this). -->
                <Grid ColumnDefinitions="*,*" Margin="0,0,0,2">
                    <RadioButton Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="TxModeAutoManual" IsChecked="{Binding AutoFollowRxMode}" Content="{loc:Translate Panes.TxControls.AutoManualAuto}" />
                    <RadioButton Grid.Column="1" Classes="Industry IndustrySeg stretched" Theme="{StaticResource IndustrySegTheme}" GroupName="TxModeAutoManual" IsChecked="{Binding !AutoFollowRxMode}" Content="{loc:Translate Panes.TxControls.AutoManualManual}" />
                </Grid>
                <!-- Visual scaffolding only below this point (spec/14-roadmap.md backlog): "Auto
                     picks" caption, quick-mode pill grid, Duration/Geometry/VOX-tone rows have no
                     real data source. -->
                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.AutoPicksLabel}" />
                    <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.AutoPicksValue}" />
                </Grid></Border>
                <!-- Order matches mock2: seg -> Auto picks -> 4x4 quick-mode grid -> select ->
                     Selected/Duration/... rows (design-fidelity-agent-caught fix: the ComboBox
                     previously rendered ABOVE the grid). -->
                <UniformGrid Columns="4" Rows="4">
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SC1}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SC2}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SCDX}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M1}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M2}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M3}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.M4}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.R36}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.R72}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD50}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD90}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD120}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD160}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD180}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.PD290}" /></Border>
                    <Border Classes="Industry IndustryMini" Margin="1"><TextBlock HorizontalAlignment="Center" Text="{loc:Translate Panes.QuickModeGrid.SC2180}" /></Border>
                </UniformGrid>
                <ComboBox Classes="Industry IndustryInput" ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding SelectedMode}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="sstv:SstvModeDefinition">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Classes="Industry IndustryRows">
                    <!-- Real (SelectedMode is the same real ComboBox-bound property above; no new
                         binding), design-fidelity-agent-caught addition — mock2's own row set
                         includes it, the port previously dropped it. -->
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.SelectedLabel}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding SelectedMode.DisplayName}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.DurationLabel}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.DurationValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.GeometryLabel}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.GeometryValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.VoxToneLabel}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.VoxToneValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.VisHeaderLabel}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.VisHeaderValue}" />
                    </Grid></Border>
                </StackPanel>
                <TextBlock Classes="Industry IndustryKicker" Margin="0,2,0,0" Text="{loc:Translate Panes.TxControls.FavoritesLabel}" />
                <ItemsControl ItemsSource="{Binding FavoriteModes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FavoriteModeButtonViewModel">
                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                    Content="{Binding Mode.DisplayName}"
                                    Command="{Binding SelectCommand}"
                                    CommandParameter="{Binding Mode}"
                                    Margin="0,0,3,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}" Content="{loc:Translate Panes.TxControls.EditFavorites}" HorizontalAlignment="Left">
                    <Button.Flyout>
                        <Flyout>
                            <ItemsControl ItemsSource="{Binding FavoriteModeOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FavoriteModeOptionViewModel">
                                        <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{Binding Mode.DisplayName}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Identification: visual scaffolding only; blocked on the missing operator-callsign/
             profile setting (spec/14-roadmap.md's "TX macros / CW-ID" backlog). -->
        <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
            <HeaderedContentControl.Header>
                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxId.CardHeader}" />
            </HeaderedContentControl.Header>
            <StackPanel Classes="Industry IndustryRows">
                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxId.FskId}" />
                    <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxId.FskIdValue}" />
                </Grid></Border>
                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxId.CwId}" />
                    <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxId.CwIdValue}" />
                </Grid></Border>
                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxId.Tail}" />
                    <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxId.TailValue}" />
                </Grid></Border>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Output: merged Drive slider (moved from the header's standalone card in
             MainWindow.axaml; same underlying RadioStatus.TxVolumePercent value via the
             RadioStatus reference MainViewModel assigns onto this VM directly, not a second
             independent value - see TxControlsPaneViewModel.RadioStatus's own doc comment) +
             a literal Device row, plus the real per-capability meters and
             SWR auto-cutoff. Each meter row only renders when the connected rig/backend actually
             negotiated that capability; never a placeholder for an unsupported rig
             (spec/14-roadmap.md's Piece 6 design decision). -->
        <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
            <HeaderedContentControl.Header>
                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxControls.OutputLabel}" />
            </HeaderedContentControl.Header>
            <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.DriveLabel}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Classes="Industry h6" Theme="{StaticResource IndustrySliderTheme}" Margin="6,0"
                            Value="{Binding RadioStatus.TxVolumePercent}"
                            Minimum="0" Maximum="100" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="IndustryRowValue"
                               Text="{Binding RadioStatus.TxVolumePercent}"
                               VerticalAlignment="Center" />
                </Grid></Border>
                <StackPanel Classes="Industry IndustryRows">
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.OutputDeviceLabel}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding OutputDeviceNameDisplay}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow" IsVisible="{Binding ShowPowerMeter}"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.Telemetry.Power}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding LivePowerPercent}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow" IsVisible="{Binding ShowAlcMeter}"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.Telemetry.Alc}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding LiveAlcLevel}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow" IsVisible="{Binding ShowSwrMeter}"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.Telemetry.Swr}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding LiveSwrRatio}" />
                    </Grid></Border>
                </StackPanel>

                <!-- SWR auto-cutoff: disabled/greyed out (not just unchecked) when the rig doesn't
                     report SWR; a checked-but-non-functional toggle would be worse than no toggle.
                     No mockup CheckBox atom exists (same reasoning as the waterfall's Peak-hold
                     chip), represented as an IndustryMiniToggle chip instead. WrapPanel, not a
                     non-wrapping horizontal StackPanel (design-fidelity-agent-caught fix): the
                     toggle's own content text ("Stop TX if SWR too high") plus the Threshold
                     label+TextBox together overflow the 236-DIP column width; WrapPanel lets the
                     Threshold group drop to a second line instead of overflowing past the card's
                     own border. -->
                <WrapPanel Margin="0,2,0,0">
                    <ToggleButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniToggleTheme}" Margin="0,0,4,4"
                                  Content="{loc:Translate Panes.TxControls.SwrCutoffEnabled}"
                                  IsChecked="{Binding SwrCutoffEnabled}"
                                  IsEnabled="{Binding ShowSwrMeter}"
                                  ToolTip.Tip="{loc:Translate Panes.TxControls.SwrCutoffEnabled.Help}" />
                    <TextBlock Classes="IndustryRowLabel" Margin="0,0,4,4" Text="{loc:Translate Panes.TxControls.SwrCutoffThresholdLabel}" VerticalAlignment="Center" />
                    <TextBox Classes="Industry IndustryInput" Margin="0,0,0,4" Text="{Binding SwrCutoffThreshold}" Width="60" IsEnabled="{Binding ShowSwrMeter}" />
                </WrapPanel>

                <!-- Tone map is real (static per-mode SstvModeDefinition.LuminanceMinHz/MaxHz
                     lookup, ToneMapText below). TX clock/Monitor audio/Occupied BW below it are
                     still visual scaffolding only: none of these are exposed anywhere in
                     ScanlineStudio.Core.Audio today (spec/14-roadmap.md backlog); Occupied BW
                     specifically was researched and deliberately deferred, not just not yet done,
                     see ~/.claude/plans/wandering-glowing-otter.md. ALC/Power/SWR values themselves
                     are NOT duplicated here; the real conditional rows above already cover that. -->
                <StackPanel Classes="Industry IndustryRows">
                    <!-- Literal, same scaffolding class as ToneMap's siblings below (design-
                         fidelity-agent-caught addition — mock2 has this row, the port previously
                         dropped it). -->
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.TuneDriveLabel}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.TuneDriveValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.Telemetry.ToneMap}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{Binding ToneMapText}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.Telemetry.TxClock}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.Telemetry.TxClockValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.Telemetry.MonitorAudio}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.Telemetry.MonitorAudioValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxControls.Telemetry.OccupiedBw}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxControls.Telemetry.OccupiedBwValue}" />
                    </Grid></Border>
                </StackPanel>
                <TextBlock Classes="Industry IndustryKicker" Margin="0,2,0,0" Text="{loc:Translate Panes.TxControls.Telemetry.MeterCaption}" />
                <Border Classes="IndustryHatchPanel" MinHeight="20" />
            </StackPanel>
        </HeaderedContentControl>

        <!-- Stock/browse image source: real app feature, no mockup equivalent (same class of
             deliberate addition as the Receive tab's Mode-override ComboBox). -->
        <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
            <HeaderedContentControl.Header>
                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxControls.StockLabel}" />
            </HeaderedContentControl.Header>
            <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                <ListBox ItemsSource="{Binding StockEntries}" MaxHeight="120">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <!-- Flat Industry chrome (design-fidelity-agent-caught fix): this was the
                             only control in the left column still rendering default Fluent Button
                             chrome (rounded corners, grey fill) inside an otherwise fully-Industry
                             card — no mockup equivalent exists for this real app feature, so match
                             IndustryThumbnail's own plain hairline-border look instead. -->
                        <DataTemplate x:DataType="vm:StockEntryViewModel">
                            <Button Command="{Binding SelectCommand}"
                                    CommandParameter="{Binding Entry}"
                                    ToolTip.Tip="{Binding Entry.FileName}"
                                    Background="Transparent" BorderBrush="{StaticResource IndustryDivider}"
                                    BorderThickness="1" CornerRadius="0" Padding="0" Margin="1">
                                <Image Source="{Binding Thumbnail}" Width="64" Height="64" Stretch="Uniform" />
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Classes="Industry IndustryBtn IndustryBtn25 IndustryBtnSecondary" Content="{loc:Translate Panes.TxControls.SelectImage}"
                        Command="{Binding SelectImageCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <TextBlock Classes="IndustryRowLabel" Text="{Binding SelectedFileName}"
                           IsVisible="{Binding SelectedFileName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       MaxHeight="160"
                       IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </HeaderedContentControl>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource IndustryDanger}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
            <ToggleButton Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary IndustryTxToggle"
                          Content="{loc:Translate Panes.TxControls.Transmit}"
                          Command="{Binding TransmitCommand}"
                          IsChecked="{Binding IsTransmitting, Mode=OneWay}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnDanger" Padding="7,0" Content="{loc:Translate Panes.TxControls.StopTransmit}" Command="{Binding StopTransmitCommand}" />
        </StackPanel>

        <!-- Outgoing metadata: visual scaffolding only; blocked on the same missing operator-
             profile setting as Identification, plus a "to station"/report/QSO-context concept
             that doesn't exist yet (spec/14-roadmap.md backlog). -->
        <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}" ClipToBounds="False">
            <HeaderedContentControl.Header>
                <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Panes.TxOutgoing.CardHeader}" />
            </HeaderedContentControl.Header>
            <StackPanel Spacing="{StaticResource IndustrySpacingTight}">
                <TextBlock Classes="Industry IndustryKicker" Text="{loc:Translate Panes.TxOutgoing.InSignalCaption}" />
                <StackPanel Classes="Industry IndustryRows">
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxOutgoing.VisCode}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.VisCodeValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxId.FskId}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxId.FskIdValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxId.CwId}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.CwIdValue}" />
                    </Grid></Border>
                </StackPanel>
                <TextBlock Classes="Industry IndustryKicker" Margin="0,2,0,0" Text="{loc:Translate Panes.TxOutgoing.BurnedCaption}" />
                <StackPanel Classes="Industry IndustryRows">
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxOutgoing.Callsign}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.CallsignValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxOutgoing.ToStation}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.ToStationValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxOutgoing.GridBeam}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.GridBeamValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxOutgoing.Report}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.ReportValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxOutgoing.FreqMode}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.FreqModeValue}" />
                    </Grid></Border>
                    <Border Classes="IndustryRow"><Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Panes.TxOutgoing.DateUtc}" />
                        <TextBlock Grid.Column="1" Classes="IndustryRowValue" Text="{loc:Translate Panes.TxOutgoing.DateUtcValue}" />
                    </Grid></Border>
                </StackPanel>
            </StackPanel>
        </HeaderedContentControl>

    </StackPanel>

</UserControl>
