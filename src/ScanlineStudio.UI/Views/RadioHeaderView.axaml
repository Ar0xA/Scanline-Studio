<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScanlineStudio.UI.ViewModels"
             xmlns:loc="using:ScanlineStudio.UI.Localization"
             xmlns:conv="using:ScanlineStudio.UI.Converters"
             x:Class="ScanlineStudio.UI.Views.RadioHeaderView"
             x:DataType="vm:RadioStatusViewModel">

    <!-- VFO / Favourites / Transceiver header cards (spec/09-ui.md, mock2's own 3-column
         header row): MainWindow chrome, not a dockable pane. Connecting happens once at
         ScanlineStudio.Host startup from persisted settings, not from this strip; always visible
         regardless of which tab is active.

         UI-redesign Phase 2: re-skinned to the Industry atoms per mockups/guidance/
         PHASE2-CHROME-DESIGN.md §2, every real binding preserved verbatim (see per-card comments
         below for exactly which). Outer Grid wraps the 3-card row AND the ErrorMessage/
         MaintenanceMessage overlay in one cell (design doc §0's blocker-2 fix): both messages are
         real, live, visibility-gated text that has to coexist with a FIXED band without growing
         it — rendered as a bottom-aligned overlay, only consuming space when actually visible,
         instead of a normal document-flow sibling.

         Phase 3 fix: band height corrected from LAYOUT-SPEC's stated 81 to 102 (see MainWindow.axaml's
         Grid.RowDefinitions comment for the measurement — a faithful local-font headless-browser
         render of the source mockup HTML showed the group boxes' own natural content height is
         87px, not the ~67 LAYOUT-SPEC's "81" implied). Must stay equal to MainWindow.axaml's
         Grid.RowDefinitions row-1 value; there is no single shared resource for it (both are
         literals) since Grid.RowDefinitions can't consume a StaticResource in this Avalonia
         version. -->
    <Grid Height="102" Background="{StaticResource IndustryBg}">
        <!-- Bottom margin 8, not 7 (design-fidelity round-2 fix): reserves the 1px the new
             band-2 hairline divider (below) needs so the cards stay 87px content-height instead of
             growing when the divider was added as a bare overlay on top of the existing budget. -->
        <Grid ColumnDefinitions="Auto,*,272" ColumnSpacing="10" Margin="9,7,9,8" Classes="Industry">

            <!-- VFO card: one of this design's 3 real blueprint-corner sites (design doc §2).
                 Frequency readout, CAT-link status, sideband segment (Tier 4, 2026-08-26 — see
                 IsSidebandUsb/Lsb/Fm's own doc comment), the rig-meters pill (2026-08-18), and now
                 Bandwidth (Tier 4, 2026-08-26 — capability-gated, see CanReadBandwidth/
                 CanSetBandwidth's own doc comment) are real. Step, Split, and RIT pills all removed
                 outright 2026-08-26 (user decision, "maybe one day" — see spec/14-roadmap.md's
                 backlog) — legacy's own CAT source (cradio.h/cradio.cpp/Main.cpp/Option.cpp) has
                 zero mentions of any of the three; Split/RIT's only trace anywhere in legacy is an
                 unused property on OmniRig's auto-generated COM binding, never read/written by
                 YONIQ's own code (see the BW pill's own comment below, and the row-2 comment below
                 it, for the full reasoning). Preserved
                 product decision (design doc §2): no vertical divider between columns B/C, per prior
                 direct user feedback — LAYOUT-SPEC's own Column C has a 1px left border; deliberately
                 not resurrected here. -->
            <ContentControl Grid.Column="0" Classes="Industry blueprint"
                             Theme="{StaticResource IndustryBlueprintBorderTheme}"
                             Padding="14,5,14,5">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <!-- MinWidth (code-review fix): the readout renders at FontSize="40" mono
                         (e.g. "1296.000000 MHz" is ~320px wide there) while the entry TextBox is
                         only Width="180" — toggling edit mode reflowed the whole VFO card's
                         Auto-width column, shifting every card to its right. Set to the wider of the
                         two so the column doesn't resize either way. -->
                    <StackPanel MinWidth="320">
                        <TextBlock Classes="IndustryKicker wide" Text="{Binding VfoKickerDisplay}" />
                        <!-- 40px mono frequency readout. The ".000" dimmed-gray tail-split from
                             LAYOUT-SPEC is deferred exactly as the pre-Phase-2 code already
                             deferred it (real FrequencyDisplay format doesn't share mock2's own
                             grouping to split on) — single-color, unchanged scope.
                             ui_transition_plan.md step 11 (T2-1): click swaps this readout for the
                             TextBox below (BeginEditFrequencyCommand/IsEditingFrequency, RadioStatusViewModel.cs
                             — SetFrequencyCommand/FrequencyInputMhz were already fully built and
                             tested, just unreachable from any View before this). Not a Button (no
                             chrome/hover-highlight wanted on a passive readout that only ever gets
                             ONE thing done to it) — a PointerPressed handler in
                             RadioHeaderView.axaml.cs instead, same "code-behind for an interaction
                             AXAML alone can't express" precedent as this app's own thumbnail
                             double-tap handlers. -->
                        <TextBlock x:Name="FrequencyReadout"
                                   FontFamily="{StaticResource IndustryMonoFontFamily}"
                                   FontSize="40" FontWeight="Medium"
                                   LetterSpacing="-1.2" LineHeight="41"
                                   Foreground="{StaticResource IndustryText}"
                                   Margin="0,2,0,0"
                                   Text="{Binding FrequencyDisplay}"
                                   Cursor="Hand"
                                   ToolTip.Tip="{loc:Translate RadioStatus.FrequencyReadout.Help}"
                                   IsVisible="{Binding !IsEditingFrequency}"
                                   PointerPressed="OnFrequencyReadoutPointerPressed" />
                        <!-- Enter/Escape handled in RadioHeaderView.axaml.cs — same "code-behind
                             KeyDown, Enter commits, Escape cancels" idiom as
                             TxImageEditorPaneView.axaml.cs's own inline text-edit TextBox. -->
                        <!-- Height/MinHeight="41" (code-review fix): IndustryInput's own style sets
                             Height/MinHeight="24", which this control's FontSize="24" override alone
                             doesn't widen — the 24px font clipped inside a 22px content box without
                             this. -->
                        <TextBox x:Name="FrequencyEntry"
                                 Classes="Industry IndustryInput"
                                 FontFamily="{StaticResource IndustryMonoFontFamily}"
                                 FontSize="24" Margin="0,2,0,0" Width="180"
                                 Height="41" MinHeight="41"
                                 Text="{Binding FrequencyInputMhz}"
                                 Watermark="{loc:Translate RadioStatus.FrequencyEntry.Watermark}"
                                 IsVisible="{Binding IsEditingFrequency}"
                                 KeyDown="OnFrequencyEntryKeyDown"
                                 LostFocus="OnFrequencyEntryLostFocus" />
                    </StackPanel>
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="14" RowSpacing="4" VerticalAlignment="Center">
                        <!-- Stub survey Tier 4 (2026-08-26): now bound to SelectedRadioMode via
                             three plain derived booleans (IsSidebandUsb/Lsb/Fm) — see those
                             properties' own doc comment. Previously a fully-clickable but entirely
                             unwired literal group (combined-batch auditor review, 2026-08-14) despite
                             SelectedRadioMode itself already being real — the stub state was this
                             control's own binding, not a missing concept. RadioButtons (not
                             ToggleButtons) so IndustrySegTheme's mutual-exclusion visual applies;
                             GroupName scopes them to this control only. -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="0">
                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}"
                                         GroupName="VfoSideband" IsChecked="{Binding IsSidebandUsb}"
                                         Content="{loc:Translate RadioStatus.SidebandUsb}" />
                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}"
                                         GroupName="VfoSideband" IsChecked="{Binding IsSidebandLsb}"
                                         Content="{loc:Translate RadioStatus.SidebandLsb}" />
                            <RadioButton Classes="Industry IndustrySeg" Theme="{StaticResource IndustrySegTheme}"
                                         GroupName="VfoSideband" IsChecked="{Binding IsSidebandFm}"
                                         Content="{loc:Translate RadioStatus.SidebandFm}" />
                        </StackPanel>
                        <!-- Bound directly, no added " UTC" suffix: RadioStatus.UtcValueFormat
                             ("{0:HH:mm:ss}Z") already bakes a "Z" suffix into UtcClockDisplay
                             itself, so appending the mockup's literal " UTC" text on top would
                             double up ("14:22:07Z UTC"), caught before shipping. Preserves the
                             existing real behavior over exact mockup wording, same precedent as
                             the frequency readout's own deferred ".000" tail-split above. -->
                        <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource IndustryMonoFontFamily}"
                                   FontSize="15" Foreground="{StaticResource IndustryText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding UtcClockDisplay}" />

                        <!-- BW un-stubbed 2026-08-26 (Tier 4 stub-removal item) — real,
                             capability-gated per RadioStatusViewModel.CanReadBandwidth/
                             CanSetBandwidth's own doc comment: Hamlib and rigctld both genuinely
                             carry a passband value on their existing mode calls, flrig deliberately
                             doesn't (unreliable Hz readback, see FlrigClientProtocol.
                             SetBandwidthAsync). Falls back to the old disabled/tooltipped stub pill
                             (spec/16-gui-wiring-survey.md:344) when neither capability is present.
                             Split's own pill removed outright 2026-08-26 (user decision, "maybe one
                             day") — legacy's own CAT source (cradio.h/cradio.cpp/Main.cpp/Option.cpp)
                             has zero mentions of Split; the only place it existed at all was an
                             unused property on OmniRig's auto-generated COM binding
                             (OmniRig_OCX.h) — never read/written by any of YONIQ's own code, and
                             OmniRig itself is a removed feature in this port. See
                             spec/14-roadmap.md's backlog. -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="3">
                            <Border Classes="Industry IndustryMini" BorderThickness="1" IsVisible="{Binding CanReadBandwidth}">
                                <TextBlock Text="{Binding BandwidthDisplay}" />
                            </Border>
                            <NumericUpDown Classes="Industry" Theme="{StaticResource IndustryStepperTheme}"
                                           Width="86" Height="22" FontSize="11"
                                           Minimum="0" Maximum="20000" Increment="10" FormatString="0"
                                           Value="{Binding BandwidthInputHz}" IsVisible="{Binding CanSetBandwidth}"
                                           ToolTip.Tip="{loc:Translate RadioStatus.BandwidthInput.Help}" />
                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                    Content="{loc:Translate RadioStatus.SetBandwidth}" Command="{Binding SetBandwidthCommand}"
                                    IsVisible="{Binding CanSetBandwidth}" />
                            <Border Classes="Industry IndustryMini" BorderThickness="1"
                                    IsVisible="{Binding !CanReadBandwidth}" Opacity="0.45"
                                    ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                <TextBlock Text="{loc:Translate RadioStatus.BwValue}" />
                            </Border>
                        </StackPanel>
                        <!-- CAT link: real, one-way binding (confirmed one-way, not two-way, per
                             design doc §2's own correction). 2026-08-14: now the real LED+lozenge
                             atom (spec §6) — auditor-caught correction of this session's earlier
                             tint fix: §9.3 names this exact chip and wants it a NEUTRAL lozenge
                             with a green LED, tint is reserved for the Rx pill alone. -->
                        <Border Grid.Row="1" Grid.Column="1" Classes="Industry IndustryStatus"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Classes="Industry IndustryLed" Classes.active="{Binding CatLinked}" VerticalAlignment="Center" />
                                <Panel>
                                    <TextBlock Text="{loc:Translate RadioStatus.CatLinked}" IsVisible="{Binding CatLinked}" />
                                    <TextBlock Text="{loc:Translate RadioStatus.CatNotLinked}" IsVisible="{Binding !CatLinked}" />
                                </Panel>
                            </StackPanel>
                        </Border>

                        <!-- Step removed outright 2026-08-26 (Tier 4 scoping pass, user decision
                             "maybe one day") — legacy's own CAT header (cradio.h) has zero mentions
                             of it. RIT removed outright 2026-08-26, same decision — legacy's own CAT
                             source (cradio.h/cradio.cpp/Main.cpp/Option.cpp) has zero mentions of
                             RIT either; the only place it existed at all was an unused property on
                             OmniRig's auto-generated COM binding (OmniRig_OCX.h), never read/written
                             by YONIQ's own code, and OmniRig is a removed feature in this port. Grid
                             row 2 column 0 is now empty (no replacement control) — see
                             spec/14-roadmap.md's backlog for both. -->
                        <!-- Auditor usability review follow-up (2026-08-18): real now — the "no
                             rig-meters concept exists" premise this stub was built on was checked
                             directly against RigctldClientProtocol/HamlibRadioProtocol and found
                             false; RadioState.SwrRatio/AlcLevel/PowerPercent are real, live,
                             already-polled TX-only meter readings, just never read out of this VM
                             before now. See RadioStatusViewModel.RigMetersDisplay's own doc comment
                             for the full reasoning, including why the ADJACENT RX-level meter (a
                             separate stub, Transceiver card) stays a stub — that one really is
                             unimplemented. -->
                        <Border Grid.Row="2" Grid.Column="1" Classes="Industry IndustryMini" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RigMetersDisplay}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Favourites card: frequency memory presets; click applies both frequency+mode in
                 one action. Presets/SelectCommand/FrequencyWithMode/Label/CommandParameter are
                 real. "Store current" is now wired to StoreCurrentPresetCommand (appends the
                 currently-tuned freq/mode as a new preset and persists). Edit list/Import/Scan
                 still have no Command (same STUB precedent, deliberately unmapped per direct user
                 request, see RadioStatusViewModel's own comment) — preserved unwired.
                 Overflow: preserves the current app's own WrapPanel behavior for the unbounded,
                 user-configured Presets collection rather than clipping to the mockup's fixed
                 7-preset example (design doc §2's own explicit decision). -->
            <HeaderedContentControl Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}"
                             Padding="{StaticResource IndustryGbPaddingFav}" ClipToBounds="False">
                <HeaderedContentControl.Header>
                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate RadioStatus.FavouritesHeader}" />
                </HeaderedContentControl.Header>
                <StackPanel Spacing="5">
                    <DockPanel LastChildFill="True">
                        <!-- Deliberate deviation from the mockup (design-fidelity round-1 finding,
                             accepted not fixed): mock2's own "Store current" sits inline in the
                             preset wrap-row at whatever position follows the last preset, moving as
                             presets are added/removed. Docked to the card's far right instead so its
                             position is stable and predictable regardless of preset count, since this
                             port's Presets collection is unbounded/user-configured, unlike mock2's
                             fixed 7-preset example (see the file's own comment above). -->
                        <Button DockPanel.Dock="Right" Classes="Industry IndustryBtn IndustryBtn36 IndustryBtnPrimary"
                                Content="{loc:Translate RadioStatus.StoreCurrent}"
                                Command="{Binding StoreCurrentPresetCommand}"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <!-- Real-window-measured fix (debug bounds dump, not screenshot guessing):
                             the ScrollViewer + per-item Margin="0,0,4,4" this card previously used
                             (to guard against an unbounded Presets collection overflowing the fixed
                             81px band) together added ~12px more height than the band's own content
                             budget (~51px after padding) has room for — the DockPanel's Store-current
                             sibling is exactly IndustryBtn36's 36px, but the wrapped preset button's
                             OWN bottom margin made ITS side of the DockPanel ~4px taller, and
                             LastChildFill sizing takes the taller of the two, compounding with the
                             second (hint+edit-buttons) row to overflow the card entirely — this is
                             what was "falling off the bottom" of the card. Fix: drop the per-item
                             bottom margin (right-margin only, matching a single-row layout; a
                             genuinely multi-row WrapPanel would need it back, but that's the
                             ALREADY-accepted-as-a-later-concern overflow case, not the default one
                             actually visible today) and drop the ScrollViewer — reverts to the SAME
                             plain-overflow handling the pre-Phase-2 old design always used for this
                             exact unbounded collection, ClipToBounds="False" already lets an
                             actually-overflowing WrapPanel bleed visibly rather than silently
                             vanish, same as it does today. -->
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FrequencyPresetButtonViewModel">
                                    <Button Classes="Industry IndustryBtn IndustryBtn36 IndustryBtnSecondary"
                                            Command="{Binding SelectCommand}"
                                            CommandParameter="{Binding Preset}"
                                            Margin="0,0,4,0">
                                        <StackPanel Spacing="0">
                                            <TextBlock FontFamily="{StaticResource IndustryMonoFontFamily}"
                                                       FontSize="12.5" FontWeight="Medium"
                                                       Foreground="{StaticResource IndustryText}"
                                                       Text="{Binding FrequencyWithMode}" />
                                            <TextBlock FontFamily="{StaticResource IndustryBodyFontFamily}"
                                                       FontSize="9.5" FontWeight="Normal" LetterSpacing="0.57"
                                                       Foreground="{StaticResource IndustryLabel}"
                                                       Text="{Binding Label}" />
                                            <!-- .06em * 9.5px = 0.57 device px. -->
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- DockPanel, not a horizontal StackPanel (design-fidelity-agent-caught fix):
                         HorizontalAlignment="Right" on a child of a horizontal StackPanel is a
                         no-op (a StackPanel gives each child exactly its own desired size along the
                         stacking axis, no extra space to align within), so the minis never actually
                         reached the card's right edge as the mockup's `margin-left:auto` does. -->
                    <DockPanel LastChildFill="True">
                        <!-- Combined-batch auditor review, 2026-08-14: all 3 were fully clickable.
                             "Edit list" specifically has a real editor (EditorRows/AddPresetRowCommand/
                             SavePresetsCommand) deliberately left unmapped per a direct prior user
                             request — but that request was about not wiring the Command, not about
                             leaving the button interactive with no effect; disabled here like its
                             Import/Scan siblings (neither of which has any backend at all) to meet the
                             "no fake-live/dead controls" bar. Stub survey Tier 2 (2026-08-26): user
                             lifted that decision (AskUserQuestion) — "Edit list" now wired. Import/Scan
                             M1-M3 removed outright, not just disabled (user decision, "maybe one
                             day", stub survey Tier 3): Import had no defined source format anywhere,
                             and Scan M1-M3 would need a rig-memory-channel-read concept that doesn't
                             exist anywhere in IRadioSessionService — real CAT-layer work, not bounded
                             UI wiring. See spec/14-roadmap.md's backlog. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                            <Button Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniButtonTheme}"
                                    Content="{loc:Translate RadioStatus.EditFavouritesList}"
                                    Command="{Binding OpenFavouritesEditorCommand}" />
                        </StackPanel>
                        <TextBlock FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="10"
                                   Foreground="{StaticResource IndustryLabel}" Margin="0,0,5,0"
                                   Text="{loc:Translate RadioStatus.FavouritesHint}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </HeaderedContentControl>

            <!-- Transceiver card: Receiving/Halt (real IsReceiving two-way + HaltReceivingCommand)
                 is real. RX level: user-directed redesign (same session) — NOT a volume slider at
                 all any more (that whole real-OS-device-volume/mute design was reverted for RX),
                 it's a plain incoming-audio-LEVEL meter, WSJT-X-style: green while
                 RadioStatusViewModel.RxLevelInGoodRange, red otherwise (too quiet or clipping-hot).
                 Pwr (TX): app-internal playback gain again (TxVolumePercent, same WSJT-X/fldigi-
                 style shape this app started with), NOT OS device volume — that reversal is the
                 other half of the same user direction. TxIsMuted/TxVolumeDisplay still show a real
                 OS mute readout for the TX device (independent of the Pwr gain, see
                 RadioStatusViewModel.TxIsMuted's own doc comment for why that one piece stayed).
                 Receiving intentionally uses the SAME accent-filled palette as a primary button,
                 not a green state color (pre-Phase-2 file's own comment: sampled directly against
                 mock2's own pixels) — preserved, not "improved" toward a green/red status pair.
                 Halt: direct user request supersedes the earlier mockup-fidelity call recorded here
                 (mock2's own Halt in this specific card was plain gray, not red) — now styled
                 IndustryBtnDanger to match TxControlsPaneView's own "Stop TX" button exactly, since
                 both are the same kind of action (a destructive stop of an in-progress RX/TX
                 operation) and the user wants them to read the same way. -->
            <HeaderedContentControl Grid.Column="2" Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}"
                             Padding="{StaticResource IndustryGbPaddingFav}" ClipToBounds="False">
                <HeaderedContentControl.Header>
                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate RadioStatus.TransceiverHeader}" />
                </HeaderedContentControl.Header>
                <!-- Spacing=3, not 5 (fix): the mockup's Transceiver .gb has no gap override in its
                     own inline style, so it uses .gb's CSS default gap:3px — unlike Favourites,
                     which explicitly overrides to gap:5px (PADDING-NORMALIZATION.md/LAYOUT-SPEC §3
                     "5 (Favourites), 3 (Transceiver)"). -->
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <!-- User-reported gap (2026-08-18): "while TX lights up, receiving should
                             not stay green" — Opacity dims this purely visually while capture is
                             paused for an in-flight local transmission (IsCapturePausedForTx), a
                             SEPARATE flag from IsChecked/Command below — unchecking this toggle
                             still really stops capture either way, that click-handling contract is
                             deliberately unchanged (see RadioStatusViewModel.IsCapturePausedForTx's
                             own doc comment for why this is scoped as a visual-only fix). -->
                        <ToggleButton Classes="Industry IndustryBtn26 IndustryBtnPrimary"
                                      IsChecked="{Binding IsReceiving}" Content="{loc:Translate RadioStatus.Receiving}"
                                      Opacity="{Binding IsCapturePausedForTx, Converter={x:Static conv:BoolToOpacityConverter.Instance}}"
                                      ToolTip.Tip="{loc:Translate RadioStatus.ReceivingPausedForTx.Help}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn26 IndustryBtnDanger"
                                Content="{loc:Translate RadioStatus.Halt}" Command="{Binding HaltReceivingCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>
                    <!-- RX level and Pwr share ONE Grid (RowDefinitions, not two separate Grids) so
                         their Auto label/value columns size off the WIDER of the two rows' content
                         ("RX level" vs "Pwr", "0" vs "93") — two separate per-row Grids each size
                         their own Auto columns independently, which left the star column (and so the
                         rendered bar) a different width per row even though both used the same
                         "Auto,*,Auto" spec. Confirmed as a real visual mismatch, not a false positive,
                         via a live screenshot. -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" RowSpacing="3">
                        <TextBlock Grid.Row="0" Classes="IndustryRowLabel" Text="{loc:Translate RadioStatus.RxLevelLabel}" VerticalAlignment="Center" />
                        <!-- WSJT-X-style level meter, not a slider: fill width tracks RxLevelFillPercent
                             (0-100, from ISstvSessionService.RawInputPeakLevel), fill color switches
                             green/red off RxLevelInGoodRange. DoubleToStarGridLengthConverter drives
                             both the fill and its complementary remainder column off the SAME source
                             value (same technique WaterfallViewModeToColumnWidthConverter uses). -->
                        <Grid Grid.Row="0" Grid.Column="1" Classes="IndustryMeter" VerticalAlignment="Center">
                            <Border Classes="IndustryMeterTrack" Height="8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding RxLevelFillPercent, Converter={x:Static conv:DoubleToStarGridLengthConverter.Instance}}" />
                                    <ColumnDefinition Width="{Binding RxLevelFillPercent, Converter={x:Static conv:DoubleToStarGridLengthConverter.Instance}, ConverterParameter=Remainder}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Classes="IndustryMeterFill" Height="8" HorizontalAlignment="Stretch"
                                        Classes.good="{Binding RxLevelInGoodRange}" Classes.danger="{Binding !RxLevelInGoodRange}" />
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="IndustryRowValue" Text="{Binding RxLevelDisplay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="IndustryRowLabel" Text="{loc:Translate RadioStatus.TxVolumeLabel}" VerticalAlignment="Center" />
                        <!-- Real bug found+fixed this session (not cosmetic): the fill/thumb never
                             reflected Value at all (confirmed via a runtime Bounds dump — DecreaseButton
                             Bounds.Width read exactly 0 regardless of Value=50 or 100) because
                             PART_DecreaseButton/PART_IncreaseButton didn't inherit Stretch
                             HorizontalAlignment, so Track's own computed proportional width was
                             discarded in favor of their empty-content DesiredSize (0). Fixed in
                             IndustrySliderTheme (Atoms.axaml) with an explicit HorizontalAlignment="Stretch"
                             on both RepeatButtons. -->
                        <Slider Grid.Row="1" Grid.Column="1" Classes="Industry h8" Theme="{StaticResource IndustrySliderTheme}"
                                Value="{Binding TxVolumePercent}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="IndustryRowValue" Text="{Binding TxVolumeDisplay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>
        </Grid>

        <!-- Band-2 bottom hairline (design-fidelity-agent-caught fix): the mockup's own CSS draws
             this as a 1px border-bottom folded into the row's total height, which this port had
             been missing entirely — added as a bottom-aligned divider rather than a Border
             BorderThickness on the outer Grid so it doesn't add its own extra pixel on top of the
             already-corrected 102px band height. -->
        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource IndustryChromeBorder}" />

        <!-- Overlay row, design doc §0's blocker-2 fix: real, live, visibility-gated messages that
             must coexist with the fixed 102px band without growing it. Bottom-aligned, only
             consumes layout space when actually IsVisible. -->
        <StackPanel VerticalAlignment="Bottom" Margin="9,0,9,2" Spacing="1">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource IndustryDanger}"
                       FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- Ultracode audit finding #34's automatic-restart mechanism: deliberately a separate
                 binding from ErrorMessage above, not sharing it (see MaintenanceMessage's own doc
                 comment on the ViewModel for why reusing ErrorMessage would be unsafe here). -->
            <TextBlock Text="{Binding MaintenanceMessage}"
                       Foreground="{StaticResource IndustryDanger}"
                       FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding MaintenanceMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </Grid>
</UserControl>
