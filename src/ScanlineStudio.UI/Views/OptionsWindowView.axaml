<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        xmlns:sys="using:System.Globalization"
        x:Class="ScanlineStudio.UI.Views.OptionsWindowView"
        x:DataType="vm:OptionsWindowViewModel"
        Title="{loc:Translate Options.Title}"
        Width="720" Height="580"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <!-- Industry design port (pre-Phase-7): pure 1:1 restyle of the old "card"/"cardInner" chrome
         onto the established Industry atom set (Atoms.axaml) - no ViewModel/binding changes.
         Priority for this pass is containment (nothing clipped, everything visible) over pixel
         fidelity - no mockup exists for this window, same "extrapolate from the atom set" situation
         as Phase 6's Logbook tab. Sections that already had their own heading text become a real
         IndustryGroupBoxTheme with that text as the Header; sections that never had one stay a
         plain IndustryBlueprintBorderTheme box (no invented header copy). Every RadioButton group -
         both the 3 real ones (CAT backend) and every disabled placeholder group - uses
         IndustryMiniRadioTheme inside a WrapPanel (not a plain horizontal StackPanel), so a narrow
         resize wraps chips to a new line instead of clipping them; same WrapPanel-plus-per-item-
         margin idiom this file's own color-swatch row already used before this port. Window
         Width/MinWidth were widened from the old 640/480 - 7 tab headers (incl. "Radio / CAT" and
         "Identification") plus the Advanced tab's 4-column stepper grid made the old floor a real
         clipping risk; verify via a real-window screenshot at both default size and the MinWidth
         floor, not assumed safe from arithmetic alone. -->

    <Border Background="{StaticResource IndustryBg}">
        <Grid RowDefinitions="*,Auto">

            <TabControl Grid.Row="0" Classes="Industry">

                <TabItem Classes="Industry" Header="{loc:Translate Options.General.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <!-- Disabled placeholders: legacy MemWin/JPEGQ, no window-geometry
                                 persistence or JPEG-quality knob exists yet. -->
                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.General.Language}" />
                                    <ComboBox Classes="Industry IndustryInput" ItemsSource="{Binding AvailableCultures}"
                                              SelectedItem="{Binding SelectedCulture}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="sys:CultureInfo">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}"
                                              Content="{loc:Translate Options.General.RememberWindow}"
                                              IsChecked="{Binding RememberWindowPosition}" />
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.General.JpegQuality}" />
                                        <TextBlock Grid.Column="1" Classes="IndustryHelpGlyph" Margin="{StaticResource IndustryPaddingHairline}" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.General.JpegQuality.Help}" />
                                        <NumericUpDown Grid.Column="2" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="85" Minimum="0" Maximum="100" HorizontalAlignment="Left"
                                                       IsEnabled="False"
                                                       ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                            <!-- Disabled placeholder: legacy's 7 waterfall/spectrum colors (PCLow,
                                 PCHigh, PCFFTB/PCFFT/PCFFTStg/PCSync/PCFreq); the new flat
                                 design's palette isn't per-element customizable yet. -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.General.ColorsHeader}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.General.ColorsHeader.Help}" />
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <WrapPanel>
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="7,0" IsEnabled="False" Content="{loc:Translate Options.General.Color.Low}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" Margin="0,0,4,4" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="7,0" IsEnabled="False" Content="{loc:Translate Options.General.Color.High}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" Margin="0,0,4,4" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="7,0" IsEnabled="False" Content="{loc:Translate Options.General.Color.FftBackground}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" Margin="0,0,4,4" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="7,0" IsEnabled="False" Content="{loc:Translate Options.General.Color.FftSignal}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" Margin="0,0,4,4" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="7,0" IsEnabled="False" Content="{loc:Translate Options.General.Color.FftHistory}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" Margin="0,0,4,4" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="7,0" IsEnabled="False" Content="{loc:Translate Options.General.Color.FftSync}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" Margin="0,0,4,4" />
                                    <Button Classes="Industry IndustryBtn IndustryBtn21 IndustryBtnSecondary" Padding="7,0" IsEnabled="False" Content="{loc:Translate Options.General.Color.FftFrequency}" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" Margin="0,0,4,4" />
                                </WrapPanel>
                            </HeaderedContentControl>

                            <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetSection}" Command="{Binding ResetGeneralToDefaultCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Classes="Industry" Header="{loc:Translate Options.Audio.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Audio.CaptureDevice}" />
                                    <ComboBox Classes="Industry IndustryInput" ItemsSource="{Binding CaptureDevices}"
                                              SelectedItem="{Binding SelectedCaptureDevice}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Audio.PlaybackDevice}" />
                                    <ComboBox Classes="Industry IndustryInput" ItemsSource="{Binding PlaybackDevices}"
                                              SelectedItem="{Binding SelectedPlaybackDevice}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Audio.SampleRate}" />
                                        <TextBlock Grid.Column="1" Classes="IndustryHelpGlyph" Margin="{StaticResource IndustryPaddingHairline}" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Audio.SampleRate.Help}" />
                                        <TextBox Grid.Column="2" Classes="Industry IndustryInput" Text="{Binding SampleRate}" />
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                            <!-- Wired 2026-08-12: AppPriority (AppPerformanceSettings.ProcessPriority),
                                 Source/stereo (AudioDeviceSettings.CaptureChannelSource), CBSTX/StereoTx
                                 (AudioDeviceSettings.StereoTxEnabled): all three had a real, already
                                 wired backend with zero UI path. RxFifo/TxFifo stay disabled: legacy's
                                 Win32 waveIn/waveOut buffer count concept has no analog in this port's
                                 MiniAudio-based engine (superseded by its own automatic buffering, not
                                 a gap). SoundPriority stays disabled too: legacy's own m_SoundPriority
                                 is read/persisted but never actually applied to anything (dead control
                                 in legacy itself, verified directly); this port's real capture-thread
                                 priority knob (AudioDeviceSettings.CaptureThreadPriority) has different
                                 enum semantics and deserves its own correctly-labeled control, not a
                                 relabel of this mismatched one; left for a future pass. -->
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Audio.PerformanceHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Audio.RxFifo}" />
                                        <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="16" Minimum="4" Maximum="64" HorizontalAlignment="Left"
                                                       IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Audio.TxFifo}" />
                                        <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="16" Minimum="4" Maximum="64" HorizontalAlignment="Left"
                                                       IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </Grid>

                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Audio.SoundPriority}" />
                                    <WrapPanel IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SoundPriorityPlaceholder" Content="{loc:Translate Options.Audio.SoundPriority.Normal}" IsChecked="True" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SoundPriorityPlaceholder" Content="{loc:Translate Options.Audio.SoundPriority.High}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SoundPriorityPlaceholder" Content="{loc:Translate Options.Audio.SoundPriority.VeryHigh}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SoundPriorityPlaceholder" Content="{loc:Translate Options.Audio.SoundPriority.Critical}" />
                                    </WrapPanel>

                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Audio.AppPriority}" />
                                    <WrapPanel>
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="AppPriority" Content="{loc:Translate Options.Audio.AppPriority.Normal}" IsChecked="{Binding IsAppPriorityNormalSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="AppPriority" Content="{loc:Translate Options.Audio.AppPriority.High}" IsChecked="{Binding IsAppPriorityHighSelected}" />
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Audio.StereoSource}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Audio.StereoSource.Help}" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="StereoSource" Content="{loc:Translate Options.Audio.StereoSource.Mono}" IsChecked="{Binding IsCaptureChannelMonoSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="StereoSource" Content="{loc:Translate Options.Audio.StereoSource.Left}" IsChecked="{Binding IsCaptureChannelLeftSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="StereoSource" Content="{loc:Translate Options.Audio.StereoSource.Right}" IsChecked="{Binding IsCaptureChannelRightSelected}" />
                                    </WrapPanel>
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Audio.StereoTx}"
                                              IsChecked="{Binding StereoTxEnabled}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetSection}" Command="{Binding ResetAudioToDefaultCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Classes="Industry" Header="{loc:Translate Options.Radio.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Radio.Backend}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Radio.Backend.Help}" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4"
                                                     GroupName="RadioBackend"
                                                     Content="{loc:Translate Options.Radio.Backend.None}"
                                                     IsChecked="{Binding IsNoneBackendSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4"
                                                     GroupName="RadioBackend"
                                                     Content="{loc:Translate Options.Radio.Backend.Rigctld}"
                                                     IsChecked="{Binding IsRigctldBackendSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4"
                                                     GroupName="RadioBackend"
                                                     Content="{loc:Translate Options.Radio.Backend.Hamlib}"
                                                     IsChecked="{Binding IsHamlibBackendSelected}" />
                                        <!-- Disabled placeholder: matches spec/03-cat-layer.md's documented
                                             (but "speculative/not yet designed") 5th backend. -->
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4"
                                                     GroupName="RadioBackendPlaceholder"
                                                     IsEnabled="False"
                                                     Content="{loc:Translate Options.Radio.Backend.OmniRig}"
                                                     ToolTip.Tip="{loc:Translate Options.Radio.Backend.OmniRig.Help}" />
                                    </WrapPanel>

                                    <StackPanel IsVisible="{Binding IsRigctldSelected}" Spacing="{StaticResource IndustrySpacingSnug}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Radio.Host}" />
                                            <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding RigctldHost}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Radio.Port}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="{Binding RigctldPort}" HorizontalAlignment="Left" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding IsHamlibSelected}" Spacing="{StaticResource IndustrySpacingSnug}">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Radio.Hamlib.Model}" />
                                            <TextBlock Grid.Column="1" Classes="IndustryHelpGlyph" Margin="{StaticResource IndustryPaddingHairline}" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Radio.Hamlib.Model.Help}" />
                                            <TextBox Grid.Column="2" Classes="Industry IndustryInput" Text="{Binding HamlibModel}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Radio.Hamlib.SerialPort}" />
                                            <TextBlock Grid.Column="1" Classes="IndustryHelpGlyph" Margin="{StaticResource IndustryPaddingHairline}" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Radio.Hamlib.SerialPort.Help}" />
                                            <TextBox Grid.Column="2" Classes="Industry IndustryInput" Text="{Binding HamlibSerialPort}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Radio.Hamlib.BaudRate}" />
                                            <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding HamlibBaudRate}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Radio.Hamlib.PttType}" />
                                            <TextBlock Grid.Column="1" Classes="IndustryHelpGlyph" Margin="{StaticResource IndustryPaddingHairline}" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Radio.Hamlib.PttType.Help}" />
                                            <TextBox Grid.Column="2" Classes="Industry IndustryInput" Text="{Binding HamlibPttType}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>

                            <!-- Disabled placeholders: legacy CBRTS/PTTLock; no PTT-during-RX
                                 control surface on IRadioController yet. -->
                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Radio.RtsOnRx}"
                                              IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Radio.PttLock}"
                                                  IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" VerticalAlignment="Center" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Radio.PttLock.Help}" />
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>

                            <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetSection}" Command="{Binding ResetRadioToDefaultCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Classes="Industry" Header="{loc:Translate Options.Tx.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Tx.Callsign}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Tx.Callsign.Help}" />
                                    </StackPanel>
                                    <TextBox Classes="Industry IndustryInput" Text="{Binding Callsign}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </ContentControl>

                            <!-- Name/Grid: no legacy MMSSTV equivalent (its own macro engine has no
                                 "my name"/"my QTH" token at all), added to back mock2's own "MY
                                 NAME"/"MY GRID" overlay insert-field chips and the TX-macro engine. -->
                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Tx.OperatorName}" />
                                        <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding OperatorName}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Tx.OperatorGrid}" />
                                        <TextBox Grid.Column="1" Classes="Industry IndustryInput" Text="{Binding OperatorGrid}" />
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                            <!-- Removed 2026-08-12: this disabled QRZ.com-lookup placeholder is now
                                 superseded by the real "QRZ.com" tab (QrzLookupEnabled/Username/
                                 Password, wired in commit 4f14396). Leaving both would mean two
                                 different "QRZ lookup" toggles in two different tabs, one real and
                                 one a dead stub, which reads as a bug, not a feature. -->

                            <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetSection}" Command="{Binding ResetTxToDefaultCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- RX/demod behavior tab. Auto-Sync/Auto-Slant wired 2026-08-11, Auto-stop/
                     Auto-restart + Sense level wired 2026-08-12, Demod type wired 2026-08-12
                     (demod-type runtime-dispatch subsystem, all 4 phases), all real
                     SstvDecoderSettings fields, restart-required. RX BPF/RX buffer/Auto-start remain
                     disabled: no backing settings surface exists yet for RX BPF/RX buffer (each
                     needs its own larger DSP-scoping pass: RX BPF a CalcBPF-equivalent FIR
                     filter-preset port, RX buffer a whole buffered-line-replay subsystem), and
                     Auto-start's real legacy behavior lives on the legacy TOOLBAR (SBAuto), not in
                     Option.dfm: a placement question, not investigated further; see
                     spec/16-gui-wiring-survey.md's Decode-tab section for all three. -->
                <TabItem Classes="Industry" Header="{loc:Translate Options.Decode.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Decode.SenseLevel}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Decode.SenseLevel.Help}" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SenseLevel" Content="{loc:Translate Options.Decode.SenseLevel.VeryLow}" IsChecked="{Binding IsSenseLevelVeryLowSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SenseLevel" Content="{loc:Translate Options.Decode.SenseLevel.Low}" IsChecked="{Binding IsSenseLevelLowSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SenseLevel" Content="{loc:Translate Options.Decode.SenseLevel.High}" IsChecked="{Binding IsSenseLevelHighSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="SenseLevel" Content="{loc:Translate Options.Decode.SenseLevel.VeryHigh}" IsChecked="{Binding IsSenseLevelVeryHighSelected}" />
                                    </WrapPanel>

                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Decode.RxBpf}" />
                                    <WrapPanel IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="RxBpfPlaceholder" Content="{loc:Translate Options.Decode.RxBpf.Normal}" IsChecked="True" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="RxBpfPlaceholder" Content="{loc:Translate Options.Decode.RxBpf.Wide}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="RxBpfPlaceholder" Content="{loc:Translate Options.Decode.RxBpf.Sharp}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="RxBpfPlaceholder" Content="{loc:Translate Options.Decode.RxBpf.VerySharp}" />
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Decode.DemodType}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Decode.DemodType.Help}" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="DemodType" Content="{loc:Translate Options.Decode.DemodType.Pll}" IsChecked="{Binding IsDemodTypePllSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="DemodType" Content="{loc:Translate Options.Decode.DemodType.ZeroCrossing}" IsChecked="{Binding IsDemodTypeZeroCrossingSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="DemodType" Content="{loc:Translate Options.Decode.DemodType.Hilbert}" IsChecked="{Binding IsDemodTypeHilbertSelected}" />
                                    </WrapPanel>

                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Decode.RxBuffer}" />
                                    <WrapPanel IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="RxBufferPlaceholder" Content="{loc:Translate Options.Decode.RxBuffer.Off}" IsChecked="True" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="RxBufferPlaceholder" Content="{loc:Translate Options.Decode.RxBuffer.On}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="RxBufferPlaceholder" Content="{loc:Translate Options.Decode.RxBuffer.Extended}" />
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Decode.AutoStart}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Decode.AutoStart.Help}" />
                                    </StackPanel>
                                    <WrapPanel IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="AutoStartPlaceholder" Content="{loc:Translate Options.Decode.AutoStart.Off}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="AutoStartPlaceholder" Content="{loc:Translate Options.Decode.AutoStart.On}" IsChecked="True" />
                                    </WrapPanel>

                                    <!-- Wired 2026-08-12: SstvDecoderSettings.AutoStopEnabled/SyncRestartEnabled are
                                         real, already-consumed decoder settings; these two were left STUB
                                         specifically because their OLD loc text lied about what the fields actually
                                         gate (AutoStop said "when sync looks stable", the field really gates
                                         stopping on erratic/WEAK signal; AutoRestart said "on loss", the field
                                         really gates restarting onto a STRONGER sync found mid-reception): fixed
                                         both labels to match SstvDecoderSettings.cs's own verified doc comments
                                         before wiring, not shipping a control that still lies. Same "takes effect
                                         on next app restart" caveat as every other Options-dialog setting. -->
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Decode.AutoStop}"
                                              IsChecked="{Binding AutoStopEnabled}" />
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Decode.AutoRestart}"
                                              IsChecked="{Binding SyncRestartEnabled}" />
                                    <!-- Wired 2026-08-11: SstvDecoderSettings.AutoSyncEnabled/AutoSlantEnabled are real,
                                         already-consumed decoder settings (RestartableSstvDecoder via
                                         ScanlineStudio.Host.Program's ISstvDecoder registration); this dialog was the
                                         only missing piece. Takes effect on next app restart (see OptionsWindowViewModel's
                                         own doc comment on these two properties). -->
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Decode.AutoSync}"
                                              IsChecked="{Binding AutoSyncEnabled}" />
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Decode.AutoSlant}"
                                              IsChecked="{Binding AutoSlantEnabled}" />

                                    <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetSection}" Command="{Binding ResetDecodeToDefaultCommand}" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ID method (CW/FSK) is real (CW-ID/FSK station-ID subsystem, Phase 6). Sound-file
                     ID, VOX, and the satellite-tune trigger stay disabled: none of those exist
                     yet. Tune frequency/duration themselves are real (header's Tune row) and
                     intentionally NOT duplicated here. NR/RST TX enable/text have no control here
                     at all (no mockup row exists for them yet: StationIdSettings.NrRstEnabled/
                     NrRstText are real, tested backend settings, preserved as-is by this dialog's
                     Save the same way SstvDecoderSettings.AfcEnabled is; see OptionsSnapshot's
                     own doc comment). -->
                <TabItem Classes="Industry" Header="{loc:Translate Options.Identification.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Identification.IdMethodHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <WrapPanel>
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="IdMethod" Content="{loc:Translate Options.Identification.IdMethod.Off}" IsChecked="{Binding IsIdMethodOffSelected}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="IdMethod" Content="{loc:Translate Options.Identification.IdMethod.Cw}" IsChecked="{Binding IsIdMethodCwSelected}" />
                                        <!-- Sound-file ID (OutputMMV) is unimplemented, out of v1 scope: stays individually
                                             disabled rather than joining the live radio group (CwIdMode's own doc comment). -->
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="IdMethod" Content="{loc:Translate Options.Identification.IdMethod.SoundFile}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </WrapPanel>

                                    <StackPanel IsVisible="{Binding IsIdMethodCwSelected}" Spacing="{StaticResource IndustrySpacingSnug}">
                                        <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Identification.CwText}" />
                                        <TextBox Classes="Industry IndustryInput" Text="{Binding CwText}" />

                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Identification.CwFrequency}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="{Binding CwToneFrequencyHz}" Minimum="100" Maximum="3000" HorizontalAlignment="Left" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Identification.CwSpeed}" />
                                            <NumericUpDown Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="{Binding CwWpm}" Minimum="10" Maximum="50" HorizontalAlignment="Left" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Identification.SoundFile}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Identification.SoundFile.Help}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource IndustrySpacingSnug}">
                                        <TextBox Classes="Industry IndustryInput" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                        <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.Identification.SoundFile.Browse}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </Grid>

                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Identification.FskEncode}"
                                              IsChecked="{Binding FskIdTxEnabled}" />
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Identification.FskDecode}"
                                              IsChecked="{Binding FskIdRxEnabled}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Identification.VoxHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <WrapPanel IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="VoxModePlaceholder" Content="{loc:Translate Options.Identification.Vox.Off}" IsChecked="True" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="VoxModePlaceholder" Content="{loc:Translate Options.Identification.Vox.On}" />
                                    </WrapPanel>
                                    <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.Identification.Vox.EditTone}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <ContentControl Classes="Industry" Theme="{StaticResource IndustryBlueprintBorderTheme}" Padding="{StaticResource IndustryGbPadding}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Identification.TuneSatellite}"
                                              IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" VerticalAlignment="Center" />
                                    <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Identification.TuneSatellite.Help}" />
                                </StackPanel>
                            </ContentControl>

                            <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetSection}" Command="{Binding ResetIdentificationToDefaultCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- New tab: deep DSP/diagnostic internals. All disabled. Filter-response preview
                     buttons (legacy DispTxBpf/DispLoopLPF/DispOutLPF/DispCrossOutLPF/RxBpfBtn) are
                     intentionally not included; they preview filters that are themselves
                     disabled placeholders, so there is nothing real to preview yet. -->
                <TabItem Classes="Industry" Header="{loc:Translate Options.Advanced.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <TextBlock Foreground="{StaticResource IndustryTextMuted62}" FontFamily="{StaticResource IndustryBodyFontFamily}" FontSize="11" TextWrapping="Wrap" Text="{loc:Translate Options.Advanced.Caption}" />

                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Advanced.PllHeader}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Advanced.PllHeader.Help}" />
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="{StaticResource IndustrySpacingSnug}" RowSpacing="{StaticResource IndustrySpacingSnug}" RowDefinitions="Auto,Auto" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.Pll.VcoGain}" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="2600" Minimum="0" Maximum="100000" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.Pll.LoopOrder}" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="3" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="1" Minimum="1" Maximum="32" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.Pll.LoopCutoff}" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="200" Minimum="0" Maximum="10000" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.Pll.OutCutoff}" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="3" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="1200" Minimum="0" Maximum="10000" />
                                </Grid>
                            </HeaderedContentControl>

                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Advanced.CrossingHeader}" />
                                        <TextBlock Classes="IndustryHelpGlyph" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Advanced.CrossingHeader.Help}" />
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="{StaticResource IndustrySpacingSnug}" RowSpacing="{StaticResource IndustrySpacingSnug}" RowDefinitions="Auto,Auto" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.Crossing.Order}" />
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="1" Minimum="1" Maximum="32" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.Crossing.Cutoff}" />
                                        <NumericUpDown Grid.Row="0" Grid.Column="3" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="1200" Minimum="0" Maximum="10000" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.Crossing.Smoothing}" />
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" Value="2000" Minimum="500" Maximum="8000" />
                                    </Grid>
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Advanced.Differentiator}"
                                              IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Advanced.TxFilterHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Advanced.TxBpf}"
                                              IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Advanced.TxLpf}"
                                              IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{loc:Translate Options.Advanced.TxSampleClockOffset}" />
                                        <TextBlock Grid.Column="1" Classes="IndustryHelpGlyph" Margin="{StaticResource IndustryPaddingHairline}" Text="{loc:Translate Options.HelpGlyph}" ToolTip.Tip="{loc:Translate Options.Advanced.TxSampleClockOffset.Help}" />
                                        <NumericUpDown Grid.Column="2" Classes="Industry" Theme="{StaticResource IndustryStepperTheme}" MinWidth="100" HorizontalAlignment="Left" Value="0" Minimum="-1500" Maximum="1500" Increment="0.02" FormatString="F2" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </Grid>
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Advanced.MiscHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Advanced.Loopback}" />
                                    <WrapPanel IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}">
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="LoopbackPlaceholder" Content="{loc:Translate Options.Advanced.Loopback.Off}" IsChecked="True" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="LoopbackPlaceholder" Content="{loc:Translate Options.Advanced.Loopback.Internal}" />
                                        <RadioButton Classes="Industry IndustryMini" Theme="{StaticResource IndustryMiniRadioTheme}" Margin="0,0,4,4" GroupName="LoopbackPlaceholder" Content="{loc:Translate Options.Advanced.Loopback.External}" />
                                    </WrapPanel>
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Advanced.PolynomialCalibration}"
                                              IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    <WrapPanel>
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4" Content="{loc:Translate Options.Advanced.ClockAdjustWizard}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Margin="0,0,4,4" Content="{loc:Translate Options.Advanced.LevelCalibrationWizard}" IsEnabled="False" ToolTip.Tip="{loc:Translate Options.NotImplemented.Help}" />
                                    </WrapPanel>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- New tab: real QRZ.com XML Callbook lookup (see QrzCallsignLookup.cs, legacy
                     qrzcom.cpp). NOT named "Logbook": QrzUploadSettings/the QRZ Logbook upload
                     API key has no UI anywhere yet, so a tab titled "Logbook" containing only
                     lookup credentials would misleadingly imply it covers that too. -->
                <TabItem Classes="Industry" Header="{loc:Translate Options.Qrz.Tab}">
                    <ScrollViewer>
                        <StackPanel Spacing="{StaticResource IndustrySpacingGroup}" Margin="{StaticResource IndustryPaddingGroup}">
                            <HeaderedContentControl Classes="Industry" Theme="{StaticResource IndustryGroupBoxTheme}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Classes="IndustryGbTitle" Text="{loc:Translate Options.Qrz.QrzLookupHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Spacing="{StaticResource IndustrySpacingSnug}">
                                    <CheckBox Classes="Industry" Theme="{StaticResource IndustryCheckBoxTheme}" Content="{loc:Translate Options.Qrz.QrzLookupEnabled}"
                                              IsChecked="{Binding QrzLookupEnabled}" />
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Qrz.UsernameLabel}" />
                                    <TextBox Classes="Industry IndustryInput" Watermark="{loc:Translate Options.Qrz.QrzLookupUsernameWatermark}"
                                             Text="{Binding QrzLookupUsername}" />
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Qrz.PasswordLabel}" />
                                    <TextBox Classes="Industry IndustryInput" Watermark="{loc:Translate Options.Qrz.QrzLookupPasswordWatermark}"
                                             Text="{Binding QrzLookupPassword}" PasswordChar="•" />
                                    <!-- A real QRZ account password (not a scoped/revocable API key like the
                                         separate QRZ Logbook upload feature) is stored in plaintext local
                                         settings: no scoped-credential mode exists for this API, so a hint
                                         is the mitigation, not a fix. -->
                                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.Qrz.QrzLookupPasswordHint}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                                        <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.Qrz.TestButton}"
                                                Command="{Binding TestQrzLookupCommand}" />
                                        <TextBlock Classes="IndustryRowLabel" VerticalAlignment="Center" Text="{Binding TestQrzLookupStatus}" />
                                    </StackPanel>
                                </StackPanel>
                            </HeaderedContentControl>

                            <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetSection}" Command="{Binding ResetQrzToDefaultCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- Bottom bar: destructive "Reset ALL" on the left with its own inline confirm step
                 (IsConfirmingResetAll), Cancel/Save on the right. Per-section resets above are a
                 single click each since nothing is persisted until Save. -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="{StaticResource IndustryPaddingGroup}">
                <Button Grid.Column="0" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0"
                        Content="{loc:Translate Options.ResetAll}"
                        Command="{Binding RequestResetAllCommand}"
                        IsVisible="{Binding !IsConfirmingResetAll}" />
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingSnug}" IsVisible="{Binding IsConfirmingResetAll}">
                    <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate Options.ResetAll.ConfirmPrompt}" TextWrapping="Wrap" MaxWidth="260" VerticalAlignment="Center" />
                    <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0" Content="{loc:Translate Options.ResetAll.ConfirmYes}" Command="{Binding ConfirmResetAllCommand}" />
                    <Button Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.ResetAll.ConfirmNo}" Command="{Binding CancelResetAllCommand}" />
                </StackPanel>

                <Button Grid.Column="2" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0" Content="{loc:Translate Options.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,4,0" IsVisible="{Binding !IsConfirmingResetAll}" />
                <Button Grid.Column="3" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0" Content="{loc:Translate Options.Save}" Command="{Binding SaveCommand}" IsVisible="{Binding !IsConfirmingResetAll}" />
            </Grid>

        </Grid>
    </Border>

</Window>
