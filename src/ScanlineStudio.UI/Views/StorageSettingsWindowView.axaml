<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        x:Class="ScanlineStudio.UI.Views.StorageSettingsWindowView"
        x:DataType="vm:StorageSettingsWindowViewModel"
        Title="{loc:Translate StorageSettings.Title}"
        Width="480" Height="200"
        MinWidth="420" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!-- Stub survey Tier 2 (2026-08-26). "Naming" dropped from scope (menu item renamed
         Configurations > Storage) — no filename-pattern setting exists anywhere to back it. -->

    <Border Background="{StaticResource IndustryBg}">
        <Grid RowDefinitions="*,Auto" Margin="{StaticResource IndustryPaddingGroup}">

            <StackPanel Grid.Row="0" Spacing="{StaticResource IndustrySpacingSnug}">
                <TextBlock Classes="IndustryRowLabel" Text="{loc:Translate StorageSettings.ImagesDirectoryLabel}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Classes="Industry IndustryInput" Text="{Binding ImagesDirectory}" />
                    <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0"
                            Content="{loc:Translate StorageSettings.BrowseButton}" Command="{Binding BrowseCommand}" />
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource IndustryDanger}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource IndustrySpacingTight}" Margin="0,11,0,0">
                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0"
                        Content="{loc:Translate StorageSettings.SaveButton}" Command="{Binding SaveCommand}" />
                <Button Grid.Column="2" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnSecondary" Padding="7,0"
                        Content="{loc:Translate StorageSettings.CloseButton}" Command="{Binding CloseCommand}" />
            </Grid>
        </Grid>
    </Border>
</Window>
