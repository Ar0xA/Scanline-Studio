<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ScanlineStudio.UI.Localization"
        xmlns:vm="using:ScanlineStudio.UI.ViewModels"
        x:Class="ScanlineStudio.UI.Views.QuickSwitchFailedDialogView"
        x:DataType="vm:QuickSwitchFailedDialogViewModel"
        Title="{loc:Translate Configurations.QuickSwitchFailedTitle}"
        Width="420" Height="200"
        MinWidth="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <!-- Minimal OK-only acknowledgement — same shape as HamlibLibraryReloadFailedDialogView.axaml,
         since Text binds to the ViewModel's own Message property instead of a static locale string. -->

    <Border Background="{StaticResource IndustryBg}">
        <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource IndustryPaddingGroup}" RowSpacing="{StaticResource IndustrySpacingGroup}">
            <TextBlock Grid.Row="0" Classes="IndustryRowValue" TextWrapping="Wrap"
                       Text="{Binding Message}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Button Grid.Column="1" Classes="Industry IndustryBtn IndustryBtn24 IndustryBtnPrimary" Padding="7,0"
                        Content="{loc:Translate Configurations.QuickSwitchFailedOkButton}" Command="{Binding CloseCommand}"
                        IsDefault="True" IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
