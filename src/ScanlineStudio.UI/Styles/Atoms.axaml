<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Reusable primitive layer for the "Industry" wireframe design system
         (mockups/guidance/LAYOUT-SPEC.md, mockups/guidance/PHASE1-ATOM-DESIGN.md — the fully
         auditor-reviewed spec this file implements, item numbers below refer to that doc).
         ADDITIVE: loaded after ChromeOverrides.axaml in App.axaml, old Tokens/Cards/ChromeOverrides
         stay in force until every view is ported (redesign plan Phase 7). Every new-design control
         instance built here or consumed at a later-phase call site carries the "Industry" marker
         class so the old design's own bare-type Style selectors (Cards.axaml/Tokens.axaml/
         ChromeOverrides.axaml, now narrowed to ":not(.Industry)" as part of this same phase) don't
         also apply — see item 0/0b for the full reasoning; empirically confirmed (not assumed)
         that a bare Style's setters win over a same-priority ControlTheme's own setters, so this
         marker is load-bearing, not defensive.

         Structure note: only KEYED resources (ControlTheme, ControlTemplate with x:Key) live inside
         Styles.Resources/ResourceDictionary below — every bare Style Selector="..." rule is a
         top-level child of the root Styles element instead, per Avalonia's actual XAML shape
         (Style elements aren't resources and can't nest inside a ResourceDictionary). -->

    <Styles.Resources>
        <ResourceDictionary>

            <!-- ═══════════════════════ 1. Group box (.gb) ═══════════════════════
                 TemplatedControl deriving HeaderedContentControl (not UserControl — a UserControl's
                 XAML root IS its Content, which would let a caller's Content overwrite the chrome).
                 Notch-over-border recipe: bordered Grid + a second, later-drawn Border (background
                 IndustryBg, negative margin) holding the title, sitting visually on the border line.
                 Blueprint corner marks (item 1's own correction: color IndustryTextMuted55, NOT
                 accent; each an 11×11px "+" cross whose own box sits outward at -6px/-6px from the
                 border's corner, so its crossing point lands essentially ON the border corner
                 (~-0.5px) while the arm tips reach 6px out — round-2 code-review fix: an earlier
                 version of this comment wrongly said the crossing point itself was "5px past the
                 border") are baked into this SAME template, gated by the "blueprint" class, so
                 the 2 real group-box blueprint sites (Incoming-frame, Editor) opt in via
                 Classes="Industry blueprint" without a second control. -->
            <ControlTheme x:Key="IndustryGroupBoxTheme" TargetType="HeaderedContentControl">
                <!-- ClipToBounds=False, set HERE not per call site (Phase 3 fix): FluentTheme's
                     base HeaderedContentControl/ContentControl styling sets ClipToBounds=True,
                     which clips this template's own -6px title notch overhang AND clips real
                     content that (legitimately, e.g. an unbounded user-configured collection)
                     exceeds a fixed-height ancestor's allotted cell — confirmed via a real-window
                     screenshot on the Phase 2 radio header cards (titles were visibly cut off,
                     Transceiver's TX-level row was missing entirely) before this fix. Setting it
                     once on the ControlTheme itself, not as a local attribute on every call site,
                     since every future group-box instance across the rest of this redesign would
                     otherwise need the same one-line fix repeated by hand. -->
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="Padding" Value="{StaticResource IndustryGbPadding}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid>
                            <Border BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1"
                                    CornerRadius="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                            <Border Background="{StaticResource IndustryBg}"
                                    Padding="{StaticResource IndustryGbtPadding}"
                                    Margin="7,-5,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                   ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            </Border>
                            <!-- Blueprint corner marks — present in every instance of this template,
                                 visibility gated by the "blueprint" class (item 1's own correction:
                                 only Incoming-frame/Editor opt in, the group box's own 2 real sites).

                                 CODE-REVIEW FIX (blocker 2): the original negative-coordinate Path
                                 Data + alignment-only approach put 3 of 4 corners INSIDE the box
                                 instead of outward — Avalonia's Shape measure (Stretch.None) only
                                 counts the POSITIVE extent of geometry data when sized purely by
                                 alignment, so e.g. the Right-aligned TR corner's negative-x data
                                 collapsed to a ~0-width desired size and got arranged flush with the
                                 border instead of -6px past it. Fixed by giving each corner an
                                 unambiguous, fixed 11x11 layout slot (matching the real CSS box size,
                                 _ds/.../styles.css:83-95) positioned via explicit Margin, with the
                                 cross drawn at LOCAL (0..11) coordinates inside that slot — the same
                                 11x11 internal cross (vertical stroke at local x=5 spanning full
                                 height, horizontal stroke at local y=5 spanning full width) is shared
                                 identically by all four corners; only the slot's Margin/Alignment
                                 differs per corner, matching the real CSS (all four `.corner`
                                 instances share one `::before`/`::after` rule, only their own
                                 top/left/right/bottom anchor differs). Needs a real-window visual
                                 confirmation once first consumed (Phase 3+) per this project's own
                                 "verify geometry-coordinate questions empirically" discipline. -->
                            <Canvas Name="PART_CornerTL" Width="11" Height="11" Margin="-5,-5,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    IsHitTestVisible="False" IsVisible="False"
                                    UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                            <Canvas Name="PART_CornerTR" Width="11" Height="11" Margin="0,-5,-5,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    IsHitTestVisible="False" IsVisible="False"
                                    UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                            <Canvas Name="PART_CornerBL" Width="11" Height="11" Margin="-5,0,0,-5"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    IsHitTestVisible="False" IsVisible="False"
                                    UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                            <Canvas Name="PART_CornerBR" Width="11" Height="11" Margin="0,0,-5,-5"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    IsHitTestVisible="False" IsVisible="False"
                                    UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- Plain bordered container with corner marks (VFO block — item 1's 3rd blueprint
                 site, NOT a group box: no .gbt title notch at all). Separate ControlTheme so
                 Classes="blueprint" is genuinely usable independently of IndustryGroupBox. Same
                 blocker-2 fix as IndustryGroupBoxTheme above — Margin-positioned 11x11 slots, not
                 negative-coordinate Data.

                 Phase 3 fix: the crosshair strokes rendered ~2x their intended 1px hairline weight
                 (user-caught, "odd big + signs" — confirmed via a raw-pixel screenshot crop: the
                 mini-chip's Border-drawn 1px borders render crisp/1px, these fill-based crosses
                 rendered ~2px, blurred). Root-caused via a dedicated Opus subagent call after two
                 failed attempts (UseLayoutRounding tweaks, EdgeMode="Aliased" alone) both still
                 showed 2 full-strength device pixels, not an AA blend. Real cause: Avalonia's
                 layout rounding (LayoutHelper.RoundLayoutSizeUp) uses Math.Ceiling, not
                 round-to-nearest, and applies to anything LAYOUT-SIZED — a Width="1" Rectangle or
                 Border.Background fill. At this window's ~1.2x render scale, ceil(1 x 1.2) = 2
                 device px: a genuine 2-solid-pixel fill, which EdgeMode="Aliased" alone can't fix
                 since both pixels are already full-strength, not antialiased. A Border/Path STROKE,
                 by contrast, is a Skia pen width handed straight to the stroke rasterizer — it
                 never goes through layout-rounding, so it stays a true 1px line regardless of
                 scale. Fixed by replacing each corner's 2 filled Border boxes with ONE stroked
                 Path per corner (this theme and IndustryGroupBoxTheme's own corner marks above),
                 at half-pixel-offset coordinates (5.5, not 5) so the 1px pen lands on exactly one
                 device pixel row/column, with UseLayoutRounding="False" on both the Canvas and the
                 Path so nothing along that chain re-snaps the offset back to an integer.

                 design-fidelity-agent-caught follow-up: the slot's own Margin was -6 on the outward
                 sides (matching the OLD 12x12-inclusive-of-border sizing assumption), but the CSS
                 `.corner` box is offset from the PADDING box (inside the 1px border), so it should
                 start 5px outside the border, not 6, so it's corrected to -5 on all 8 corner-mark
                 instances (this theme and IndustryGroupBoxTheme's PART_CornerTL/TR/BL/BR above),
                 confirmed via a real headless-render pixel comparison against the mockup HTML. -->

            <ControlTheme x:Key="IndustryBlueprintBorderTheme" TargetType="ContentControl">
                <!-- ClipToBounds=False, same Phase 3 fix/reasoning as IndustryGroupBoxTheme above. -->
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid>
                            <Border BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1"
                                    CornerRadius="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                            <Canvas Width="11" Height="11" Margin="-5,-5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                            <Canvas Width="11" Height="11" Margin="0,-5,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                            <Canvas Width="11" Height="11" Margin="-5,0,0,-5" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                            <Canvas Width="11" Height="11" Margin="0,0,-5,-5" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" UseLayoutRounding="False">
                                <Path Canvas.Left="0" Canvas.Top="0"
                                      Stroke="{StaticResource IndustryTextMuted55}"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      UseLayoutRounding="False"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ═══════════════════════ 2. .mini Button/ToggleButton forms ═══════════════════════
                 (the static Border form needs no ControlTheme — a plain Border + TextBlock, styled
                 entirely via bare Style rules below.) -->
            <ControlTheme x:Key="IndustryMiniButtonTheme" TargetType="Button">
                <!-- MinHeight paired with Height (post-Phase-2-verification fix, same bug class as
                     IndustryBtn*/Menu.Industry/TabItem.Industry — a ControlTheme's own Height
                     Setter alone can still lose to a competing base-FluentTheme Style's MinHeight,
                     since Style-vs-ControlTheme precedence applies regardless of which Theme is
                     assigned; confirmed via a real-window screenshot on the sibling IndustryBtn26
                     case). -->
                <Setter Property="Padding" Value="{StaticResource IndustryMiniPadding}" />
                <Setter Property="Height" Value="17" />
                <Setter Property="MinHeight" Value="17" />
                <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Face" Background="Transparent"
                                BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1" CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="IndustryMiniToggleTheme" TargetType="ToggleButton">
                <Setter Property="Padding" Value="{StaticResource IndustryMiniPadding}" />
                <Setter Property="Height" Value="17" />
                <Setter Property="MinHeight" Value="17" />
                <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Face" Background="Transparent"
                                BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1" CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- Third .mini form, Phase 4 (Editor card): a real exclusive-select tool strip
                 (legacy has no equivalent — this is app-added scaffolding — but the OLD design
                 already implemented it as a genuine RadioButton GroupName group, not a plain
                 Button row, so re-skinning to Industry must preserve that exclusivity, not
                 downgrade it to inert chips. ToggleButton has no built-in GroupName mechanism in
                 Avalonia, so IndustryMiniToggleTheme can't substitute here — this is a real
                 third mini-chip control type, not a drive-by addition. Template identical to
                 IndustryMiniButtonTheme/IndustryMiniToggleTheme; :checked visual state below
                 mirrors ToggleButton.IndustryMini:checked exactly (accent fill, IndustryBg text). -->
            <ControlTheme x:Key="IndustryMiniRadioTheme" TargetType="RadioButton">
                <Setter Property="Padding" Value="{StaticResource IndustryMiniPadding}" />
                <Setter Property="Height" Value="17" />
                <Setter Property="MinHeight" Value="17" />
                <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Face" Background="Transparent"
                                BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1" CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ═══════════════════════ 2b. Real CheckBox (Options window) ═══════════════════════
                 First real consumer of a form-style boolean toggle — every mockup toggle to date
                 was `.seg`/`.mini` (exclusive-select or momentary chip), never a plain checkbox.
                 Full ControlTemplate replacement, same low-risk technique as IndustryMiniToggleTheme/
                 IndustrySegTheme above: CheckBox's own check/uncheck logic lives on the control
                 itself (OnToggle), not on any named template part, so there is no PART_* wiring to
                 get wrong. Tick glyph as Path geometry, not a literal Text= character — same
                 NoHardcodedAxamlStringsTests reasoning as the stepper/disclosure atoms. -->
            <ControlTheme x:Key="IndustryCheckBoxTheme" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource IndustryBodyFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource IndustrySpacingTight}">
                            <Border Name="PART_Box" Width="14" Height="14" VerticalAlignment="Center"
                                    Background="{StaticResource IndustrySurface}"
                                    BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1" CornerRadius="0">
                                <Path Name="PART_Tick" Data="M 2.5,7.5 L 6,11 L 11.5,3.5"
                                      Stroke="{StaticResource IndustryBg}" StrokeThickness="1.5"
                                      Stretch="None" IsVisible="False"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                               ContentTemplate="{TemplateBinding ContentTemplate}"
                                               VerticalAlignment="Center" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ═══════════════════════ 5. Stepper — reuses NumericUpDown ═══════════════════════
                 CODE-REVIEW FIX (blocker 1): NumericUpDown does NOT have PART_IncreaseButton/
                 PART_DecreaseButton members — those belong to ButtonSpinner. NumericUpDown only
                 recognizes Spinner (a ButtonSpinner) and TextBox template parts, wiring spin
                 through Spinner.Spin -> OnSpin -> OnIncrement/OnDecrement. The original template's
                 bare RepeatButtons with those names were invisible to NumericUpDown (confirmed
                 against Avalonia 11.3.12's own reference metadata) — clicking them did nothing, and
                 dropping ButtonSpinner also silently killed mouse-wheel/arrow-key spin (both live
                 on ButtonSpinner, not NumericUpDown). Fixed: host a real ButtonSpinner (named
                 PART_Spinner, itself carrying a named Theme — see IndustrySpinnerTheme below, this
                 exact "named theme on a template-internal control" shape is already proven safe in
                 this codebase at ChromeOverrides.axaml:83-84/93) wrapping the value TextBox as its
                 Content. Named ControlTheme, never the bare {x:Type NumericUpDown} key (item 0's
                 rule). Every stepper site carries Classes="Industry" ONLY — never IndustryInput
                 (item 8's selector target), or it would also match .input and fight this template.

                 CODE-REVIEW FIX (blocker 4): MinWidth belongs to the WHOLE control here, not just
                 the value cell — LAYOUT-SPEC's 52/46/34/24 numbers are the value CELL's own
                 min-width (confirmed: LAYOUT-SPEC.md:143/189), so each site's override must add the
                 two 18px buttons + ~2px of borders (36+2=38) on top: default 52+38=90, and the
                 46/34/24 sites become 84/72/62 at their own call sites. NumericUpDown.MinWidth is a
                 perfectly normal Control property (not baked into a template literal), so a
                 call-site-local MinWidth genuinely overrides this ControlTheme's own default Setter
                 (Local value beats ControlTheme, per this project's own empirically-confirmed
                 precedence rule) — the Grid's "*" middle column then naturally receives whatever
                 width remains, without needing to reach inside the template at all. -->
            <ControlTheme x:Key="IndustrySpinnerTheme" TargetType="ButtonSpinner">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <Grid ColumnDefinitions="18,*,18">
                                <!-- Glyphs as Path geometry, not a literal Text= character: matches
                                     ChromeOverrides.axaml's own existing ButtonSpinner-glyph
                                     convention, and avoids NoHardcodedAxamlStringsTests's blanket
                                     ban on literal Text=/Content=/Header= attributes. -->
                                <!-- MinWidth/MinHeight="0" (round-2 code-review risk): the old
                                     design's own ButtonSpinner theme (ChromeOverrides.axaml's
                                     PART_IncreaseButton/PART_DecreaseButton) sets both explicitly,
                                     strong evidence Fluent's RepeatButton imposes a non-zero
                                     default minimum that would otherwise overflow this fixed
                                     18px column and overlap the value TextBox. -->
                                <RepeatButton Name="PART_DecreaseButton" Grid.Column="0"
                                              Background="Transparent" BorderThickness="0,0,1,0"
                                              BorderBrush="{StaticResource IndustryDivider}" CornerRadius="0"
                                              Padding="0" MinWidth="0" MinHeight="0"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              IsVisible="{TemplateBinding ShowButtonSpinner}">
                                    <!-- Explicit Width/Height + centered-in-box Data (design-fidelity-
                                         agent-caught fix, Phase 3's first real consumer of this atom):
                                         this glyph's original geometry "M 0 0 L 8 0" is a horizontal
                                         line with a ZERO-HEIGHT bounding box. Stretch="None" alone
                                         did NOT fix it (confirmed empirically, pixel-level, after
                                         trying it first), the Path's own DesiredSize/render box
                                         still comes out degenerate from a zero-extent geometry
                                         regardless of Stretch mode, unlike the sibling IncreaseButton's
                                         "M 0 4 L 8 4 M 4 0 L 4 8" cross, which has a proper 2D extent
                                         and rendered fine at the same site untouched. Fixed by giving
                                         the Path an explicit non-degenerate 8x8 box and moving the
                                         line to the vertical center of it (y=4, not y=0), the same
                                         "give it a real box, don't rely on the geometry's own
                                         bounding box" technique as the blueprint corner-mark fix. -->
                                    <Path Data="M 0 4 L 8 4" Width="8" Height="8" Stroke="{StaticResource IndustryAccent700}" StrokeThickness="1.5"
                                          Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </RepeatButton>
                                <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}"
                                                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                <RepeatButton Name="PART_IncreaseButton" Grid.Column="2"
                                              Background="Transparent" BorderThickness="1,0,0,0"
                                              BorderBrush="{StaticResource IndustryDivider}" CornerRadius="0"
                                              Padding="0" MinWidth="0" MinHeight="0"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              IsVisible="{TemplateBinding ShowButtonSpinner}">
                                    <Path Data="M 0 4 L 8 4 M 4 0 L 4 8" Width="8" Height="8" Stroke="{StaticResource IndustryAccent700}" StrokeThickness="1.5"
                                          Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </RepeatButton>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <!-- Hover state (item 18: IndustryAccent100 fill on the glyph buttons) MUST live
                     here, scoped to THIS theme via ControlTheme.Children + "^" (self), not as a
                     top-level "NumericUpDown.Industry /template/ RepeatButton:pointerover" Style —
                     auditor-caught regression: the /template/ combinator only does a single
                     TemplatedParent hop, and after the ButtonSpinner-hosting fix these RepeatButtons'
                     TemplatedParent is the ButtonSpinner, not the NumericUpDown, so a selector
                     anchored on NumericUpDown can never reach them. -->
                <ControlTheme.Children>
                    <Style Selector="^ /template/ RepeatButton:pointerover">
                        <Setter Property="Background" Value="{StaticResource IndustryAccent100}" />
                    </Style>
                </ControlTheme.Children>
            </ControlTheme>

            <ControlTheme x:Key="IndustryStepperTheme" TargetType="NumericUpDown">
                <Setter Property="MinWidth" Value="90" />
                <!-- 90 = 52 (default value-cell min-width, LAYOUT-SPEC.md:143) + 38 (2x18px
                     buttons + ~2px border). Per-site overrides (value-cell 46/34/24) become 84/72/62
                     as a plain local MinWidth on the NumericUpDown instance at each call site. -->
                <Setter Property="Height" Value="22" />
                <!-- MinHeight paired with Height (post-Phase-2-verification fix, same bug class as
                     every other Height-only atom found overflowing in a real composed layout). -->
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <ButtonSpinner Name="PART_Spinner" Theme="{StaticResource IndustrySpinnerTheme}"
                                       AllowSpin="True" ShowButtonSpinner="True"
                                       BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1">
                            <!-- Classes="Industry" so old Cards.axaml/ChromeOverrides.axaml
                                 TextBox:not(.Industry) selectors (height 19, padding 4,0, Fluent's
                                 own hover tint on Border#PART_BorderElement) don't leak onto this
                                 template-internal TextBox — cheap, safe regardless of whether a
                                 template-literal value would already have won that fight. -->
                            <TextBox Name="PART_TextBox" Classes="Industry" Background="Transparent" BorderThickness="0"
                                     Padding="{StaticResource IndustryStepperValuePadding}"
                                     FontFamily="{StaticResource IndustryMonoFontFamily}" FontSize="12" FontWeight="Medium"
                                     TextAlignment="Right" VerticalContentAlignment="Center" />
                        </ButtonSpinner>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ═══════════════════════ 6. .trk track/slider ═══════════════════════
                 IndustrySliderTheme is a NAMED ControlTheme (item 0's rule) — never a bare
                 {x:Type Slider} key, which would re-skin every live old-design Slider instantly. -->
            <ControlTheme x:Key="IndustrySliderTheme" TargetType="Slider">
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid VerticalAlignment="Center">
                            <Border Name="PART_TrackWell" Height="4" VerticalAlignment="Center" CornerRadius="0"
                                    Background="{StaticResource IndustryNeutral300}" />
                            <Track Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton" Classes="Industry" Height="4" MinWidth="0" MinHeight="0" Padding="0"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  Focusable="False" BorderThickness="0" CornerRadius="0"
                                                  Background="{StaticResource IndustryAccent}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton" Classes="Industry" Height="4" MinWidth="0" MinHeight="0" Padding="0"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  Focusable="False" BorderThickness="0" CornerRadius="0"
                                                  Background="Transparent" />
                                </Track.IncreaseButton>
                                <!-- Explicit inline Template (design-fidelity-agent-caught fix): the base
                                     Fluent Thumb ControlTheme's own template doesn't paint the plain
                                     Background property we set above, so the thumb rendered invisible,
                                     forced visible with a one-Border template bound straight to it. -->
                                <Thumb Name="PART_Thumb" Width="3" Height="12" Margin="0"
                                       Background="{StaticResource IndustryAccent800}">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ═══════════════════════ 9. .seg segmented control ═══════════════════════
                 Call sites need Classes="Industry IndustrySeg" (+ "stretched" where applicable) —
                 RadioButton isn't itself an item-0b collision-table selector, but the Industry
                 marker is still required for consistency with every other atom's convention
                 (code-review nit: this requirement was previously undocumented at this site). -->
            <ControlTheme x:Key="IndustrySegTheme" TargetType="RadioButton">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="PART_Face" Margin="-1,0,0,0"
                                Background="{StaticResource IndustrySurface}"
                                BorderBrush="{StaticResource IndustryDivider}" BorderThickness="1" CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" FontSize="11"
                                               FontFamily="{StaticResource IndustryBodyFontFamily}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ═══════════════════════ 16. Disclosure header ("＋ ADVANCED TIMING") ═══════════════════════
                 Plain borderless ToggleButton (header text + chevron) driving an IsVisible binding
                 on a sibling content Panel — sidesteps Expander's pitfalls entirely rather than
                 solving them (item 16's own conclusion). Call sites need Classes="Industry
                 IndustryDisclosure" — ToggleButton IS an item-0b collision-table selector, so the
                 Industry marker is load-bearing here, not just conventional (code-review nit: this
                 requirement was previously undocumented at this site). -->
            <ControlTheme x:Key="IndustryDisclosureToggleTheme" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0,4,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <!-- "+"/"−" glyph as Path geometry, not a literal Text= character —
                                     same NoHardcodedAxamlStringsTests reasoning as the stepper
                                     above; the checked-state Style below swaps Data to a
                                     horizontal-only line for "−". -->
                                <Path Name="PART_Chevron" Data="M 0 3 L 6 3 M 3 0 L 3 6"
                                      Stroke="{StaticResource IndustryAccent700}" StrokeThickness="1"
                                      Width="6" Height="6" VerticalAlignment="Center" />
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- Design-fidelity-agent-caught addition (Gallery, Phase 5), generalized for reuse
                 (Logbook, Phase 6): any Industry list needing a real ListBox (for a TwoWay
                 SelectedItem binding — most Industry lists are a plain ItemsControl/UniformGrid
                 instead, since they don't need selection) gets default FluentTheme ListBoxItem
                 chrome (non-zero Padding/MinHeight, pointerover/selected fills) around whatever the
                 DataTemplate composes, which no Industry list design wants. Minimal template: no
                 padding/min-size, transparent background, no corner radius — selection is still a
                 real TwoWay-bound value regardless of this template; each call site supplies its
                 own :selected visual feedback via a descendant selector reaching into the
                 DataTemplate's own content (see Border.IndustryThumbnail's accent-border rule and
                 Border.IndustryTableRowRule's accent-fill rule below), matching this design
                 system's existing accent selected-state convention elsewhere (chips' own :checked
                 state). -->
            <ControlTheme x:Key="IndustryListBoxItemTheme" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="Transparent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ═══════════════════════ 17. Focus ring — DEFERRED to Phase 2 ═══════════════════════
                 CODE-REVIEW FIX: an earlier pass defined ControlTemplate resources here and called
                 the item done, but never wired them (no Setter Property="FocusAdorner" anywhere) —
                 misleading dead code, worse than an honest gap. Verified by reflection against the
                 real Avalonia 11.3.12 assemblies (not guessed): Control.FocusAdorner is typed
                 ITemplate&lt;Control&gt; (single generic arg), but Avalonia's XAML ControlTemplate
                 element implements IControlTemplate : ITemplate&lt;TemplatedControl,
                 TemplateResult&lt;Control&gt;&gt; (a DIFFERENT, two-arg interface) — a bare
                 ControlTemplate resource is not assignable to FocusAdorner without either an actual
                 ITemplate&lt;Control&gt;-typed wrapper (e.g. FuncTemplate&lt;Control&gt;) or
                 confirming Avalonia's XAML compiler does an implicit conversion for this specific
                 property (unconfirmed either way). Item 17's own sequencing note already said this
                 needed a real implementation-time spike, not a guess — correctly deferred to
                 whichever Phase 2+ view first ships an interactive atom, at which point the actual
                 working mechanism (FuncTemplate&lt;Control&gt; wiring vs. confirming the XAML
                 conversion) gets resolved and this comment updated. Also still open from the
                 design doc: the .seg-opt inward (-2px) focus-offset variant. -->

        </ResourceDictionary>
    </Styles.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════════════
         Bare Style rules below — top-level children of Styles, not resources.
         ═══════════════════════════════════════════════════════════════════════════════ -->

    <!-- 0.9-beta UI-honesty pass fix, 2026-08-14: Avalonia's ToolTip.ShowOnDisabled defaults to
         false, so every "hover a disabled control to see why" tooltip in this app
         (Options.NotImplemented.Help, applied to ~100+ controls across Options and the 0.9-beta
         sweep) was silently non-functional — flagged as a likely latent bug in
         mockups/guidance/PHASE1-ATOM-DESIGN.md long before this pass scaled the pattern, confirmed
         here by the combined-batch auditor review. `:is(Control)` (not a bare `Control` type
         selector, which only matches controls of literally that exact type, not derived types) so
         this applies globally regardless of the disabled control's concrete type. -->
    <Style Selector=":is(Control)">
        <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>

    <!-- 1. Group box -->
    <Style Selector="HeaderedContentControl.blueprint /template/ Canvas#PART_CornerTL,
                      HeaderedContentControl.blueprint /template/ Canvas#PART_CornerTR,
                      HeaderedContentControl.blueprint /template/ Canvas#PART_CornerBL,
                      HeaderedContentControl.blueprint /template/ Canvas#PART_CornerBR">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TextBlock.IndustryGbTitle">
        <Setter Property="FontFamily" Value="{StaticResource IndustryHeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="LetterSpacing" Value="1.33" />
        <!-- .14em * 9.5px = 1.33 device px (LAYOUT-SPEC §6 pitfall 8). -->
        <!-- 2026-08-14: was IndustryAccent700 (blue) — mockups/colors/SSTV-Color-Scheme.md §2.1
             explicitly assigns "group titles" to LabelBrush (grey), not a hue. Blue is reserved
             for selection specifically (spec §1 rule 1: "a hue never does two jobs"); a group-box
             title isn't a selection claim. -->
        <Setter Property="Foreground" Value="{StaticResource IndustryLabel}" />
    </Style>

    <!-- 2. .mini chips — 3 forms. Every instance carries Classes="Industry IndustryMini" on the
         Button/ToggleButton forms (Border form only needs IndustryMini — Border isn't in the old-
         style collision table). -->
    <Style Selector="Border.IndustryMini">
        <Setter Property="Height" Value="17" />
        <Setter Property="Padding" Value="{StaticResource IndustryMiniPadding}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- Descendant combinator, not direct-child (design-fidelity-agent-caught fix): the CAT-link
         chip nests its 2 TextBlocks inside a Panel (RadioHeaderView.axaml's CatLinked/CatNotLinked
         pair), which a " > TextBlock" selector can't reach, so that one chip silently missed every
         setter below (font, size, weight, and the IndustryText foreground fix). -->
    <Style Selector="Border.IndustryMini TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
    </Style>
    <!-- 2026-08-14: recolored blue -> green. Only real consumer is the status bar's "Rx" pill
         (MainWindow.axaml, bound to RadioStatus.IsReceiving) — a STATUS indicator ("receiving"),
         not a selection, per mockups/colors/SSTV-Color-Scheme.md §6's own named example ("the
         primary RX banner ... uses the green tint triad" — one of the few status lozenges that IS
         tinted, unlike most which stay neutral). Confirmed no other call site uses
         Classes.active on Border.IndustryMini (this class is distinct from
         ToggleButton/RadioButton.IndustryMini:checked below, which stay blue — those are genuine
         selection/latching-toggle states, e.g. a future AGC/NR/Notch toggle, and are unaffected by
         this change). -->
    <Style Selector="Border.IndustryMini.active">
        <Setter Property="Background" Value="{StaticResource IndustryHealthyTint}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryHealthyTintBorder}" />
    </Style>
    <Style Selector="Border.IndustryMini.active TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IndustryHealthyTintText}" />
    </Style>
    <Style Selector="Border.IndustryMini.accentOutline">
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
    </Style>
    <Style Selector="Border.IndustryMini.accentOutline TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IndustryAccent700}" />
    </Style>
    <!-- Interaction states, item 18: hover = text-7% mix (NOT IndustryAccent100 — .mini is
         structurally like .btn-secondary/.seg-opt, not the stepper's borderless accent glyphs;
         IndustryAccent100 also breaks the active variant's readability), disabled = 45% opacity. -->
    <Style Selector="Button.IndustryMini:pointerover /template/ Border#PART_Face">
        <Setter Property="Background" Value="#121D1F20" />
    </Style>
    <Style Selector="Button.IndustryMini:pressed /template/ Border#PART_Face">
        <Setter Property="Background" Value="#241D1F20" />
    </Style>
    <Style Selector="Button.IndustryMini:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.IndustryMini:pointerover /template/ Border#PART_Face">
        <Setter Property="Background" Value="#121D1F20" />
    </Style>
    <Style Selector="ToggleButton.IndustryMini:pressed /template/ Border#PART_Face">
        <Setter Property="Background" Value="#241D1F20" />
    </Style>
    <Style Selector="ToggleButton.IndustryMini:checked /template/ Border#PART_Face">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
    </Style>
    <Style Selector="ToggleButton.IndustryMini:checked /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryBg}" />
    </Style>
    <Style Selector="ToggleButton.IndustryMini:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="RadioButton.IndustryMini:pointerover /template/ Border#PART_Face">
        <Setter Property="Background" Value="#121D1F20" />
    </Style>
    <Style Selector="RadioButton.IndustryMini:pressed /template/ Border#PART_Face">
        <Setter Property="Background" Value="#241D1F20" />
    </Style>
    <Style Selector="RadioButton.IndustryMini:checked /template/ Border#PART_Face">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
    </Style>
    <Style Selector="RadioButton.IndustryMini:checked /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryBg}" />
    </Style>
    <Style Selector="RadioButton.IndustryMini:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 3. Rows (.r2). IndustryRow is a Border (hosts the top-rule via BorderThickness/Brush —
         Grid has no border properties, so the row's outer wrapper must be a Border; markup authors
         put a Grid/DockPanel with the label/value layout AS the Border's Child). Separator via
         :nth-child (empirically confirmed to work on a plain, hand-authored container's direct
         children, not just ItemsControl-generated ones) — the DEFAULT for uniform .r2 stacks;
         Classes="ruled"/"unruled" overrides for group boxes whose body mixes .r2 rows with non-row
         content, where :nth-child's "count every child" semantics diverge from CSS's real
         ".r2 + .r2" ("rule iff the immediately preceding sibling is ALSO .r2") — item 3's own
         documented caveat. -->
    <Style Selector="Border.IndustryRow">
        <Setter Property="MinHeight" Value="16.5" />
    </Style>
    <!-- design-fidelity-caught fix: CSS's .gb{gap:3px} applies to .r2 rows too, not just
         non-row children, which this atom never set — rows were sitting flush against each
         other with only their 1px top-rule for separation, ~2px shorter row pitch than the
         mockup at every row, in every card that uses this atom. -->
    <Style Selector="StackPanel.IndustryRows">
        <Setter Property="Spacing" Value="3" />
    </Style>
    <Style Selector="StackPanel.IndustryRows > Border.IndustryRow:not(:nth-child(1)):not(.unruled)">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryRowRule6}" />
    </Style>
    <Style Selector="StackPanel.IndustryRows > Border.IndustryRow.ruled">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryRowRule6}" />
    </Style>
    <Style Selector="TextBlock.IndustryRowLabel">
        <Setter Property="FontFamily" Value="{StaticResource IndustryBodyFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16.5" />
        <Setter Property="Foreground" Value="{StaticResource IndustryTextMuted62}" />
    </Style>
    <!-- 2026-08-14, mockups/colors/SSTV-Color-Scheme.md §3: "Every frequency, S-meter, SNR,
         line-count, timer and callsign-of-sender readout is a read-only data field: sunken
         #E4E4E4, not white, not the card face." One style change here reaches every row-value
         across the whole app (hundreds of consumers) without touching any view file, since they
         all share this one class. Skipping the spec's own "1px inset shadow" detail (no Avalonia
         equivalent without a second Border layer per call site — out of scope for a style-only
         pass) and the mono-readout's own implied border (this atom's tight MinHeight=16.5 rows
         have no room for a full bordered-field look without also touching every IndustryRow's own
         padding, a bigger layout change than "every value gets tinted" — background + light inset
         padding is the contained version of the same rule). TextBlock.Padding is a real Avalonia
         11 property, not a TemplatedControl-only one. -->
    <Style Selector="TextBlock.IndustryRowValue">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="16.5" />
        <Setter Property="LetterSpacing" Value="-0.22" />
        <!-- -.02em * 11px = -0.22 device px. -->
        <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Background" Value="{StaticResource IndustryDataField}" />
        <Setter Property="Padding" Value="4,0,4,0" />
    </Style>

    <!-- 4. Kicker text -->
    <Style Selector="TextBlock.IndustryKicker">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="LetterSpacing" Value="1.4" />
        <!-- .14em * 10px = 1.4 device px. -->
        <!-- 2026-08-14: was IndustryAccent700 (blue) — user decision, matching group-box titles
             above (same "secondary label" role per the color spec's §2.1 neutrals table; keeping
             one blue and one grey for the same semantic role would read as mismatched). -->
        <Setter Property="Foreground" Value="{StaticResource IndustryLabel}" />
    </Style>
    <Style Selector="TextBlock.IndustryKicker.wide">
        <Setter Property="LetterSpacing" Value="1.6" />
        <!-- .16em * 10px = 1.6 device px — the VFO-only variant. -->
    </Style>

    <!-- 5. Stepper — interaction states. Glyph-button hover (item 18: IndustryAccent100) now lives
         inside IndustrySpinnerTheme's own ControlTheme.Children (auditor-caught regression: the
         RepeatButtons' TemplatedParent became the ButtonSpinner, not this NumericUpDown, once the
         stepper started hosting a real ButtonSpinner — a selector anchored here could never reach
         them). Only the disabled state stays a plain NumericUpDown-scoped rule. -->
    <Style Selector="NumericUpDown.Industry:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 6. .trk track/slider — per-site track height override (default 4, 6 or 8 per LAYOUT-SPEC
         §5): set at the call site via Classes="Industry h6"/"h8"; track width, where fixed, is a
         plain Width on the Slider itself, not a template concern (item 6's own note). -->
    <Style Selector="Slider.Industry.h6 /template/ Border#PART_TrackWell,
                      Slider.Industry.h6 /template/ RepeatButton#PART_DecreaseButton,
                      Slider.Industry.h6 /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="Slider.Industry.h8 /template/ Border#PART_TrackWell,
                      Slider.Industry.h8 /template/ RepeatButton#PART_DecreaseButton,
                      Slider.Industry.h8 /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="Slider.Industry:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 6b. .trk-style ProgressBar (real bound percent, e.g. frame-decode progress) — a minimal
         re-skin of Fluent's own ProgressBar (Background = track color, PART_Indicator = fill
         color), not a full ControlTemplate replacement, since Fluent's own indicator-sizing logic
         already does the exact percent computation this needs (item 6's Grid.IndustryMeter atom
         is for STATIC/display-only fill%, a genuinely different case). -->
    <Style Selector="ProgressBar.Industry">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Background" Value="{StaticResource IndustryNeutral300}" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- design-fidelity-caught fix (round 2): without this, Fluent's own default
             BorderBrush/BorderThickness on ProgressBar left a stray 1px #A0A0A0 line around the
             track, not an Industry design-system color, and shrank the visible fill height. -->
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ProgressBar.Industry /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Display-only meter (RX/TX level, L/R meters, POWER/ALC): a plain 3-element Grid, NOT a
         Slider — LAYOUT-SPEC's own real example (RX lvl fill 63% thumb 78%) has fill% and thumb%
         as independently different values, which a Slider's single Value can't represent.
         FillPercent/MarkerPercent are represented by a per-instance Width binding at each call
         site — no styled properties needed here beyond the visual. -->
    <Style Selector="Grid.IndustryMeter">
        <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="Border.IndustryMeterTrack">
        <Setter Property="Background" Value="{StaticResource IndustryNeutral300}" />
    </Style>
    <Style Selector="Border.IndustryMeterFill">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Marker Height (12) intentionally exceeds the Grid's own Height (4) — confirmed against
         source CSS (SSTV Console.dc.html:41): ".trk b{top:-4px;width:3px;height:12px}" on a 4px
         track means the marker overflows the track by 4px on each side, vertically centered via a
         negative top offset. Not a bug (code-review nit, resolved): call sites center this marker
         inside the Grid via VerticalAlignment="Center" rather than a literal negative-top offset
         (Avalonia has no direct top-offset-outside-parent-bounds shorthand the way CSS does; a
         centered 12px element inside a Grid whose row/cell height is 4 naturally overflows both
         edges equally, same visual result). -->
    <Style Selector="Border.IndustryMeterMarker">
        <Setter Property="Background" Value="{StaticResource IndustryAccent800}" />
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 7. Buttons at 6 heights. Classes composition (IndustryBtn + IndustryBtn{N} +
         IndustryBtnPrimary/Secondary), matching Cards.axaml's own established convention. Padding
         is a deliberate, documented per-instance exemption (item 7/Summary's "padding exemption
         policy") — NOT set here, cited from PADDING-NORMALIZATION.md §1b at each later-phase call
         site. Every call site needs Classes="Industry IndustryBtn IndustryBtn{N}" — the base/height
         selectors below require BOTH Industry and IndustryBtn (code-review risk fix): Button IS an
         item-0b collision-table selector, so requiring Industry here means a call site that forgot
         the marker renders fully unstyled (obviously wrong) instead of a half-old/half-new hybrid
         (subtly wrong, e.g. old Height=19 silently fighting a new FontSize=12.5). -->
    <Style Selector="Button.Industry.IndustryBtn">
        <Setter Property="FontFamily" Value="{StaticResource IndustryHeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- MinHeight paired with Height on every variant below (post-Phase-2-verification fix): same
         bug class already found and fixed on Menu.Industry/TabItem.Industry — Avalonia's layout
         clamps Height up to MinHeight, so Height alone loses to whatever Fluent's own default
         Button/ToggleButton MinHeight resource is. Confirmed real here too via a real-window
         screenshot showing the Transceiver card's Receiving/Halt buttons and RX/TX level rows
         overflowing their fixed-height container. -->
    <Style Selector="Button.Industry.IndustryBtn36">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Button.Industry.IndustryBtn26">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.Industry.IndustryBtn25">
        <Setter Property="Height" Value="25" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.Industry.IndustryBtn24">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.Industry.IndustryBtn22">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.Industry.IndustryBtn21">
        <Setter Property="Height" Value="21" />
        <Setter Property="MinHeight" Value="21" />
        <Setter Property="FontSize" Value="10.5" />
    </Style>
    <!-- Primary/secondary need /template/ ContentPresenter targeting — the same Fluent
         Button.accent-conflict trick ChromeOverrides.axaml already proves for the OLD design's own
         primary button; these selectors are Classes-scoped (opt-in) already, so no item-0
         collision risk. -->
    <!-- 2026-08-14, mockups/colors/SSTV-Color-Scheme.md §4: "Primary | solid #0F62A8 | Maximum
         one per pane" — Background/BorderBrush already correct via the IndustryAccent token
         change (Phase A); hover/press specifically are spec-literal one-off values ("Primary hover
         #1472C0, border unchanged; press #0B4C83") that don't match the base or any tint token, so
         inlined per this file's own established convention for one-off interaction colors (see the
         Danger button's own comment below) — press happens to equal IndustrySelectSolidBorder, but
         named for what it verifiably IS per the spec (a press state), not reused speculatively. -->
    <Style Selector="Button.IndustryBtnPrimary /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryBg}" />
    </Style>
    <Style Selector="Button.IndustryBtnPrimary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FF1472C0" />
    </Style>
    <Style Selector="Button.IndustryBtnPrimary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustrySelectSolidBorder}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustrySelectSolidBorder}" />
    </Style>
    <Style Selector="Button.IndustryBtnPrimary:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- 2026-08-14, spec §4: "Standard | face #E9E9E9, border #A0A0A0 | The default. Browse,
         Calibrate, Save Frame, Clear, Copy." Was Background="Transparent" with a translucent
         darken-on-hover — the spec wants a real grey FACE at rest and a blue-tinted hover/press,
         not a transparent-until-interacted-with button. This is the button class with the most
         real consumers in the app (Browse/Calibrate/Save-frame-class actions everywhere), so this
         is a genuinely visible change, not a token swap. -->
    <Style Selector="Button.IndustryBtnSecondary /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryControlFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryControlBorder}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryText}" />
    </Style>
    <Style Selector="Button.IndustryBtnSecondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryHoverFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryHoverBorder}" />
    </Style>
    <Style Selector="Button.IndustryBtnSecondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryPressFace}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryPressBorder}" />
    </Style>
    <Style Selector="Button.IndustryBtnSecondary:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Danger/destructive variant: recolored 2026-08-14 to spec §4 ("Destructive | solid #B42A2A
         | white text 600 | HALT TX, Abort, Delete. Always red, every context") — was a tinted/
         outlined pink button (ported from the old design's Button.halt, Cards.axaml), which the
         new spec explicitly does not want: destructive actions get the SAME solid-fill treatment
         as primary, just red instead of blue, so they read with equal weight/urgency, not softer.
         IndustryTxToggle below is a SEPARATE control (the transmit toggle itself, not a plain
         button) and is handled on its own in the next pass — not touched here. -->
    <Style Selector="Button.IndustryBtnDanger /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryDanger}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDangerSolidBorder}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryDangerForeground}" />
    </Style>
    <Style Selector="Button.IndustryBtnDanger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFC93333" />
    </Style>
    <Style Selector="Button.IndustryBtnDanger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryDangerSolidBorder}" />
    </Style>
    <Style Selector="Button.IndustryBtnDanger:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Phase 2 addendum: ToggleButton is a separate type from Button in Avalonia (not a subtype —
         confirmed by this codebase's own pre-existing Cards.axaml, which already styles
         "Selector=Button" and "Selector=ToggleButton" as two independent, non-overlapping rules),
         so the Button-typed IndustryBtn*/IndustryBtnPrimary selectors above do NOT match a
         ToggleButton element at all. Needed for RadioHeaderView's Receiving toggle specifically
         (a real two-way IsChecked binding, so it can't be swapped to a plain Button) — duplicated
         narrowly for just the one height/variant this phase actually uses, not the full matrix. -->
    <Style Selector="ToggleButton.Industry.IndustryBtn26">
        <Setter Property="FontFamily" Value="{StaticResource IndustryHeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ToggleButton.IndustryBtnPrimary /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryBg}" />
    </Style>
    <!-- 2026-08-14: was IndustryAccent600 (tuned for the old #5980A6 base, mismatched now) — same
         spec-literal hover value as Button.IndustryBtnPrimary above. -->
    <Style Selector="ToggleButton.IndustryBtnPrimary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FF1472C0" />
        <Setter Property="BorderBrush" Value="#FF1472C0" />
    </Style>
    <Style Selector="ToggleButton.IndustryBtnPrimary:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- TX transmit toggle (Phase 7): ported 1:1 from the old design's ScanlineStudioTxToggleButtonTheme
         (Tokens.axaml) - plain/secondary look at rest, solid red fill only while actually
         transmitting (IsChecked). Call sites pair this with the plain
         "Industry IndustryBtn IndustryBtn26 IndustryBtnSecondary" classes for the rest-state look,
         same base as any other secondary toggle; this adds only the :checked override. -->
    <Style Selector="ToggleButton.IndustryTxToggle:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource IndustryDanger}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDanger}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryDangerForeground}" />
    </Style>

    <!-- 8. .input — a SEPARATE IndustryInput class, distinct from the bare Industry exclusion
         marker (item 8's own N3 correction) — every .input instance carries BOTH
         Classes="Industry IndustryInput"; the stepper's own NumericUpDown carries Industry only.
         Per-type setters (VerticalContentAlignment isn't shared by the 3 types at the selector's
         common base, same caveat ChromeOverrides.axaml already documents). The base selector below
         requires BOTH classes (code-review risk fix, same reasoning as item 7's buttons above) —
         TextBox/ComboBox/NumericUpDown are all item-0b collision-table selectors, so a call site
         missing Industry renders fully unstyled instead of a silent old/new hybrid. -->
    <!-- 2026-08-14, spec §3: "Editable | white #FFF | border #A0A0A0 | White always and only means
         you can type here." Was Background=IndustrySurface (the same grey as everything else) —
         no visual distinction existed between editable and non-editable controls, which is the
         spec's own single most important field rule ("the rule an operator learns in five seconds
         and then relies on forever"). Real consumers: every genuinely-editable TextBox/ComboBox/
         NumericUpDown in the app (Override-callsign, CW text, operator settings, stepper values,
         etc.) — NOT the read-only TextBlock.IndustryRowValue rows fixed separately above, which
         were never this class to begin with. -->
    <Style Selector="TextBox.Industry.IndustryInput, ComboBox.Industry.IndustryInput, NumericUpDown.Industry.IndustryInput">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="{StaticResource IndustryStepperValuePadding}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{StaticResource IndustryEditField}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.IndustryInput">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource IndustryBodyFontFamily}" />
    </Style>
    <Style Selector="ComboBox.IndustryInput">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource IndustryBodyFontFamily}" />
    </Style>
    <Style Selector="NumericUpDown.IndustryInput">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
    </Style>
    <!-- Mode <select>, height 26. -->
    <Style Selector="ComboBox.IndustryInput.tall">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.IndustryInput:pointerover, ComboBox.IndustryInput:pointerover, NumericUpDown.IndustryInput:pointerover">
        <Setter Property="BorderBrush" Value="#731D1F20" />
        <!-- text-45% mix, item 18. -->
    </Style>
    <Style Selector="TextBox.IndustryInput:disabled, ComboBox.IndustryInput:disabled, NumericUpDown.IndustryInput:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 9. .seg segmented control -->
    <Style Selector="RadioButton.IndustrySeg">
        <Setter Property="Padding" Value="{StaticResource IndustrySegOptPadding}" />
    </Style>
    <Style Selector="RadioButton.IndustrySeg.stretched">
        <Setter Property="Padding" Value="{StaticResource IndustrySegOptPaddingStretched}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Interaction states, item 18: hover suppressed when checked (real source is
         .seg-opt:not(:has(input:checked)):hover — Avalonia applies :pointerover and :checked
         simultaneously, so the hover selector must explicitly exclude :checked or it washes ink
         over the accent-filled selected segment). -->
    <Style Selector="RadioButton.IndustrySeg:pointerover:not(:checked) /template/ Border#PART_Face">
        <Setter Property="Background" Value="#121D1F20" />
    </Style>
    <Style Selector="RadioButton.IndustrySeg:checked /template/ Border#PART_Face">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
    </Style>
    <Style Selector="RadioButton.IndustrySeg:checked /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryBg}" />
    </Style>
    <Style Selector="RadioButton.IndustrySeg:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 10. .table — plain Grid/ItemsControl table, NOT Avalonia.Controls.DataGrid (item 10's own
         reasoning: LAYOUT-SPEC's tables are 4-9 columns x 5-6 STATIC rows, closer to the mockup's
         real plain <table> than a scrolling/virtualized/sortable grid — fighting DataGrid's own
         chrome system a second time for a 5-row static table is more work than a header Grid +
         ItemsControl body). Package removal (Avalonia.Controls.DataGrid reference, Fluent.xaml
         StyleInclude) happened in Phase 7, once Decode-activity/TX-log were confirmed the last two
         consumers and both were already ported to this atom in Phases 3/4. -->
    <Style Selector="TextBlock.IndustryTableHeader">
        <Setter Property="FontFamily" Value="{StaticResource IndustryBodyFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LetterSpacing" Value="0.88" />
        <!-- .08em * 11px = 0.88 device px (LAYOUT-SPEC §6 pitfall 8). -->
        <Setter Property="Foreground" Value="{StaticResource IndustryTextMuted62}" />
    </Style>
    <Style Selector="Border.IndustryTableHeaderRule">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDivider}" />
        <Setter Property="Padding" Value="{StaticResource IndustryTableCellPadding}" />
    </Style>
    <Style Selector="Border.IndustryTableHeaderRule.narrow">
        <Setter Property="Padding" Value="{StaticResource IndustryTableCellPaddingNarrow}" />
    </Style>
    <Style Selector="TextBlock.IndustryTableCell">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LetterSpacing" Value="-0.22" />
        <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
    </Style>
    <Style Selector="Border.IndustryTableRowRule">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryTableRule8}" />
        <Setter Property="Padding" Value="{StaticResource IndustryTableCellPadding}" />
    </Style>
    <Style Selector="Border.IndustryTableRowRule.narrow">
        <Setter Property="Padding" Value="{StaticResource IndustryTableCellPaddingNarrow}" />
    </Style>
    <!-- Real selection feedback for a ListBox-based Industry table (first real consumer: the
         Logbook's QSO table, Phase 6) — accent-tinted fill per cell, not a border (a table row's
         own visual language is a fill, unlike a thumbnail figure's bordered-card language). Same
         descendant-selector-across-the-template-boundary technique as the Gallery thumbnail's own
         :selected rule. -->
    <Style Selector="ListBoxItem:selected Border.IndustryTableRowRule">
        <Setter Property="Background" Value="{StaticResource IndustryAccent100}" />
    </Style>

    <!-- 11. Thumbnail figure — composed from existing atoms (IndustryHatchPanel below for the
         placeholder body, IndustryMini Border form for the mode-badge chip) rather than a bespoke
         templated control — every part of "figure" is already a plain Border/Grid/StackPanel
         composition, no new template needed. Markup authors compose it per-site (AspectRatio drives
         the MeasureOverride mechanism LAYOUT-SPEC §6 pitfall 4/5 already mandates for the Incoming-
         frame's own height-driven ratio — that mechanism's concrete implementation is a Phase 3+
         concern, reusing the same technique, not duplicated here). -->
    <Style Selector="Border.IndustryThumbnail">
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- Real selection feedback for the Gallery's ListBox-based thumbnail grid (see
         IndustryListBoxItemTheme's own comment) — a plain descendant selector reaches
         into the DataTemplate-generated content across the template boundary. -->
    <Style Selector="ListBoxItem:selected Border.IndustryThumbnail">
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.IndustryThumbnailCaption">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDivider}" />
        <Setter Property="Padding" Value="{StaticResource IndustryThumbnailCaptionPadding}" />
    </Style>
    <Style Selector="Border.IndustryThumbnailCaption.gallery">
        <Setter Property="Padding" Value="{StaticResource IndustryThumbnailCaptionPaddingGallery}" />
    </Style>
    <Style Selector="TextBlock.IndustryThumbnailCall">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
    </Style>
    <!-- Gallery variant (design-fidelity-agent-caught addition): mock2's own Gallery figure uses
         bare .v2 (11px) for the call line, not the Receive/Transmit thumbnails' own 10px .mini
         override — each mockup site genuinely has its own font-size, this isn't one atom with an
         inconsistency. Mirrors the already-existing (previously unused) IndustryThumbnailCaption.gallery
         padding variant. -->
    <Style Selector="TextBlock.IndustryThumbnailCall.gallery">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.IndustryThumbnailMeta">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource IndustryTextMuted50}" />
    </Style>
    <Style Selector="TextBlock.IndustryThumbnailMeta.gallery">
        <Setter Property="FontSize" Value="9.5" />
    </Style>

    <!-- 12. Hatch panel — the brush itself (IndustryHatchStripeBrush) lives in AtomsTokens.axaml,
         alongside the composite-Thickness resources — it's a resource, same layer as the other
         tokens, not view-shaped like everything else in this file. This is just the bordered panel
         atom that hosts it. -->
    <Style Selector="Border.IndustryHatchPanel">
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource IndustryHatchStripeBrush}" />
    </Style>

    <!-- 13. Plot canvas frame (waterfall/spectrum/scope/editor-preview containers) — dark
         accent-900 background + hairline divider border, per every `<canvas>` wrapper's inline
         style in the mockup HTML (e.g. SSTV Console.dc.html's Spectrum/waterfall plots). Phase 3+
         first consumer; the plot's OWN pixel content (waterfall gradient, spectrum trace, editor
         canvas) is unaffected — this is only the surrounding frame chrome. -->
    <Style Selector="Border.IndustryPlot">
        <Setter Property="BorderBrush" Value="{StaticResource IndustryDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource IndustryAccent900}" />
    </Style>

    <!-- 16. Disclosure header — .gbt group-box-title typography (NOT kicker text — item 16's own
         correction), source text is mixed-case with CSS text-transform:uppercase, so markup
         authors type it uppercase (matching item 4's kicker convention) rather than relying on a
         text-transform Avalonia doesn't have. -->
    <Style Selector="ToggleButton.IndustryDisclosure /template/ ContentPresenter">
        <Setter Property="TextBlock.FontFamily" Value="{StaticResource IndustryHeadingFontFamily}" />
        <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
        <Setter Property="TextBlock.FontSize" Value="9.5" />
        <Setter Property="TextBlock.LetterSpacing" Value="1.33" />
        <!-- .14em * 9.5px = 1.33 device px. -->
        <Setter Property="TextBlock.Foreground" Value="{StaticResource IndustryAccent700}" />
    </Style>
    <Style Selector="ToggleButton.IndustryDisclosure:checked /template/ Path#PART_Chevron">
        <Setter Property="Data" Value="M 0 3 L 6 3" />
    </Style>

    <!-- ═══════════════════════ Phase 2: Menu / MenuItem (deferred by Phase 1) ═══════════════════════
         DEVIATION from mockups/guidance/PHASE2-CHROME-DESIGN.md's suggested mechanism, made during
         implementation and flagged for review: the design doc calls for full ControlTheme/
         ControlTemplate replacement (citing FluentTheme's icon-column/chevron/min-height
         resources). Implemented instead as plain, Classes-scoped Style Setters — NOT a template
         replacement — because MenuItem's real template hosts a Popup for submenus (this app has
         real, working multi-level menus: File > Open image, Configurations > 4 items, etc.), and
         this port has no way to empirically verify the exact PART_Popup/PART_ItemsPresenter names
         a from-scratch MenuItem template would need before shipping (unlike TabControl below,
         where the existing ChromeOverrides.axaml already proves the real Fluent part names via a
         working `/template/` reach). Getting a replaced MenuItem template's Popup wiring wrong
         would silently break every submenu (File/Configurations/Rig & PTT/Calibration/Tools all
         stop opening, no exception) — a far worse failure mode than this Setter-only approach's
         one known limitation: Fluent's own icon-gutter column still reserves its usual space
         before the text (no icon is ever set anywhere in this app, so it reads as a few extra
         pixels of left padding, not a functional problem), and MenuItem's :pointerover hover fill
         is NOT re-skinned to IndustryAccent100/IndustryAccent800 (Fluent's own hover highlight
         mechanism's exact template part name is unknown without live source access) — Fluent's
         own default hover visual is left in place rather than guessed at. Every property Setter
         below IS known-safe: Background/Foreground/Padding/FontFamily/FontSize are standard
         TemplateBinding-forwarded properties on every Avalonia templated control by convention,
         the same category of property (not template-literal) that already lets Button/TabItem's
         plain-Style atoms work elsewhere in this exact file. -->
    <Style Selector="Menu.Industry">
        <!-- Height + MinHeight together (code-review fix): Avalonia's layout clamps Height up to
             MinHeight, so Height alone loses to Fluent's own MenuBarHeight resource (confirmed
             present in the shipped Fluent theme assembly) — this band is now a FIXED 26px row
             (Phase 2's own architectural point), so this can't be left to Fluent's default. Same
             two-Setter pattern this file already uses for the .input atom. -->
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="{StaticResource IndustryMenuPadding}" />
        <Setter Property="Background" Value="{StaticResource IndustryBg}" />
    </Style>
    <!-- Descendant selector (not a direct-child/Classes requirement per item): reaches every
         MenuItem nested anywhere under an Industry-classed Menu, including submenu items, without
         needing Classes="Industry" hand-added to ~30 individual MenuItem instances in
         MainWindow.axaml. No old-design MenuItem collision exists to guard against (confirmed: no
         bare "MenuItem" Style selector exists anywhere in Cards.axaml/Tokens.axaml/
         ChromeOverrides.axaml), so this selector needs no :not(.Industry) exclusion partner. -->
    <Style Selector="Menu.Industry MenuItem">
        <Setter Property="Padding" Value="{StaticResource IndustryMenuItemPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource IndustryBodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
    </Style>
    <Style Selector="Menu.Industry MenuItem:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Code-review nit fix: the File menu's plain &lt;Separator/&gt; was left at Fluent's default
         look, which the design doc explicitly said would clash — same descendant-selector,
         no-collision reasoning as the MenuItem rules above. -->
    <Style Selector="Menu.Industry Separator">
        <Setter Property="Background" Value="{StaticResource IndustryDivider}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- ═══════════════════════ Phase 2: TabControl / TabItem ═══════════════════════
         DEVIATION from mockups/guidance/PHASE2-CHROME-DESIGN.md's suggested mechanism, same
         reasoning class as Menu/MenuItem above but with stronger in-repo evidence it's safe:
         Cards.axaml's OWN existing (old-design) TabItem style already re-skins Height/Background/
         Foreground/BorderBrush/BorderThickness/CornerRadius via plain Setters alone, with zero
         ControlTemplate replacement, and that code is shipped/running today — direct proof THESE
         SPECIFIC properties are ordinary TemplateBinding-forwarded properties on this Avalonia
         version's real Fluent TabItem template, not template-literal values immune to Setters (the
         trap class ChromeOverrides.axaml's Slider/ButtonSpinner work exists to route around).
         Code-review correction: this proof does NOT extend to `Padding` — ChromeOverrides.axaml's
         own PART_LayoutRoot rule zeroes Padding directly at the template part
         (ChromeOverrides.axaml's "kill Fluent's pill + pipe" block), meaning the OLD design's own
         Padding="14,0" (Cards.axaml) was never actually in effect and proves nothing either way;
         nor does it extend to TextBlock.LetterSpacing, which has no old-design precedent on
         TabItem at all (only the disclosure-header atom above uses this exact attached-property
         mechanism, on a different control). Both are believed safe (ordinary Control-declared/
         inheriting properties, same category as everything else here) but are NOT proven the way
         Height/Background/etc. are — visually confirm tab label spacing/letter-spacing once this
         phase is running for real, don't just trust this comment. Skipping
         a full TabControl/TabItem template replacement also sidesteps the design doc's own
         highest-flagged risk entirely (PART_ItemsPresenter/PART_SelectedContentHost naming — a
         wrong name there produces a silently blank, non-functional tab body) — Fluent's own
         default TabControl template keeps doing that job, verified today by the running app's own
         4 working tabs. The header strip's 26px height falls out naturally: Fluent's default
         TabControl template sizes its header row to Auto (confirmed by the current app already
         working this way at TabItem Height=20), so setting Height=26 on Industry-classed TabItems
         makes the whole strip 26px without touching TabControl itself at all.

         Code-review fix: Height alone isn't sufficient — Avalonia's layout clamps Height up to
         MinHeight, and the shipped Fluent theme assembly carries a TabItemMinHeight resource that
         could exceed 26, silently winning over the Height Setter below exactly the same way
         Menu.Industry's own gap (fixed above) would have. Old Cards.axaml TabItem rule proves this
         for the OLD value (20 vs whatever Fluent's default was, since it visibly worked); it says
         nothing about whether 26 clears the same resource, so pin MinHeight explicitly here too. -->
    <Style Selector="TabItem.Industry">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="{StaticResource IndustryTabItemPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IndustryHeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <!-- LetterSpacing isn't a Control-level property (TabItem doesn't expose it directly,
             unlike FontFamily/FontSize/Foreground which Control itself declares) — set via the
             TextBlock attached property, same mechanism the disclosure-header atom above already
             uses for the same reason. -->
        <Setter Property="TextBlock.LetterSpacing" Value="1.035" />
        <!-- .09em * 11.5px = 1.035 device px. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- Kills Fluent's own selected-pill/pipe the same way Cards.axaml's old TabItem style already
         does (same PART_SelectedPipe name, proven real by that existing, shipped rule) — the new
         design draws its own 2px accent bottom border via plain BorderThickness/BorderBrush
         instead (proven-safe property class, see the block comment above). -->
    <Style Selector="TabItem.Industry /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabItem.Industry:selected">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
        <Setter Property="Foreground" Value="{StaticResource IndustryText}" />
    </Style>
    <Style Selector="TabItem.Industry:pointerover">
        <Setter Property="Foreground" Value="{StaticResource IndustryAccent700}" />
    </Style>
    <!-- Code-review fix: outer strip padding 6,0,6,0 (PADDING-NORMALIZATION.md §3 Band 3) was
         dropped entirely when the old-design :not(.Industry) narrowing removed its own 6px
         left-only inset (ChromeOverrides.axaml's "kill Fluent's pill + pipe" ItemsPresenter
         margin rule) from Industry-classed TabControls — reach the same proven-real
         PART_ItemsPresenter part directly, matching the mockup's actual (both-sides) padding
         rather than the old design's left-only one. -->
    <Style Selector="TabControl.Industry /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="6,0,6,0" />
    </Style>

    <!-- 2b. Real CheckBox — interaction states. -->
    <Style Selector="CheckBox.Industry:checked /template/ Border#PART_Box">
        <Setter Property="Background" Value="{StaticResource IndustryAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource IndustryAccent}" />
    </Style>
    <Style Selector="CheckBox.Industry:checked /template/ Path#PART_Tick">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.Industry:pointerover /template/ Border#PART_Box">
        <Setter Property="BorderBrush" Value="#731D1F20" />
        <!-- text-45% mix, item 18 — same hover convention as the .input atom. -->
    </Style>
    <Style Selector="CheckBox.Industry:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Help glyph: small "[?]" beside an esoteric setting's label, ToolTip.Tip carries the real
         explanation (Options window). Industry-token reskin of the old ScanlineStudioHelpGlyph
         (Tokens.axaml) so consumers of this atom no longer need that file loaded. -->
    <Style Selector="TextBlock.IndustryHelpGlyph">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource IndustryTextMuted55}" />
        <Setter Property="Cursor" Value="Help" />
    </Style>

    <!-- Status-bar LED indicator: recolored + reshaped 2026-08-14 for
         mockups/colors/SSTV-Color-Scheme.md §6 ("8x8px, 1px border one step darker than its fill,
         SQUARE"). Was Ellipse (round) — an Ellipse element can never render as a square regardless
         of style properties, so the element type itself changes to Rectangle (also brings the LED
         in line with this app's own "square corners everywhere" rule, spec/09-ui.md, which the
         round LED was already violating independent of the new color spec). Colors: standby
         #C8C8C8/#6E6E6E (was gray/off #B9B9B9/#6E6E6E, close but not exact); healthy/active
         #2E9E44/#256F33 (spec §2.2 Healthy, was a near-but-not-exact #2FA02F/#1F6E1F); alert now
         reuses the new IndustryTxLed/IndustryDangerSolidBorder tokens (#D42A2A/#8C1F1F, spec's own
         "do not unify the TX-LED red with the button-danger red" rule — this LED's "alert" class is
         a fault indicator per spec §6's fault row, which ALSO specifies the brighter #D42A2A, not
         the base #B42A2A). Only real consumer: MainWindow's status-bar TX-inhibit indicator
         (updated from Ellipse to Rectangle at its call site in the same pass). -->
    <Style Selector="Rectangle.IndustryLed">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stroke" Value="#FF6E6E6E" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Fill" Value="#FFC8C8C8" />
    </Style>
    <Style Selector="Rectangle.IndustryLed.active">
        <Setter Property="Fill" Value="{StaticResource IndustryHealthy}" />
        <Setter Property="Stroke" Value="{StaticResource IndustryHealthySolidBorder}" />
    </Style>
    <Style Selector="Rectangle.IndustryLed.alert">
        <Setter Property="Fill" Value="{StaticResource IndustryTxLed}" />
        <Setter Property="Stroke" Value="{StaticResource IndustryDangerSolidBorder}" />
    </Style>

    <!-- Small muted readout label (Phase 7): ported 1:1 from the old design's TextBlock.readoutSmall
         (Cards.axaml), Industry mono font swapped in. Only real consumer: the status-bar TX-inhibit
         label next to IndustryLed above. -->
    <Style Selector="TextBlock.IndustryReadoutSmall">
        <Setter Property="FontFamily" Value="{StaticResource IndustryMonoFontFamily}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#FF8A8A8A" />
    </Style>

</Styles>
