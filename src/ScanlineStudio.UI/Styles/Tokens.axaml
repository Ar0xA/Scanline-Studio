<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design-token layer: see spec/09-ui.md's "Aesthetic Directive": raw, functional
         instrumentation (cuSDR64/Perseus/SDR++), not a modern SaaS look. No rounded corners, no
         gradients/shadows/glows, minimal padding, monospace for all numeric/data readouts. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ScanlineStudioPanelHeaderBackgroundColor">#1B1B20</Color>
                    <Color x:Key="ScanlineStudioPanelHeaderForegroundColor">#D6D6DC</Color>
                    <Color x:Key="ScanlineStudioPanelBodyBackgroundColor">#131316</Color>
                    <Color x:Key="ScanlineStudioPanelBorderColor">#2A2A30</Color>
                    <Color x:Key="ScanlineStudioAccentColor">#3FA7D6</Color>
                    <Color x:Key="ScanlineStudioTxActiveColor">#D64545</Color>
                    <Color x:Key="ScanlineStudioTxActiveForegroundColor">#FFFFFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ScanlineStudioPanelHeaderBackgroundColor">#E4E4EA</Color>
                    <Color x:Key="ScanlineStudioPanelHeaderForegroundColor">#202024</Color>
                    <Color x:Key="ScanlineStudioPanelBodyBackgroundColor">#F2F2F5</Color>
                    <Color x:Key="ScanlineStudioPanelBorderColor">#CFCFD6</Color>
                    <Color x:Key="ScanlineStudioAccentColor">#1E7EA8</Color>
                    <Color x:Key="ScanlineStudioTxActiveColor">#B93636</Color>
                    <Color x:Key="ScanlineStudioTxActiveForegroundColor">#FFFFFF</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Spacing scale: Aesthetic Directive says 2px/4px maximum between individual elements.
                 "Large" is deliberately still small (6px) and reserved for rare panel-level
                 separation only, never the default for control-to-control spacing. Two shapes of
                 the same numbers: plain doubles for double-typed properties (e.g.
                 StackPanel.Spacing), Thickness for Padding/Margin. Avalonia's DynamicResource
                 lookup does not run the string-to-Thickness type converter a Padding="4" literal
                 gets, so a bare double resource used against a Thickness-typed property throws at
                 runtime (confirmed by actually running the app, not assumed). -->
            <x:Double x:Key="ScanlineStudioSpacingSmall">2</x:Double>
            <x:Double x:Key="ScanlineStudioSpacingMedium">4</x:Double>
            <x:Double x:Key="ScanlineStudioSpacingLarge">6</x:Double>
            <Thickness x:Key="ScanlineStudioPaddingSmall">2</Thickness>
            <Thickness x:Key="ScanlineStudioPaddingMedium">4</Thickness>
            <Thickness x:Key="ScanlineStudioPaddingLarge">6</Thickness>

            <!-- Monospace for every numeric/rapid-update readout (frequency, signal meters, etc.):
                 comma-separated fallback list, same mechanism as bundling Inter for body text, but
                 relying on each OS's own already-installed monospace font rather than adding another
                 bundled-font dependency for a Phase-3 minimal need. -->
            <FontFamily x:Key="ScanlineStudioMonospaceFontFamily">Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,Menlo,monospace</FontFamily>

            <!-- TX toggle button: opt-in (Theme="{StaticResource ScanlineStudioTxToggleButtonTheme}"), not a
                 global implicit style, since this state coloring is specific to the one TX/transmit
                 control, not every ToggleButton in the app. -->
            <ControlTheme x:Key="ScanlineStudioTxToggleButtonTheme" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Style Selector="^:checked /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ScanlineStudioTxActiveColor}" />
                    <Setter Property="TextBlock.Foreground" Value="{DynamicResource ScanlineStudioTxActiveForegroundColor}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Square corners everywhere, globally: the Aesthetic Directive's least negotiable rule.
         FluentTheme's default control themes expose CornerRadius as a themed property their own
         templates bind to, so overriding it here (rather than replacing whole templates) is enough. -->
    <!-- :not(.Industry) exclusion (UI-redesign Phase 1, item 0b): the "Industry" marker class is
         carried by every new-design control instance so these old bare-type selectors can't leak
         onto them while the two design systems coexist — same mitigation, same reasoning as
         Cards.axaml's own copy of this comment. -->
    <Style Selector="Button:not(.Industry)">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingMedium}" />
    </Style>
    <Style Selector="ToggleButton:not(.Industry)">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingMedium}" />
    </Style>
    <Style Selector="ComboBox:not(.Industry)">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingSmall}" />
    </Style>
    <Style Selector="ComboBoxItem:not(.Industry)">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingSmall}" />
    </Style>
    <Style Selector="TextBox:not(.Industry)">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="CheckBox:not(.Industry)">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- FluentTheme's default TabItem header uses a much larger type-ramp size than every other
         control in this app (confirmed by actually running it: "General"/"Audio" etc. rendered
         comically oversized next to normal-sized buttons/labels right next to them); pinned down
         to a normal control-text size here, matching the Aesthetic Directive's "minimal padding,
         nothing oversized" rule. -->
    <!-- :not(.Industry) exclusion, same reason as above. -->
    <Style Selector="TabItem:not(.Industry)">
        <Setter Property="CornerRadius" Value="0" />
        <!-- Cards.axaml sets the workspace tabs to 11.5; this only needs to stop FluentTheme's
             oversized default for tabs in windows Cards.axaml doesn't reach (Options). -->
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingMedium}" />
    </Style>

    <Style Selector="Border.ScanlineStudioPanelHeader">
        <Setter Property="Background" Value="{DynamicResource ScanlineStudioPanelHeaderBackgroundColor}" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingMedium}" />
    </Style>
    <Style Selector="Border.ScanlineStudioPanelHeader TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ScanlineStudioPanelHeaderForegroundColor}" />
    </Style>

    <Style Selector="Border.ScanlineStudioPanelBody">
        <Setter Property="Background" Value="{DynamicResource ScanlineStudioPanelBodyBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScanlineStudioPanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingMedium}" />
    </Style>

    <!-- Rigid grouping: a bordered "module" container simulating a physical hardware module
         boundary (Avalonia has no native GroupBox); opt-in via Classes="ScanlineStudioModuleGroup", not
         every Border, since not every container is meant to read as a distinct instrument module. -->
    <Style Selector="Border.ScanlineStudioModuleGroup">
        <Setter Property="BorderBrush" Value="{DynamicResource ScanlineStudioPanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ScanlineStudioPaddingSmall}" />
    </Style>

    <!-- Monospace readout: opt-in via Classes="ScanlineStudioReadout" on any TextBlock showing a
         frequency/signal-meter/rapid-update numeric value. -->
    <Style Selector="TextBlock.ScanlineStudioReadout">
        <Setter Property="FontFamily" Value="{DynamicResource ScanlineStudioMonospaceFontFamily}" />
    </Style>

    <!-- Help glyph: a small "[?]" placed next to an esoteric setting's label, its own ToolTip.Tip
         carrying the actual explanation (see the Options window). Muted so it reads as secondary
         chrome, not a real button; opt-in via Classes="ScanlineStudioHelpGlyph" on a TextBlock. -->
    <Style Selector="TextBlock.ScanlineStudioHelpGlyph">
        <Setter Property="FontFamily" Value="{DynamicResource ScanlineStudioMonospaceFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Cursor" Value="Help" />
    </Style>

</Styles>
