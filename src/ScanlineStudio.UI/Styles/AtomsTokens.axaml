<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design-token layer for the "Industry" wireframe design system
         (mockups/guidance/LAYOUT-SPEC.md, mockups/guidance/SSTV Console.dc.html's id="2a" mockup):
         steel-blue accent on a light technical ground, Barlow / Barlow Condensed, square corners,
         hairline borders, blueprint corner marks. As of Phase 7 this is the ONLY design system in
         the app — the old "Aesthetic Directive" (flat WSJT-X/fldigi gray Win32/Qt chrome,
         Tokens.axaml/Cards.axaml/ChromeOverrides.axaml) was deleted once every view was confirmed
         ported. During the migration this file was additive (loaded alongside the old files,
         which is why every resource here is `Industry`-prefixed rather than reusing a bare
         Cards.axaml class name like `.chip`/`.primary`/`.halt`/`.seg` at different metrics) — that
         prefix stays now for clarity/searchability, not because collision avoidance is still
         load-bearing. -->

    <Styles.Resources>
        <ResourceDictionary>

            <!-- ================= Color (LAYOUT-SPEC.md §2) =================
                 "Opaque over ground" values are used directly (not translucent Color+Opacity
                 composites) for hairlines/text per §2's own guidance: Avalonia composites
                 translucent 1px borders differently from the browser and a translucent hairline
                 over a panel edge reads doubled. This rule is scoped to 1px rules and text on the
                 flat paper ground specifically; colors that must overlay live/dark content
                 (waterfall overlay lines, the TX editor's safe-area rectangle, interactive-state
                 hover/press tints) stay genuinely translucent; see the hatch-fill DrawingBrush and
                 the interaction-state colors added in Styles/Atoms.axaml (Phase 1) for those. -->
            <!-- ============ mockups/colors/SSTV-Color-Scheme.md, 2026-08-14 ============
                 Supersedes this block's original LAYOUT-SPEC.md §2 values wholesale (user decision,
                 not a hybrid): "grey is the default, color is a claim about meaning, exactly four
                 claims" — blue=selection, green=healthy, amber=attention, red=destroying. The spec
                 was authored against the PRE-Phase-7 "Aesthetic Directive" tree (its own §8 says
                 "add to avalonia/fixed/Styles/Tokens.axaml", "keep the ScanlineStudio prefix" — that
                 tree was deleted, see this file's own header comment) — its §8/§9 implementation
                 instructions are reference-only, NOT applicable literally; its §1-§7/§11 rules and
                 palette ARE authoritative and are what's implemented here. Old Industry-ramp values
                 (#F2F2F3 ground, #1D1F20 text, #5980A6 accent, single #D0D0D1 divider, 5-step
                 Muted42..72 ramp, Accent100/600/700/800/900) are being migrated OFF, additively:
                 this block updates the direct 1:1 concept matches (Ground/Text/Accent/Danger) now:
                 - Ground/Surface/Text: LAYOUT-SPEC values -> spec's exact Ground/ControlFace/Text.
                 - Accent: user decision "switch entirely" -> IndustryAccentColor IS the new Select
                   blue #0F62A8 now, not a separate token — every existing IndustryAccent consumer
                   picks this up automatically. Where a consumer's real role is chrome/branding
                   rather than "selection" (group-box titles, kickers — user decision: both move to
                   grey/Label, NOT blue) that consumer is migrated OFF IndustryAccent entirely onto
                   IndustryLabel, per-usage, as those views are swept (Phase B/C, not this file).
                 - Danger: value corrected to spec's exact #B42A2A (was the old design's own
                   #B93636); the OLD comment's TX-active-toggle/error-text/danger-button consumers
                   are still correct consumers of this same token under the new spec (§4 destructive
                   buttons, §6 TX-active state) — only the value changes, not the semantic role.
                   New IndustryTxLed (#D42A2A) is the spec's own separate, deliberately-brighter red
                   for LED dots specifically (§2.2's "do not unify" rule) — was previously a bare
                   literal on Ellipse.IndustryLed.alert in Atoms.axaml, not a token; consolidated here.
                 The 5-step muted-text ramp, Accent100/600/700/800/900, and IndustrySurface are LEFT
                 AS-IS in this pass (not deleted) — Phase B/C remaps each of their real consumers
                 onto the new precise tokens below (Label/MutedText/DisabledText, Hover/Press)
                 per-usage, since collapsing a 5-step ramp requires knowing what each specific
                 consumer actually means, not just a value swap. Old tokens get deleted once nothing
                 references them, not before (this project's own established migration pattern —
                 see this file's header comment on how AtomsTokens.axaml itself replaced Tokens.axaml).
                 IndustryDivider (the single pre-spec #D0D0D1 border/separator color) was the one
                 already fully swept: every remaining real consumer resolves to
                 IndustryChromeBorder (card border/band separator/tab border, #B9B9B9, per spec
                 §2) or IndustryControlBorder (button/field/segment border, #A0A0A0, per spec §2
                 — also the §7.4 fixed-exception value for image thumbnails/the received-frame
                 pane, which override §2's card-border default) per its own role — the old
                 IndustryDivider/IndustryDividerColor tokens are deleted below since nothing
                 references them anymore. One consumer (the table-header rule) needed neither
                 role and got its own spec-exact IndustryTableHeaderBorderColor (§6: "#E4E4E4
                 on #C8C8C8") instead of a "close enough" substitute. The §7.4 exception covers
                 both received-frame sites (RX-history preview AND the live Incoming-frame pane,
                 RxImagePaneView.axaml — the latter via a local BorderBrush override rather than
                 retargeting Border.IndustryPlot itself, since that style is shared with the
                 legitimately-chrome spectrum/waterfall canvases, §7.3) and both halves of the
                 thumbnail figure (Border.IndustryThumbnail + its IndustryThumbnailCaption
                 divider, kept consistent as one composed content object rather than two
                 independently-classified borders). -->
            <!-- Phase 1 dark mode: Color+Brush pairs collapsed into one Color-valued SolidColorBrush
                 per theme branch (their *Color halves had zero external consumers — every reference
                 was the matching brush definition right below it) — see
                 ResourceDictionary.ThemeDictionaries below. Light values are unchanged from before
                 this restructure (pinned by a golden test); Dark values are this phase's own new
                 design work, a principled first-pass derived via hue-preserving HSL lightness
                 inversion (accent/semantic families) and light-mode-lerp-fraction reapplication
                 (muted-text ramp, rule/neutral tones), with a manual contrast boost for
                 control-face-class surfaces (buttons/fields) — the naive fraction under-contrasts
                 those specifically, a known dark-theme pitfall. Two tokens are deliberately NOT
                 inverted between branches (documented per-key below): IndustryAccent900 (the
                 plot/waterfall canvas background — fixed C#-side pens in
                 SpectrumTraceControl.cs/DecoderTraceControl.cs are not theme-token-driven and were
                 tuned against this exact value) and IndustryDangerForeground (white text on solid
                 red — inverting would make it unreadable). Subject to correction via the real-window
                 visual-verification gate (plan Process step 4) before this phase ships. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IndustryBg" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="IndustrySurface" Color="#E9E9EA" />
                    <SolidColorBrush x:Key="IndustryText" Color="#101010" />
                    <SolidColorBrush x:Key="IndustryAccent" Color="#0F62A8" />
                    <SolidColorBrush x:Key="IndustryTextMuted42" Color="#99999A" />
                    <SolidColorBrush x:Key="IndustryTextMuted50" Color="#88898A" />
                    <SolidColorBrush x:Key="IndustryTextMuted55" Color="#7D7E7F" />
                    <SolidColorBrush x:Key="IndustryTextMuted62" Color="#6E6F70" />
                    <SolidColorBrush x:Key="IndustryTextMuted72" Color="#595A5B" />
                    <SolidColorBrush x:Key="IndustryRowRule7" Color="#E3E3E4" />
                    <SolidColorBrush x:Key="IndustryRowRule6" Color="#E5E5E6" />
                    <SolidColorBrush x:Key="IndustryTableRule8" Color="#E1E1E2" />
                    <!-- Spec §6: "Header row #E4E4E4 on #C8C8C8" — its own value, distinct from
                         both border roles (§2 ChromeBorder #B9B9B9 / ControlBorder #A0A0A0). -->
                    <SolidColorBrush x:Key="IndustryTableHeaderBorder" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="IndustryNeutral200" Color="#E7E7EA" />
                    <SolidColorBrush x:Key="IndustryNeutral300" Color="#D4D4D7" />
                    <SolidColorBrush x:Key="IndustryAccent100" Color="#EEF6FF" />
                    <SolidColorBrush x:Key="IndustryAccent600" Color="#597EA3" />
                    <SolidColorBrush x:Key="IndustryAccent700" Color="#416180" />
                    <SolidColorBrush x:Key="IndustryAccent800" Color="#2C455D" />
                    <!-- Plot/waterfall canvas background — identical value in both branches, see
                         the block comment above. -->
                    <SolidColorBrush x:Key="IndustryAccent900" Color="#1D2D3D" />
                    <!-- DO NOT INVERT: foreground ink for text/glyphs drawn directly on the
                         IndustryAccent900 plot canvas (e.g. RxImagePaneView's "No image yet"
                         placeholder) — that canvas background is itself never inverted (see
                         above), so an inverting foreground token composited against it goes
                         near-black-on-near-black in Dark. Code-review finding: an earlier pass
                         used IndustryBg (which DOES invert) for exactly this and it went
                         invisible (~1.1:1 contrast) the moment Dark shipped. -->
                    <SolidColorBrush x:Key="IndustryPlotInk" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="IndustryDanger" Color="#B42A2A" />
                    <!-- White text on solid red — identical value in both branches, see the block
                         comment above. -->
                    <SolidColorBrush x:Key="IndustryDangerForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IndustryTxLed" Color="#D42A2A" />
                    <SolidColorBrush x:Key="IndustryControlFace" Color="#E9E9E9" />
                    <SolidColorBrush x:Key="IndustryDataField" Color="#E4E4E4" />
                    <SolidColorBrush x:Key="IndustryEditField" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IndustryDisabledFace" Color="#EDEDED" />
                    <SolidColorBrush x:Key="IndustryChromeBorder" Color="#B9B9B9" />
                    <SolidColorBrush x:Key="IndustryControlBorder" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="IndustryDisabledBorder" Color="#C6C6C6" />
                    <SolidColorBrush x:Key="IndustryLabel" Color="#454545" />
                    <SolidColorBrush x:Key="IndustryMutedText" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="IndustryDisabledText" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="IndustryStatusText" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="IndustrySelectSolidBorder" Color="#0B4C83" />
                    <SolidColorBrush x:Key="IndustrySelectTint" Color="#C4DDF5" />
                    <SolidColorBrush x:Key="IndustrySelectTintBorder" Color="#2A5D8F" />
                    <SolidColorBrush x:Key="IndustrySelectTintText" Color="#0B3E68" />
                    <SolidColorBrush x:Key="IndustryHealthy" Color="#2E9E44" />
                    <SolidColorBrush x:Key="IndustryHealthySolidBorder" Color="#256F33" />
                    <SolidColorBrush x:Key="IndustryHealthyTint" Color="#DCEFD9" />
                    <SolidColorBrush x:Key="IndustryHealthyTintBorder" Color="#4E9A4E" />
                    <SolidColorBrush x:Key="IndustryHealthyTintText" Color="#14471C" />
                    <SolidColorBrush x:Key="IndustryAttention" Color="#C88A00" />
                    <SolidColorBrush x:Key="IndustryAttentionSolidBorder" Color="#8F6300" />
                    <SolidColorBrush x:Key="IndustryAttentionTint" Color="#FAECC4" />
                    <SolidColorBrush x:Key="IndustryAttentionTintBorder" Color="#B0871F" />
                    <SolidColorBrush x:Key="IndustryAttentionTintText" Color="#4A3600" />
                    <SolidColorBrush x:Key="IndustryDangerSolidBorder" Color="#8C1F1F" />
                    <SolidColorBrush x:Key="IndustryDangerTint" Color="#F3D9D9" />
                    <SolidColorBrush x:Key="IndustryDangerTintBorder" Color="#B45A5A" />
                    <SolidColorBrush x:Key="IndustryDangerTintText" Color="#5A1010" />
                    <SolidColorBrush x:Key="IndustryHoverFace" Color="#DCE9F5" />
                    <SolidColorBrush x:Key="IndustryHoverBorder" Color="#7EB4EA" />
                    <SolidColorBrush x:Key="IndustryPressFace" Color="#C4DDF5" />
                    <SolidColorBrush x:Key="IndustryPressBorder" Color="#5A9AD4" />
                    <!-- The 17 literal-color Setters tokenized this phase (Atoms.axaml hover/press
                         feedback layer + LED-off + TxImageEditorPaneView's rotation overlay). -->
                    <SolidColorBrush x:Key="IndustryHoverInk" Color="#121D1F20" />
                    <SolidColorBrush x:Key="IndustryPressInk" Color="#241D1F20" />
                    <SolidColorBrush x:Key="IndustryInputHoverInk" Color="#731D1F20" />
                    <SolidColorBrush x:Key="IndustryPrimaryHover" Color="#FF1472C0" />
                    <SolidColorBrush x:Key="IndustryPrimaryHoverBorder" Color="#FF1472C0" />
                    <SolidColorBrush x:Key="IndustryDangerHover" Color="#FFC93333" />
                    <SolidColorBrush x:Key="IndustryLedOffStroke" Color="#FF6E6E6E" />
                    <SolidColorBrush x:Key="IndustryLedOffFill" Color="#FFC8C8C8" />
                    <SolidColorBrush x:Key="IndustryOverlayFill" Color="#33FFFFFF" />
                    <DrawingBrush x:Key="IndustryHatchStripeBrush" TileMode="Tile"
                                  SourceRect="0,0,16.9706,16.9706" DestinationRect="0,0,16.9706,16.9706">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#240F62A8">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup FillRule="NonZero">
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,0" IsClosed="True">
                                                <LineSegment Point="8.4853,0" />
                                                <LineSegment Point="0,8.4853" />
                                            </PathFigure>
                                        </PathGeometry>
                                        <PathGeometry>
                                            <PathFigure StartPoint="16.9706,0" IsClosed="True">
                                                <LineSegment Point="16.9706,8.4853" />
                                                <LineSegment Point="8.4853,16.9706" />
                                                <LineSegment Point="0,16.9706" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="IndustryBg" Color="#1A1B1C" />
                    <SolidColorBrush x:Key="IndustrySurface" Color="#242526" />
                    <SolidColorBrush x:Key="IndustryText" Color="#E7E7E8" />
                    <SolidColorBrush x:Key="IndustryAccent" Color="#49A5F3" />
                    <SolidColorBrush x:Key="IndustryTextMuted42" Color="#6A6A6B" />
                    <SolidColorBrush x:Key="IndustryTextMuted50" Color="#78797A" />
                    <SolidColorBrush x:Key="IndustryTextMuted55" Color="#828384" />
                    <SolidColorBrush x:Key="IndustryTextMuted62" Color="#909192" />
                    <SolidColorBrush x:Key="IndustryTextMuted72" Color="#A3A4A5" />
                    <SolidColorBrush x:Key="IndustryRowRule7" Color="#2E2F30" />
                    <SolidColorBrush x:Key="IndustryRowRule6" Color="#2C2D2E" />
                    <SolidColorBrush x:Key="IndustryTableRule8" Color="#313132" />
                    <SolidColorBrush x:Key="IndustryTableHeaderBorder" Color="#535455" />
                    <SolidColorBrush x:Key="IndustryNeutral200" Color="#2C2D2E" />
                    <SolidColorBrush x:Key="IndustryNeutral300" Color="#414243" />
                    <SolidColorBrush x:Key="IndustryAccent100" Color="#1B2937" />
                    <SolidColorBrush x:Key="IndustryAccent600" Color="#95ADC5" />
                    <SolidColorBrush x:Key="IndustryAccent700" Color="#A7BDD2" />
                    <SolidColorBrush x:Key="IndustryAccent800" Color="#BACCDE" />
                    <!-- DO NOT INVERT: plot/waterfall canvas background, see block comment above. -->
                    <SolidColorBrush x:Key="IndustryAccent900" Color="#1D2D3D" />
                    <!-- DO NOT INVERT: foreground ink for text on the plot canvas, see block
                         comment above. -->
                    <SolidColorBrush x:Key="IndustryPlotInk" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="IndustryDanger" Color="#DA4E4E" />
                    <!-- DO NOT INVERT: white text on solid red, see block comment above. -->
                    <SolidColorBrush x:Key="IndustryDangerForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="IndustryTxLed" Color="#E44E4E" />
                    <SolidColorBrush x:Key="IndustryControlFace" Color="#373839" />
                    <SolidColorBrush x:Key="IndustryDataField" Color="#2E2F30" />
                    <!-- Code-review finding (round 1): the original #2E3032 was actually DARKER
                         than ControlFace/DataField (near-identical to DataField), losing the
                         "editable one reads lightest" invariant Light enforces hard
                         (#FFFFFF > #E4E4E4/#E9E9E9). #3D4043 restores that ordering while staying
                         a deliberately muted (not pure-white) surface — stands in for "the
                         editable one" semantic role that pure white served in Light mode (spec:
                         "white always and only means editable"). -->
                    <SolidColorBrush x:Key="IndustryEditField" Color="#3D4043" />
                    <SolidColorBrush x:Key="IndustryDisabledFace" Color="#262728" />
                    <SolidColorBrush x:Key="IndustryChromeBorder" Color="#585859" />
                    <SolidColorBrush x:Key="IndustryControlBorder" Color="#6C6D6E" />
                    <SolidColorBrush x:Key="IndustryDisabledBorder" Color="#474849" />
                    <SolidColorBrush x:Key="IndustryLabel" Color="#AEAEAF" />
                    <SolidColorBrush x:Key="IndustryMutedText" Color="#8B8B8C" />
                    <SolidColorBrush x:Key="IndustryDisabledText" Color="#767778" />
                    <SolidColorBrush x:Key="IndustryStatusText" Color="#BEBEBF" />
                    <SolidColorBrush x:Key="IndustrySelectSolidBorder" Color="#82C2F7" />
                    <SolidColorBrush x:Key="IndustrySelectTint" Color="#073C69" />
                    <SolidColorBrush x:Key="IndustrySelectTintBorder" Color="#0E7EDC" />
                    <SolidColorBrush x:Key="IndustrySelectTintText" Color="#96CBF8" />
                    <SolidColorBrush x:Key="IndustryHealthy" Color="#5CCC72" />
                    <SolidColorBrush x:Key="IndustryHealthySolidBorder" Color="#319B46" />
                    <SolidColorBrush x:Key="IndustryHealthyTint" Color="#184E23" />
                    <SolidColorBrush x:Key="IndustryHealthyTintBorder" Color="#33A349" />
                    <SolidColorBrush x:Key="IndustryHealthyTintText" Color="#AAE4B5" />
                    <SolidColorBrush x:Key="IndustryAttention" Color="#FFC033" />
                    <SolidColorBrush x:Key="IndustryAttentionSolidBorder" Color="#D69400" />
                    <SolidColorBrush x:Key="IndustryAttentionTint" Color="#664600" />
                    <SolidColorBrush x:Key="IndustryAttentionTintBorder" Color="#E09B00" />
                    <SolidColorBrush x:Key="IndustryAttentionTintText" Color="#FFDC8F" />
                    <SolidColorBrush x:Key="IndustryDangerSolidBorder" Color="#A92323" />
                    <SolidColorBrush x:Key="IndustryDangerTint" Color="#541212" />
                    <SolidColorBrush x:Key="IndustryDangerTintBorder" Color="#B12525" />
                    <SolidColorBrush x:Key="IndustryDangerTintText" Color="#ECA2A2" />
                    <SolidColorBrush x:Key="IndustryHoverFace" Color="#0A4270" />
                    <SolidColorBrush x:Key="IndustryHoverBorder" Color="#1483E1" />
                    <SolidColorBrush x:Key="IndustryPressFace" Color="#0D528C" />
                    <SolidColorBrush x:Key="IndustryPressBorder" Color="#3197ED" />
                    <!-- Hover/press ink was near-black at low alpha over a LIGHT ground in Light
                         mode — over a Dark ground a near-black tint composites to nothing, so the
                         Dark branch uses a near-white tint at the same alpha instead, preserving
                         "hover/press reads lighter than resting" in both themes. -->
                    <SolidColorBrush x:Key="IndustryHoverInk" Color="#12E7E7E8" />
                    <SolidColorBrush x:Key="IndustryPressInk" Color="#24E7E7E8" />
                    <SolidColorBrush x:Key="IndustryInputHoverInk" Color="#73E7E7E8" />
                    <SolidColorBrush x:Key="IndustryPrimaryHover" Color="#FF4FA5ED" />
                    <SolidColorBrush x:Key="IndustryPrimaryHoverBorder" Color="#FF4FA5ED" />
                    <SolidColorBrush x:Key="IndustryDangerHover" Color="#FFDC7575" />
                    <!-- Mid-grey works unchanged against both grounds. -->
                    <SolidColorBrush x:Key="IndustryLedOffStroke" Color="#FF6E6E6E" />
                    <SolidColorBrush x:Key="IndustryLedOffFill" Color="#FF404040" />
                    <!-- First-pass value; needs the real-window eyeball check over actual image
                         content the plan calls for (plan §1) — a flat white wash may read
                         differently over a dark canvas than it does in Light mode. -->
                    <SolidColorBrush x:Key="IndustryOverlayFill" Color="#40FFFFFF" />
                    <DrawingBrush x:Key="IndustryHatchStripeBrush" TileMode="Tile"
                                  SourceRect="0,0,16.9706,16.9706" DestinationRect="0,0,16.9706,16.9706">
                        <DrawingBrush.Drawing>
                            <!-- New Dark accent (#49A5F3) at a higher alpha (0x2E vs Light's 0x24)
                                 for visibility over a near-black ground. -->
                            <GeometryDrawing Brush="#2E49A5F3">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup FillRule="NonZero">
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,0" IsClosed="True">
                                                <LineSegment Point="8.4853,0" />
                                                <LineSegment Point="0,8.4853" />
                                            </PathFigure>
                                        </PathGeometry>
                                        <PathGeometry>
                                            <PathFigure StartPoint="16.9706,0" IsClosed="True">
                                                <LineSegment Point="16.9706,8.4853" />
                                                <LineSegment Point="8.4853,16.9706" />
                                                <LineSegment Point="0,16.9706" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ================= Spacing (LAYOUT-SPEC.md §2) =================
                 Real steps are 2, 3, 4, 5, 6, 7, 9, 11, deliberately off a 4px grid, matching the
                 reference apps this design imitates. Word-suffixed names, NOT a numeric suffix
                 (e.g. NOT "IndustrySpacing4"): NoThicknessSpacingMismatchTests's regex
                 ([A-Za-z]*Spacing[A-Za-z]*) requires letters only around the word "Spacing" with no
                 digit anywhere in the matched resource-key span, so a numeric-suffixed name would
                 silently stop being caught by that guard (confirmed against the live regex, not
                 assumed), auditor round-2 finding N1. Two shapes of the same numbers, matching
                 Tokens.axaml's existing established pattern: plain x:Double for double-typed
                 properties (e.g. StackPanel.Spacing), Thickness for Padding/Margin (Avalonia's
                 DynamicResource lookup runs no type converter, so a bare double used against a
                 Thickness-typed property throws at runtime). -->
            <x:Double x:Key="IndustrySpacingHairline">2</x:Double>
            <x:Double x:Key="IndustrySpacingTight">3</x:Double>
            <x:Double x:Key="IndustrySpacingSnug">4</x:Double>
            <x:Double x:Key="IndustrySpacingCozy">5</x:Double>
            <x:Double x:Key="IndustrySpacingBase">6</x:Double>
            <x:Double x:Key="IndustrySpacingWide">7</x:Double>
            <x:Double x:Key="IndustrySpacingGutter">9</x:Double>
            <x:Double x:Key="IndustrySpacingGroup">11</x:Double>
            <Thickness x:Key="IndustryPaddingHairline">2</Thickness>
            <Thickness x:Key="IndustryPaddingTight">3</Thickness>
            <Thickness x:Key="IndustryPaddingSnug">4</Thickness>
            <Thickness x:Key="IndustryPaddingCozy">5</Thickness>
            <Thickness x:Key="IndustryPaddingBase">6</Thickness>
            <Thickness x:Key="IndustryPaddingWide">7</Thickness>
            <Thickness x:Key="IndustryPaddingGutter">9</Thickness>
            <Thickness x:Key="IndustryPaddingGroup">11</Thickness>
            <!-- Composite (asymmetric) Thickness resources for this design's real paddings (a flat
                 8-step scale cannot express e.g. the group-box's own 7,11,7,6 default) are added in
                 Phase 1 alongside the atoms that consume them, sourced from
                 mockups/guidance/PADDING-NORMALIZATION.md, not invented ad hoc per-view. -->

            <!-- ================= Type (LAYOUT-SPEC.md §2) =================
                 Folder-per-family URIs (Assets/Fonts/Barlow/, Assets/Fonts/BarlowCondensed/, not
                 one shared Fonts/ folder): confirmed empirically that Avalonia's
                 avares://Folder#FamilyName resolution searches every font in that folder for the
                 closest weight match rather than filtering by family first, so a shared folder
                 silently cross-resolved a Barlow Condensed request to plain Barlow Bold. See
                 tests/ScanlineStudio.UI.FontTests's regression coverage for this. -->
            <FontFamily x:Key="IndustryHeadingFontFamily">avares://ScanlineStudio.UI/Assets/Fonts/BarlowCondensed#Barlow Condensed</FontFamily>
            <FontFamily x:Key="IndustryBodyFontFamily">avares://ScanlineStudio.UI/Assets/Fonts/Barlow#Barlow</FontFamily>
            <!-- Bundled (not left to per-OS fallback, unlike LAYOUT-SPEC.md §2's own "mono is
                 allowed to fall back to the OS"): nearly every pixel-exact width in this design
                 (stepper value widths, table columns, the 40px frequency readout) is mono
                 glyph-advance-width-driven, and per-OS metric drift (Cascadia Mono vs. Consolas vs.
                 DejaVu Sans Mono) would silently break the design's own §7 pixel-measurement
                 checklist. Reuses the project's already-vetted/licensed DejaVu Sans Mono
                 (LICENSES.md), not a new font dependency. -->
            <FontFamily x:Key="IndustryMonoFontFamily">avares://ScanlineStudio.UI/Assets/Fonts/DejaVuSansMono#DejaVu Sans Mono</FontFamily>

            <!-- ================= Composite (asymmetric) paddings (Phase 1) =================
                 The flat 2/3/4/5/6/7/9/11 spacing scale above can't express this design's real
                 (mostly asymmetric) paddings on its own — these are sourced from
                 mockups/guidance/PADDING-NORMALIZATION.md, not invented, per
                 mockups/guidance/PHASE1-ATOM-DESIGN.md's own item-by-item citations. Word-suffixed
                 names (no digit in the key), same NoThicknessSpacingMismatchTests constraint as the
                 base scale above. -->
            <!-- Menu bar (Phase 2): PADDING-NORMALIZATION.md §2 Band 1. -->
            <Thickness x:Key="IndustryMenuPadding">6,1,6,1</Thickness>
            <Thickness x:Key="IndustryMenuItemPadding">7,2,7,2</Thickness>
            <!-- Tab strip (Phase 2): PADDING-NORMALIZATION.md §1 (.tabbtn2) / §2 Band 3. -->
            <Thickness x:Key="IndustryTabItemPadding">11,5,11,4</Thickness>
            <Thickness x:Key="IndustryGbPadding">7,11,7,6</Thickness>
            <Thickness x:Key="IndustryGbPaddingWide">8,11,8,6</Thickness>
            <Thickness x:Key="IndustryGbPaddingWideDeep">8,11,8,7</Thickness>
            <Thickness x:Key="IndustryGbPaddingFav">8,11,8,5</Thickness>
            <Thickness x:Key="IndustryGbPaddingNested">6,10,6,5</Thickness>
            <Thickness x:Key="IndustryGbtPadding">5,0,5,0</Thickness>
            <Thickness x:Key="IndustryMiniPadding">5,1,5,1</Thickness>
            <!-- Shared by the stepper's value cell (item 5) AND .input (item 8) — one canonical
                 name, not two resources for the same value. -->
            <Thickness x:Key="IndustryStepperValuePadding">6,0,6,0</Thickness>
            <Thickness x:Key="IndustrySegOptPadding">10,2,10,2</Thickness>
            <Thickness x:Key="IndustrySegOptPaddingStretched">6,3,6,3</Thickness>
            <Thickness x:Key="IndustryTableCellPadding">5,2,5,2</Thickness>
            <Thickness x:Key="IndustryTableCellPaddingNarrow">4,2,4,2</Thickness>
            <!-- Thumbnail figure caption paddings (item 11): default shared by Previous
                 frames/Saved templates/Recently sent; Gallery's own figcaption is genuinely larger,
                 not a copy error (confirmed against PADDING-NORMALIZATION.md). -->
            <Thickness x:Key="IndustryThumbnailCaptionPadding">4,2,4,2</Thickness>
            <Thickness x:Key="IndustryThumbnailCaptionPaddingGallery">5,3,5,3</Thickness>

            <!-- IndustryHatchStripeBrush (LAYOUT-SPEC.md §2, Phase 1 geometry — the diagonal-stripe
                 tiling derivation, "/"-direction bowtie-bug history, and 16.9706 tile-size math are
                 all documented once, on the Light branch's copy above) now lives per-branch in
                 ResourceDictionary.ThemeDictionaries since Phase 1 dark mode needs its own fill
                 color/alpha over a dark ground — geometry is identical in both branches, only the
                 GeometryDrawing.Brush differs; a guard test asserts this. -->

        </ResourceDictionary>
    </Styles.Resources>

</Styles>
