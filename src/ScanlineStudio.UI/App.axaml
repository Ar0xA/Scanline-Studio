<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScanlineStudio.UI.App"
             xmlns:local="using:ScanlineStudio.UI"
             RequestedThemeVariant="Light">
             <!-- Explicit Light default (not "Default"/follow-system): user preference, confirmed
                  after actually seeing the app default to dark on a dark-OS-theme machine.
                  User-overridable theme selection is a future settings-UI item, not built yet. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Global square-corner override (spec/09-ui.md Aesthetic Directive): closes the
                 gap the per-control Style selectors in Tokens.axaml never covered (Flyout,
                 ListBoxItem, menu popups still got FluentTheme's rounded corners without this).
                 Application.Resources is the correct scope to match the mockup's own
                 Window.Resources declaration of these same three keys. -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- DataGrid ships its own theme separately from the base Avalonia packages; needed for
             two mock2 visual-scaffolding-only cards (Decode activity, TX log). Included before
             Tokens.axaml/Cards.axaml so those two files' own DataGridColumnHeader/DataGridCell
             overrides win. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- Design-token layer (spec/09-ui.md): every panel draws from this, not one-off brushes. -->
        <StyleInclude Source="avares://ScanlineStudio.UI/Styles/Tokens.axaml" />
        <!-- Flat WSJT-X/fldigi-utilitarian chrome (current Aesthetic Directive) — included after
             Tokens.axaml so its selectors win on any overlapping property. -->
        <StyleInclude Source="avares://ScanlineStudio.UI/Styles/Cards.axaml" />
        <!-- Replacement ControlThemes for parts no Style selector can reach (Slider, ButtonSpinner)
             plus the field-metric resource overrides. Must be last of the OLD "Aesthetic
             Directive" trio (Tokens/Cards/ChromeOverrides). -->
        <StyleInclude Source="avares://ScanlineStudio.UI/Styles/ChromeOverrides.axaml" />
        <!-- New "Industry" design system (mockups/guidance/LAYOUT-SPEC.md), replacing the trio
             above view-by-view per the redesign plan. ADDITIVE for now, not a replacement: loaded
             after ChromeOverrides.axaml so its resources are available everywhere, but nothing
             above is deleted until every view is ported (redesign plan's Phase 7), since an
             in-place swap would throw immediately (TxControlsPaneView.axaml:238's
             StaticResource-consumed ScanlineStudioTxToggleButtonTheme, see AtomsTokens.axaml's own
             doc comment). -->
        <StyleInclude Source="avares://ScanlineStudio.UI/Styles/AtomsTokens.axaml" />
        <!-- Reusable atom controls (Phase 1) built on AtomsTokens.axaml's resources — loaded after
             it, still additive, no view yet consumes any of these. -->
        <StyleInclude Source="avares://ScanlineStudio.UI/Styles/Atoms.axaml" />
    </Application.Styles>
</Application>