<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScanlineStudio.UI.App"
             xmlns:local="using:ScanlineStudio.UI"
             RequestedThemeVariant="Light">
             <!-- Explicit Light default (not "Default"/follow-system): user preference, confirmed
                  after actually seeing the app default to dark on a dark-OS-theme machine.
                  User-overridable theme selection is a future settings-UI item, not built yet. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Global square-corner override (spec/09-ui.md Aesthetic Directive): closes the
                 gap the per-control Style selectors in Tokens.axaml never covered (Flyout,
                 ListBoxItem, menu popups still got FluentTheme's rounded corners without this).
                 Application.Resources is the correct scope to match the mockup's own
                 Window.Resources declaration of these same three keys. -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Real-window code-review finding (Phase 4, spec/15-template-designer.md): referencing
             FluentTheme alone does NOT register Avalonia.Controls.ColorPicker's own control themes
             (a separate NuGet package with its own theme resource bundle) — without this include,
             every ColorPicker/ColorView instance resolves Template=null/Theme=null and renders as an
             invisible, zero-DesiredSize control (confirmed via Avalonia DevTools against a real
             running window: Bounds had layout space from its parent Grid column, but DesiredSize was
             exactly 0,0). Source path confirmed by inspecting the installed package's own embedded
             resource names (`avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml`),
             not assumed from general Avalonia documentation. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <!-- "Industry" design system (mockups/guidance/LAYOUT-SPEC.md) — the only design system in
             the app as of Phase 7 of the UI redesign. The old "Aesthetic Directive" trio
             (Tokens.axaml/Cards.axaml/ChromeOverrides.axaml) and the DataGrid theme it needed
             (Avalonia.Controls.DataGrid - no view uses a real DataGrid anymore, superseded by the
             plain Grid/IndustryTable atom, item 10's own decision) were deleted once every view
             was confirmed ported and nothing referenced them (grepped the whole project first, not
             assumed). -->
        <StyleInclude Source="avares://ScanlineStudio.UI/Styles/AtomsTokens.axaml" />
        <StyleInclude Source="avares://ScanlineStudio.UI/Styles/Atoms.axaml" />
    </Application.Styles>
</Application>