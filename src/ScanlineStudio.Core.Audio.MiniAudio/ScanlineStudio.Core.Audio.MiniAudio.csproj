<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for pointer-based ring buffer P/Invoke (MiniAudioRing): pinning a Span/array via
         `fixed` and passing the raw pointer is the allocation-free path; marshaling a `float[]`
         parameter on every call would allocate/copy on every single audio buffer, defeating the
         entire point of piece Audio 3. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScanlineStudio.Abstractions\ScanlineStudio.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!--
    Piece Audio 1b: one MSBuild target per OS in the CI matrix (.github/workflows/ci.yml:
    windows-latest, ubuntu-latest, macos-latest), each building the native shim with that
    platform's own toolchain, gated so it only runs on the matching OS. Link flags/compiler choice
    per platform follow miniaudio's own documented build requirements (native/miniaudio.h,
    "2.1 Windows" / "2.2 macOS and iOS" / "2.3 Linux" sections) directly, not guessed:
      - Windows: miniaudio's own WASAPI/WinMM backend needs "no include paths nor link to any
        libraries" (loaded via LoadLibrary at runtime) — but piece Audio 9 (real OS device mute
        state) added DIRECT COM calls (CoInitializeEx/CoCreateInstance/CoUninitialize via
        mmdeviceapi.h/endpointvolume.h, not through miniaudio's own runtime-loaded path), so this
        target links Ole32.lib for the COM entry points themselves. It does NOT link Uuid.lib: a
        real Windows publish hit LNK2019 for CLSID_MMDeviceEnumerator/IID_IMMDeviceEnumerator/
        IID_IAudioEndpointVolume even with Uuid.lib linked (user-caught, verified directly against
        a real Windows SDK install — those three GUIDs' storage is not actually provided by any
        shipped import library, on x64 or ARM64, despite mmdeviceapi.h/endpointvolume.h only
        DECLARING them). scanline_audio.c now defines the three GUIDs itself via DEFINE_GUID — see
        that file's own doc comment at the WASAPI section for the full story, including why an
        EARLIER "auditor-caught" fix here (linking Uuid.lib, on the theory that's where the GUIDs'
        storage lives) was itself wrong. Uses cl.exe (present on windows-latest GitHub Actions
        runners); redirects
        intermediate .obj/.exp/.lib into the output dir to avoid littering the source tree. Symbol
        export: unlike ELF/Mach-O, MSVC exports nothing from a DLL by default, so scanline_audio.h's
        own SCANLINE_AUDIO_API macro (opus-review fix) marks every function __declspec(dllexport) on
        this platform: miniaudio's own docs quoted above are about include paths/link libraries,
        not DLL symbol visibility, and don't cover this.
      - macOS: miniaudio's own CoreAudio backend "should compile cleanly without the need to
        download any dependencies nor link to any libraries or frameworks" (command-line,
        non-notarized build; CoreAudio/AudioToolbox are loaded at runtime, not link time, since
        MA_NO_RUNTIME_LINKING is not defined here) — but that same section's very next sentence
        says command-line compiling "requires linking to -lpthread and -lm" (opus-review
        correction: an earlier revision of this target quoted only the first sentence and omitted
        the second, then didn't link either); both are genuinely needed regardless, since the
        context-level mutex guarding concurrent PulseAudio-style mainloop access (scanline_audio.c's
        g_context_mutex) uses pthread_mutex_t on non-Windows. Piece Audio 9 additionally added
        DIRECT CoreAudio/CoreFoundation calls (AudioObjectGetPropertyData et al., CFStringRef) for
        real OS device mute state, bypassing miniaudio's own runtime-loaded path the same way the
        Windows COM calls above do — `-framework CoreAudio -framework CoreFoundation` are linked
        for that (auditor-caught: an earlier revision left this feature's macOS link inputs
        unchanged, which would have failed to link under clang's default -undefined error). Uses
        clang, producing a .dylib via -dynamiclib.
      - Linux: unchanged from piece Audio 1: "only requires linking to -ldl, -lpthread and -lm."
    The Windows and macOS targets are unverified in this project's own dev sandbox (Linux-only);
    real verification is the CI matrix itself once these commits reach it. See [[05-audio-engine]]
    and spec/14-roadmap.md's Audio 1b entry for the same caveat already recorded for Audio 9.

    Each target declares Inputs/Outputs (opus-review fix) so MSBuild skips re-running it when the
    native sources haven't changed, instead of recompiling the ~95k-line vendored miniaudio.h on
    every single build. This project's own .csproj is included in Inputs too (second-opus-review
    fix): without it, changing a compiler flag inside one of these targets would not itself
    invalidate the target's cached output, silently leaving the old binary in place.
  -->
  <Target Name="BuildNativeShimLinux" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux'))"
           Inputs="native/scanline_audio.c;native/scanline_audio.h;native/miniaudio.h;ScanlineStudio.Core.Audio.MiniAudio.csproj"
           Outputs="$(OutDir)libscanlineaudio.so">
    <PropertyGroup>
      <NativeDir>$(MSBuildProjectDirectory)/native/</NativeDir>
      <NativeObjPath>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)scanline_audio.o</NativeObjPath>
      <NativeLibPath>$(MSBuildProjectDirectory)/$(OutDir)libscanlineaudio.so</NativeLibPath>
    </PropertyGroup>
    <Exec Command="gcc -c -O2 -fPIC &quot;$(NativeDir)scanline_audio.c&quot; -o &quot;$(NativeObjPath)&quot;" />
    <Exec Command="gcc -shared -o &quot;$(NativeLibPath)&quot; &quot;$(NativeObjPath)&quot; -ldl -lpthread -lm" />
  </Target>

  <!-- Architecture-aware, deliberately. The previous version compiled straight into $(OutDir) and was
       incremental on that path, which contains no RID. Building x64 and then arm64 saw an up-to-date
       output and silently reused the FIRST architecture's DLL, with no build error. The mismatch only
       surfaced at load time, as a test host that could not load the shim. Reported from the first
       real Windows run (windows_tests.md, "Native shim is not RID-aware").

       The fix is two targets. This one compiles into an architecture-specific intermediate directory,
       so each architecture has its own output and its own incrementality. The copy below then moves
       it into $(OutDir) with SkipUnchangedFiles, which compares timestamp AND size, so switching
       architecture copies, while an unchanged rebuild does not.

       VSCMD_ARG_TGT_ARCH is set by vcvarsall.bat and is the only reliable statement of what cl.exe
       will actually emit. $(Platform) is "Any CPU" for this project and says nothing about the native
       target. If it is absent the build falls back to "unknown", which still isolates that output
       from a properly initialised one rather than colliding with it. -->
  <PropertyGroup>
    <NativeShimArch Condition="'$(VSCMD_ARG_TGT_ARCH)' != ''">$(VSCMD_ARG_TGT_ARCH)</NativeShimArch>
    <NativeShimArch Condition="'$(NativeShimArch)' == ''">unknown</NativeShimArch>
    <NativeShimStageDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)native\$(NativeShimArch)\</NativeShimStageDir>
  </PropertyGroup>

  <Target Name="BuildNativeShimWindows" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))"
           Inputs="native\scanline_audio.c;native\scanline_audio.h;native\miniaudio.h;ScanlineStudio.Core.Audio.MiniAudio.csproj"
           Outputs="$(NativeShimStageDir)scanlineaudio.dll">
    <MakeDir Directories="$(NativeShimStageDir)" />
    <PropertyGroup>
      <NativeDir>$(MSBuildProjectDirectory)\native\</NativeDir>
      <NativeObjPath>$(NativeShimStageDir)scanline_audio.obj</NativeObjPath>
      <NativeLibPath>$(NativeShimStageDir)scanlineaudio.dll</NativeLibPath>
      <NativeImpLibPath>$(NativeShimStageDir)scanlineaudio.lib</NativeImpLibPath>
      <NativeExpPath>$(NativeShimStageDir)scanlineaudio.exp</NativeExpPath>
    </PropertyGroup>
    <!-- Opus-review fix: /Fo:/Fe: (colon form) is not the traditional MSVC syntax and couldn't be
         verified from anything in this repo; /Fo"path" and /Fe"path" (no colon) are the
         long-established forms, used here instead. -->
    <Exec Command="cl.exe /nologo /O2 /MD /LD /Fo&quot;$(NativeObjPath)&quot; /Fe&quot;$(NativeLibPath)&quot; &quot;$(NativeDir)scanline_audio.c&quot; /link /IMPLIB:&quot;$(NativeImpLibPath)&quot; Ole32.lib" />
  </Target>

  <!-- Deliberately NOT incremental on its own Inputs and Outputs: it must still run when the
       compile target above was skipped, which is exactly the architecture switch case.
       SkipUnchangedFiles makes it a no-op when the staged DLL already matches. -->
  <Target Name="CopyNativeShimWindows" AfterTargets="BuildNativeShimWindows" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Copy SourceFiles="$(NativeShimStageDir)scanlineaudio.dll"
          DestinationFolder="$(MSBuildProjectDirectory)\$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildNativeShimMacOS" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
           Inputs="native/scanline_audio.c;native/scanline_audio.h;native/miniaudio.h;ScanlineStudio.Core.Audio.MiniAudio.csproj"
           Outputs="$(OutDir)libscanlineaudio.dylib">
    <PropertyGroup>
      <NativeDir>$(MSBuildProjectDirectory)/native/</NativeDir>
      <NativeObjPath>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)scanline_audio.o</NativeObjPath>
      <NativeLibPath>$(MSBuildProjectDirectory)/$(OutDir)libscanlineaudio.dylib</NativeLibPath>
    </PropertyGroup>
    <Exec Command="clang -c -O2 -fPIC &quot;$(NativeDir)scanline_audio.c&quot; -o &quot;$(NativeObjPath)&quot;" />
    <Exec Command="clang -dynamiclib -o &quot;$(NativeLibPath)&quot; &quot;$(NativeObjPath)&quot; -lpthread -lm -framework CoreAudio -framework CoreFoundation" />
  </Target>
</Project>
