<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScanlineStudio.Imaging.OpenJpeg\ScanlineStudio.Imaging.OpenJpeg.csproj" />
    <ProjectReference Include="..\..\src\ScanlineStudio.Core.Drm\ScanlineStudio.Core.Drm.csproj" />
  </ItemGroup>

  <!-- The harness's JP2 of its synthetic test card, encoded by QSSTV's jp2IO with OpenJPEG 2.5.4. -->
  <ItemGroup>
    <None Include="..\ScanlineStudio.Core.Drm.Tests\Fixtures\QsstvGolden\inputs\card.jp2" Link="Fixtures\card.jp2" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- OpenJPEG 2.5.4 color.c reference vectors and JP2s, from ~/tools/drm-p7a2-colorref (Fixtures/Ycc/README.md). -->
  <ItemGroup>
    <None Include="Fixtures\Ycc\**" Exclude="Fixtures\Ycc\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
