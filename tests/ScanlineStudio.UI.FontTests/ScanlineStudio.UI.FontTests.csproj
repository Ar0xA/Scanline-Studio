<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken): headless UI tests never need cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- .UseSkia() is required alongside Avalonia.Headless here (unlike
         ScanlineStudio.UI.Tests's TestAppBuilder): the default headless font manager
         (HeadlessFontManagerStub) does not load real embedded fonts at all, confirmed
         empirically - every FontManager.TryGetGlyphTypeface call failed outright under the stub,
         even for a font's own Regular weight. This project exists solely to run
         IndustryFontResolutionTests against a real Skia-backed font manager, isolated from
         ScanlineStudio.UI.Tests's much larger, faster stub-based suite (Avalonia's headless
         platform is process-global singleton state, so the two font-manager configurations
         cannot coexist in one test assembly/process). -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <!-- Avalonia 12 splits text shaping out of Skia: an explicit .UseSkia() needs .UseHarfBuzz() too. -->
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScanlineStudio.UI\ScanlineStudio.UI.csproj" />
    <!-- Perspective-transform corner-drag verification: needs the REAL TransmitImagePreparer (not a
         fake) to exercise the actual warp render path. ScanlineStudio.UI deliberately does NOT
         reference Core.Imaging (UiLayeringArchitectureTests enforces this), so this test-only
         reference is scoped to this project, matching ScanlineStudio.UI.Tests's own identical
         reference for the same reason. -->
    <ProjectReference Include="..\..\src\ScanlineStudio.Core.Imaging\ScanlineStudio.Core.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared-compile, not a second hand-written copy: ScanlineStudio.UI.Tests's Fakes.cs already
         has every fake this project's perspective-drag tests need (FakeLocalizationService,
         FakeFilePickerService, FakeImageFileLoader, FakeRadioSessionService, FakeReceivedImageBuffer,
         FakeReceiveHistoryStore, FakeTemplateStore, FakeImageSourceWriter). Confirmed self-contained
         (only external deps: Abstractions/Application/Settings/ScanlineStudio.UI.Services, all
         already referenced) before wiring this — a hand-duplicated copy of ~2300 lines including
         two large-interface stubs (IRadioSessionService, IReceiveHistoryStore) would be a real,
         ongoing drift risk this avoids entirely; each project gets its own internal-scoped compiled
         copy from the one source file, so a change in one project's tests can't silently diverge from
         the other's. -->
    <Compile Include="..\ScanlineStudio.UI.Tests\Fakes.cs" Link="Fakes.cs" />
  </ItemGroup>

</Project>
