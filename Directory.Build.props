<Project>

  <!--
    Centralized settings for every project under src/, tests/, and tools/ — see spec/01-architecture.md.
    Individual .csproj files should not repeat TargetFramework/Nullable/etc.; override only what a
    specific project genuinely needs to differ (e.g. OutputType for ScanlineStudio.Host).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>

    <!-- CLAUDE.md: "Treat compiler warnings as errors." -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <IsPackable>false</IsPackable>

    <!--
      spec/18-path-to-1.0.md High item 5: previously absent entirely, so every assembly shipped
      as the .NET default 1.0.0.0 with no way to tell which build a bug report came from. Centralized
      here (not per-project) since every assembly in the solution should agree on the same product
      identity. The .NET 8 SDK automatically appends a git commit SHA to InformationalVersion once it
      detects a .git directory (bundled Microsoft.Build.Tasks.Git, no SourceLink package needed) —
      shortened to the same 7-char form `git log`/commit messages use by the TrimSourceRevisionId
      target below, not the SDK's own full 40-char default. See ScanlineStudio.Host.csproj's own doc
      comment for a dead-end hand-rolled stamping target that predates and is superseded by this.
    -->
    <Version>0.9.0-beta</Version>
    <Product>Scanline Studio</Product>
    <!-- A literal year, not $([System.DateTime]::Now.Year) (code-review finding): the latter makes
         two builds of the identical commit produce different assembly content depending on what
         day they're built, which defeats reproducible/deterministic builds for no real benefit.
         Bump by hand at each new year, same as any other copyright notice. -->
    <Copyright>Copyright © 2026 the Scanline Studio contributors</Copyright>
  </PropertyGroup>

  <!-- The SDK's own git-SHA suffix above appends the FULL 40-char commit hash to
       InformationalVersion, not the short form this project's own commit messages/git log use
       (`git rev-parse` in short form == 7 chars). SourceRevisionId is the property that "+&lt;sha&gt;" suffix
       is actually built from; trim it right after Microsoft.Build.Tasks.Git's own
       InitializeSourceControlInformation target sets it, before anything downstream consumes it. -->
  <Target Name="TrimSourceRevisionId" AfterTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
